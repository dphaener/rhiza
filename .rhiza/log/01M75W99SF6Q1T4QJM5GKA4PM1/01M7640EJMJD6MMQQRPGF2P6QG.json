      },
      {
        "fields": {
          "statement": "Whether a failure is transient is decided by a configurable LLM command, not by language-specific patterns, and fix agents read the failed CI logs themselves."
        },
        "handle": "m32-failures-classified",
        "id": "01M7640BEF2N168VC80M2MWNYG",
