      {
        "fields": {
          "quote": "I think that should all get cleaned up. Rhiza is the only self update candidate moving forward. Self update project is a useless setting at this point. Any non Rhiza projects that want self update can do so through their own custom workflow.",
          "statement": "self_update_project is removed: Rhiza is the only self-update candidate; other projects redeploy themselves through their own custom workflows"
        },
        "handle": "d-no-self-update-project",
        "id": "01M7640BS6K2P3Q0FB5SC3S6CW",
        "key": null,
