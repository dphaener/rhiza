      {
        "fields": {
          "milestone": "32",
          "statement": "Runs clean up after themselves and Rhiza's shipped defaults are language-neutral: no Go-, make- or Rhiza-specific behaviour ships to users, Rhiza keeps its own in its own workflows, and auto-update is a documented setting with channels."
        },
        "handle": "milestone-32",
        "id": "01M7640BA83BXBMSEMZNTMJ5G9",
        "key": "zzzzzzz",
        "kind": "intent",
        "node": "01M7640BA83BXBMSEMZNC4K97G",
        "op": "node.create",
        "parent": null
      },
      {
        "fields": {
          "statement": "Disk use no longer grows with runs: a finished run leaves no agent scratch folders and no index database for its removed worktree behind, and the daemon prunes orphans."
        },
        "handle": "m32-leftovers-cleaned",
        "id": "01M7640BBADP9F9SG2AYZ442HY",
        "key": "i",
        "kind": "intent",
        "node": "01M7640BBADP9F9SG2AVA3CJYR",
        "op": "node.create",
        "parent": "01M7640BA83BXBMSEMZNC4K97G"
      },
      {
        "fields": {
          "statement": "A workflow declares an end-of-run cleanup phase that runs whether the run ends done, failed or abandoned, and never fails the run."
        },
        "handle": "m32-cleanup-phase",
        "id": "01M7640BC582M4EH4NQVXGGN23",
        "key": "r",
        "kind": "intent",
        "node": "01M7640BC582M4EH4NQVWEQF58",
        "op": "node.create",
        "parent": "01M7640BA83BXBMSEMZNC4K97G"
      },
      {
        "fields": {
          "statement": "Rhiza's Go- and Rhiza-specific behaviour (Go cache trim, GOTMPDIR, the PR-head build in ship) lives in Rhiza's own workflows, not in the shipped product."
        },
        "handle": "m32-go-in-own-workflows",
        "id": "01M7640BCVRHRSCQYVTSHDRAAN",
        "key": "w",
        "kind": "intent",
        "node": "01M7640BCVRHRSCQYVTQX29SSW",
        "op": "node.create",
        "parent": "01M7640BA83BXBMSEMZNC4K97G"
      },
      {
        "fields": {
          "statement": "Auto-update is a documented setting, rhiza.daemon.autoUpdate, with channels: off and main now, latest and release once the release channels milestone publishes builds."
        },
        "handle": "m32-auto-update",
        "id": "01M7640BD7VV6DC2F6NSNDYP6S",
        "key": "y",
        "kind": "intent",
