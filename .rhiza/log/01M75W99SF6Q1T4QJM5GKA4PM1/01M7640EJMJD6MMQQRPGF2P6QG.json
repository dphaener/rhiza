      },
      {
        "fields": {
          "quote": "I think it can and should show up in the generated reference and user docs.",
          "statement": "The auto-update setting appears in daemon settings, the generated reference and the user docs"
        },
        "handle": "d-auto-update-documented",
        "id": "01M7640BXVEM10G34R5Q7B511P",
