      },
      {
        "fields": {
          "question": "What triggers an official release?",
          "quote": "#1, and when does a major release happen?",
          "statement": "Every finished milestone triggers a minor release; fix-only patch releases come in between"
        },
        "handle": "m33-milestone-is-minor",
        "id": "01M76AYSX3MH9BQ3HBT55EG9MZ",
        "key": null,
