      {
        "fields": {
          "statement": "Releases are cut by rule: a finished milestone is a minor, landed fixes a batched patch (a severe fix at once), every release passes CI, a 24h soak and the milestone-closed gate with notes from the model; minor and patch are automatic, a major is owner-gated and strict semver holds from v1.0.0."
        },
        "handle": "m33-release-policy",
        "id": "01M76AYSVSA60HBQ48Z2DA02A0",
        "key": "y",
        "kind": "intent",
        "node": "01M76AYSVSA60HBQ48YZFSVRS3",
