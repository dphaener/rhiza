      {
        "fields": {
          "question": "When does a major release happen?",
          "quote": "If we're sticking to semver, then a breaking change is always a major release. Does semver allow for a major release that is NOT a breaking change?",
          "statement": "Releases follow semver: a breaking change is always a major release (strict from v1.0.0, as settled next)"
        },
