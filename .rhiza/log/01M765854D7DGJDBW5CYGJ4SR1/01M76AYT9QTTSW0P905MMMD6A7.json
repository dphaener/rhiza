        "parent": null
      },
      {
        "fields": {
          "question": "Once the gates pass, who tags the release?",
          "quote": "Fully automatic for minor and patch, owner gated for major releases",
          "statement": "Minor and patch releases are cut fully automatically once the gates pass; a major release waits for the owner's sign-off"
        },
        "handle": "m33-auto-minor-patch",
