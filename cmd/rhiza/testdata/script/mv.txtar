# mv moves a capability or intent: --parent or --root, and --before or
# --after a sibling (default after the last one). On a landed node it writes
# a node.move, and a second mv replaces it (D9); on a node added here it
# revises the node.create.

rhiza init
rhiza change new Shape
rhiza add capability store --record
rhiza add capability api --record
rhiza add capability log --parent store --record

# A landed node: one node.move, replaced by the next mv.
rhiza mv log --root
stdout '^Wrote entry [0-9A-Z]{26} to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^- node [0-9A-Z]{26} \(log\)$'
rhiza mv log --parent api --json
stdout '"nodes": \['
rhiza change show --json
stdout '"op": "node.move"'
stdout '"key": "i"'
! stdout '"parent": null'
rhiza change show
stdout -count=1 '^- node.move '

# Placing before a sibling.
rhiza mv api --before store
rhiza change show
stdout -count=2 '^- node.move '

# A node added here: its create is revised.
rhiza add capability new
rhiza mv new --parent store
rhiza change show
stdout -count=1 '^- node.create .*\(new\)$'
stdout -count=2 '^- node.move '

# A dry run prints the move and writes nothing.
rhiza mv store --after api --dry-run
stdout '^Dry run: would write 1 operation\(s\)'
stdout '"op":"node.move"'
rhiza change show
stdout -count=2 '^- node.move '

# Usage errors, exit 2.
rhiza add decision d
! rhiza mv d --root --json
stdout '"code": "usage"'
stdout 'not in a tree'
! rhiza mv store --parent store
stderr 'under itself or one of its descendants'
! rhiza mv store --root --parent api
stderr 'not both'
! rhiza mv store
stderr '^rhiza: nothing to move'
! rhiza mv store --after new
stderr 'not a sibling'
! rhiza mv 01M5PWG --root --json
stdout '"code": "usage"'

# Unknown ref, exit 4.
! rhiza mv nosuch --root --json
stdout '"code": "not_found"'

fold-ok
