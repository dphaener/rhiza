# The read apps show what the matching command prints with --json. --once
# runs the app's operation in-process and prints the result; it never dials
# Rex, starts a daemon or binds a socket.

exec rhiza init
exec rhiza add intent grow --record
exec rhiza add capability store --record
exec rhiza change new A
exec rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves grow
exec rhiza set store --field statement=Kept
exec rhiza propose
exec rhiza accept --reason ok
fold-ok

env REX_SESSION=
env REX_SERVER=

exec rhiza roadmap --json
cp stdout want-roadmap.json
exec rhiza tui app roadmap --once
cmp stdout want-roadmap.json

exec rhiza ready --json
cp stdout want-ready.json
exec rhiza tui app ready --once
cmp stdout want-ready.json

exec rhiza show store --json
cp stdout want-show.json
exec rhiza tui app show store --once
cmp stdout want-show.json

exec rhiza why store --json
cp stdout want-why.json
exec rhiza tui app why store --once
cmp stdout want-why.json

exec rhiza slice store --json
cp stdout want-slice.json
exec rhiza tui app slice store --once
cmp stdout want-slice.json

# No daemon lock or socket was created.
! exists .rhiza/daemon.lock
! exec rhiza tui app nope --once
stderr 'unknown app "nope"'
