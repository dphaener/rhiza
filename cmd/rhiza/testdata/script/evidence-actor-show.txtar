# An Evidence node's actor is the actor stamped on the entry that created
# it: show gives it, the rendered page names it, and another actor setting
# a field on it later changes nothing.

rhiza init
rhiza add actor verifier --record
rhiza add actor other --record
rhiza add capability store --field 'statement=Keeps the log' --record

env RHIZA_ACTOR=verifier
rhiza add evidence store-ok --field 'statement=store keeps the log' --field result=PASS --record
rhiza link store-ok verifies store --record
env RHIZA_ACTOR=other
rhiza set store-ok --field result=FAIL --field command=other --record
env RHIZA_ACTOR=

# show --json gives the creating actor's handle; a field named command stays
# a field.
rhiza show store-ok --json
stdout '^    "actor": "verifier",$'
stdout '^      "command": "other",?$'
! stdout '^    "actor": "other"'
stdout '^      "result": "FAIL",?$'

# show names it next to Created.
rhiza show store-ok
stdout '^- Created: '
stdout '^- Actor: verifier$'

# Nodes of other kinds carry no actor.
rhiza show store --json
! stdout '^    "actor":'
rhiza show store
! stdout '^- Actor:'
rhiza show verifier --json
! stdout '^    "actor":'

# The rendered page names it, linked to the actor's page.
rhiza render
grep '^evidence · `[0-9A-Z]{26}` · actor \[verifier\]\(\.\./actor/verifier\.md\)$' .rhiza/rendered/evidence/store-ok.md
! grep 'actor \[other\]' .rhiza/rendered/evidence/store-ok.md
! grep ' · actor ' .rhiza/rendered/capability/store.md

# In a draft change set the what-if view gives it the same way.
rhiza change new 'More evidence'
env RHIZA_ACTOR=verifier
rhiza add evidence log-ok --field 'statement=the log reads' --field result=PASS
env RHIZA_ACTOR=other
rhiza set log-ok --field result=FAIL
env RHIZA_ACTOR=
rhiza show log-ok --json
stdout '"view": "what-if:'
stdout '^    "actor": "verifier",$'

fold-ok
