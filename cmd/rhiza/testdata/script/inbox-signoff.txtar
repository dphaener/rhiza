# rhiza inbox approve <item> and rhiza inbox request-changes <item> <file>
# act on a sign-off item through rhiza run approve and rhiza run
# request-changes on that item's run. A review run waiting at its sign-off
# is approved through its item and ends done with an approved entry;
# another is sent back with one finding and starts a fix cycle; on a
# question item both exit 2 and journal nothing.
#
# The fake rex runs the tab's command synchronously in the window's
# directory. The fake claude passes as check alpha; as the fixer it
# commits with a Leaf: trailer; as the verifier it writes Evidence.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
exec git add -A
exec git commit -qm review

# A review run waits at its sign-off.
exec rhiza change new 'Approve me' --title 'Approve me'
exec rhiza add capability thing
exec git add -A
exec git commit -qm thing
exec sh -c 'rhiza run start --foreground --workflow review --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
stdout '^exit=0$'
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ signoff " | cut -d" " -f1'
cp stdout $WORK/aid
exec sh -c 'wc -l < $(ls -t .git/rhiza/runs/*.jsonl | head -1)'
cp stdout $WORK/approve.lines

# A dry run journals nothing.
exec sh -c 'rhiza inbox approve --foreground --dry-run --json "$(cat $WORK/aid)"'
stdout '"outcome": "approved"'
stdout '"dry_run": true'
exec sh -c 'wc -l < $(ls -t .git/rhiza/runs/*.jsonl | head -1)'
cmp stdout $WORK/approve.lines

# Approving the item ends the run done with an approved entry.
exec sh -c 'rhiza inbox approve --foreground "$(cat $WORK/aid)"; echo exit=$?'
stdout '^Sign-off: signoff \(visit 1\): approved by test$'
stdout '^Run [0-9A-Z]{26} succeeded$'
stdout '^exit=0$'
exec rhiza run status --json
stdout '"state": "succeeded"'
stdout '"outcome": "approved"'
exec rhiza inbox
stdout '^Nothing waits on you$'

# A second review, on another change set, is sent back with one finding.
exec rhiza change new 'Change me' --title 'Change me'
exec rhiza add capability other
exec git add -A
exec git commit -qm other
exec sh -c 'rhiza run start --foreground --workflow review --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ signoff " | cut -d" " -f1'
cp stdout $WORK/cid
exec sh -c 'rhiza inbox request-changes --foreground "$(cat $WORK/cid)" $WORK/changes.json; echo exit=$?'
stdout '^Sign-off: signoff \(visit 1\): changes asked by test$'
stdout '^- alpha f1 major at other.txt:1 on other: say more$'
stdout '^Step review fixes them, then the run waits for the sign-off again\.$'
stdout '^exit=0$'
exec cat $WORK/claude.log
stdout 'role=fixer .* leaf=other findings=yes'
exec rhiza run status --json
stdout '"outcome": "changes"'
stdout '"signoff_waiting": true'

# A question item is no sign-off: both commands exit 2.
mkdir .git/rhiza/runs
cp $WORK/question.jsonl .git/rhiza/runs/QUESTIONRUN.jsonl
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ question " | cut -d" " -f1'
cp stdout $WORK/qid
exec sh -c 'cat .git/rhiza/runs/QUESTIONRUN.jsonl | wc -l'
cp stdout $WORK/q.lines
exec sh -c 'rhiza inbox approve --foreground "$(cat $WORK/qid)"; echo exit=$?'
stdout '^exit=2$'
stderr 'inbox approve works on a sign-off item, and item [0-9a-f]+ is a question'
exec sh -c 'rhiza inbox request-changes --foreground "$(cat $WORK/qid)" $WORK/changes.json; echo exit=$?'
stdout '^exit=2$'
stderr 'inbox request-changes works on a sign-off item'
exec sh -c 'cat .git/rhiza/runs/QUESTIONRUN.jsonl | wc -l'
cmp stdout $WORK/q.lines

# An unknown item exits 2 too.
exec sh -c 'rhiza inbox approve --foreground nope; echo exit=$?'
stdout '^exit=2$'

fold-ok

-- empty-round.json --
{"findings":[]}
-- changes.json --
{"findings":[{"check":"alpha","severity":"major","leaf":"other","place":"other.txt:1","reason":"say more"}]}
-- question.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSQUESTION"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"blocked","at":"2026-01-01T01:00:00Z","step":"build","session":"S1","block":{"kind":"question","question":"Which store?","tab_title":"leaf one","tab_block":"block:b1"}}
-- review.toml --
[step.review]
kind = "checks"
interval = "50ms"
max_visits = 2
on.pass = "signoff"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"

[step.signoff]
kind = "signoff"
max_visits = 2
on.pass = "done"
on.changes = "review"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
found=
case "$last" in *"The owner requested these changes on leaf other:"*"say more"*) found=yes ;; esac
echo "role=$RHIZA_ROLE check=$RHIZA_CHECK cycle=$RHIZA_CYCLE leaf=$RHIZA_LEAF findings=$found" | sed 's/ findings=$//' >> "$WORK/claude.log"
case "$RHIZA_ROLE" in
check)
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty-round.json" >&2 || exit 1
	;;
fixer)
	echo more > "$RHIZA_LEAF.txt"
	git add "$RHIZA_LEAF.txt"
	git commit -q -m "fix $RHIZA_LEAF" -m "Leaf: $RHIZA_LEAF" -- "$RHIZA_LEAF.txt" || exit 1
	;;
verifier)
	rhiza add evidence "$RHIZA_LEAF-ok" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	rhiza link "$RHIZA_LEAF-ok" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
	;;
esac
exit 0
