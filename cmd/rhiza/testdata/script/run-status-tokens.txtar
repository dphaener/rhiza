# run status lists every session the run launched, in order, with its step
# and the latest reading of its token use, and the run's totals: the sums
# of the sessions with a reading, the sessions' own tokens and their
# helpers' kept apart. A session with no readable token use (no
# transcript) is listed with the reason, no_tokens, and left out of the
# totals.
#
# Nothing here reaches Rex or Claude Code. The fake rex runs the tab's
# command synchronously. The fake claude counts its calls: the first
# (build) and second (review) write made-up transcripts with known usage
# to $HOME/.claude/projects/p/<sid>.jsonl; the third (check) writes none.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Token use' --title 'Token use' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
mkdir .rhiza/workflows
cp $WORK/three.toml .rhiza/workflows/three.toml

exec rhiza run start --foreground --workflow three --permission-mode manual
stdout '^Run 01M5PWGJC82P7YGZTWYFFZ0VJG succeeded$'
stderr '^rhiza: step check: record token use: no transcript of session '

exec rhiza run status 01M5PWGJC82P7YGZTWYFFZ0VJG --json
stdout '"sessions": \[\n\s+\{\n\s+"session": "158fe87f-5cf4-47e4-a3e9-01a16dc84988",\n\s+"step": "build",\n\s+"tokens": \{\n\s+"helpers": \{\n\s+"cache_creation": 3,\n\s+"cache_read": 4,\n\s+"input": 1,\n\s+"output": 2\n\s+\},\n\s+"session": \{\n\s+"cache_creation": 30,\n\s+"cache_read": 40,\n\s+"input": 10,\n\s+"output": 20\n\s+\}\n\s+\}\n\s+\},\n\s+\{\n\s+"session": "158fe87f-5cf8-452b-9c62-01a16dc84988",\n\s+"step": "review",\n\s+"tokens": \{\n\s+"helpers": \{\n\s+"cache_creation": 7,\n\s+"cache_read": 8,\n\s+"input": 5,\n\s+"output": 6\n\s+\},\n\s+"session": \{\n\s+"cache_creation": 300,\n\s+"cache_read": 400,\n\s+"input": 100,\n\s+"output": 200\n\s+\}\n\s+\}\n\s+\},\n\s+\{\n\s+"no_tokens": "transcript unreadable: no transcript of session 158fe87f-5cfc-4086-9c96-01a16dc84988: looked in [^"]*",\n\s+"session": "158fe87f-5cfc-4086-9c96-01a16dc84988",\n\s+"step": "check"\n\s+\}\n\s+\],'
# The totals are the sums of build and review; check adds nothing.
stdout '"totals": \{\n\s+"helpers": \{\n\s+"cache_creation": 10,\n\s+"cache_read": 12,\n\s+"input": 6,\n\s+"output": 8\n\s+\},\n\s+"session": \{\n\s+"cache_creation": 330,\n\s+"cache_read": 440,\n\s+"input": 110,\n\s+"output": 220\n\s+\}\n\s+\}'
stdout -count=2 '"tokens": \{'

exec rhiza run status 01M5PWGJC82P7YGZTWYFFZ0VJG
stdout '^## Sessions\n\n- build, session 158fe87f-5cf4-47e4-a3e9-01a16dc84988: tokens input 10, output 20, cache creation 30, cache read 40; helper tokens input 1, output 2, cache creation 3, cache read 4\n- review, session 158fe87f-5cf8-452b-9c62-01a16dc84988: tokens input 100, output 200, cache creation 300, cache read 400; helper tokens input 5, output 6, cache creation 7, cache read 8\n- check, session 158fe87f-5cfc-4086-9c96-01a16dc84988: no token use shown, transcript unreadable: no transcript of session 158fe87f-5cfc-4086-9c96-01a16dc84988: looked in [^\n]*\n\nTotals: tokens input 110, output 220, cache creation 330, cache read 440; helper tokens input 6, output 8, cache creation 10, cache read 12\n'

# A run with no sessions lists none and has zero totals.
cp $WORK/cmd.toml .rhiza/workflows/cmd.toml
exec rhiza run start --foreground --workflow cmd
stdout '^Run 01M5PWGNA0MVZ1H5AXG5VQ0BY9 succeeded$'
exec rhiza run status 01M5PWGNA0MVZ1H5AXG5VQ0BY9 --json
stdout '"sessions": \[\],'
stdout '"totals": \{\n\s+"helpers": \{\n\s+"cache_creation": 0,\n\s+"cache_read": 0,\n\s+"input": 0,\n\s+"output": 0\n\s+\},\n\s+"session": \{\n\s+"cache_creation": 0,\n\s+"cache_read": 0,\n\s+"input": 0,\n\s+"output": 0\n'
exec rhiza run status 01M5PWGNA0MVZ1H5AXG5VQ0BY9
! stdout '## Sessions'
! stdout 'Totals'

fold-ok

-- three.toml --
name = "three"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "review"
on.fail = "review"

[step.review]
kind = "agent"
prompt = "Review {change}"
interval = "50ms"
on.pass = "check"
on.fail = "check"

[step.check]
kind = "agent"
prompt = "Check {change}"
interval = "50ms"
on.pass = "done"
on.fail = "done"
-- cmd.toml --
name = "cmd"

[step.a]
kind = "command"
run = "true"
on.pass = "done"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@"; echo "exit=$?") >"$WORK/tab.out" 2>&1
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
echo x >> "$WORK/claude.calls"
n=$(wc -l < "$WORK/claude.calls" | tr -d ' ')
t="$HOME/.claude/projects/p/$sid.jsonl"
mkdir -p "$HOME/.claude/projects/p"
if [ "$n" = 1 ]; then
	echo '{"type":"assistant","isSidechain":false,"message":{"id":"msg_A","usage":{"input_tokens":10,"output_tokens":20,"cache_creation_input_tokens":30,"cache_read_input_tokens":40}}}' > "$t"
	echo '{"type":"assistant","isSidechain":true,"message":{"id":"msg_H","usage":{"input_tokens":1,"output_tokens":2,"cache_creation_input_tokens":3,"cache_read_input_tokens":4}}}' >> "$t"
fi
if [ "$n" = 2 ]; then
	echo '{"type":"assistant","isSidechain":false,"message":{"id":"msg_B","usage":{"input_tokens":100,"output_tokens":200,"cache_creation_input_tokens":300,"cache_read_input_tokens":400}}}' > "$t"
	echo '{"type":"assistant","isSidechain":true,"message":{"id":"msg_I","usage":{"input_tokens":5,"output_tokens":6,"cache_creation_input_tokens":7,"cache_read_input_tokens":8}}}' >> "$t"
fi
exit 0
