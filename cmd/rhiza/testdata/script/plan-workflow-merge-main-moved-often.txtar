# When origin/main moves again and again (a busy main), the built-in plan
# workflow's merge step fails each time (no gh pr merge call) and the run goes
# back to rebase, up to its cap of 6 visits: here main moves after each of the
# first three rebased-green checks, so merge fails three times, and the fourth
# rebased head is merged, pinned to it, before closing out. The run never goes
# over max_visits.
#
# The fakes are plan-workflow-merge-main-moved.txtar's, except that the fake gh
# pushes a commit to origin's main on its 5th, 7th and 9th pr view of the
# plan's branch (right after each of the first three rebased-green checks).

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH
mkdir $HOME/.claude/projects/p
exec git init -q --bare origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
exec git add -A
exec git commit -qm init
exec git push -q -u origin main

# A draft record change set to plan a milestone in, committed (with the
# owner's actor) so the run's worktree has it.
exec rhiza change new 'Plan reports' --kind record --title 'Plan reports' --json
stdout '"change_set": "(01[0-9A-Z]{24})"'
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\".*/\1/p" > $WORK/rec'
exec git add -A
exec git commit -qm 'Plan reports'
exec git push -q origin main

exec sh -c 'rhiza run start --foreground $(cat $WORK/rec) --workflow plan --permission-mode manual > $WORK/out 2> $WORK/err; echo exit=$?'
stdout '^exit=0$'
exec cat $WORK/out
stdout '^Run [0-9A-Z]{26} succeeded$'

exec rhiza run status
stdout '^- pr-green \(visit 1\): pass, then rebase: exit 0$'
stdout '^- rebase \(visit 1\): pass, then wait-rebased: exit 0$'
stdout '^- rebased-green \(visit 1\): pass, then merge: exit 0$'
stdout '^- merge \(visit 1\): fail, then rebase: exit 1$'
stdout '^- rebase \(visit 2\): pass, then wait-rebased: exit 0$'
stdout '^- rebased-green \(visit 2\): pass, then merge: exit 0$'
stdout '^- merge \(visit 2\): fail, then rebase: exit 1$'
stdout '^- rebase \(visit 3\): pass, then wait-rebased: exit 0$'
stdout '^- rebased-green \(visit 3\): pass, then merge: exit 0$'
stdout '^- merge \(visit 3\): fail, then rebase: exit 1$'
stdout '^- rebase \(visit 4\): pass, then wait-rebased: exit 0$'
stdout '^- rebased-green \(visit 4\): pass, then merge: exit 0$'
stdout '^- merge \(visit 4\): pass, then close-out: exit 0$'
stdout '^- close-out \(visit 1\): pass'
! stdout 'visit 5'
! stdout 'went over max_visits'
exists $WORK/moved
exec sh -c 'grep -c "^pr merge" $WORK/gh.log'
stdout '^1$'
exec sh -c 'grep -c -x "pr merge 7 --squash --match-head-commit $(cat $WORK/merged-head)" $WORK/gh.log'
stdout '^1$'
exec sh -c 'git --git-dir=$WORK/origin.git merge-base --is-ancestor $(cat $WORK/other.sha) $(cat $WORK/merged-head) && echo holds'
stdout '^holds$'
fold-ok

-- source.json --
{"title":"Planning interview","summary":"The owner planned the reports milestone.","quotes":[{"text":"Stream it, reports get huge","by":"owner"}]}
-- record.json --
{"writes":[
  {"op":"add","kind":"intent","handle":"milestone-1","fields":["statement=Users take their reports out of the product","milestone=1"]},
  {"op":"add","kind":"decision","handle":"csv-streaming","fields":[
    "statement=Stream CSV rows instead of building the file in memory",
    "quote=Stream it, reports get huge"]},
  {"op":"link","from":"csv-streaming","type":"derived-from","to":"plan-interview"}
]}
-- leaf.json --
{"writes":[
  {"op":"add","kind":"capability","handle":"export-csv","fields":["statement=Users export any report as CSV"]},
  {"op":"link","from":"export-csv","type":"decided-by","to":"csv-streaming"}
]}
-- findings.json --
{"findings":[{"node":"export-csv","kind":"missing-acceptance","reason":"export-csv has no acceptance check"}]}
-- clean.json --
{"findings":[]}
-- verdict.json --
{"verdicts":[{"finding":"f1","verdict":"confirmed","reason":"export-csv has no acceptance field"}]}
-- fix.json --
{"writes":[
  {"op":"set","ref":"export-csv","fields":["acceptance=A test exports a 100k-row report with flat memory use"]}
]}
-- transcript.jsonl --
{"type": "user", "message": {"role": "user", "content": "Stream it, reports get huge"}}
-- bin/rex --
#!/bin/sh
case "$1 $2" in
window\ close | block\ close)
	echo "$*" >> "$WORK/rex.log"
	exit 0
	;;
esac
case "$1" in
events | send | send-key)
	echo "$*" >> "$WORK/rex.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
i=0
until [ -f "$WORK/ready" ]; do
	i=$((i + 1))
	if [ $i -gt 1600 ]; then
		echo 'fake rex: the agent never got ready' >&2
		exit 1
	fi
	sleep 0.025
done
rm -f "$WORK/ready"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
printf '%s\n' "$last" >> "$WORK/prompts.log"
fail() {
	echo "fake claude: $*" >> "$WORK/claude.err"
	touch "$WORK/ready"
	exit 1
}
has_acceptance() {
	rhiza show export-csv --change "$(cat "$WORK/cs")" --json | grep -q '"acceptance"'
}
case "$last" in
/rhiza-planner*)
	rec=$RHIZA_CHANGE
	cp "$WORK/transcript.jsonl" "$HOME/.claude/projects/p/$RHIZA_SESSION.jsonl"
	rhiza source add plan-interview "$WORK/source.json" --raw-session "$RHIZA_SESSION" --json >> "$WORK/agent.out" || fail source
	rhiza apply "$WORK/record.json" --json >> "$WORK/agent.out" || fail record
	rhiza change new 'Export reports' --json > "$WORK/new.out" || fail change new
	sed -n 's/.*"change_set": "\([0-9A-Z]*\)".*/\1/p' "$WORK/new.out" > "$WORK/cs"
	rhiza link "$(cat "$WORK/cs")" serves milestone-1 --change "$rec" >> "$WORK/agent.out" || fail serves
	rhiza land --json >> "$WORK/agent.out" || fail land
	rhiza apply "$WORK/leaf.json" --change "$(cat "$WORK/cs")" --json >> "$WORK/agent.out" || fail leaf
	;;
/rhiza-plan-reviewer*)
	if has_acceptance; then
		rhiza run findings "$WORK/clean.json" --json >> "$WORK/agent.out" || fail findings
	else
		rhiza run findings "$WORK/findings.json" --json >> "$WORK/agent.out" || fail findings
	fi
	;;
/rhiza-plan-critic*)
	if ! has_acceptance; then
		rhiza run verdict "$WORK/verdict.json" --json >> "$WORK/agent.out" || fail verdict
	fi
	;;
*'as check '*)
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/clean.json" --json >> "$WORK/agent.out" || fail check
	;;
/rhiza-plan-reviser*)
	rhiza apply "$WORK/fix.json" --change "$(cat "$WORK/cs")" --json >> "$WORK/agent.out" || fail fix
	;;
*)
	fail "unexpected prompt: $last"
	;;
esac
rhiza session done >> "$WORK/done.out" || fail done
touch "$WORK/ready"
exit 0
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
o="$WORK/origin.git"
case "$1 $2" in
"pr view")
	if [ ! -f "$WORK/pr.created" ]; then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	case "$3" in
	7 | 8)
		printf '{"state":"MERGED","mergeCommit":{"oid":"%s"}}\n' "$(cat "$WORK/merged-head")"
		exit 0
		;;
	esac
	# The plan's branch has PR #7, merged by the plan run; the planned
	# change set's branch has none until the ship run opens #8.
	if [ "$3" != cs/plan-reports ] && [ ! -f "$WORK/pr2.created" ]; then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	n=7
	state=OPEN
	if [ -f "$WORK/pr.merged" ]; then
		state=MERGED
	fi
	if [ -f "$WORK/pr2.created" ]; then
		n=8
		state=OPEN
	fi
	head=$(git -C "$o" rev-parse --verify "refs/heads/$3")
	echo x >> "$WORK/views"
	case "$(wc -l < "$WORK/views")" in
	5 | 7 | 9)
		sha=$(git -C "$o" commit-tree "refs/heads/main^{tree}" -p refs/heads/main -m 'Another change set')
		git -C "$o" update-ref refs/heads/main "$sha"
		echo "$sha" > "$WORK/other.sha"
		touch "$WORK/moved"
		;;
	esac
	printf '{"body":"Change set '"$csid"'","number":%s,"url":"https://github.test/o/r/pull/%s","state":"%s","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"}]}\n' "$n" "$n" "$state" "$head"
	;;
"pr merge")
	# Squash-free: main on origin takes the branch as it was checked.
	b=$(git -C "$o" for-each-ref --format='%(refname:short)' 'refs/heads/cs/*')
	git -C "$o" rev-parse "refs/heads/$b" > "$WORK/merged-head"
	git -C "$o" update-ref refs/heads/main "refs/heads/$b"
	rm -f "$WORK/pr2.created"
	touch "$WORK/pr.merged"
	;;
"pr create")
	while [ $# -gt 0 ]; do
		if [ "$1" = --body-file ]; then
			cp "$2" "$WORK/pr-body.md"
		fi
		shift
	done
	if [ -f "$WORK/pr.created" ]; then
		touch "$WORK/pr2.created"
	fi
	touch "$WORK/pr.created"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
