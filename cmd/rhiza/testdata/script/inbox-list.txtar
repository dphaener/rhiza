# rhiza inbox lists, oldest first across every run, what waits on the owner:
# a question, a run waiting at sign-off, a failed run, and a run the daemon
# gave up on (interrupted again after its one resume). A done run is not
# listed. Once the question is answered, the sign-off approved, the given-up
# run abandoned and a new run finished on the failed run's change set,
# nothing waits. The journals are fixtures.

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init

exec rhiza inbox
stdout '^Nothing waits on you$'
exec rhiza inbox --json
stdout '"items": \[\]'

mkdir .git/rhiza/runs
cp ../question.jsonl .git/rhiza/runs/QUESTIONRUN.jsonl
cp ../signoff.jsonl .git/rhiza/runs/SIGNOFFRUN01.jsonl
cp ../failed.jsonl .git/rhiza/runs/FAILEDRUN001.jsonl
cp ../done.jsonl .git/rhiza/runs/DONERUN00001.jsonl
exec sh -c 'sed "s/HOST/$(hostname)/" ../gaveup.jsonl > .git/rhiza/runs/GAVEUPRUN001.jsonl'

# The first four, in order of when they began to wait.
exec rhiza inbox
stdout 'question run QUESTIONRUN, change set CSQUESTION, step build'
stdout 'tab: leaf one'
stdout 'question: Which store\?'
stdout 'signoff run SIGNOFFRUN01, change set CSSIGNOFF, step signoff'
stdout 'failed run FAILEDRUN001, change set CSFAILED, step build'
stdout 'boom'
stdout 'gave-up run GAVEUPRUN001, change set CSGAVEUP, step build'
! stdout 'DONERUN00001'
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ " | sed -E "s/^[0-9a-f]+ ([a-z-]+) .*/\1/" | tr "\n" " "'
stdout '^question signoff failed gave-up $'
exec rhiza inbox --json
stdout '"kind": "question"'
stdout '"question": "Which store\?"'
stdout '"tab": "leaf one"'
stdout '"kind": "gave-up"'
! stdout 'DONERUN00001'
exec sh -c 'rhiza inbox --json | grep "\"kind\"" | tr -d " \n"'
stdout '^"kind":"question".*"kind":"signoff".*"kind":"failed".*"kind":"gave-up"'

# Clear each: answer, approve, abandon, and a new run on the failed change set.
exec sh -c 'echo "{\"type\":\"unblocked\",\"at\":\"2026-01-02T00:00:00Z\",\"step\":\"build\",\"session\":\"S1\"}" >> .git/rhiza/runs/QUESTIONRUN.jsonl'
exec sh -c 'echo "{\"type\":\"signoff\",\"at\":\"2026-01-02T00:00:01Z\",\"step\":\"signoff\",\"visit\":1,\"rule\":\"owner\",\"outcome\":\"approved\"}" >> .git/rhiza/runs/SIGNOFFRUN01.jsonl'
exec rhiza run abandon GAVEUPRUN001
exec sh -c 'cat ../newrun.jsonl > .git/rhiza/runs/NEWRUN000001.jsonl'
exec rhiza inbox
stdout '^Nothing waits on you$'
exec rhiza inbox --json
stdout '"items": \[\]'
# Two proposed change sets setting one field of a node overlap: the inbox
# lists the overlap with no run, naming both change sets and the target, and
# inbox open on it exits 2.
exec rhiza add capability thing --field 'statement=Does the thing' --record
exec rhiza render
exec rhiza change new 'First edit' --json
exec rhiza set thing --field statement=A
exec rhiza propose
exec rhiza change new 'Second edit' --json
exec rhiza set thing --field statement=B
exec rhiza propose
exec rhiza inbox
stdout -count=1 '^[0-9a-f]{7} overlap change sets [0-9A-Z]{26} and [0-9A-Z]{26}$'
stdout -count=1 '^  target: thing$'
stdout '^  both write field:statement$'
stdout -count=1 '^  next: rhiza slice --change [0-9A-Z]{26} --view what-if$'
exec rhiza inbox --json
stdout '"kind": "overlap"'
stdout '"target": "thing"'
stdout '"other": "[0-9A-Z]{26}"'
! stdout '"run"'
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]{7} overlap" | cut -d" " -f1 > id.txt'
exec sh -c 'rhiza inbox open $(cat id.txt) 2>err.txt; echo $?'
stdout '^2$'
exec cat err.txt
stdout 'overlap'
-- question.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSQUESTION"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"blocked","at":"2026-01-01T01:00:00Z","step":"build","session":"S1","block":{"kind":"question","question":"Which store?","tab_title":"leaf one","tab_block":"block:b1"}}
-- signoff.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"signoff","started":{"workflow":"ship-change","definition":"","change":"CSSIGNOFF"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"signoff","visit":1}
{"type":"stopped","at":"2026-01-01T02:00:00Z","step":"signoff","detail":"waiting for the owner's sign-off: rhiza run approve | rhiza run request-changes <file>; rhiza run summary"}
-- failed.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSFAILED"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"finished","at":"2026-01-01T03:00:00Z","step":"build","end":"failed","detail":"boom"}
-- gaveup.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSGAVEUP"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"process","at":"2026-01-01T00:00:02Z","process":{"host":"HOST","pid":999999}}
{"type":"daemon-resumed","at":"2026-01-01T04:00:00Z","detail":"resumed by the daemon"}
{"type":"process","at":"2026-01-01T04:00:30Z","process":{"host":"HOST","pid":999999}}
-- done.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSDONE"}}
{"type":"finished","at":"2026-01-01T05:00:00Z","end":"succeeded"}
-- newrun.jsonl --
{"type":"started","at":"2026-01-03T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSFAILED"}}
{"type":"finished","at":"2026-01-03T00:00:05Z","end":"succeeded"}
