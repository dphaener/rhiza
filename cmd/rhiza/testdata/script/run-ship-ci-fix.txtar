# A red PR goes to a fixer instead of failing the run. When the head's CI
# fails (after its once-per-head rerun) with failing tests in the log,
# ship-change routes pr-green or rebased-green to ci-triage, which passes
# only when ship check recorded a failing test, then to ci-fix: one fixer
# session on the run worktree that commits with a Review: trailer. The run
# renders, pushes and waits for CI again, at most twice.
#
# Case 1: red at pr-green, one fix makes it green; the run reaches its
# sign-off. The owner then approves, and it lands and merges.
# Case 2: green at pr-green, red at rebased-green (a new test fails on the
# rebased head): a second fix, sign-off again, rebase again, then it lands.
# Case 3: still red after two fixes: the run fails, naming the tests.
# Case 4: red with a log naming no test (infra): the run fails at ci-triage
# and ci-fix never runs.
#
# The fakes are run-ship-change.txtar's, except that gh's PR is red until
# the branch holds as many fix-N.txt files as $WORK/need says, and its
# failed-job log names TestScripts/x and its subtest x/sub (or an infra error, with $WORK/infra).

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH

# Case 1: red at pr-green, fixed once.
exec sh -c 'echo 1 > $WORK/need'
exec sh $WORK/setup.sh
cd repo
exec sh -c 'rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
stdout '^exit=0$'
exec rhiza run status
stdout '^- pr-green \(visit 1\): fail, then conflict-triage'
stdout '^- conflict-triage \(visit 1\): fail, then ci-triage'
stdout '^- ci-triage \(visit 1\): pass, then ci-fix: '
stdout '^- ci-fix \(visit 1\): pass, then render-pr'
stdout '^- render-pr \(visit 2\): pass, then open-pr'
stdout '^- pr-green \(visit 2\): pass, then signoff'
stdout '^- Current step: signoff$'
# The one fixer's commit carries a Review: trailer naming the run, with
# the failing test read from the CI log.
exec sh -c 'wc -l < $WORK/fixes.log'
stdout '^1$'
exec git -C $WORK/repo.ship-it log -1 --format=%B --grep='fix ci 1'
stdout '^Review: \S+$'
grep 'run view 42 --log-failed' $WORK/gh.log
exec sh -c 'grep -c "^run rerun" $WORK/gh.log || true'
stdout '^1$'

# Case 2: the rebased head is red again (a second test fails): one more
# fix, the sign-off again and a second rebase; then it lands and merges.
exec sh -c 'echo 2 > $WORK/need'
cd $WORK/repo.ship-it
exec sh -c 'rhiza run approve --foreground --json; echo exit=$?'
stdout '"signoff_waiting": true'
exec rhiza run status
stdout '^- rebased-green \(visit 1\): fail, then conflict-triage'
stdout '^- conflict-triage \(visit 2\): fail, then ci-triage'
stdout '^- ci-triage \(visit 2\): pass, then ci-fix'
stdout '^- ci-fix \(visit 2\): pass, then render-pr'
stdout '^- Current step: signoff$'
exec sh -c 'wc -l < $WORK/fixes.log'
stdout '^2$'
exec sh -c 'rhiza run approve --foreground; echo exit=$?'
stdout '^exit=0$'
stdout '^Run \S+ succeeded$'
cd $WORK/repo
exec rhiza run status
stdout '^- rebase \(visit 2\): pass, then wait-rebased'
stdout '^- rebased-green \(visit 2\): pass, then land'
stdout '^- land \(visit 1\): pass'
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- State: landed'
exec git -C $WORK/origin.git log main --format=%s
stdout 'Ship it \(#7\)'

# Case 3: still red after two fixes: the third red head fails the run and
# its output names the failing tests.
exec sh -c 'echo 99 > $WORK/need'
cd $WORK
exec sh $WORK/setup.sh
cd repo
exec sh -c 'rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
! stdout '"signoff_waiting": true'
exec rhiza run status
stdout '^- ci-fix \(visit 2\): pass, then render-pr'
stdout '^- ci-triage \(visit 3\)'
stdout 'TestScripts/x'
! stdout '^- ci-fix \(visit 3\)'
exec rhiza run status --json
stdout '"state": "failed"'
exec sh -c 'wc -l < $WORK/fixes.log'
stdout '^2$'

# Case 4: a failure whose log names no test is an infra failure: the run
# fails at ci-triage and no fixer runs.
exec sh -c 'echo 99 > $WORK/need'
cd $WORK
exec sh $WORK/setup.sh
exec sh -c 'touch $WORK/infra'
cd repo
exec sh -c 'rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
exec rhiza run status
stdout '^- ci-triage \(visit 1\): fail'
! stdout '^- ci-fix'
exec rhiza run status --json
stdout '"state": "failed"'
! exists $WORK/fixes.log
-- setup.sh --
#!/bin/sh
# A fresh origin and repo with an accepted change set, as a reviewed one
# would be, committed on main and pushed.
set -e
rm -rf "$WORK/origin.git" "$WORK/repo" "$WORK/repo.ship-it"
rm -f "$WORK/gh.log" "$WORK/pr.created" "$WORK/infra" "$WORK/fixes.log" "$WORK/order.log" "$WORK/ship.log"
git init -q --bare "$WORK/origin.git"
mkdir "$WORK/repo"
cd "$WORK/repo"
git init -q
git remote add origin "$WORK/origin.git"
rhiza init > /dev/null
mkdir .rhiza/workflows
cp "$WORK/ship.sh" .rhiza/workflows/ship.sh
cp "$WORK/review.toml" .rhiza/workflows/review.toml
rhiza change new 'Ship it' --title 'Ship it' --json > /dev/null
rhiza add capability first --field 'statement=Does first' > /dev/null
rhiza propose > /dev/null
rhiza accept --reason ok > /dev/null
git add -A
git commit -qm 'Start shipping'
git push -q -u origin main
-- review.toml --
# The repo's own review, as the built-in one but with two fake checks.
# Its code step runs rhiza check, which passes only because ship-change
# rendered and committed what build's sessions wrote.
[step.code]
kind = "command"
run = "rhiza run code-check"
on.pass = "review"

[step.review]
kind = "checks"
interval = "50ms"
max_visits = 3
on.pass = "signoff"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[[step.review.check]]
name = "beta"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"

[step.signoff]
kind = "signoff"
max_visits = 3
on.pass = "done"
on.changes = "review"
-- ship.sh --
#!/bin/sh
echo shipped >> "$WORK/ship.log"
echo shipped >> "$WORK/order.log"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
case "$RHIZA_ROLE" in
builder)
	echo built > feature.txt
	git add feature.txt
	git commit -q -m "build $RHIZA_LEAF" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Leaf: $RHIZA_LEAF" -- feature.txt || exit 1
	;;
verifier)
	rhiza add evidence "$RHIZA_LEAF-verified" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	rhiza link "$RHIZA_LEAF-verified" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
	;;
check)
	echo '{"findings":[]}' > "$WORK/empty-round.json"
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty-round.json" >&2 || exit 1
	;;
*)
	# The ci-fix agent step: no role. It sees the failing tests in ship
	# check's output, fixes by adding one fix-N.txt, and commits with the
	# run's Review: trailer, taken from its prompt.
	case "$last" in
	*"Fix the failing CI tests"*) ;;
	*) exit 0 ;;
	esac
	rhiza ship check --json > "$WORK/fix-input.json" 2>&1
	grep -q 'TestScripts/x/sub' "$WORK/fix-input.json" || exit 1
	grep -q '"TestScripts/x"' "$WORK/fix-input.json" && exit 1
	run=$(printf '%s' "$last" | sed -n 's/.*in run \([^:]*\):.*/\1/p')
	n=$(( $(ls fix-*.txt 2>/dev/null | wc -l) + 1 ))
	echo "fix $n" > "fix-$n.txt"
	git add "fix-$n.txt"
	git commit -q -m "fix ci $n" -m "Review: $run" -- "fix-$n.txt" || exit 1
	echo "$run" >> "$WORK/fixes.log"
	rhiza session done >&2 || exit 1
	;;
esac
exit 0
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
o="$WORK/origin.git"
case "$1 $2" in
"pr view")
	if [ "$3" = 7 ]; then
		printf '{"mergeCommit":{"oid":"%s"},"state":"MERGED"}\n' "$(cat "$WORK/merge.sha")"
		exit 0
	fi
	if ! head=$(git -C "$o" rev-parse --verify --quiet "refs/heads/$3"); then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	if [ ! -f "$WORK/pr.created" ]; then
		printf '{"body":"Change set '"$csid"'","number":3,"url":"https://github.test/o/r/pull/3","state":"MERGED","headRefOid":"%s","statusCheckRollup":[]}\n' "$head"
		exit 0
	fi
	echo "$head" > "$WORK/landed.sha"
	have=$(git -C "$o" ls-tree --name-only "$head" | grep -c '^fix-')
	c=SUCCESS
	[ "$have" -lt "$(cat "$WORK/need")" ] && c=FAILURE
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"%s","detailsUrl":"https://github.test/o/r/actions/runs/42/job/9"},{"context":"lint","state":"SUCCESS"}]}\n' "$head" "$c"
	;;
"run rerun")
	;;
"run view")
	if [ -f "$WORK/infra" ]; then
		echo "test	Set up job	runner lost contact"
	else
		echo "test	Run tests	--- FAIL: TestScripts/x (0.10s)"
		echo "test	Run tests	--- FAIL: TestScripts/x/sub (0.10s)"
	fi
	;;
"pr create")
	while [ $# -gt 0 ]; do
		if [ "$1" = --body-file ]; then
			cp "$2" "$WORK/pr-body.md"
		fi
		shift
	done
	touch "$WORK/pr.created"
	;;
"pr edit")
	;;
"pr merge")
	head=$(git -C "$o" rev-parse refs/heads/cs/ship-it)
	if [ "$6" != "$head" ]; then
		echo "head branch was modified" >&2
		exit 1
	fi
	sha=$(git -C "$o" commit-tree "$head^{tree}" -p refs/heads/main -m 'Ship it (#7)')
	git -C "$o" update-ref refs/heads/main "$sha"
	echo "$sha" > "$WORK/merge.sha"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
