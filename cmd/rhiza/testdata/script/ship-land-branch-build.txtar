# A workflow that names a build of the PR head (SHIP_HEAD_RHIZA, built by
# one of its steps) makes ship land land and render with that build, so a
# branch whose rendering differs from the running rhiza's lands with its
# own rendering, and the head's check finds no stale rendered files. With
# none named, ship land renders in-process. A named build that is missing
# (its step did not run) fails ship land before it writes or pushes
# anything.
#
# The running rhiza here stands for an older installed one: the test hook
# RHIZA_TEST_RENDER_STALE makes its render write an extra stale.md that
# check calls extra. head/rhiza stands for the step-built head: a script
# that runs this test's rhiza without that hook, logging its argv to
# head.log. The fake gh answers pr view from the bare origin: PR #7 open
# with every check passed at the branch's head on origin.

chmod 755 bin/gh
chmod 755 head/rhiza
env PATH=$WORK/bin:$PATH

# A repo on the change set's branch, pushed, its PR green.
exec git init -q --bare origin.git
env ORIGIN=$WORK/origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
cp $WORK/feature.txt feature.txt
exec git add feature.txt
exec git commit -qm 'Build the feature'
exec git push -q -u origin cs/ship-it
exec rhiza ship check --change 01M5PWGEF85Y185JZ2ZGCNH40N
stdout 'passed'

# The running rhiza's rendering differs from the head's: with the hook,
# its render would leave stale.md, which check calls extra.
# The workflow names the step-built head.
env RHIZA_TEST_RENDER_STALE='rendered by an older rhiza'
env SHIP_HEAD_RHIZA=$WORK/head/rhiza
exec rhiza ship land --change 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^Landed change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^Pushed [0-9a-f]{7}\.$'

# The land and render ran with the head build, in the worktree.
exec cat $WORK/head.log
stdout -count=2 '^repo '
stdout '^repo land --change 01M5PWGEF85Y185JZ2ZGCNH40N --json$'
stdout '^repo render --json$'
! exists .rhiza/rendered/stale.md

# The head's check passes: no stale rendered files.
exec $WORK/head/rhiza check
stdout '^ok$'
! stdout 'stale\.md'

# The land commit is pushed with its trailers, and nothing is left over.
exec git -C $WORK/origin.git log -1 --format=%B cs/ship-it
stdout '^Land the change set and record its CI$'
stdout '^Change: 01M5PWGEF85Y185JZ2ZGCNH40N$'
stdout '^Actor: test$'
exec git status --porcelain
! stdout .
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- State: landed'
fold-ok

# A workflow that names no head build: render runs in-process (and so,
# with the hook, leaves stale.md in the land commit).
cd $WORK
rm head.log
env SHIP_HEAD_RHIZA=
exec git init -q --bare other.git
env ORIGIN=$WORK/other.git
mkdir other
cd other
exec git init -q
exec git remote add origin $WORK/other.git
env RHIZA_TEST_RENDER_STALE=
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
cp $WORK/feature.txt feature.txt
exec git add feature.txt
exec git commit -qm 'Build the feature'
exec git push -q -u origin cs/ship-it
exec rhiza ship check
stdout 'passed'
env RHIZA_TEST_RENDER_STALE='rendered by an older rhiza'
exec rhiza ship land
stdout '^Landed change set '
! exists $WORK/head.log
exists .rhiza/rendered/stale.md
exec git -C $WORK/other.git show --stat --format=%s cs/ship-it
stdout '\.rhiza/rendered/stale\.md'
! exec rhiza check
stdout 'stale\.md'

# The workflow names a head build its step never built: ship land fails
# and records, lands and pushes nothing.
cd $WORK
exec git init -q --bare broken.git
env ORIGIN=$WORK/broken.git
mkdir broken
cd broken
exec git init -q
exec git remote add origin $WORK/broken.git
env RHIZA_TEST_RENDER_STALE=
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
cp $WORK/feature.txt feature.txt
exec git add feature.txt
exec git commit -qm 'Build the feature'
exec git push -q -u origin cs/ship-it
exec rhiza ship check
stdout 'passed'
exec git rev-parse HEAD
cp stdout $WORK/before.sha
env SHIP_HEAD_RHIZA=$WORK/head/missing
! exec rhiza ship land
stderr 'SHIP_HEAD_RHIZA names .*/head/missing, which is not a built rhiza'
! exists $WORK/head.log
exec git rev-parse cs/ship-it
cmp stdout $WORK/before.sha
exec git -C $WORK/broken.git rev-parse cs/ship-it
cmp stdout $WORK/before.sha
exec git status --porcelain
! stdout .
exec rhiza ls --kind evidence --json
! stdout '"handle"'
exec rhiza change show
stdout '^- State: accepted'

-- feature.txt --
built
-- head/rhiza --
#!/bin/sh
echo "$(basename "$(pwd -P)") $*" >> "$WORK/head.log"
unset RHIZA_TEST_RENDER_STALE
exec rhiza "$@"
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
case "$1 $2" in
"pr view")
	if ! head=$(git -C "$ORIGIN" rev-parse --verify --quiet "refs/heads/$3"); then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"}]}\n' "$head"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
