# When a run ends, Rhiza removes the scratch folders of the agent sessions
# it started for that run; when a run's worktree is removed, Rhiza removes
# that worktree's index database under the user cache dir (rhiza/index).
# A live run's scratch folders and index stay.
#
# Two change sets each get a run whose agent step runs the fake claude in
# the run's worktree: it makes a scratch folder where Claude Code makes one
# ($TMPDIR/claude-<uid>/<encoded cwd>/<session id>), runs `rhiza slice` so
# the worktree gets an index database, and writes both paths to $WORK. The
# live run then stops at a wait step (--no-wait); the ended run is done.
# Abandoning the live run ends it and removes its worktree.
#
# The fake rex runs the tab's command synchronously in the window's
# directory; the fake claude commits the worktree's files, so abandoning
# finds it clean. Nothing here reaches Rex, Claude Code or GitHub.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .rhiza/workflows
cp $WORK/build-hold.toml .rhiza/workflows/build-hold.toml
cp $WORK/build-done.toml .rhiza/workflows/build-done.toml

# The live run: its agent made a scratch folder and an index, then the run
# stopped at its wait.
exec rhiza change new 'Live run' --title 'Live run' --json
exec rhiza run start --foreground --workflow build-hold --permission-mode manual --no-wait
stdout '^Run 01M5PWGJC82P7YGZTWYFFZ0VJG stopped$'
exec sh -c 'test -d "$(cat $WORK/live-run.scratch)"'
exec sh -c 'test -f "$(cat $WORK/live-run.index)"'

# The ended run: its agent made a scratch folder and an index, and the run
# succeeded.
exec rhiza change new 'Ended run' --title 'Ended run' --json
exec rhiza run start --foreground --workflow build-done --permission-mode manual
stdout '^Run \S+ succeeded$'
exists $WORK/ended-run.scratch
exists $WORK/ended-run.index

# The ended run's session scratch folder is gone; the live run's stays, and
# so does its index. The ended run's worktree was not removed, so its index
# stays too.
exec sh -c '! test -e "$(cat $WORK/ended-run.scratch)"'
exec sh -c 'test -d "$(cat $WORK/live-run.scratch)"'
exec sh -c 'test -f "$(cat $WORK/live-run.index)"'
exec sh -c 'test -f "$(cat $WORK/ended-run.index)"'
# Another folder under the agent's temp folder, no session's, stays.
exists $WORK/.tmp/claude-test/other/keep

# Abandon the live run: it ends, so its session's scratch folder goes, and
# its worktree is removed, so its index goes. The other worktree's index
# stays.
exec rhiza run abandon 01M5PWGJC82P7YGZTWYFFZ0VJG
stdout 'remove-worktree done'
! exists $WORK/repo.live-run
exec sh -c '! test -e "$(cat $WORK/live-run.scratch)"'
exec sh -c '! test -e "$(cat $WORK/live-run.index)"'
exec sh -c 'test -f "$(cat $WORK/ended-run.index)"'
exists $WORK/.tmp/claude-test/other/keep

-- .tmp/claude-test/other/keep --
-- build-hold.toml --
name = "build-hold"

[step.build]
kind = "agent"
prompt = "Build {change}"
on.pass = "hold"

[step.hold]
kind = "wait"
until = "test -f ../go"
timeout = "30s"
interval = "50ms"
on.pass = "done"
on.timeout = "failed"
-- build-done.toml --
name = "build-done"

[step.build]
kind = "agent"
prompt = "Build {change}"
on.pass = "done"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
name=${PWD##*/repo.}
scratch="$TMPDIR/claude-test/encoded-$name/$sid"
mkdir -p "$scratch/scratchpad" || exit 3
echo note > "$scratch/scratchpad/note"
echo "$scratch" > "$WORK/$name.scratch"
rhiza slice --json > /dev/null 2>&1
git add -A && git commit -qm 'Build' || exit 4
real=$(pwd -P)
if command -v sha256sum > /dev/null; then
	sum=$(printf %s "$real" | sha256sum | cut -d' ' -f1)
else
	sum=$(printf %s "$real" | shasum -a 256 | cut -d' ' -f1)
fi
echo "$XDG_CACHE_HOME/rhiza/index/$sum.db" > "$WORK/$name.index"
exit 0
