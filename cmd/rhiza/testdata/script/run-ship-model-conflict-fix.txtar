# A land refused on a model conflict goes to a fixer instead of ending the
# run. The shipping change set's update of `first` rests on a base that the
# landed change set Other has since rewritten (rhiza check only warns about
# that), so ship land is refused and records the conflict; land-triage (ship
# gate --failed) fails, model-conflict-triage (ship check --model-conflict)
# routes it to model-conflict-fix, a fixer session that restates the update on
# the landed version with `rhiza set first --rebase` and commits the log
# entry with the Review: trailer, and the run goes back through
# render-model-conflict, gate-land and land, which merges the PR.
#
# Case 1: the fixer repairs it: one fixer session, land visited twice.
# Case 2: a fixer that leaves the conflict in place fails the step's until:
# the run fails at model-conflict-fix with nothing merged.
#
# The fakes are run-ship-conflict-fix.txtar's, without main moving.

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH

# Case 1.
exec sh -c ': > $WORK/triggers; : > $WORK/fixer-pushes'
cd $WORK
exec sh $WORK/setup.sh
cd repo
exec sh -c 'rhiza run start --foreground $(cat $WORK/cs) --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
exec sh -c 'cd $WORK/repo.ship-it && rhiza run approve --foreground; echo exit=$?'
stdout '^exit=0$'
stdout '^Run \S+ succeeded$'
exec rhiza run status
stdout '^- land \(visit 1\): fail, then land-triage'
stdout '^- land-triage \(visit 1\): fail, then model-conflict-triage'
stdout '^- model-conflict-triage \(visit 1\): pass, then model-conflict-fix: '
stdout '^- model-conflict-fix \(visit 1\): pass, then render-model-conflict'
stdout '^- gate-land \(visit 2\): pass, then land'
stdout '^- land \(visit 2\): pass, then wait-landed'
! stdout '^- gate-fix-merge'
exec sh -c 'wc -l < $WORK/model-fixes.log'
stdout '^1$'
# The fixer committed under the run's Review: trailer (its prompt names the run).
grep '^[0-9A-Z]+$' $WORK/model-fixes.log
exec git -C $WORK/origin.git log main --format=%s
stdout 'Ship it \(#7\)'
exec rhiza show first --json
stdout 'Theirs and ours'

# Case 2: a fixer that repairs nothing fails the run.
exec sh -c 'echo lazy > $WORK/fixer-mode'
cd $WORK
exec sh $WORK/setup.sh
cd repo
exec sh -c 'rhiza run start --foreground $(cat $WORK/cs) --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
exec sh -c 'cd $WORK/repo.ship-it && rhiza run approve --foreground; echo exit=$?'
stdout '^Run \S+ failed$'
exec rhiza run status
stdout '^- model-conflict-fix \(visit 1\): fail'
stdout 'until did not hold'
! stdout '^- land \(visit 2\)'
! grep '^pr merge' $WORK/gh.log
-- setup.sh --
#!/bin/sh
# A fresh bare origin that refuses pushes while $WORK/refuse exists, a repo
# with an accepted change set pushed to it, and a clone, other, holding
# unpushed commits: m1..m4 in a line, each changing feature.txt, and n1,
# touching an unrelated file.
set -e
rm -rf "$WORK/origin.git" "$WORK/repo" "$WORK/repo.ship-it" "$WORK/other"
rm -f "$WORK/cs" "$WORK/gh.log" "$WORK/pr.created" "$WORK/fixes.log" "$WORK/ship.log" "$WORK/refuse" "$WORK/typed.log" "$WORK/model-fixes.log" "$WORK/answer" "$WORK/clash.log" "$WORK/tab.out" "$WORK/arbiter.log"
git init -q --bare "$WORK/origin.git"
cat > "$WORK/origin.git/hooks/pre-receive" <<'EOF'
#!/bin/sh
if [ -f "$WORK/refuse" ]; then
	echo "push refused" >&2
	exit 1
fi
EOF
chmod 755 "$WORK/origin.git/hooks/pre-receive"
mkdir "$WORK/repo"
cd "$WORK/repo"
git init -q
git remote add origin "$WORK/origin.git"
rhiza init > /dev/null
mkdir .rhiza/workflows
cp "$WORK/ship.sh" .rhiza/workflows/ship.sh
cp "$WORK/review.toml" .rhiza/workflows/review.toml
rhiza change new 'Base' --title 'Base' --json > /dev/null
rhiza add capability first --field 'statement=One' > /dev/null
rhiza propose > /dev/null
rhiza accept --reason ok > /dev/null
rhiza land > /dev/null
rhiza change new 'Ship it' --title 'Ship it' --json > /dev/null
rhiza change ls --json | grep -B2 '"intent": "Ship it"' | grep '"id"' | cut -d'"' -f4 > "$WORK/cs"
rhiza set first --field 'statement=Ours' > /dev/null
rhiza add capability second --field 'statement=Does second' > /dev/null
rhiza change new 'Other' --json > /dev/null
rhiza set first --field 'statement=Theirs' > /dev/null
rhiza propose > /dev/null
rhiza accept --reason ok > /dev/null
rhiza land > /dev/null
rhiza change use "$(cat "$WORK/cs")" > /dev/null
rhiza propose > /dev/null
rhiza accept --reason ok > /dev/null
git add -A
git commit -qm 'Start shipping'
git push -q -u origin main
git clone -q "$WORK/origin.git" "$WORK/other"
cd "$WORK/other"
git checkout -q -b n1
echo unrelated > unrelated.txt
git add unrelated.txt
git commit -qm 'Add something unrelated' -m 'Change: 01M5PWGEF85Y185JZ2ZGCNH40M'
git checkout -q main
git checkout -q -b m0
for n in 1 2 3 4; do
	git checkout -q -b m$n
	echo "main $n" > feature.txt
	git add feature.txt
	git commit -qm "Main $n" -m 'Change: 01M5PWGEF85Y185JZ2ZGCNH40M'
done
-- review.toml --
# The repo's own review, as the built-in one but with two fake checks.
# Its code step runs rhiza check, which passes only because ship-change
# rendered and committed what build's sessions wrote.
[step.code]
kind = "command"
run = "rhiza run code-check"
on.pass = "review"

[step.review]
kind = "checks"
interval = "50ms"
max_visits = 3
on.pass = "signoff"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[[step.review.check]]
name = "beta"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"

[step.signoff]
kind = "signoff"
max_visits = 3
on.pass = "done"
on.changes = "review"
-- ship.sh --
#!/bin/sh
echo shipped >> "$WORK/ship.log"
echo shipped >> "$WORK/order.log"
-- bin/rex --
#!/bin/sh
case "$1" in
send | send-key)
	echo "$*" >> "$WORK/typed.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		if [ -f "$WORK/bg" ]; then
			(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		else
			(cd "$dir" && "$@") >&2 || true
		fi
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
for a; do last=$a; done
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
case "$last" in
*'rhiza guide arbiter'*)
	q=$(printf '%s\n' "$last" | sed -n 's/^Decide question \([0-9A-Z]*\):.*/\1/p')
	printf '{"writes":[{"op":"add","kind":"decision","handle":"clash-ruling","fields":["statement=Keep main behaviour","wording=(assumed, would have escalated)","reasoning=Main moved first"]},{"op":"link","from":"clash-ruling","type":"answers","to":"%s"}]}\n' "$q" > "$WORK/decision.json"
	rhiza apply "$WORK/decision.json" --json >&2 || exit 7
	rhiza session done >&2 || exit 6
	exit 0
	;;
esac
case "$RHIZA_ROLE" in
builder)
	echo built > feature.txt
	git add feature.txt
	git commit -q -m "build $RHIZA_LEAF" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Leaf: $RHIZA_LEAF" -- feature.txt || exit 1
	;;
verifier)
	rhiza add evidence "$RHIZA_LEAF-verified" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	rhiza link "$RHIZA_LEAF-verified" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
	;;
check)
	echo '{"findings":[]}' > "$WORK/empty-round.json"
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty-round.json" >&2 || exit 1
	;;
*)
	# The conflict-fix agent steps: no role. The merge is in progress and
	# ship check --json shows its context; resolve every conflicted file,
	# commit the merge with the run's Review: trailer (from the prompt),
	# never push, then maybe let main move.
	case "$last" in
	*"Repair the model conflict"*)
		rhiza ship check --model-conflict --json > "$WORK/model-input.json" 2>&1 || exit 1
		grep -q '"model_conflicts"' "$WORK/model-input.json" || exit 1
		grep -q 'field:statement' "$WORK/model-input.json" || exit 1
		run=$(printf '%s' "$last" | sed -n 's/.*in run \([^:]*\):.*/\1/p')
		echo "$run" >> "$WORK/model-fixes.log"
		if [ "$(cat "$WORK/fixer-mode" 2>/dev/null)" != lazy ]; then
			rhiza set first --rebase --field 'statement=Theirs and ours' >&2 || exit 1
			git add -A -- .rhiza/log
			git commit -q -m "Restate the update on the landed version" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Review: $run" || exit 1
		fi
		rhiza session done >&2 || exit 1
		exit 0
		;;
	*"Resolve the merge conflicts"*) ;;
	*) exit 0 ;;
	esac
	rhiza ship check --json > "$WORK/fix-input.json" 2>&1
	grep -q '"merge_conflict"' "$WORK/fix-input.json" || exit 1
	grep -q '"feature.txt"' "$WORK/fix-input.json" || exit 1
	git rev-parse --verify --quiet MERGE_HEAD > /dev/null || exit 1
	mode=$(cat "$WORK/fixer-mode" 2>/dev/null)
	if [ "$mode" = nocommit ]; then
		rhiza session done >&2 || exit 1
		exit 0
	fi
	if [ "$mode" = clash ]; then
		echo asked >> "$WORK/clash.log"
		echo '{"session_id":"'$sid'","hook_event_name":"PreToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Design clash between change sets Ship it and Main in feature.txt: main writes main N, the branch writes built"}]}}' | rhiza session hook PreToolUse >> "$WORK/hook.out" || exit 8
		# An autonomous run's denied question leaves the session idle; the
		# owner's pending one does not.
		if [ -f "$WORK/stop" ]; then
			echo '{"session_id":"'$sid'","hook_event_name":"Stop"}' | rhiza session hook Stop >> "$WORK/hook.out" || exit 8
		fi
		i=0
		until grep -q '^send-key ' "$WORK/typed.log" 2>/dev/null || [ -f "$WORK/answer" ]; do
			i=$((i + 1))
			[ $i -gt 4000 ] && exit 9
			sleep 0.025
		done
		git rev-parse --verify --quiet MERGE_HEAD > /dev/null || exit 1
	fi
	run=$(printf '%s' "$last" | sed -n 's/.*in run \([^:]*\):.*/\1/p')
	n=$(( $(cat "$WORK/fixes.log" 2>/dev/null | wc -l) + 1 ))
	for f in $(git diff --name-only --diff-filter=U); do
		echo "resolved $n" > "$f"
		git add "$f"
	done
	git add -A -- .rhiza/rendered .rhiza/log
	git commit -q -m "Resolve conflict $n" -m "Change: $RHIZA_CHANGE
Review: $run" || exit 1
	echo "$run" >> "$WORK/fixes.log"
	next=$(head -1 "$WORK/fixer-pushes" 2>/dev/null)
	sed -i 1d "$WORK/fixer-pushes" 2>/dev/null
	case "$next" in
	m*) git -C "$WORK/other" push -q origin "$next:main" || exit 1 ;;
	esac
	rhiza session done >&2 || exit 1
	;;
esac
exit 0
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
o="$WORK/origin.git"
case "$1 $2" in
"pr view")
	if [ "$3" = 7 ]; then
		printf '{"mergeCommit":{"oid":"%s"},"state":"MERGED"}\n' "$(cat "$WORK/merge.sha")"
		exit 0
	fi
	if ! head=$(git -C "$o" rev-parse --verify --quiet "refs/heads/$3") || [ ! -f "$WORK/pr.created" ]; then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	# Main moves when a head's subject matches a trigger line.
	if [ -s "$WORK/triggers" ]; then
		subj=$(git -C "$o" log -1 --format=%s "$head")
		while IFS== read -r s b; do
			if [ "$s" = "*" ] || [ "$s" = "$subj" ]; then
				git -C "$WORK/other" push -q origin "$b:main" || exit 1
				grep -v -x -F -- "$s=$b" "$WORK/triggers" > "$WORK/triggers.new"
				mv "$WORK/triggers.new" "$WORK/triggers"
			fi
		done < "$WORK/triggers"
	fi
	m=MERGEABLE
	if ! git -C "$o" merge-base --is-ancestor main "$head"; then
		m=CONFLICTING
	fi
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","mergeable":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"},{"context":"lint","state":"SUCCESS"}]}\n' "$head" "$m"
	;;
"pr create")
	touch "$WORK/pr.created"
	;;
"pr edit")
	;;
"pr merge")
	head=$(git -C "$o" rev-parse refs/heads/cs/ship-it)
	if [ "$6" != "$head" ]; then
		echo "head branch was modified" >&2
		exit 1
	fi
	sha=$(git -C "$o" commit-tree "$head^{tree}" -p refs/heads/main -m 'Ship it (#7)')
	git -C "$o" update-ref refs/heads/main "$sha"
	echo "$sha" > "$WORK/merge.sha"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
