# When a verifier passes a leaf, the engine commits the log entry files of
# that verifier's Evidence and of its actor's record, and only them, as
# its own chore(rhiza) commit naming the leaf, with the run's Change: and the verifier's Actor:
# trailers and no Leaf: trailer. The builder's staged, unstaged and
# untracked edits in the build worktree stay exactly as they were. The
# commit is journalled on the passed leaf.
#
# The builder's own actor record goes in its leaf commit, so after the run
# no builder actor entry is left untracked under .rhiza/log.
#
# The fake rex runs the tab's command synchronously in the window's
# directory. The fake claude, as the builder, stages its actor record with
# the recipe `rhiza guide build` gives and commits it with its leaf's file
# under Leaf: and Actor: trailers, then leaves a staged and an unstaged edit and an
# untracked file behind and snapshots them; as the verifier it writes its
# Evidence as its own actor with an add and a link: two entries.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init

exec rhiza change new 'Evidence' --title 'Evidence'
exec rhiza add capability good
mkdir .rhiza/workflows
cp $WORK/build.toml .rhiza/workflows/build.toml
exec git add -A
exec git commit -qm leaves

exec sh -c 'rhiza run start --workflow build --permission-mode manual --json; echo exit=$?'
stdout '"state": "succeeded"'
stdout '^exit=0$'

# HEAD is one new commit on the builder's leaf commit, holding only the
# verifier's two Evidence entry files in the run's change set and the
# entries of its actor's record change set.
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git rev-parse HEAD^'
cmp stdout $WORK/want.commit
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git log -1 --format=%B && git show --name-only --format= HEAD'
stdout '^chore\(rhiza\): evidence for good$'
stdout '^Change: [0-9A-Z]{26}$'
stdout '^Actor: claude-code-[0-9a-z-]+$'
! stdout 'Leaf:'
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git show --name-only --format= HEAD | cut -d/ -f3 | sort | uniq -c'
stdout -count=2 '^ +[0-9]+ [0-9A-Z]{26}$'
stdout '^ +2 '
exec sh -c 'cd "$(cat $WORK/build.pwd)" && for f in $(git show --name-only --format= HEAD); do grep -l good-ok "$f"; grep -l verifies "$f"; done; true'
stdout -count=2 '\.json$'

# The actor the Actor: trailer names is created in the commit's tree.
exec sh -c 'cd "$(cat $WORK/build.pwd)" && a=$(git log -1 --format="%(trailers:key=Actor,valueonly)" | tr -d "[:space:]") && git show --name-only --format= HEAD | xargs grep -l "\"handle\": *\"$a\"" && git show --name-only --format= HEAD | xargs grep -l "\"kind\": *\"actor\""'
stdout -count=2 '\.json$'

# The builder's leaf commit holds its actor record: the actor its Actor:
# trailer names is created in that commit's tree, which also holds the
# leaf's file. No builder actor entry is left untracked under .rhiza.
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git show --name-only --format= HEAD^'
stdout '^good\.txt$'
stdout '^\.rhiza/log/[0-9A-Z]{26}/[0-9A-Z]{26}\.json$'
exec sh -c 'cd "$(cat $WORK/build.pwd)" && a=$(git log -1 --format="%(trailers:key=Actor,valueonly)" HEAD^ | tr -d "[:space:]") && test "$a" = "$(cat $WORK/builder.actor)" && git show --name-only --format= HEAD^ | grep "^\.rhiza/" | xargs grep -l "\"handle\": *\"$a\"" && git show --name-only --format= HEAD^ | grep "^\.rhiza/" | xargs grep -l "\"kind\": *\"actor\""'
stdout -count=2 '\.json$'
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git status --porcelain --untracked-files=all -- .rhiza'
! stdout .

# A clean clone of the leaf commit folds and reads the builder's actor, so
# its record is committed, not just present in the build worktree.
exec sh -c 'git clone -q "$(cat $WORK/build.pwd)" $WORK/leaf && cd $WORK/leaf && git checkout -q "$(cat $WORK/want.commit)"'
fold-ok $WORK/leaf/.rhiza
exec sh -c 'cd $WORK/leaf && rhiza show "$(cat $WORK/builder.actor)" --json'
stdout '"kind": "actor"'

# The leaf passed with that commit journalled on it.
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git rev-parse HEAD > $WORK/evidence.commit'
exec rhiza run status --json
stdout '"detail": "attempt 1: verifier passed",'
exec sh -c 'rhiza run status --json | grep -c "\"commit\": \"$(cat $WORK/evidence.commit)\""'
stdout '^2$'

# The builder's staged, unstaged and untracked edits are untouched, and
# the committed entries show clean.
exec sh -c 'cd "$(cat $WORK/build.pwd)" && git diff > $WORK/after.diff && git diff --cached > $WORK/after.cached && git status --porcelain --untracked-files=all -- notes.txt scratch.txt > $WORK/after.status && git status --porcelain --untracked-files=all -- $(git show --name-only --format= HEAD)'
! stdout .
cmp $WORK/after.diff $WORK/before.diff
cmp $WORK/after.cached $WORK/before.cached
cmp $WORK/after.status $WORK/before.status
grep 'unstaged' $WORK/after.diff
grep 'staged' $WORK/after.cached
grep '^MM notes.txt$' $WORK/after.status
grep '^\?\? scratch.txt$' $WORK/after.status

fold-ok

-- build.toml --
name = "build"

[step.build]
kind = "leaves"
on.pass = "done"
on.fail = "done"

[step.build.builder]
prompt = "Build {leaf}"

[step.build.verifier]
prompt = "Verify {leaf}"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
if [ "$RHIZA_ROLE" = builder ]; then
	pwd -P > "$WORK/build.pwd"
	echo base > notes.txt
	echo "$RHIZA_LEAF" > "$RHIZA_LEAF.txt"
	echo "$RHIZA_ACTOR" > "$WORK/builder.actor"
	git add "$RHIZA_LEAF.txt" notes.txt
	eval "$(rhiza guide build | grep '^git add .*Record agent actor')" || exit 1
	git commit -q -m "build $RHIZA_LEAF" -m "Leaf: $RHIZA_LEAF
Actor: $RHIZA_ACTOR" || exit 1
	git rev-parse HEAD > "$WORK/want.commit"
	echo staged >> notes.txt
	git add notes.txt
	echo unstaged >> notes.txt
	echo scratch > scratch.txt
	git diff > "$WORK/before.diff"
	git diff --cached > "$WORK/before.cached"
	git status --porcelain --untracked-files=all -- notes.txt scratch.txt > "$WORK/before.status"
	exit 0
fi
rhiza add evidence "$RHIZA_LEAF-ok" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
rhiza link "$RHIZA_LEAF-ok" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
exit 0
