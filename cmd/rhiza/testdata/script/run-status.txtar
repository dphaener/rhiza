# run status reads a run from its journal alone: stopped at a wait step
# (--no-wait), running while another process holds the run, and succeeded
# with every step done once it ends. The wait polls for ../go, which is
# $WORK/go from the run's worktree next to the repo.

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Read status' --title 'Run status' --json
stdout '"change_set": "[0-9A-Z]{26}"'
mkdir .rhiza/workflows
cp ../gate.toml .rhiza/workflows/gate.toml

# Mid-run, stopped: the first step is done and the wait step is current.
exec rhiza run start --foreground --workflow gate --no-wait
stdout '^Run [0-9A-Z]{26} stopped$'
stdout '^- Current step: hold$'
stdout '^- first \(visit 1\): pass, then hold: exit 0$'
! stdout 'hold \(visit'
stdout '^next: rhiza run resume [0-9A-Z]{26}$'
exec rhiza run status --json
stdout '"state": "stopped"'
stdout '"current": "hold"'

# A change set has one live run, so the live run is on another change set.
exec rhiza change new 'Live status' --title 'Live status' --json
stdout '"change_set": "[0-9A-Z]{26}"'

# A live run: started in the background, it waits for the flag. Status
# reports running (bounded retries) until the flag appears.
exec rhiza run start --foreground --workflow gate &
exec sh -c 'i=0; while [ $i -lt 400 ]; do rhiza run status | grep -q "^Run .* running$" && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec rhiza run status
stdout '^Run [0-9A-Z]{26} running$'
stdout '^- Current step: hold$'
stdout '^next: rhiza run status [0-9A-Z]{26}$'
exec sh -c 'echo > $WORK/go'
wait
stdout '^Run [0-9A-Z]{26} succeeded$'

# After it ends, status shows every step done.
exec rhiza run status
stdout '^Run [0-9A-Z]{26} succeeded$'
stdout '^- first \(visit 1\): pass, then hold: exit 0$'
stdout '^- hold \(visit 1\): pass, then last: held after [0-9]+ checks$'
stdout '^- last \(visit 1\): pass, then end: exit 0$'
! stdout '^- Current step:'
exec rhiza run status --json
stdout '"state": "succeeded"'

# A review check whose cycle 1 failed and cycle 2 is open reads as open in
# cycle 2, with no outcome in JSON. The journal is written by hand.
exec sh -c 'printf "%s\n%s\n%s\n%s\n" "{\"type\":\"started\",\"at\":\"2026-01-01T00:00:00Z\",\"started\":{\"workflow\":\"review\",\"definition\":\"\",\"change\":\"01M5PWGEF85Y185JZ2ZGCNH40N\"}}" "{\"type\":\"check-cycle\",\"at\":\"2026-01-01T00:00:01Z\",\"step\":\"review\",\"cycle\":1,\"checks\":[\"alpha\"]}" "{\"type\":\"check\",\"at\":\"2026-01-01T00:00:02Z\",\"step\":\"review\",\"check\":\"alpha\",\"cycle\":1,\"outcome\":\"failed\"}" "{\"type\":\"check-cycle\",\"at\":\"2026-01-01T00:00:03Z\",\"step\":\"review\",\"cycle\":2,\"checks\":[\"alpha\"]}" > .git/rhiza/runs/OPENCYCLE01.jsonl'
exec rhiza run status OPENCYCLE01
stdout '^- alpha \(step review\): open in cycle 2 \(cycle 1 failed\)$'
exec rhiza run status OPENCYCLE01 --json
! stdout '^      "outcome"'
stdout '^          "outcome": "failed",'
stdout '"open_cycle": 2'

-- gate.toml --
name = "gate"

[step.first]
kind = "command"
run = "true"
on.pass = "hold"

[step.hold]
kind = "wait"
until = "test -f ../go"
timeout = "30s"
interval = "50ms"
on.pass = "last"
on.timeout = "failed"

[step.last]
kind = "command"
run = "true"
on.pass = "done"
