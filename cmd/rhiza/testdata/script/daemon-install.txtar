# daemon install writes one systemd user unit for the root's daemon
# (rhiza-root.service, run in the root, Restart=always, after rex.service), reloads systemd, enables
# and starts it and turns on lingering; a second install changes nothing;
# uninstall disables and removes it. systemctl and loginctl are fakes that
# only log; with neither on PATH both commands exit 2 naming systemd.

# No systemctl on PATH: exit 2, nothing written. PATH holds only rhiza, so
# the host's own systemctl and loginctl are never found or run.
env HOME=$WORK/home
mkdir repo
cd repo
exec git init -q
exec rhiza init
env HOSTPATH=$PATH
env PATH=$RHIZA_TEST_BIN
! exec rhiza daemon install
stderr 'needs systemd: systemctl is not on PATH'
! exists $WORK/home/.config
! exec rhiza daemon uninstall
stderr 'needs systemd: systemctl is not on PATH'
env PATH=$HOSTPATH

# From inside a project (a subfolder of it) install writes the one unit of
# the root.
chmod 755 $WORK/bin/systemctl
chmod 755 $WORK/bin/loginctl
env PATH=$WORK/bin:$PATH
env 'TMPDIR=$WORK/tmp dir'
mkdir sub
cd sub
exec rhiza daemon install
stdout 'rhiza-root.service'
cd ..
grep '^ExecStart=.* daemon --autonomous$' $WORK/home/.config/systemd/user/rhiza-root.service
grep '^WorkingDirectory='$WORK'$' $WORK/home/.config/systemd/user/rhiza-root.service
! grep '^WorkingDirectory=.*/repo$' $WORK/home/.config/systemd/user/rhiza-root.service
grep '^Restart=always$' $WORK/home/.config/systemd/user/rhiza-root.service
grep '^After=rex.service$' $WORK/home/.config/systemd/user/rhiza-root.service
cmp $WORK/calls.log $WORK/want-install.log
grep '^Environment="PATH=' $WORK/home/.config/systemd/user/rhiza-root.service
grep '^Environment="TMPDIR=.*/tmp dir"$' $WORK/home/.config/systemd/user/rhiza-root.service
grep '^Environment="PATH=.*bin' $WORK/home/.config/systemd/user/rhiza-root.service

# A second install writes nothing and does not reload.
cp $WORK/home/.config/systemd/user/rhiza-root.service $WORK/unit.copy
rm $WORK/calls.log
exec rhiza daemon install
stdout 'nothing changed'
cmp $WORK/home/.config/systemd/user/rhiza-root.service $WORK/unit.copy
! grep 'daemon-reload' $WORK/calls.log

# A changed PATH rewrites the unit and reloads systemd.
rm $WORK/calls.log
env PATH=$WORK/bin:$WORK/extra:$PATH
exec rhiza daemon install
stdout 'Installed'
grep 'extra' $WORK/home/.config/systemd/user/rhiza-root.service
grep 'daemon-reload' $WORK/calls.log

# start and stop act on that unit from the root itself, not a git checkout.
rm $WORK/calls.log
cd $WORK
exec rhiza daemon start
exec rhiza daemon stop
cmp $WORK/calls.log $WORK/want-startstop.log
cd repo

# Uninstall disables, removes the unit and reloads.
rm $WORK/calls.log
exec rhiza daemon uninstall
! exists $WORK/home/.config/systemd/user/rhiza-root.service
cmp $WORK/calls.log $WORK/want-uninstall.log

# A unit the owner wrote is never touched.
mkdir $WORK/home/.config/systemd/user
cp $WORK/theirs.service $WORK/home/.config/systemd/user/rhiza-root.service
! exec rhiza daemon install
stderr 'not written by rhiza daemon install'
! exec rhiza daemon uninstall
grep '^theirs$' $WORK/home/.config/systemd/user/rhiza-root.service

-- bin/systemctl --
#!/bin/sh
echo "systemctl $@" >> "$WORK/calls.log"
-- bin/loginctl --
#!/bin/sh
echo "loginctl $@" >> "$WORK/calls.log"
-- theirs.service --
theirs
-- want-install.log --
systemctl --user daemon-reload
systemctl --user enable --now rhiza-root.service
loginctl enable-linger
-- want-startstop.log --
systemctl --user start rhiza-root.service
systemctl --user stop rhiza-root.service
-- want-uninstall.log --
systemctl --user disable --now rhiza-root.service
systemctl --user daemon-reload
