# change workflow pins a draft change set to a workflow, as change new
# --workflow does: change show --json records it and run start --dry-run
# picks it. --clear returns it to the dispatch rules. An unknown name and a
# landed change set are refused.

mkdir repo
cd repo
exec git init -q
rhiza init
mkdir .rhiza/workflows
cp $WORK/docs.toml .rhiza/workflows/docs.toml
exec git add -A
exec git commit -qm init

rhiza change new 'Docs pass' --json
! stdout '"workflow"'
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\".*/\1/p" > $WORK/cs'

! rhiza change workflow nonesuch
! stdout .
stderr 'no such workflow'
! rhiza change workflow
stderr 'name a workflow'
! rhiza change workflow docs --clear
stderr 'not both'
rhiza change show --json
! stdout '"workflow"'

rhiza change workflow docs --dry-run
stdout 'Would pin'
rhiza change show --json
! stdout '"workflow"'

rhiza change workflow docs --json
stdout '"workflow": "docs"'
rhiza change show --json
stdout '"workflow": "docs"'
exec sh -c 'rhiza run start --dry-run $(cat $WORK/cs)'
stdout '^- Workflow: docs$'
fold-ok

rhiza change workflow --clear --json
stdout '"previous": "docs"'
! stdout '"workflow": "docs",'
rhiza change show --json
! stdout '"workflow"'
exec sh -c 'rhiza run start --dry-run $(cat $WORK/cs) --permission-mode manual'
! stdout '^- Workflow: docs$'
stdout '^- Workflow: ship-change$'
fold-ok

rhiza change workflow docs
stdout 'Pinned change set'
rhiza change show --json
stdout '"workflow": "docs"'
rhiza propose
rhiza accept
rhiza land
! exec sh -c 'rhiza change workflow --clear --change $(cat $WORK/cs)'
stderr 'landed'
fold-ok
-- docs.toml --
name = "docs"

[step.a]
kind = "command"
run = "true"
on.pass = "done"
