# A dependency drops what B rests on (D13). B depends on A and sets a field
# on A's base; A then retires base, which drops its own node.create. B's
# update now rests on nothing: check warns with next, ready gives the reason,
# land refuses B, before A lands and after.

exec rhiza init

# A adds base; B depends on A and sets base's statement.
exec rhiza change new A
stdout 'change set 01M5PWGEF85Y185JZ2ZGCNH40N '
exec rhiza add capability base --field statement=Base --field owner=a
exec rhiza change new B
stdout 'change set 01M5PWGKBGYFZMTH8Y8AF1G8GN '
exec rhiza link 01M5PWGKBGYFZMTH8Y8AF1G8GN depends-on 01M5PWGEF85Y185JZ2ZGCNH40N
exec rhiza set base --field statement=FromB

# A retires base: its create is dropped, A has no ops left.
exec rhiza retire base --reason gone --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout '"ops": \[\]'
fold-ok

# check warns: the drop conflict, with next, and the node B's op misses.
exec rhiza render
exec rhiza check
stdout '^ok$'
stdout '^warn in-flight change set 01M5PWGKBGYFZMTH8Y8AF1G8GN, op 01M5PWGNA0MVZ1H5AXG5VQ0BY9: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N dropped op 01M5PWGJC82P7YGZTWYJ3Y88Z9, taking 01M5PWGJC82P7YGZTWYFFZ0VJG, after op 01M5PWGNA0MVZ1H5AXG5VQ0BY9 was written on it$'
stdout '^  next: rhiza slice --change 01M5PWGKBGYFZMTH8Y8AF1G8GN --view what-if$'
stdout '^warn in-flight change set 01M5PWGKBGYFZMTH8Y8AF1G8GN, op 01M5PWGNA0MVZ1H5AXG5VQ0BY9: model: not found: node 01M5PWGJC82P7YGZTWYFFZ0VJG$'

# ready gives the reason; land refuses B while A is in flight.
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza propose --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec rhiza accept --reason ok --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec rhiza ready --json
stdout '"reasons": \[\n +"depends on 01M5PWGEF85Y18 \(accepted\)",\n +"01M5PWGEF85Y18 revised under it: 1 operations"\n +\]'
! exec rhiza land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stderr '^next: rhiza land --change 01M5PWGEF85Y18$'

# A lands. B's update still rests on nothing: ready gives the reason and
# land refuses B, exit 3, with next.
exec rhiza land --change 01M5PWGEF85Y185JZ2ZGCNH40N
fold-ok
exec rhiza ready --json
stdout '"01M5PWGEF85Y18 revised under it: 1 operations"'
! exec rhiza land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stderr '^rhiza: cannot land change set 01M5PWGKBGYFZMTH8Y8AF1G8GN: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N dropped op 01M5PWGJC82P7YGZTWYJ3Y88Z9, taking 01M5PWGJC82P7YGZTWYFFZ0VJG, after op 01M5PWGNA0MVZ1H5AXG5VQ0BY9 was written on it$'
stderr '^next: rhiza check$'
exec sh -c 'rhiza land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN 2>/dev/null; echo exit $?'
stdout '^exit 3$'
exec rhiza render
exec rhiza check
stdout '^ok$'
