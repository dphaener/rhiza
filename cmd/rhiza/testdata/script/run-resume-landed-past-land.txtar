# run resume continues a non-plan run that reached its land step on a landed
# change set, past its stopped step.

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .rhiza/workflows
cp $WORK/shape.toml .rhiza/workflows/shape.toml

# A ship-change-shaped run stops at its wait after its land step; its change set lands.
exec rhiza change new 'Ship S' --kind record --title 'Ship S' --json
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\".*/\1/p" > $WORK/cs'
exec rhiza add intent want-s
exec rhiza run start --foreground --workflow shape --no-wait
stdout '^Run (01[0-9A-Z]{24}) stopped$'
exec sh -c 'ls .git/rhiza/runs | sed "s/\.jsonl$//" > $WORK/runid'
exec sh -c 'sed -i s/\"workflow\":\"shape\"/\"workflow\":\"ship-change\"/ .git/rhiza/runs/*.jsonl'
exec rhiza land
exec sh -c 'rhiza change show $(cat $WORK/cs) --json'
stdout '"state": "landed"'

# The run reached land, so it goes on past its wait.
exec sh -c 'echo > $WORK/go'
exec sh -c 'rhiza run resume --foreground $(cat $WORK/runid)'
stdout 'succeeded$'

-- shape.toml --
name = "shape"

[step.land]
kind = "command"
run = "echo landed"
on.pass = "wait-main"

[step.wait-main]
kind = "wait"
until = "test -f ../go"
timeout = "30s"
interval = "50ms"
on.pass = "done"
on.timeout = "failed"
