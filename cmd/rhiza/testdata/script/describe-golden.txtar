                  "type": "string"
                },
                "intent": {
                  "description": "Its intent",
                  "type": "string"
                },
                "kind": {
                  "description": "intention or record",
                  "type": "string"
                },
                "ops": {
                  "description": "The operations it applied to the target, in apply order",
                  "items": {
                    "additionalProperties": false,
