    {
      "name": "inbox.open",
      "request": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "Look in every registered project, from anywhere under the root",
            "type": "boolean"
          },
          "item": {
            "description": "The inbox item: its short ID from rhiza inbox, or a unique prefix of it",
            "type": "string"
          },
          "project": {
            "description": "Only look in this registered project; default the current project, or every project at the root",
            "type": "string"
          }
        },
        "required": [
          "item"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "item": {
            "description": "The item's short ID",
