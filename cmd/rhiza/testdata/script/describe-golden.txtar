            "description": "What the link says",
            "enum": [
              "serves",
              "constrains",
              "exempts",
              "depends-on",
              "relates-to",
              "decided-by",
              "answers",
              "blocks",
              "supersedes",
              "derived-from",
              "discovered-from",
              "implements",
              "verifies",
              "observes",
              "discusses"
            ],
            "type": "string"
          }
        },
        "required": [
          "from",
