          "nodes"
        ],
        "type": "object"
      },
      "summary": "Change a node's handle or fields",
      "write": true
    },
    {
      "name": "ship.check",
      "request": {
        "additionalProperties": false,
        "properties": {
          "main": {
            "description": "Check that the merge commit rhiza ship merge recorded has the tree of the head whose checks passed, locally with git and no wait on CI, instead of checking the pull request; a differing tree dispatches CI on the merge commit (once) and checks its runs as it does a pull request's, and a stop that cannot be waited out exits 75 with a stop: line",
            "type": "boolean"
          },
          "pr_open": {
            "description": "Exit 0 once a pull request from the change set's branch is open, whatever its CI; records nothing (for an agent step's until)",
            "type": "boolean"
          },
          "settled": {
            "description": "Exit 0 once every check has finished, passed or not, instead of only when all passed; for a wait step; when GitHub reports the pull request CONFLICTING it rebases the branch onto main as ship rebase does, then reports not settled, and exits 75 with a stop: line on a conflict in code",
            "type": "boolean"
          },
          "test_failures": {
            "description": "Exit 0 only if the head's latest ship check recorded at least one failing test read from a CI log, else exit 1 (an infra or unparsable failure); reads the state file only and records nothing (for a step that routes a red PR to a fixer)",
            "type": "boolean"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "description": "The change set's branch",
            "type": "string"
          },
          "change": {
            "description": "The change set",
            "type": "string"
          },
          "checks": {
            "description": "The checks reported for the commit",
            "items": {
              "additionalProperties": false,
              "properties": {
                "conclusion": {
                  "description": "How it finished, such as SUCCESS or FAILURE; empty until it has",
                  "type": "string"
                },
                "name": {
                  "description": "The check's name",
                  "type": "string"
                },
                "status": {
                  "description": "COMPLETED once it has finished, else its status, such as IN_PROGRESS or PENDING",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "commit": {
            "description": "The commit checked: the PR's head, or the merge commit",
            "type": "string"
          },
          "conflicts": {
            "description": "With --settled on a conflicting pull request: the files whose conflict outside the rendered files stopped the rebase; the command exits 75",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detail": {
            "description": "Why it did not pass, such as no open pull request",
            "type": "string"
          },
          "failed": {
            "description": "The names of the settled checks that did not pass",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "findings": {
            "description": "One finding, with no leaf, per failing test, for a fix step; recorded in the state file as well",
            "items": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "description": "What failed and where it was read",
                  "type": "string"
                },
                "test": {
                  "description": "The failing test or testscript",
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "test"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "green": {
            "description": "True if settled and every check passed (success, neutral or skipped)",
            "type": "boolean"
          },
          "main": {
            "description": "True if it checked the merge commit on main rather than the pull request",
            "type": "boolean"
          },
          "passed": {
            "description": "True if the check asked for holds: open with --pr-open, settled with --settled, else green; the command exits 1 otherwise",
            "type": "boolean"
          },
          "pr": {
            "description": "The pull request's number; 0 if none was found",
            "type": "integer"
          },
          "question": {
            "description": "The handle of the question raised about those conflicts",
            "type": "string"
          },
          "rebased": {
            "description": "With --settled on a conflicting pull request: the head pushed after rebasing the branch onto main",
            "type": "string"
          },
          "reran": {
            "description": "The GitHub Actions run IDs whose failed jobs this check reran, once per head, instead of failing; the check then reports not settled",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "settled": {
            "description": "True if there is an open PR (or a merge commit) and every check on it has finished",
            "type": "boolean"
          },
          "state": {
            "description": "The pull request's state, such as OPEN or MERGED",
            "type": "string"
          },
          "stop": {
            "description": "With --main: why main cannot be confirmed, such as no workflow to dispatch CI on a merge commit whose tree differs from the tested head's, or CI on it failing again after a rerun; the command exits 75",
            "type": "string"
          },
          "tests": {
            "description": "The failing tests the failed Actions runs' logs name, once the failed jobs were rerun and failed again: Go tests and testscripts (a '--- FAIL:' line, such as TestScripts/x), RSpec ('rspec ./spec/x_spec.rb:12'), Minitest ('bin/rails test test/x_test.rb:12') and pytest ('pytest tests/test_x.py::test_y'), each as its runner's rerun command",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "description": "The pull request's URL",
            "type": "string"
          },
          "written": {
            "description": "True if the result was recorded in the state file for the next steps",
            "type": "boolean"
          }
        },
        "required": [
          "branch",
          "change",
          "checks",
          "green",
          "passed",
          "settled"
        ],
        "type": "object"
      },
      "summary": "Check that a change set's pull request has every CI check passed, or that main after its merge has the tested head's tree; with --settled, rebase a pull request GitHub reports conflicting",
      "write": true
    },
