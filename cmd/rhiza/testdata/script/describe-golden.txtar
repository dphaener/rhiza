    {
      "name": "run.build-check",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "description": "The run's change set",
            "type": "string"
          },
          "leaves": {
            "description": "The change set's leaves in leaf order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence": {
                  "description": "The live Evidence that verifies it, by handle (ID when it has none), in link order; empty when none does",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "handle": {
                  "description": "Its handle",
                  "type": "string"
                },
                "leaf": {
                  "description": "The leaf capability's ID",
                  "type": "string"
                },
                "ok": {
                  "description": "True if live Evidence verifies it written by an actor that wrote none of its commits",
                  "type": "boolean"
                },
                "why": {
                  "description": "Why it is not OK; absent when it is",
                  "type": "string"
                }
              },
              "required": [
                "evidence",
                "handle",
                "leaf",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "passed": {
            "description": "True if every leaf is OK",
            "type": "boolean"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          }
        },
        "required": [
          "change",
          "leaves",
          "passed",
          "run"
        ],
        "type": "object"
      },
      "summary": "Check the change set of the run RHIZA_RUN names: pass when every leaf has live Evidence by an actor that wrote none of its commits, else fail naming each leaf that lacks it",
      "write": false
    },
    {
      "name": "run.code-check",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "causes": {
            "description": "Why it failed, one cause per line: each failure rhiza check found, then each leaf lacking Evidence by a verifier; empty when it passed",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "change": {
            "description": "The run's change set",
            "type": "string"
          },
          "check": {
            "additionalProperties": false,
            "description": "rhiza check's report on the run's worktree",
            "properties": {
              "base": {
                "description": "The git revision the append-only rule compared against; empty when it was skipped",
                "type": "string"
              },
              "findings": {
                "description": "Every finding, sorted by rule (log, fold, model, in-flight, link, depends-on, evidence-actor, unclaimed, anchor, text-ref, render, append-only), then path and IDs",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "change_set": {
                      "description": "The change set's ID",
                      "type": "string"
                    },
                    "entry": {
                      "description": "The entry's ID",
                      "type": "string"
                    },
                    "link": {
                      "description": "The link's ID",
                      "type": "string"
                    },
                    "message": {
                      "description": "What is wrong",
                      "type": "string"
                    },
                    "next": {
                      "description": "A command that would help",
                      "type": "string"
                    },
                    "op": {
                      "description": "The operation's ID",
                      "type": "string"
                    },
                    "path": {
                      "description": "The file, relative to the project root",
                      "type": "string"
                    },
                    "rule": {
                      "description": "The rule that found it",
                      "enum": [
                        "log",
                        "fold",
                        "model",
                        "in-flight",
                        "link",
                        "depends-on",
                        "evidence-actor",
                        "unclaimed",
                        "anchor",
                        "text-ref",
                        "render",
                        "append-only"
                      ],
                      "type": "string"
                    },
                    "severity": {
                      "description": "fail makes the check fail; warn does not",
                      "enum": [
                        "fail",
                        "warn"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message",
                    "rule",
                    "severity"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "merge_base_of": {
                "description": "The ref whose merge-base with HEAD is the default base; absent with --base",
                "type": "string"
              },
              "ok": {
                "description": "True when no finding fails",
                "type": "boolean"
              },
              "skipped": {
                "description": "Why the append-only rule was skipped, if it was",
                "type": "string"
              }
            },
            "required": [
              "base",
              "findings",
              "ok"
            ],
            "type": "object"
          },
          "dry_run": {
            "description": "True if nothing was journalled",
            "type": "boolean"
          },
          "leaves": {
            "description": "build-check's leaves of the change set, in leaf order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence": {
                  "description": "The live Evidence that verifies it, by handle (ID when it has none), in link order; empty when none does",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "handle": {
                  "description": "Its handle",
                  "type": "string"
                },
                "leaf": {
                  "description": "The leaf capability's ID",
                  "type": "string"
                },
                "ok": {
                  "description": "True if live Evidence verifies it written by an actor that wrote none of its commits",
                  "type": "boolean"
                },
                "why": {
                  "description": "Why it is not OK; absent when it is",
                  "type": "string"
                }
              },
              "required": [
                "evidence",
                "handle",
                "leaf",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "passed": {
            "description": "True if rhiza check found no failure and every leaf is OK",
            "type": "boolean"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          },
          "step": {
            "description": "The step the run is at, which the code-check entry names",
            "type": "string"
          }
        },
        "required": [
          "causes",
          "change",
          "check",
          "leaves",
          "passed",
          "run"
        ],
        "type": "object"
      },
      "summary": "Run rhiza check and build-check on the change set of the run RHIZA_RUN names and journal the outcome as its code check: pass when rhiza check finds no failure and every leaf has Evidence by a verifier, else fail naming each cause",
      "write": true
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "description": "The findings, in order; empty for a clean review or check, but at least one with --leaf. They are numbered f1, f2, ... in the round, or in the leaf's attempt",
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "description": "What is wrong with the node. Required, except with --check or --leaf, which refuse it",
                  "enum": [
                    "missing-acceptance",
                    "missing-provenance",
                    "unreal-depends-on",
                    "outside-intent",
                    "contradiction"
                  ]
                },
                "leaf": {
                  "description": "The leaf of the run's change set it is about, by handle or ID. Optional with --check, refused otherwise",
                  "type": "string"
                },
                "node": {
                  "description": "The node: a full ID, a unique prefix of 4+ characters or a handle, in the run's change set's view. Required, except with --check or --leaf, which refuse it",
                  "type": "string"
                },
                "place": {
                  "description": "Where: file:line or a node. Required with --check, refused otherwise",
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "description": "Why",
                  "minLength": 1,
                  "type": "string"
                },
                "severity": {
                  "description": "How serious it is. Required with --check, refused otherwise",
                  "enum": [
                    "blocker",
                    "major",
                    "minor",
                    "nit"
                  ]
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "findings"
        ],
        "type": "object"
      },
      "name": "run.findings",
      "request": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "description": "A check of the checks step the run is in: journal that review check's findings, each with a severity, place and reason, as its next round; required in a review run, refused outside one",
            "type": "string"
          },
          "file": {
            "description": "A JSON file of findings, or - for stdin (see the input schema)",
            "type": "string"
          },
          "leaf": {
            "description": "A leaf of the run's change set, by handle or ID: journal a verifier's findings, each just a reason, on the leaf's current attempt in the run's leaves step instead of a plan review round",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "description": "With --leaf: the leaf's attempt the findings are on, from 1",
            "type": "integer"
          },
          "check": {
            "description": "With --check: the check",
            "type": "string"
          },
          "cycle": {
            "description": "With --check: the check's cycle the round is in, from 1",
            "type": "integer"
          },
          "dry_run": {
            "description": "True if nothing was journalled",
            "type": "boolean"
          },
          "findings": {
            "description": "The findings recorded, in order; empty for a clean review",
            "items": {
              "additionalProperties": false,
              "properties": {
                "check": {
                  "description": "A review check's finding: the check that found it",
                  "type": "string"
                },
                "handle": {
                  "description": "The node's handle when the finding was recorded; absent when it had none",
                  "type": "string"
                },
                "id": {
                  "description": "The finding's ID in its round: f1, f2, ...",
                  "type": "string"
                },
                "kind": {
                  "description": "What is wrong: missing-acceptance, missing-provenance, unreal-depends-on, outside-intent or contradiction; absent for a leaf's or a review check's finding",
                  "type": "string"
                },
                "leaf": {
                  "description": "A review check's finding: the leaf it is about, by ID; absent when it names none",
                  "type": "string"
                },
                "leaf_handle": {
                  "description": "That leaf's handle when the finding was recorded",
                  "type": "string"
                },
                "node": {
                  "description": "The node it is about, by ID; absent for a leaf's finding",
                  "type": "string"
                },
                "place": {
                  "description": "A review check's finding: where, as file:line or a node",
                  "type": "string"
                },
                "reason": {
                  "description": "Why the reviewer found it",
                  "type": "string"
                },
                "severity": {
                  "description": "A review check's finding: blocker, major, minor or nit",
                  "type": "string"
                },
                "verdict": {
                  "description": "The critic's latest verdict, confirmed or dropped; absent before one",
                  "type": "string"
                },
                "verdict_reason": {
                  "description": "Why the critic gave it; absent before a verdict",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "leaf": {
            "description": "With --leaf: the leaf's handle",
            "type": "string"
          },
          "round": {
            "description": "The round the findings opened, from 1 (with --check, in the check's rounds); absent for a leaf's findings",
            "type": "integer"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          }
        },
        "required": [
          "findings",
          "run"
        ],
        "type": "object"
      },
      "summary": "Journal a plan reviewer's findings as the next review round of the run RHIZA_RUN names, with --check a review check's findings as that check's next round, or with --leaf a verifier's findings on a leaf's current attempt",
      "write": true
    },
    {
      "name": "run.gate",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "autonomous": {
            "description": "True if the run is autonomous, so the gate accepted in the owner's place",
            "type": "boolean"
          },
          "change_sets": {
            "description": "The plan's change sets: the run's change set and every change set serving an intent it adds, by ID",
            "items": {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "Its state before the gate",
                  "type": "string"
                },
                "id": {
                  "description": "The change set's ID",
                  "type": "string"
                },
                "moves": {
                  "description": "What the gate did, in order: proposed, accepted; absent when it left the change set as it was",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "next": {
                  "description": "The owner's command when it waits proposed in a normal run; absent otherwise",
                  "type": "string"
                },
                "state": {
                  "description": "Its state after the gate (in a dry run, the state it would have)",
                  "type": "string"
                },
                "title": {
                  "description": "Its title",
                  "type": "string"
                }
              },
              "required": [
                "from",
                "id",
                "state",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "commit": {
            "description": "The commit that renders and commits .rhiza on the run's branch; absent when there was nothing to commit, or in a dry run",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was written or journalled",
            "type": "boolean"
          },
          "open": {
            "description": "Every question the plan left with no live answering Decision: the review's questions and each question node created in the plan's change sets, in order; empty when none",
            "items": {
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "description": "Its handle, when it has one",
                  "type": "string"
                },
                "id": {
                  "description": "The question node's full ID",
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          }
        },
        "required": [
          "autonomous",
          "change_sets",
          "open",
          "run"
        ],
        "type": "object"
      },
      "summary": "End the plan of the run RHIZA_RUN names: propose each draft among its change sets; an autonomous run whose review passed accepts each under rule autonomous",
      "write": true
    },
    {
      "name": "run.log",
      "request": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "Print the whole log, ignoring --limit and --cursor",
            "type": "boolean"
          },
          "cursor": {
            "description": "Where to go on: the next_cursor of the page before",
            "type": "string"
          },
          "layer": {
            "description": "Open the log in a Rex layer, in the session the caller runs in, instead of printing it",
            "type": "boolean"
          },
          "limit": {
            "description": "The most lines to return, 1 to 1000; default 50",
            "type": "integer"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "lines": {
            "description": "The log's lines of this page, oldest first",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "The cursor of the next page; absent when no more remain",
            "type": "string"
          },
          "opened": {
            "description": "True when --layer opened the log in a Rex layer",
            "type": "boolean"
          },
          "run": {
            "description": "The run ID",
            "type": "string"
          }
        },
        "required": [
          "lines",
          "run"
        ],
        "type": "object"
      },
      "summary": "Page a headless run's driver log a page of lines at a time, or open it in a Rex layer with --layer; exits 2 for a run with no log",
      "write": false
    },
    {
      "name": "run.ls",
      "request": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "The most runs to return, 1 to 1000; default 20",
