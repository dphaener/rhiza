                "description": "The run the launch belongs to, if any",
                "type": "string"
              },
              "source": {
                "description": "Who reported the resolved status: hook, rex, exit, or default when no one has",
                "enum": [
                  "hook",
                  "rex",
                  "exit",
                  "default"
                ],
                "type": "string"
              },
              "started_at": {
                "description": "When it was launched, RFC 3339 UTC",
                "type": "string"
              },
              "status": {
                "additionalProperties": false,
                "description": "The resolved status: hooks first, then Rex, then the process exit",
                "properties": {
                  "at": {
                    "description": "When it was reported, RFC 3339 UTC",
                    "type": "string"
                  },
                  "code": {
                    "description": "The process exit code; only the exit source sets it",
                    "type": "integer"
                  },
                  "detail": {
                    "description": "Free text from the source",
                    "type": "string"
                  },
                  "kind": {
                    "description": "What a blocked session waits for: permission, question or auth",
                    "type": "string"
                  },
                  "state": {
                    "description": "The state",
                    "enum": [
                      "starting",
                      "working",
                      "idle",
                      "blocked",
                      "done",
                      "error",
                      "exited"
                    ],
                    "type": "string"
                  }
                },
                "required": [
