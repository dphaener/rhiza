        "type": "object"
      },
      "summary": "Send a run waiting at a signoff step back to a fixer with a note: the note is journalled as the next review round's one finding (the owner's, naming the first check of the checks step the sign-off goes back to), the run returns to that step's fixer instead of signing off, and the continuation is queued for the daemon (--foreground continues it in this process). Exit 2 on a run not waiting at a sign-off step; nothing changes",
      "write": true
    },
    {
      "name": "run.start",
      "request": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "description": "The agent adapter of agent steps that name none; default the built-in default adapter",
            "type": "string"
          },
          "autonomous": {
            "description": "Run without the owner: skip the owner's gates and questions, recording each; never changes agent permissions. Resume keeps it",
            "type": "boolean"
          },
          "change": {
            "description": "The change set: a full ID or a unique prefix of 4+ characters; default --change, else the current one",
            "type": "string"
          },
          "foreground": {
            "description": "Drive the run in this process, rather than hand it to the daemon. The daemon passes it to the detached process it starts",
            "type": "boolean"
          },
          "milestone": {
            "description": "With --new: open a record change set, to plan a milestone in; without it an intention",
            "type": "boolean"
          },
          "new": {
            "description": "With --workflow plan and no change set: open a draft change set with this one-line intent and start the plan run on it",
            "type": "string"
          },
          "no_wait": {
            "description": "Stop at a wait step whose condition does not hold yet, instead of waiting; resume the run later",
            "type": "boolean"
          },
          "permission_mode": {
            "description": "The permission mode of agent steps that set none; modes that bypass the agent's permission checks are refused",
            "type": "string"
          },
          "ref": {
            "description": "With --new: an opaque external reference for the opened change set, such as an issue URL, at most 2048 bytes; Rhiza never interprets it. The daemon passes the request's",
            "type": "string"
          },
          "request": {
