    {
      "name": "log",
      "request": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "Return every change set, ignoring --limit and --cursor",
            "type": "boolean"
          },
          "cursor": {
            "description": "Where to go on: the next_cursor of the page before",
            "type": "string"
          },
          "limit": {
            "description": "The most change sets to return, 1 to 1000; default 100",
            "type": "integer"
          },
          "ref": {
            "description": "The node or link: an ID, a unique ID prefix of 4+ characters, or a node's handle",
            "type": "string"
          },
          "view": {
            "description": "as-is, to-be or what-if:<change set>; default what-if of a draft or proposed effective change set, to-be of an accepted one, else as-is",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_sets": {
            "description": "The change sets that touched it, in apply order; one page",
            "items": {
              "additionalProperties": false,
              "properties": {
                "actor": {
                  "description": "Who landed it; absent unless landed",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "at": {
                  "description": "When it landed (RFC 3339, UTC); absent unless landed",
                  "type": "string"
                },
                "carves": {
                  "description": "Its carve entries that moved the target in or out, in the order found; absent when none",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "carve_entry": {
                        "description": "The other change set's entry of the same carve",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "carved_from": {
                        "description": "The change set the target was carved from; set on the target change set's entry",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "carved_into": {
                        "description": "The change set the target was carved into; set on the source change set's entry",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "entry": {
                        "description": "The carve entry, in this change set",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "carve_entry",
                      "entry"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "events": {
                  "description": "Its applied land and reopen entries, in causal order; absent unless it was ever reopened",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "actor": {
                        "description": "Who landed or reopened it",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "at": {
                        "description": "When it was written (RFC 3339, UTC)",
                        "type": "string"
                      },
                      "entry": {
                        "description": "The land or reopen entry",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "type": {
                        "description": "land or reopen",
                        "type": "string"
                      }
                    },
                    "required": [
                      "actor",
                      "at",
                      "entry",
                      "type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "description": "The change set's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "intent": {
                  "description": "Its intent",
                  "type": "string"
                },
                "kind": {
                  "description": "intention or record",
                  "type": "string"
                },
                "ops": {
                  "description": "The operations it applied to the target, in apply order",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "description": "The operation's ID",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "type": {
                        "description": "Its type, such as node.create",
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "state": {
                  "description": "Its lifecycle state",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "intent",
                "kind",
                "ops",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "The cursor of the next page; absent when no more remain",
            "type": "string"
          },
          "target": {
            "additionalProperties": false,
            "description": "The node or link",
            "properties": {
              "handle": {
                "description": "The node's handle; absent for a link",
                "type": "string"
              },
              "id": {
                "description": "Its ID",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "kind": {
                "description": "node or link",
                "enum": [
                  "node",
                  "link"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          },
          "view": {
            "description": "The view read",
            "type": "string"
          }
        },
        "required": [
          "change_sets",
          "target",
          "view"
        ],
        "type": "object"
      },
      "summary": "List every change set that touched a node or link, in order",
      "write": false
    },
    {
      "name": "ls",
