                    "properties": {
                      "cache_creation": {
                        "description": "Input tokens written to the cache",
                        "type": "integer"
                      },
                      "cache_read": {
                        "description": "Input tokens read from the cache",
                        "type": "integer"
                      },
                      "input": {
                        "description": "Input tokens neither written to nor read from the cache",
                        "type": "integer"
                      },
                      "output": {
                        "description": "Output tokens the model generated",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "cache_creation",
                      "cache_read",
                      "input",
                      "output"
                    ],
                    "type": "object"
                  },
                  "session": {
                    "additionalProperties": false,
                    "description": "The tokens of the session's own model calls",
                    "properties": {
                      "cache_creation": {
                        "description": "Input tokens written to the cache",
                        "type": "integer"
                      },
                      "cache_read": {
                        "description": "Input tokens read from the cache",
                        "type": "integer"
                      },
                      "input": {
                        "description": "Input tokens neither written to nor read from the cache",
                        "type": "integer"
                      },
                      "output": {
