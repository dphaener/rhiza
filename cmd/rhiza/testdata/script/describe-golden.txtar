      "summary": "Ask for changes to a run waiting at a signoff step: journal the owner's findings as confirmed and queue the run's continuation for the daemon (--foreground continues it in this process), which fixes them in one cycle outside the cap, re-runs the checks they name and waits for the sign-off again (a ship-change run first pushes and replaces the PR body, and waits for CI)",
      "write": true
    },
    {
      "name": "run.resume",
      "request": {
        "additionalProperties": false,
        "properties": {
          "foreground": {
            "description": "Drive the run in this process, rather than hand it to the daemon. The daemon passes it to the detached process it starts",
            "type": "boolean"
          },
          "no_wait": {
            "description": "Stop at a wait step whose condition does not hold yet, instead of waiting",
            "type": "boolean"
          },
          "retry": {
            "description": "Restart a failed run at the step that failed, once its cause is fixed; the retry is journalled. A run that succeeded is refused",
            "type": "boolean"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [
          "run"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
