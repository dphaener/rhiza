              "state",
              "steps",
              "title",
              "totals",
              "workflow",
              "worktree"
            ],
            "type": "object"
          }
        },
        "required": [
          "run"
        ],
        "type": "object"
      },
      "summary": "Queue the continuation of a stopped or interrupted run for the daemon, which drives it headless where its journal left it, or retries a failed run at its failed step; --foreground drives it in this process",
      "write": true
    },
    {
      "name": "run.review-check",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "description": "The round's findings the critic confirmed, in order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "check": {
                  "description": "A review check's finding: the check that found it",
                  "type": "string"
                },
                "handle": {
                  "description": "The node's handle when the finding was recorded; absent when it had none",
                  "type": "string"
                },
                "id": {
                  "description": "The finding's ID in its round: f1, f2, ...",
                  "type": "string"
                },
                "kind": {
                  "description": "What is wrong: missing-acceptance, missing-provenance, unreal-depends-on, outside-intent or contradiction; absent for a leaf's or a review check's finding",
                  "type": "string"
                },
                "leaf": {
                  "description": "A review check's finding: the leaf it is about, by ID; absent when it names none",
                  "type": "string"
                },
                "leaf_handle": {
                  "description": "That leaf's handle when the finding was recorded",
                  "type": "string"
                },
                "node": {
                  "description": "The node it is about, by ID; absent for a leaf's finding",
                  "type": "string"
                },
                "place": {
                  "description": "A review check's finding: where, as file:line or a node",
                  "type": "string"
                },
                "reason": {
                  "description": "Why the reviewer found it",
                  "type": "string"
                },
                "severity": {
                  "description": "A review check's finding: blocker, major, minor or nit",
                  "type": "string"
                },
                "verdict": {
                  "description": "The critic's latest verdict, confirmed or dropped; absent before one",
                  "type": "string"
                },
                "verdict_reason": {
                  "description": "Why the critic gave it; absent before a verdict",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written or journalled",
            "type": "boolean"
          },
          "passed": {
            "description": "True: the review may go on to the gate",
            "type": "boolean"
          },
          "questions": {
            "description": "From round 3, the question nodes left for the confirmed findings, in order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "added": {
                  "description": "True if this check added it; false if an earlier check had",
                  "type": "boolean"
                },
                "blocks": {
                  "description": "The capability it blocks, by ID; absent when the finding names another kind of node",
                  "type": "string"
                },
                "finding": {
                  "description": "The finding it holds, by ID in the round",
                  "type": "string"
                },
                "handle": {
                  "description": "Its handle: review-<run8>-r<round>-<finding>",
                  "type": "string"
                },
                "id": {
                  "description": "The question node's ID",
                  "type": "string"
                }
              },
              "required": [
                "added",
                "finding",
                "handle",
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "round": {
            "description": "The latest review round, from 1",
            "type": "integer"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          }
        },
        "required": [
          "confirmed",
          "passed",
          "round",
          "run"
        ],
        "type": "object"
      },
      "summary": "Check the latest review round of the run RHIZA_RUN names: pass with no confirmed finding, fail with one before round 3, else leave each as a question and pass",
      "write": true
    },
    {
      "name": "run.send-back",
      "request": {
        "additionalProperties": false,
