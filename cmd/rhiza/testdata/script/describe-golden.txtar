                  "description": "The step the outcome led to; empty when it ended the run",
                  "type": "string"
                },
                "outcome": {
                  "description": "How it ended: pass, fail, timeout, or error when it could not run",
                  "type": "string"
                },
                "retry": {
                  "description": "True for the first visit of the step after a retry restarted the run at it",
                  "type": "boolean"
                },
                "session": {
                  "description": "An agent step's session",
                  "type": "string"
                },
                "step": {
                  "description": "The step's name",
                  "type": "string"
                },
                "visit": {
                  "description": "Which visit of the step it was, from 1",
                  "type": "integer"
                }
              },
              "required": [
                "at",
                "outcome",
                "step",
                "visit"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "description": "The change set's title",
            "type": "string"
          },
          "totals": {
            "additionalProperties": false,
            "description": "The sums of the sessions with recorded token use, the session's own and helpers' kept apart",
            "properties": {
              "helpers": {
                "additionalProperties": false,
                "description": "The tokens of the calls its helper agents logged in its transcript, kept apart from the session's",
                "properties": {
                  "cache_creation": {
                    "description": "Input tokens written to the cache",
                    "type": "integer"
                  },
                  "cache_read": {
                    "description": "Input tokens read from the cache",
                    "type": "integer"
                  },
                  "input": {
                    "description": "Input tokens neither written to nor read from the cache",
                    "type": "integer"
                  },
                  "output": {
                    "description": "Output tokens the model generated",
                    "type": "integer"
                  }
                },
                "required": [
                  "cache_creation",
                  "cache_read",
                  "input",
                  "output"
                ],
                "type": "object"
              },
              "session": {
                "additionalProperties": false,
                "description": "The tokens of the session's own model calls",
                "properties": {
                  "cache_creation": {
                    "description": "Input tokens written to the cache",
                    "type": "integer"
                  },
                  "cache_read": {
                    "description": "Input tokens read from the cache",
                    "type": "integer"
                  },
                  "input": {
                    "description": "Input tokens neither written to nor read from the cache",
                    "type": "integer"
                  },
                  "output": {
                    "description": "Output tokens the model generated",
                    "type": "integer"
                  }
                },
                "required": [
                  "cache_creation",
                  "cache_read",
                  "input",
                  "output"
                ],
                "type": "object"
              }
            },
            "required": [
              "helpers",
              "session"
            ],
            "type": "object"
          },
          "waiting": {
            "description": "The plan's change sets run gate proposed that still wait proposed for the owner, by ID; absent when none does",
            "items": {
              "additionalProperties": false,
              "properties": {
                "change": {
                  "description": "The change set's ID",
                  "type": "string"
                },
                "next": {
                  "description": "The owner's command to accept it: rhiza accept --rule owner --change <id>",
                  "type": "string"
                },
                "title": {
                  "description": "Its title",
                  "type": "string"
                }
              },
              "required": [
                "change",
                "next",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "workflow": {
            "description": "The workflow's name",
            "type": "string"
          },
          "worktree": {
            "description": "The worktree every step runs in",
            "type": "string"
          }
        },
        "required": [
          "amendments",
          "change",
          "id",
          "messages",
          "sessions",
          "started_at",
          "state",
          "steps",
          "title",
          "totals",
          "workflow",
          "worktree"
        ],
        "type": "object"
      },
      "summary": "Show a run's state and the steps it has done, from its journal",
      "write": false
    },
    {
      "name": "run.summary",
      "request": {
        "additionalProperties": false,
        "properties": {
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run of the current change set, else the latest run",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "description": "The run's change set",
            "type": "string"
          },
          "markdown": {
            "description": "The summary as markdown, rendered from the run's journal alone",
            "type": "string"
          },
          "run": {
            "description": "The run's ID",
            "type": "string"
          }
        },
        "required": [
          "change",
          "markdown",
          "run"
        ],
        "type": "object"
      },
      "summary": "Render a review run's verdicts as markdown from its journal: each check's outcome, its confirmed findings, the findings its critic dropped, the minors and nits, the fix cycles, the code checks and the sign-off",
      "write": false
    },
    {
      "name": "run.tail",
      "request": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "The most lines to return, 1 to 1000; default 100",
            "type": "integer"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "lines": {
            "description": "The last lines of the log, oldest first",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "run": {
            "description": "The run ID",
            "type": "string"
          }
        },
        "required": [
          "lines",
          "run"
        ],
        "type": "object"
      },
      "summary": "Print the last lines of a headless run's driver log; exits 2 for a run with no log",
      "write": false
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "verdicts": {
            "description": "The verdicts, each on a different finding of the latest round (with --check, of the check's latest round)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "finding": {
                  "description": "The finding's ID in the latest round: f1, f2, ...",
                  "type": "string"
                },
                "reason": {
                  "description": "Why",
                  "minLength": 1,
                  "type": "string"
                },
                "verdict": {
                  "description": "confirmed or dropped",
                  "enum": [
                    "confirmed",
                    "dropped"
                  ]
                }
              },
              "required": [
                "finding",
                "reason",
                "verdict"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "verdicts"
        ],
        "type": "object"
      },
      "name": "run.verdict",
      "request": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "description": "A check of the checks step the run is in: judge that review check's latest round; required in a review run, refused outside one",
            "type": "string"
          },
          "file": {
            "description": "A JSON file of verdicts, or - for stdin (see the input schema)",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "description": "With --check: the check",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was journalled",
            "type": "boolean"
          },
          "round": {
            "description": "The round judged: the latest (with --check, the check's latest)",
            "type": "integer"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          },
          "verdicts": {
            "description": "The verdicts recorded, in order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "finding": {
                  "description": "The finding's ID in the round",
                  "type": "string"
                },
                "reason": {
                  "description": "Why",
                  "type": "string"
                },
                "verdict": {
                  "description": "confirmed or dropped",
                  "type": "string"
                }
              },
              "required": [
                "finding",
                "reason",
                "verdict"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "round",
          "run",
          "verdicts"
        ],
        "type": "object"
      },
      "summary": "Journal a critic's verdicts on the findings of the latest review round of the run RHIZA_RUN names, or with --check of that review check's latest round",
      "write": true
    },
    {
      "name": "search",
      "request": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "Where to go on: the next_cursor of the page before",
            "type": "string"
          },
          "kinds": {
            "description": "Keep the nodes of this kind; repeat for several; default every kind",
            "items": {
              "enum": [
                "intent",
                "capability",
                "constraint",
                "decision",
                "question",
                "evidence",
                "source",
                "actor",
                "anchor",
                "note"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "limit": {
            "description": "The most hits to return, 1 to 200; default 20",
            "type": "integer"
          },
          "text": {
            "description": "The words to find; every word must start a word of the handle or of a field",
            "type": "string"
          },
          "view": {
            "description": "as-is, to-be or what-if:<change set>; default follows the effective change set",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "hits": {
            "description": "The hits, best first, equal scores by ID",
            "items": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "description": "Where the text matched best: \"handle\" or a field name",
                  "type": "string"
                },
                "handle": {
                  "description": "The node's handle",
                  "type": "string"
                },
                "id": {
                  "description": "The node's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "kind": {
                  "description": "The node's kind",
                  "type": "string"
                },
                "path": {
                  "description": "Its ancestors in the tree, the root first; empty for a root or a kind outside the tree",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "handle": {
                        "description": "The ancestor's handle",
                        "type": "string"
                      },
                      "id": {
                        "description": "The ancestor's ID",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "handle",
                      "id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "score": {
                  "description": "The rank: higher is better",
                  "type": "integer"
                },
                "snippet": {
                  "description": "The matched text, shortened around the match",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "handle",
                "id",
                "kind",
                "path",
                "score",
                "snippet"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "The cursor of the next page; absent when no more remain",
            "type": "string"
          },
          "view": {
            "description": "The view it was read in: as-is, to-be or what-if:<change set ID>",
            "type": "string"
          }
        },
        "required": [
          "hits",
          "view"
        ],
        "type": "object"
      },
      "summary": "Find live nodes by the text of their handles and fields, ranked",
      "write": false
    },
    {
      "name": "session.done",
      "request": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The session: its full ID or a unique prefix of 4+ characters; default RHIZA_SESSION, which a launched agent has",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "already": {
            "description": "True if the session had already said done; the first mark stands",
            "type": "boolean"
          },
          "at": {
            "description": "When the session first said done, RFC 3339 UTC",
            "type": "string"
          },
          "decisions": {
            "description": "Handles of the Decisions proposed from the questions the owner answered (see session.interview)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "session": {
            "description": "The session's full ID",
            "type": "string"
          },
          "skipped": {
            "description": "Handles of answers already recorded as Decisions, left alone (see session.interview)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "warnings": {
            "description": "Answers that could not be captured, or token use that could not be read or recorded, when the session said done; the done mark stands",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "at",
          "session"
        ],
        "type": "object"
      },
      "summary": "Mark a session's work as done; its agent runs this as its very last action",
      "write": false
    },
    {
      "name": "session.hook",
      "request": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "description": "The hook event, as the agent names it; the payload is read from stdin",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "journaled": {
            "description": "Whether a message the session sent was journaled in its run",
            "type": "boolean"
          },
          "kind": {
            "description": "What a blocked session waits for",
            "type": "string"
          },
          "recorded": {
            "description": "Whether the hook report was recorded",
            "type": "boolean"
          },
          "session": {
            "description": "The session the payload names, if Rhiza launched it",
            "type": "string"
          },
          "state": {
            "description": "The state recorded",
            "enum": [
              "starting",
              "working",
              "idle",
              "blocked",
              "done",
              "error",
              "exited"
            ],
            "type": "string"
          }
        },
        "required": [
          "recorded"
        ],
        "type": "object"
      },
      "summary": "Record the status an agent hook reports, read from stdin; the agent's hooks run this",
      "write": false
    },
    {
      "name": "session.interview",
      "request": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The session: its full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "description": "The session's change set, which the Decisions go into while it is open",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "proposed": {
            "description": "The Decisions proposed, in transcript order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "description": "The Decision's handle: answer-<first 8 characters of the session ID>-<position in the transcript>",
                  "type": "string"
                },
                "picked": {
                  "description": "The agent's option labels the owner picked, verbatim",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "question": {
                  "description": "The question the agent asked, verbatim",
                  "type": "string"
                },
                "typed": {
                  "description": "The text the owner typed, verbatim",
                  "type": "string"
                }
              },
              "required": [
                "handle",
                "question"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "record": {
            "description": "The landed record change set the Decisions were written in, when the session's change set had landed",
            "type": "string"
          },
          "session": {
            "description": "The session ID",
            "type": "string"
          },
          "skipped": {
            "description": "Handles of answers already proposed in the change set, left alone",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "change",
          "proposed",
          "session",
          "skipped"
        ],
        "type": "object"
      },
      "summary": "Propose a Decision for each question the session's agent asked and the owner answered",
      "write": true
    },
    {
      "name": "session.key",
      "request": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "The key: escape or enter",
            "type": "string"
          },
          "session": {
            "description": "The session: its full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [
          "key",
          "session"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "True if nothing was sent",
            "type": "boolean"
          },
          "key": {
            "description": "The key pressed",
            "type": "string"
          },
          "session": {
            "description": "The session's full ID",
            "type": "string"
          }
        },
        "required": [
          "key",
          "session"
        ],
        "type": "object"
      },
      "summary": "Press a key (escape or enter) in a running agent session's terminal",
      "write": true
    },
    {
      "name": "session.ls",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "description": "Every session, oldest first",
            "items": {
              "additionalProperties": false,
              "properties": {
                "agent": {
                  "description": "The agent adapter",
                  "type": "string"
                },
                "branch": {
                  "description": "The worktree's branch",
                  "type": "string"
                },
                "change": {
                  "description": "The change set it works on",
                  "type": "string"
                },
                "id": {
                  "description": "The session ID, also the agent's own session ID",
                  "type": "string"
                },
                "permission_mode": {
                  "description": "The agent's permission mode",
                  "type": "string"
                },
                "source": {
                  "description": "Who reported the resolved status: hook, rex, exit, or default when no one has",
                  "enum": [
                    "hook",
                    "rex",
                    "exit",
                    "default"
                  ],
                  "type": "string"
                },
                "started_at": {
                  "description": "When it was launched, RFC 3339 UTC",
                  "type": "string"
                },
                "status": {
                  "description": "The resolved status",
                  "enum": [
                    "starting",
                    "working",
                    "idle",
                    "blocked",
                    "done",
                    "error",
                    "exited"
                  ],
                  "type": "string"
                },
                "step": {
                  "description": "The step it works on",
                  "type": "string"
                },
                "tab": {
                  "additionalProperties": false,
                  "description": "The terminal tab it runs in",
                  "properties": {
                    "block": {
                      "description": "The Rex block running the agent; empty until the tab opened",
                      "type": "string"
                    },
                    "session": {
                      "description": "The Rex session; empty when Rex chose it",
                      "type": "string"
                    },
                    "title": {
                      "description": "The tab title",
                      "type": "string"
                    },
                    "window": {
                      "description": "The Rex window ID; empty until the tab opened",
                      "type": "string"
                    }
                  },
                  "required": [
                    "block",
                    "session",
                    "title",
                    "window"
                  ],
                  "type": "object"
                },
                "title": {
                  "description": "The change set's title",
                  "type": "string"
                },
                "worktree": {
                  "description": "The worktree it runs in",
                  "type": "string"
                }
              },
              "required": [
                "agent",
                "branch",
                "change",
                "id",
                "permission_mode",
                "source",
                "started_at",
                "status",
                "step",
                "tab",
                "title",
                "worktree"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "summary": "List the agent sessions with their change set, tab, worktree and status",
      "write": false
    },
    {
      "name": "session.message",
      "request": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "The session: its full ID or a unique prefix of 4+ characters",
            "type": "string"
          },
          "text": {
            "description": "The message, kept verbatim in the file the session reads; must not be blank",
            "type": "string"
          },
          "timeout": {
            "description": "How long to wait for the session to be at its prompt, a Go duration such as 30s or 10m; default 10m",
            "type": "string"
          }
        },
        "required": [
          "session",
          "text"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "True if nothing was written or sent",
            "type": "boolean"
          },
          "file": {
            "description": "The message file, an absolute path inside the session's worktree",
            "type": "string"
          },
          "from": {
            "description": "The sender's actor handle",
            "type": "string"
          },
          "pointer": {
            "description": "The one line typed at the session's prompt",
            "type": "string"
          },
          "session": {
            "description": "The session's full ID",
            "type": "string"
          },
          "waited": {
            "description": "How long it waited for the prompt, a Go duration",
            "type": "string"
          }
        },
        "required": [
          "file",
          "from",
          "pointer",
          "session",
          "waited"
        ],
        "type": "object"
      },
      "summary": "Send a running agent session a message: a file in its worktree and a one-line pointer, typed at its prompt or, while it works, handed over at its next tool call",
      "write": true
    },
    {
      "name": "session.pane",
      "request": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "The session: its full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "The session's full ID",
            "type": "string"
          },
          "text": {
            "description": "The text on the session's terminal, screen and scrollback",
            "type": "string"
          },
          "usage_limit": {
            "description": "True when the session's adapter reads the text as the agent parked at a usage-limit prompt",
            "type": "boolean"
          }
        },
        "required": [
          "session",
          "text",
          "usage_limit"
        ],
