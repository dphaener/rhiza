          "guide": {
            "description": "Each installed guide found, user then project",
            "items": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "description": "Whether that version is the running rhiza's",
                  "type": "boolean"
                },
                "dir": {
                  "description": "The plugin folder",
                  "type": "string"
                },
                "scope": {
                  "description": "user (in the home directory) or project (in the repository)",
                  "enum": [
                    "user",
                    "project"
                  ],
                  "type": "string"
                },
                "version": {
                  "description": "The version it was installed by",
                  "type": "string"
                }
              },
              "required": [
                "current",
                "dir",
                "scope",
                "version"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next": {
            "description": "Commands that would help, in order; empty if none",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "version": {
            "description": "The running rhiza's version",
            "type": "string"
          }
        },
        "required": [
          "attention",
          "change_set",
          "guide",
          "next",
          "version"
        ],
        "type": "object"
      },
      "summary": "Show the current change set, what is in flight and the installed guide",
      "write": false
    },
    {
      "name": "tree",
      "request": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "description": "How many levels below the top to show; 0 for all",
            "type": "integer"
          },
          "kind": {
            "description": "Which tree: capability or intent; default capability, or the node's own kind with a ref",
            "enum": [
              "capability",
              "intent"
            ],
            "type": "string"
          },
          "ref": {
            "description": "The node whose subtree to show: an ID, ID prefix or handle; default every root of the tree",
            "type": "string"
          },
          "retired": {
            "description": "Show retired nodes too, and what is under them",
            "type": "boolean"
          },
          "view": {
            "description": "as-is, to-be or what-if:<change set>; default follows the effective change set",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "capability or intent",
            "type": "string"
          },
          "nodes": {
            "description": "The nodes, depth first in pre-order, siblings by key then ID",
            "items": {
              "additionalProperties": false,
              "properties": {
                "children": {
                  "description": "How many of its direct children are in the output",
                  "type": "integer"
                },
                "depth": {
                  "description": "0 for the top, one more per level down",
                  "type": "integer"
                },
                "handle": {
                  "description": "The node's handle",
                  "type": "string"
                },
                "id": {
                  "description": "The node's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "retired": {
                  "description": "True if the node is retired",
                  "type": "boolean"
                }
              },
              "required": [
                "children",
                "depth",
                "handle",
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "root": {
            "description": "The node whose subtree this is; absent for the whole tree",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "view": {
            "description": "The view read: as-is, to-be or what-if:<change set ID>",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "nodes",
          "view"
        ],
        "type": "object"
      },
      "summary": "Show the capability tree, or the subtree under a node",
      "write": false
    },
    {
      "name": "unlink",
      "request": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "description": "The link (a full ID or a unique prefix of 4+ characters), or the node it starts at when type and to follow",
            "type": "string"
          },
          "to": {
            "description": "The node the link ends at, with type",
            "type": "string"
          },
          "type": {
            "description": "The link type, with to",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set written to (with --record, the new record change set)",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "drop": {
            "description": "Dry run only: the op IDs the entry would drop",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links the write created or retired, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "description": "The nodes the write created or changed, sorted; link endpoints are not included",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "Dry run only: the ops the entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "record": {
            "description": "True if the write opened and landed a record change set",
            "type": "boolean"
          }
        },
        "required": [
          "change_set",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Retire a link",
      "write": true
    },
    {
      "name": "why",
      "request": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "description": "The node: an ID, a unique ID prefix of 4+ characters, or a handle",
            "type": "string"
          },
          "view": {
            "description": "as-is, to-be or what-if:<change set>; default what-if of a draft or proposed effective change set, to-be of an accepted one, else as-is",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_sets": {
            "description": "The change sets of the node's history, in apply order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "The change set's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "intent": {
                  "description": "Its intent",
                  "type": "string"
                },
                "kind": {
                  "description": "intention or record",
                  "type": "string"
                },
                "sources": {
                  "description": "The sources its open names, then those its own derived-from links lead to",
                  "items": {
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "state": {
                  "description": "Its lifecycle state",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "intent",
                "kind",
                "sources",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "decisions": {
            "description": "The decisions reached, in walk order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "answers": {
                  "description": "The questions it answers",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "handle": {
                        "description": "Its handle",
                        "type": "string"
                      },
                      "id": {
                        "description": "The node's ID",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "handle",
                      "id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "fields": {
                  "description": "Every field, name to JSON value",
                  "type": "object"
                },
                "handle": {
                  "description": "Its handle",
                  "type": "string"
                },
                "id": {
                  "description": "The decision's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "inherited": {
                  "description": "True when via is a tree ancestor of the node, not the node or a decision",
                  "type": "boolean"
                },
                "kind": {
                  "description": "Its kind: decision, unless the model links something else",
                  "type": "string"
                },
                "relation": {
                  "description": "How via relates to it: via is decided by it, via supersedes it, or via is superseded by it",
                  "enum": [
                    "decided by",
                    "supersedes",
                    "superseded by"
                  ],
                  "type": "string"
                },
                "via": {
                  "additionalProperties": false,
                  "description": "The node whose link led here",
                  "properties": {
                    "handle": {
                      "description": "Its handle",
                      "type": "string"
                    },
                    "id": {
                      "description": "The node's ID",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle",
                    "id"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "answers",
                "fields",
                "handle",
                "id",
                "inherited",
                "kind",
                "relation",
                "via"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "node": {
            "additionalProperties": false,
            "description": "The node explained",
            "properties": {
              "fields": {
                "description": "Every field, name to JSON value",
                "type": "object"
              },
              "handle": {
                "description": "Its handle",
                "type": "string"
              },
              "id": {
                "description": "The node's ID",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "kind": {
                "description": "Its kind",
                "type": "string"
              }
            },
            "required": [
              "fields",
              "handle",
              "id",
              "kind"
            ],
            "type": "object"
          },
          "sources": {
            "description": "The sources reached, in walk order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "fields": {
                  "description": "Every field, name to JSON value",
                  "type": "object"
                },
                "handle": {
                  "description": "Its handle",
                  "type": "string"
                },
                "id": {
                  "description": "The source's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "kind": {
                  "description": "Its kind: source, unless the model links something else",
                  "type": "string"
                },
                "via": {
                  "additionalProperties": false,
                  "description": "The node whose derived-from link led here",
                  "properties": {
                    "handle": {
                      "description": "Its handle",
                      "type": "string"
                    },
                    "id": {
                      "description": "The node's ID",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle",
                    "id"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "fields",
                "handle",
                "id",
                "kind",
                "via"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "view": {
            "description": "The view read",
            "type": "string"
          }
        },
        "required": [
          "change_sets",
          "decisions",
          "node",
          "sources",
          "view"
        ],
        "type": "object"
      },
      "summary": "Walk back through the decisions, sources and change sets that shaped a node",
      "write": false
    },
    {
      "name": "withdraw",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set moved",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "cleared_current": {
            "description": "True if the move ended the current change set and cleared it",
            "type": "boolean"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "from": {
            "description": "The state before the move",
            "type": "string"
          },
          "reason": {
            "description": "The reason of an accept or reject",
            "type": "string"
          },
          "rule": {
            "description": "The rule of an accept or reject",
            "type": "string"
          },
          "to": {
            "description": "The state after the move",
            "type": "string"
          }
        },
        "required": [
          "change_set",
          "from",
          "to"
        ],
        "type": "object"
      },
      "summary": "Withdraw a change set that has not landed",
      "write": true
    }
  ]
}
