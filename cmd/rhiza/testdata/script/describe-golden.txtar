# describe --json must match the golden below byte for byte: it is the
# public contract of every operation (names, summaries, request and response
# schemas). When a request or response type changes on purpose, regenerate
# it and review the diff:
#
#   go test ./cmd/rhiza -run TestScripts/describe-golden -update
#
# or by hand: go build -o $TMPDIR/rhiza-x ./cmd/rhiza &&
# $TMPDIR/rhiza-x describe --json, pasted below the golden's header.

exec rhiza describe --json
cmp stdout describe.golden.json
! stderr .

-- describe.golden.json --
{
  "operations": [
    {
      "name": "accept",
      "request": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Why",
            "type": "string"
          },
          "rule": {
            "description": "The rule the decision is made under; default owner",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set moved",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "cleared_current": {
            "description": "True if the move ended the current change set and cleared it",
            "type": "boolean"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "from": {
            "description": "The state before the move",
            "type": "string"
          },
          "reason": {
            "description": "The reason of an accept or reject",
            "type": "string"
          },
          "rule": {
            "description": "The rule of an accept or reject",
            "type": "string"
          },
          "to": {
            "description": "The state after the move",
            "type": "string"
          }
        },
        "required": [
          "change_set",
          "from",
          "to"
        ],
        "type": "object"
      },
      "summary": "Accept a proposed change set",
      "write": true
    },
    {
      "name": "add",
      "request": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Place it just after this sibling; default after the last one",
            "type": "string"
          },
          "before": {
            "description": "Place it just before this sibling",
            "type": "string"
          },
          "fields": {
            "description": "A text field, name=text",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "handle": {
            "description": "The node's handle: lower-case words joined by single dashes, unique among live nodes",
            "type": "string"
          },
          "json_fields": {
            "description": "A JSON field, name=<json>",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "description": "The node's kind",
            "enum": [
              "intent",
              "capability",
              "constraint",
              "decision",
              "question",
              "evidence",
              "source",
              "actor",
              "anchor"
            ],
            "type": "string"
          },
          "parent": {
            "description": "The parent node (capabilities and intents only, same kind); default a root",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "kind"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set written to (with --record, the new record change set)",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "drop": {
            "description": "Dry run only: the op IDs the entry would drop",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links the write created or retired, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "description": "The nodes the write created or changed, sorted; link endpoints are not included",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "Dry run only: the ops the entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "record": {
            "description": "True if the write opened and landed a record change set",
            "type": "boolean"
          }
        },
        "required": [
          "change_set",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Add a node",
      "write": true
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "writes": {
            "description": "The writes, applied in order",
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "after": {
                      "description": "Place it just after this sibling; default after the last one",
                      "type": "string"
                    },
                    "before": {
                      "description": "Place it just before this sibling",
                      "type": "string"
                    },
                    "fields": {
                      "description": "A text field, name=text",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "The node's handle: lower-case words joined by single dashes, unique among live nodes",
                      "type": "string"
                    },
                    "json_fields": {
                      "description": "A JSON field, name=<json>",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "kind": {
                      "description": "The node's kind",
                      "enum": [
                        "intent",
                        "capability",
                        "constraint",
                        "decision",
                        "question",
                        "evidence",
                        "source",
                        "actor",
                        "anchor"
                      ],
                      "type": "string"
                    },
                    "op": {
                      "const": "add",
                      "description": "The operation this item is a request of"
                    },
                    "parent": {
                      "description": "The parent node (capabilities and intents only, same kind); default a root",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle",
                    "kind",
                    "op"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "description": "Set a text field, name=text",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "A new handle",
                      "type": "string"
                    },
                    "json_fields": {
                      "description": "Set a JSON field, name=<json>",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "op": {
                      "const": "set",
                      "description": "The operation this item is a request of"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "unset": {
                      "description": "Remove a field by name",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "after": {
                      "description": "Place it just after this sibling; default after the last one",
                      "type": "string"
                    },
                    "before": {
                      "description": "Place it just before this sibling",
                      "type": "string"
                    },
                    "op": {
                      "const": "mv",
                      "description": "The operation this item is a request of"
                    },
                    "parent": {
                      "description": "The new parent, of the same kind",
                      "type": "string"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "root": {
                      "description": "Make it a root instead",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "retire",
                      "description": "The operation this item is a request of"
                    },
                    "reason": {
                      "description": "Why it is retired",
                      "type": "string"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "reason",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "decision": {
                      "description": "The decision node behind an exempts link (exempts only, required there)",
                      "type": "string"
                    },
                    "from": {
                      "description": "The node or change set the link starts at: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "note": {
                      "description": "Why; required on relates-to and exempts",
                      "type": "string"
                    },
                    "op": {
                      "const": "link",
                      "description": "The operation this item is a request of"
                    },
                    "to": {
                      "description": "The node or change set the link ends at",
                      "type": "string"
                    },
                    "type": {
                      "description": "What the link says",
                      "enum": [
                        "serves",
                        "constrains",
                        "exempts",
                        "depends-on",
                        "relates-to",
                        "decided-by",
                        "answers",
                        "blocks",
                        "supersedes",
                        "derived-from",
                        "discovered-from",
                        "implements",
                        "verifies",
                        "observes"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "op",
                    "to",
                    "type"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "unlink",
                      "description": "The operation this item is a request of"
                    },
                    "ref": {
                      "description": "The link (a full ID or a unique prefix of 4+ characters), or the node it starts at when type and to follow",
                      "type": "string"
                    },
                    "to": {
                      "description": "The node the link ends at, with type",
                      "type": "string"
                    },
                    "type": {
                      "description": "The link type, with to",
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "writes"
        ],
        "type": "object"
      },
      "name": "apply",
      "request": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "A JSON file of writes, or - for stdin (see the input schema); refs may name nodes added by earlier items",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set written to (with --record, the new record change set)",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "drop": {
            "description": "Dry run only: the op IDs the entry would drop",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links the write created or retired, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "description": "The nodes the write created or changed, sorted; link endpoints are not included",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "Dry run only: the ops the entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "record": {
            "description": "True if the write opened and landed a record change set",
            "type": "boolean"
          }
        },
        "required": [
          "change_set",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Apply many writes as one entry: a JSON file {\"writes\":[{\"op\":\"add\",...},...]} whose items are add, set, mv, retire, link or unlink requests plus \"op\"",
      "write": true
    },
    {
      "name": "carve",
      "request": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "The change set to carve from: an ID or a unique prefix of 4+ characters",
            "type": "string"
          },
          "nodes": {
            "description": "The nodes to move, at least one: IDs, unique ID prefixes of 4+ characters, or handles, as the source sees them; each must be created in the source",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to": {
            "description": "The change set to carve into: an ID or a unique prefix of 4+ characters",
            "type": "string"
          },
          "with_children": {
            "description": "Also move every node created in the source below a named one, transitively",
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "nodes",
          "to"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "depends_on": {
            "description": "The depends-on link added from the source to the target, if one was",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "dropped": {
            "description": "The op IDs dropped from the source, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "links": {
            "description": "The links moved, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "next": {
            "description": "A command that would help: withdrawing the source, when the carve left it with no ops",
            "type": "string"
          },
          "nodes": {
            "description": "The nodes moved, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "The new op IDs in the target, in order",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "description": "The change set carved from",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "source_entry": {
            "description": "The entry written to the source, dropping the moved ops; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "source_ops": {
            "description": "Dry run only: the ops the source's entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "target": {
            "description": "The change set carved into",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_entry": {
            "description": "The entry written to the target, re-creating them; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_ops": {
            "description": "Dry run only: the ops the target's entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          }
        },
        "required": [
          "dropped",
          "nodes",
          "ops",
          "source",
          "target"
        ],
        "type": "object"
      },
      "summary": "Move nodes from one change set to another, keeping their IDs",
      "write": true
    },
    {
      "name": "change.ls",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_sets": {
            "description": "Every change set, sorted by ID",
            "items": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "description": "Whether it is the current change set",
                  "type": "boolean"
                },
                "id": {
                  "description": "The change set's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "intent": {
                  "description": "The change set's intent",
                  "type": "string"
                },
                "kind": {
                  "description": "intention or record; empty without a valid open",
                  "type": "string"
                },
