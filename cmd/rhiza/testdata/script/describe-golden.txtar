                "prior_outcome": {
                  "description": "That cycle's outcome, passed or failed, when open_cycle is set",
                  "type": "string"
                },
                "questions": {
                  "description": "The questions it raised when it still failed with no fix cycle left, in order; absent when none",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "cycle": {
                        "description": "The cycle that ended with no fix cycle left",
                        "type": "integer"
                      },
                      "finding": {
                        "description": "The surviving confirmed finding it is about; empty for one on the check's failure itself",
                        "type": "string"
                      },
                      "leaf": {
                        "description": "The leaf node the finding names, which the question blocks; empty for a question in the change set at large",
                        "type": "string"
                      },
                      "leaf_handle": {
                        "description": "That leaf's handle",
                        "type": "string"
                      },
                      "question": {
                        "description": "The question node's ID",
                        "type": "string"
                      },
                      "question_handle": {
                        "description": "The question node's handle",
                        "type": "string"
                      }
                    },
                    "required": [
                      "cycle",
                      "question",
                      "question_handle"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "rounds": {
                  "description": "Its findings rounds, journalled by run findings --check and judged by run verdict --check, in order; absent when there were none",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "When its findings were journalled, RFC 3339 UTC",
                        "type": "string"
                      },
                      "confirmed": {
                        "description": "How many findings the latest verdict confirms",
                        "type": "integer"
                      },
                      "cycle": {
                        "description": "The check's cycle it was recorded in, from 1",
                        "type": "integer"
                      },
                      "findings": {
                        "description": "The check's findings, in order, each with its latest verdict; empty for a clean check",
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "check": {
                              "description": "A review check's finding: the check that found it",
                              "type": "string"
                            },
                            "handle": {
                              "description": "The node's handle when the finding was recorded; absent when it had none",
                              "type": "string"
                            },
                            "id": {
                              "description": "The finding's ID in its round: f1, f2, ...",
