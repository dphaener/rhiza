            "type": "string"
          }
        },
        "required": [
          "branch",
          "change",
          "main",
          "main_updated",
          "steps",
          "worktree"
        ],
        "type": "object"
      },
      "summary": "After the merge, remove a change set's worktree and branch, locally and on origin, and fast-forward main",
      "write": false
    },
