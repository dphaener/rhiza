                  "type": "string"
                },
                "id": {
                  "description": "The node's full ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "kind": {
                  "description": "The node's kind",
                  "type": "string"
                },
                "note": {
                  "description": "The link's note",
                  "type": "string"
                },
                "relation": {
                  "description": "How it relates to the focus: ancestor, serves, blocks, relates-to, needs or needed by",
