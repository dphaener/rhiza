                      "depends_on": {
                        "description": "The change sets it depends on, sorted",
                        "items": {
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "id": {
                        "description": "The change set's ID",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "type": "string"
                      },
                      "intent": {
                        "description": "The change set's intent",
                        "type": "string"
                      },
                      "kind": {
                        "description": "intention or record",
                        "type": "string"
                      },
                      "project": {
                        "description": "The registered project the change set belongs to, on a roadmap that covers every project; absent on a single project's roadmap",
                        "type": "string"
                      },
                      "ready": {
                        "description": "Whether it can be worked on now (see ready)",
                        "type": "boolean"
                      },
                      "serves": {
                        "description": "The intents it serves, sorted",
                        "items": {
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                          "type": "string"
