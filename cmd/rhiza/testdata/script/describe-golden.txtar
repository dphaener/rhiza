            "type": "boolean"
          }
        },
        "required": [
          "item",
          "kind",
          "opened",
          "run"
        ],
        "type": "object"
      },
      "summary": "Focus the Rex tab an inbox item waits in: the asking session's for a question, the run's journalled tab for the rest",
      "write": false
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "findings": {
