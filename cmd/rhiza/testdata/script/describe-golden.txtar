                        "type": "string"
                      },
                      "kind": {
                        "description": "What a blocked session waits for: permission, question or auth",
                        "type": "string"
                      },
                      "state": {
                        "description": "The state",
                        "enum": [
                          "starting",
                          "working",
                          "idle",
                          "blocked",
                          "done",
                          "error",
                          "exited"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "at",
                      "state"
                    ],
                    "type": "object"
                  }
                },
                "required": [],
                "type": "object"
              },
