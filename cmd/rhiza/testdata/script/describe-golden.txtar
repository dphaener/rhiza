            "description": "Drive the run in this process, rather than hand it to the daemon. The daemon passes it to the detached process it starts",
            "type": "boolean"
          },
          "item": {
            "description": "The inbox item: its short ID from rhiza inbox, or a unique prefix of it; it must be a sign-off",
            "type": "string"
          },
          "project": {
            "description": "Only look in this registered project; default the current project, or every project at the root",
            "type": "string"
