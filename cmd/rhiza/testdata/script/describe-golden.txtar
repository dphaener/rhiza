      },
      "summary": "Give up on an unfinished or failed run: journal it failed as abandoned, so the inbox stops listing it and a new run can start on its change set",
      "write": true
    },
    {
      "name": "run.amend",
      "request": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "The step's brief or plan file, a path relative to the run's worktree; it must already exist",
            "type": "string"
          },
          "from": {
            "description": "A file holding the new content, or - for stdin; the content must not be blank",
            "type": "string"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run of the current change set, else the latest run",
            "type": "string"
          },
          "step": {
            "description": "The agent step to amend; default the run's current step",
            "type": "string"
          },
          "timeout": {
            "description": "How long to wait for the step's session to be at its prompt, a Go duration such as 30s or 10m; default 10m",
            "type": "string"
          }
        },
        "required": [
          "file",
          "from"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "description": "The sender's actor handle",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was written, journaled or sent",
            "type": "boolean"
          },
          "file": {
            "description": "The amended file, relative to the run's worktree",
            "type": "string"
          },
          "path": {
            "description": "The amended file, an absolute path",
            "type": "string"
          },
          "pointer": {
            "description": "The one line typed at the session's prompt",
            "type": "string"
          },
          "run": {
            "description": "The run's full ID",
            "type": "string"
          },
          "session": {
            "description": "The step's session, which was sent the pointer",
            "type": "string"
          },
          "step": {
            "description": "The amended step",
            "type": "string"
          },
          "waited": {
            "description": "How long it waited for the prompt, a Go duration",
            "type": "string"
          }
        },
        "required": [
          "actor",
          "file",
          "path",
          "pointer",
          "run",
          "session",
          "step",
          "waited"
        ],
        "type": "object"
      },
      "summary": "Amend a running agent step: replace its brief or plan file, journal the amendment and type a pointer to it at its prompt",
      "write": true
    },
    {
      "name": "run.approve",
      "request": {
        "additionalProperties": false,
        "properties": {
          "foreground": {
            "description": "Drive the run in this process, rather than hand it to the daemon. The daemon passes it to the detached process it starts",
            "type": "boolean"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run of the current change set, else the latest run",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "description": "With changes: the checks step that fixes them",
            "type": "string"
          },
          "daemon": {
            "description": "With queued: the daemon's process, as host:pid; empty when no daemon runs and the run waits for one",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was journalled or run",
            "type": "boolean"
          },
          "queued": {
            "description": "True when the sign-off was journalled and the run's continuation queued for the daemon, which drives it headless, rather than driven in this process; absent otherwise",
            "type": "boolean"
          },
          "run": {
            "additionalProperties": false,
            "description": "The run after it was continued; in a dry run, or when queued, as it stands. The command exits 1 when the run failed",
            "properties": {
              "accepts": {
                "description": "The change sets an autonomous run accepted or rejected in the owner's place under rule autonomous, in order; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "When it was journalled, RFC 3339 UTC",
                      "type": "string"
                    },
                    "change": {
                      "description": "The change set accepted or rejected",
                      "type": "string"
                    },
                    "entry": {
                      "description": "The model log entry ID of the accept or reject",
                      "type": "string"
                    },
                    "verb": {
                      "description": "accepted or rejected",
                      "type": "string"
                    }
                  },
                  "required": [
                    "at",
                    "change",
                    "entry",
                    "verb"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "amendments": {
                "description": "The amendments made to its agent steps' briefs or plans, in order",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "actor": {
                      "description": "The sender's actor handle",
                      "type": "string"
                    },
                    "at": {
                      "description": "When it was amended, RFC 3339 UTC",
                      "type": "string"
                    },
                    "file": {
                      "description": "The amended file, relative to the run's worktree",
                      "type": "string"
                    },
                    "session": {
                      "description": "The step's session, which was sent a pointer to the file",
                      "type": "string"
                    },
                    "step": {
                      "description": "The amended step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "actor",
