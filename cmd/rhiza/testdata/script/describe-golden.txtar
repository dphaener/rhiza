              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "unchanged",
          "written"
        ],
        "type": "object"
      },
      "summary": "Install the Rhiza check as a GitHub workflow",
      "write": false
    },
    {
      "name": "daemon",
      "request": {
        "additionalProperties": false,
        "properties": {
          "autonomous": {
            "description": "Start each run with --autonomous: it goes on without the owner",
            "type": "boolean"
          },
          "event_command": {
            "description": "Run this command through sh -c in the repo root once per change set lifecycle move (proposed, accepted, rejected, withdrawn, superseded, landed, reopened) it has not handled, in log order, with the move as JSON on stdin and RHIZA_EVENT, RHIZA_EVENT_CHANGE, RHIZA_EVENT_ENTRY and RHIZA_EVENT_TITLE set; default: git config rhiza.eventCommand. The first run only records the moves already in the log. A failing or timed-out (10 s) command is logged and not retried",
            "type": "string"
          },
          "max_runs": {
            "description": "Start runs until this many are running; default 2. An interrupted run takes no slot",
            "type": "integer"
          },
          "min_free": {
            "description": "Start and resume nothing while the repo's filesystem has less free space than this: bytes, or a number with K, M, G or T (powers of 1024); default 10G; 0 turns the guard off",
            "type": "string"
          },
          "notify_command": {
            "description": "Run this command through sh -c in the repo root once per new inbox item, with the item's JSON on stdin and RHIZA_INBOX_KIND, RHIZA_INBOX_ID, RHIZA_INBOX_CHANGE and RHIZA_INBOX_TITLE set; default: git config rhiza.notifyCommand. A failing or timed-out (10 s) command is logged and not retried",
            "type": "string"
          },
          "once": {
            "description": "Poll once, start what is picked and stop",
            "type": "boolean"
          },
          "permission_mode": {
            "description": "Start each run with this --permission-mode, for its agent steps that set none; checked against ship-change before the daemon starts",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "planned": {
            "description": "The plan requests whose plan runs the daemon started, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "process": {
            "description": "The daemon's process, as host:pid",
            "type": "string"
          },
          "resumed": {
            "description": "The interrupted runs the daemon resumed, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "started": {
            "description": "The change sets whose runs the daemon started, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "planned",
          "process",
          "resumed",
          "started"
        ],
        "type": "object"
      },
      "summary": "Run the daemon in the foreground: one per repository, held by a lock in the git common dir",
      "write": false
    },
    {
      "name": "daemon.install",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "The unit file, absolute",
            "type": "string"
          },
          "unit": {
            "description": "The unit's name, such as rhiza-root.service",
            "type": "string"
          },
          "written": {
            "description": "Whether the unit file changed; false if it was already current",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "unit",
          "written"
        ],
        "type": "object"
      },
      "summary": "Run the root's daemon as a systemd user service: write and enable the unit and turn on lingering",
      "write": false
    },
    {
      "name": "daemon.set",
      "request": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "The setting: rhiza.daemon.paused, selfUpdate, maxRuns, minFree, permissionMode, usage.session, usage.weekly or usage.reserve, rhiza.web.host, rhiza.web.port, rhiza.ship.deployUrl or deployTimeout, or rhiza.autonomy.plan, accept, ship or signoff",
            "type": "string"
          },
          "project": {
            "description": "The registered project a project setting is written to; default the current project",
            "type": "string"
          },
          "value": {
            "description": "The new value: true or false, a whole number, a token count, a percent, a size, a permission mode, an IP address, a port number or off, an http(s) URL, a duration, or auto or owner, as the key takes",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "The setting",
            "type": "string"
          },
          "scope": {
            "description": "Where it was written: machine (rhiza.toml) or project (git config)",
            "type": "string"
          },
          "value": {
            "description": "The value written",
            "type": "string"
          }
        },
        "required": [
          "key",
          "scope",
          "value"
        ],
        "type": "object"
      },
      "summary": "Validate and write one daemon setting to the repo's git config; a running daemon reads it at its next poll",
      "write": false
