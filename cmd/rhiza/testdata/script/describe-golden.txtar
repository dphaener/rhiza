                      "depends_on",
                      "id",
                      "intent",
                      "kind",
                      "ready",
                      "serves",
                      "state"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "intent": {
                  "additionalProperties": false,
                  "description": "The milestone; absent for the backlog",
                  "properties": {
                    "handle": {
                      "description": "Its handle; empty if the view does not have it",
                      "type": "string"
                    },
                    "id": {
                      "description": "The intent's ID",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "path": {
                      "description": "The handles of its ancestors in the intent tree, the root first",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "statement": {
                      "description": "Its statement; empty if the view does not have it",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle",
                    "id",
                    "path"
                  ],
                  "type": "object"
                },
                "kind": {
                  "description": "milestone, backlog for the change sets that serve no milestone, or umbrella for those serving an umbrella intent",
                  "type": "string"
                },
                "project": {
                  "description": "The registered project the group belongs to, on a roadmap that covers every project; absent on a single project's roadmap",
                  "type": "string"
                }
              },
              "required": [
                "change_sets",
                "kind"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "The cursor of the next page; absent when no more remain",
            "type": "string"
          },
          "view": {
            "description": "The view read: as-is, to-be or what-if:<ID>",
            "type": "string"
          }
        },
        "required": [
          "groups",
          "view"
        ],
        "type": "object"
      },
      "summary": "Show the proposed and accepted change sets: milestone groups first, then the backlog",
      "write": false
    },
    {
      "name": "root.init",
      "request": {
        "additionalProperties": false,
        "properties": {
          "dir": {
            "description": "The directory to make a root; created if missing (default: the working directory)",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "description": "The root's config file",
            "type": "string"
          },
          "root": {
            "description": "The root directory",
            "type": "string"
          }
        },
        "required": [
          "config",
          "root"
        ],
        "type": "object"
      },
      "summary": "Make a directory a Rhiza root by writing its rhiza.toml",
      "write": false
    },
    {
      "name": "root.show",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "description": "The root's config file",
            "type": "string"
          },
          "project": {
            "description": "The registered project the working directory belongs to, by its folder or a <project>.<slug> sibling worktree; empty at the root itself",
            "type": "string"
          },
          "root": {
            "description": "The root directory: the nearest ancestor holding a rhiza.toml",
            "type": "string"
          }
        },
        "required": [
          "config",
          "project",
          "root"
        ],
        "type": "object"
      },
      "summary": "Show the Rhiza root, its config file and the project the working directory belongs to",
      "write": false
    },
    {
      "name": "run.abandon",
      "request": {
        "additionalProperties": false,
        "properties": {
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [
          "run"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "cleanup": {
            "description": "The clean-up of the run's worktree and local branch, in order; absent in a dry run or when the run has no worktree",
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "description": "Why it was kept",
                  "type": "string"
                },
                "status": {
                  "description": "done, already-gone, or kept (the worktree is dirty, or git refused)",
                  "enum": [
                    "done",
                    "already-gone",
                    "kept"
                  ],
                  "type": "string"
                },
                "step": {
                  "description": "remove-worktree or delete-branch",
                  "enum": [
                    "remove-worktree",
                    "delete-branch"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "step"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "run": {
            "additionalProperties": false,
            "description": "The run as its journal stands, failed with the abandoned detail",
            "properties": {
              "accepts": {
                "description": "The change sets an autonomous run accepted or rejected in the owner's place under rule autonomous, in order; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "When it was journalled, RFC 3339 UTC",
                      "type": "string"
                    },
                    "change": {
                      "description": "The change set accepted or rejected",
                      "type": "string"
                    },
                    "entry": {
                      "description": "The model log entry ID of the accept or reject",
                      "type": "string"
                    },
                    "verb": {
                      "description": "accepted or rejected",
                      "type": "string"
                    }
                  },
                  "required": [
                    "at",
                    "change",
                    "entry",
                    "verb"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "amendments": {
                "description": "The amendments made to its agent steps' briefs or plans, in order",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "actor": {
                      "description": "The sender's actor handle",
                      "type": "string"
                    },
                    "at": {
                      "description": "When it was amended, RFC 3339 UTC",
                      "type": "string"
                    },
                    "file": {
                      "description": "The amended file, relative to the run's worktree",
                      "type": "string"
                    },
                    "session": {
                      "description": "The step's session, which was sent a pointer to the file",
                      "type": "string"
                    },
                    "step": {
                      "description": "The amended step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "actor",
                    "at",
                    "file",
                    "session",
                    "step"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "autonomous": {
                "description": "True for a run started with --autonomous: it goes on without the owner; absent otherwise",
                "type": "boolean"
              },
              "blocked": {
                "additionalProperties": false,
                "description": "What the run waits on while its agent step's session is blocked; absent otherwise",
                "properties": {
                  "kind": {
                    "description": "What kind of block: permission, question or auth; empty when the session gave none",
                    "type": "string"
                  },
                  "question": {
                    "description": "What the session asks the owner, as it reported it; empty when it gave nothing",
                    "type": "string"
                  },
                  "session": {
                    "description": "The step's session",
                    "type": "string"
                  },
                  "step": {
                    "description": "The agent step that waits",
                    "type": "string"
                  },
                  "tab": {
                    "additionalProperties": false,
                    "description": "The terminal tab the session runs in, where the owner answers",
                    "properties": {
                      "block": {
                        "description": "The Rex block running the agent; empty until the tab opened",
                        "type": "string"
                      },
                      "session": {
                        "description": "The Rex session; empty when Rex chose it",
                        "type": "string"
                      },
                      "title": {
                        "description": "The tab title",
                        "type": "string"
                      },
                      "window": {
                        "description": "The Rex window ID; empty until the tab opened",
                        "type": "string"
                      }
                    },
                    "required": [
                      "block",
                      "session",
                      "title",
                      "window"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "session",
                  "step",
                  "tab"
                ],
                "type": "object"
              },
              "change": {
                "description": "The change set it runs on",
                "type": "string"
              },
              "checks": {
                "description": "The checks its checks steps ran, in the order they began, each with its cycles and outcome; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "check": {
                      "description": "The check's name",
                      "type": "string"
                    },
                    "cycles": {
                      "description": "The cycles it ran in, in order",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When the check's outcome in the cycle was journalled, RFC 3339 UTC",
                            "type": "string"
                          },
                          "cycle": {
                            "description": "The cycle, from 1",
                            "type": "integer"
                          },
                          "decisions": {
                            "description": "For a fresh cycle past the cap, the Decisions (handles) answering the questions the cycle before raised; absent otherwise",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "detail": {
                            "description": "Why the check ended the cycle as it did",
                            "type": "string"
                          },
                          "kind": {
                            "description": "answered for a fresh cycle past the cap, owner for the cycle fixing the owner's request for changes; absent for a cycle within the cap",
                            "type": "string"
                          },
                          "outcome": {
                            "description": "passed or failed; empty while the cycle is open for the check",
                            "type": "string"
                          },
                          "sessions": {
                            "description": "The check's sessions in the cycle, in the order they started",
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "at": {
                                  "description": "When it started, RFC 3339 UTC",
                                  "type": "string"
                                },
                                "detail": {
                                  "description": "Why it was judged so: the session's exit, or that its agent said done",
                                  "type": "string"
                                },
                                "model": {
                                  "description": "The model it runs; empty for the agent's default",
                                  "type": "string"
                                },
                                "outcome": {
                                  "description": "pass or fail once its work was judged; empty while it runs",
                                  "type": "string"
                                },
                                "role": {
                                  "description": "check",
                                  "type": "string"
                                },
                                "session": {
                                  "description": "The session's ID",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "at",
                                "role",
                                "session"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "cycle",
                          "sessions"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "open_cycle": {
                      "description": "The cycle that is open, when its latest cycle is open after an earlier one was judged; absent otherwise",
                      "type": "integer"
                    },
                    "outcome": {
                      "description": "passed or failed: its latest cycle's outcome; empty while that cycle is open, even when an earlier cycle was judged",
                      "type": "string"
                    },
                    "prior_cycle": {
                      "description": "The newest earlier cycle that was judged, when open_cycle is set",
                      "type": "integer"
                    },
                    "prior_outcome": {
                      "description": "That cycle's outcome, passed or failed, when open_cycle is set",
                      "type": "string"
                    },
                    "questions": {
                      "description": "The questions it raised when it still failed with no fix cycle left, in order; absent when none",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "cycle": {
                            "description": "The cycle that ended with no fix cycle left",
                            "type": "integer"
                          },
                          "finding": {
                            "description": "The surviving confirmed finding it is about; empty for one on the check's failure itself",
                            "type": "string"
                          },
                          "leaf": {
                            "description": "The leaf node the finding names, which the question blocks; empty for a question in the change set at large",
                            "type": "string"
                          },
                          "leaf_handle": {
                            "description": "That leaf's handle",
                            "type": "string"
                          },
                          "question": {
                            "description": "The question node's ID",
                            "type": "string"
                          },
                          "question_handle": {
                            "description": "The question node's handle",
                            "type": "string"
                          }
                        },
                        "required": [
                          "cycle",
                          "question",
                          "question_handle"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "rounds": {
                      "description": "Its findings rounds, journalled by run findings --check and judged by run verdict --check, in order; absent when there were none",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When its findings were journalled, RFC 3339 UTC",
                            "type": "string"
                          },
                          "confirmed": {
                            "description": "How many findings the latest verdict confirms",
                            "type": "integer"
                          },
                          "cycle": {
                            "description": "The check's cycle it was recorded in, from 1",
                            "type": "integer"
                          },
                          "findings": {
                            "description": "The check's findings, in order, each with its latest verdict; empty for a clean check",
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "check": {
                                  "description": "A review check's finding: the check that found it",
                                  "type": "string"
                                },
                                "handle": {
                                  "description": "The node's handle when the finding was recorded; absent when it had none",
                                  "type": "string"
                                },
                                "id": {
                                  "description": "The finding's ID in its round: f1, f2, ...",
                                  "type": "string"
                                },
                                "kind": {
                                  "description": "What is wrong: missing-acceptance, missing-provenance, unreal-depends-on, outside-intent or contradiction; absent for a leaf's or a review check's finding",
                                  "type": "string"
                                },
                                "leaf": {
                                  "description": "A review check's finding: the leaf it is about, by ID; absent when it names none",
                                  "type": "string"
                                },
                                "leaf_handle": {
                                  "description": "That leaf's handle when the finding was recorded",
                                  "type": "string"
                                },
                                "node": {
                                  "description": "The node it is about, by ID; absent for a leaf's finding",
                                  "type": "string"
                                },
                                "place": {
                                  "description": "A review check's finding: where, as file:line or a node",
                                  "type": "string"
                                },
                                "reason": {
                                  "description": "Why the reviewer found it",
                                  "type": "string"
                                },
                                "severity": {
                                  "description": "A review check's finding: blocker, major, minor or nit",
                                  "type": "string"
                                },
                                "verdict": {
                                  "description": "The critic's latest verdict, confirmed or dropped; absent before one",
                                  "type": "string"
                                },
                                "verdict_reason": {
                                  "description": "Why the critic gave it; absent before a verdict",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "reason"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "round": {
                            "description": "The round's number in the check, from 1",
                            "type": "integer"
                          },
                          "verdicts": {
                            "description": "The verdicts journalled on the round, in order; absent before any",
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "finding": {
                                  "description": "The finding's ID in the round",
                                  "type": "string"
                                },
                                "reason": {
                                  "description": "Why",
                                  "type": "string"
                                },
                                "verdict": {
                                  "description": "confirmed or dropped",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "finding",
                                "reason",
                                "verdict"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "at",
                          "confirmed",
                          "cycle",
                          "findings",
                          "round"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "step": {
                      "description": "The checks step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "check",
                    "cycles",
                    "step"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "code_checks": {
                "description": "The code checks rhiza run code-check journalled, in order; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "When it ran, RFC 3339 UTC",
                      "type": "string"
                    },
                    "detail": {
                      "description": "A fail's causes, separated by semicolons",
                      "type": "string"
                    },
                    "outcome": {
                      "description": "pass or fail",
                      "enum": [
                        "pass",
                        "fail"
                      ],
                      "type": "string"
                    },
                    "step": {
                      "description": "The step the run was at",
                      "type": "string"
                    }
                  },
                  "required": [
                    "at",
                    "outcome"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "current": {
                "description": "The step being run or to run next; empty once the run is finished",
                "type": "string"
              },
              "detail": {
                "description": "Why it stopped or failed",
                "type": "string"
              },
              "fixes": {
                "description": "The change-set fixers its checks steps ran, for confirmed findings naming no leaf, one per cycle, in order; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "When it started, RFC 3339 UTC",
                      "type": "string"
                    },
                    "commit": {
                      "description": "A passed fixer's new commit whose Review: trailer names the run",
                      "type": "string"
                    },
                    "cycle": {
                      "description": "The cycle whose fix phase ran it, from 2",
                      "type": "integer"
                    },
                    "detail": {
                      "description": "Why it was judged so",
                      "type": "string"
                    },
                    "model": {
                      "description": "The model it runs; empty for the agent's default",
                      "type": "string"
                    },
                    "outcome": {
                      "description": "pass or fail once its work was judged; empty while it runs",
                      "type": "string"
                    },
                    "session": {
                      "description": "The fixer session's ID",
                      "type": "string"
                    },
                    "since": {
                      "description": "The worktree's HEAD when it started, which its commit must follow",
                      "type": "string"
                    },
                    "step": {
                      "description": "The checks step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "at",
                    "cycle",
                    "session",
                    "since",
                    "step"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "The run ID",
                "type": "string"
              },
              "leaves": {
                "description": "The leaves its leaves steps conducted, and those its checks steps' fixers fixed, in the order they began, each with its sessions, judged attempts and outcome; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "attempts": {
                      "description": "The judgements of its sessions' work, in order",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When it was judged, RFC 3339 UTC",
                            "type": "string"
                          },
                          "attempt": {
                            "description": "The leaf's attempt, from 1; on a checks step, its session's attempt, one per try of a cycle's fix",
                            "type": "integer"
                          },
                          "commit": {
                            "description": "A passed builder's or fixer's commit naming its leaf; a passed verifier's Evidence commit",
                            "type": "string"
                          },
                          "cycle": {
                            "description": "On a checks step, the review cycle of the fix it belongs to",
                            "type": "integer"
                          },
                          "detail": {
                            "description": "Why: the session's exit, that its agent said done, or that a builder left no commit naming its leaf",
                            "type": "string"
                          },
                          "outcome": {
                            "description": "pass or fail",
                            "type": "string"
                          },
                          "role": {
                            "description": "builder or verifier; on a checks step fixer or verifier",
                            "type": "string"
                          }
                        },
                        "required": [
                          "at",
                          "attempt",
                          "outcome",
                          "role"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "commit": {
                      "description": "A passed leaf's Evidence commit: its verifier's Evidence entries, committed alone",
                      "type": "string"
                    },
                    "detail": {
                      "description": "Why the leaf ended as it did",
                      "type": "string"
                    },
                    "findings": {
                      "description": "The findings its verifiers journalled with run findings --leaf, in order; absent when there were none",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When it was journalled, RFC 3339 UTC",
                            "type": "string"
                          },
                          "attempt": {
                            "description": "The leaf's attempt it is on, from 1",
                            "type": "integer"
                          },
                          "id": {
                            "description": "The finding's ID in the attempt: f1, f2, ...",
                            "type": "string"
                          },
                          "reason": {
                            "description": "What the verifier found wrong",
                            "type": "string"
                          }
                        },
                        "required": [
                          "at",
                          "attempt",
                          "id",
                          "reason"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "The leaf capability's handle",
                      "type": "string"
                    },
                    "leaf": {
                      "description": "The leaf capability's ID",
                      "type": "string"
                    },
                    "outcome": {
                      "description": "passed, failed or skipped; empty while the leaf is open, and always on a checks step",
                      "type": "string"
                    },
                    "question": {
                      "description": "The question node a failed leaf raised, by ID, if any",
                      "type": "string"
                    },
                    "question_handle": {
                      "description": "That question node's handle",
                      "type": "string"
                    },
                    "round": {
                      "description": "The leaf's current round of attempts, from 1",
                      "type": "integer"
                    },
                    "rounds": {
                      "description": "Its fresh rounds, each given once a Decision answered the question its failure raised; absent in round 1",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "after": {
                            "description": "The attempts before it: its first attempt is after + 1",
                            "type": "integer"
                          },
                          "at": {
                            "description": "When the round began, RFC 3339 UTC",
                            "type": "string"
                          },
                          "decision": {
                            "description": "The handle of the Decision that answers it",
                            "type": "string"
                          },
                          "question": {
                            "description": "The question node the leaf's failure raised, by ID",
                            "type": "string"
                          },
                          "question_handle": {
                            "description": "That question node's handle",
                            "type": "string"
                          },
                          "round": {
                            "description": "The round, from 2",
                            "type": "integer"
                          }
                        },
                        "required": [
                          "after",
                          "at",
                          "decision",
                          "question",
                          "round"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sessions": {
                      "description": "The leaf's sessions, in the order they started",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When it started, RFC 3339 UTC",
                            "type": "string"
                          },
                          "attempt": {
