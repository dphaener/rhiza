          "dry_run": {
            "description": "True if nothing was written or run",
            "type": "boolean"
          },
          "queued": {
            "description": "True when run start or run resume queued the run for the daemon rather than driving it: a started run has no ID yet, and the daemon drives it headless; absent otherwise",
            "type": "boolean"
          },
          "retry": {
            "description": "The step a resume --retry restarted the failed run at, or in a dry run would; absent otherwise",
            "type": "string"
