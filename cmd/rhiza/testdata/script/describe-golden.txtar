          }
        },
        "required": [
          "asker",
          "run",
          "session"
        ],
        "type": "object"
      },
      "summary": "Journal an advisor session's recommendation and reasons for the question it was launched on; it answers nothing",
      "write": true
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "description": "The owner's findings, in order, numbered f1, f2, ...; they count as confirmed",
            "items": {
              "additionalProperties": false,
              "properties": {
                "check": {
                  "description": "A check of the checks step the sign-off goes back to: it runs again once the findings are fixed",
                  "type": "string"
                },
                "leaf": {
                  "description": "The leaf of the run's change set it is about, by handle or ID; without one, the change set's fixer takes it",
                  "type": "string"
                },
                "place": {
                  "description": "Where: file:line or a node",
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "description": "What to change, and why",
                  "minLength": 1,
                  "type": "string"
                },
                "severity": {
                  "description": "How serious it is",
                  "enum": [
                    "blocker",
                    "major",
                    "minor",
                    "nit"
                  ]
                }
              },
              "required": [
                "check",
                "place",
                "reason",
                "severity"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "findings"
        ],
        "type": "object"
      },
      "name": "run.request-changes",
      "request": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "A JSON file of the owner's findings, or - for stdin (see the input schema)",
            "type": "string"
          },
          "foreground": {
            "description": "Drive the run in this process, rather than hand it to the daemon. The daemon passes it to the detached process it starts",
            "type": "boolean"
          },
          "run": {
            "description": "The run: a full ID or a unique prefix of 4+ characters; default the latest run of the current change set, else the latest run",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "description": "With changes: the checks step that fixes them",
            "type": "string"
          },
          "daemon": {
            "description": "With queued: the daemon's process, as host:pid; empty when no daemon runs and the run waits for one",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was journalled or run",
            "type": "boolean"
          },
          "queued": {
            "description": "True when the sign-off was journalled and the run's continuation queued for the daemon, which drives it headless, rather than driven in this process; absent otherwise",
            "type": "boolean"
          },
          "run": {
            "additionalProperties": false,
            "description": "The run after it was continued; in a dry run, or when queued, as it stands. The command exits 1 when the run failed",
            "properties": {
              "accepts": {
                "description": "The change sets an autonomous run accepted or rejected in the owner's place under rule autonomous, in order; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "When it was journalled, RFC 3339 UTC",
                      "type": "string"
                    },
                    "change": {
                      "description": "The change set accepted or rejected",
                      "type": "string"
                    },
                    "entry": {
                      "description": "The model log entry ID of the accept or reject",
                      "type": "string"
                    },
                    "verb": {
                      "description": "accepted or rejected",
                      "type": "string"
                    }
                  },
                  "required": [
                    "at",
                    "change",
                    "entry",
                    "verb"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "amendments": {
                "description": "The amendments made to its agent steps' briefs or plans, in order",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "actor": {
                      "description": "The sender's actor handle",
                      "type": "string"
                    },
                    "at": {
                      "description": "When it was amended, RFC 3339 UTC",
                      "type": "string"
                    },
                    "file": {
                      "description": "The amended file, relative to the run's worktree",
                      "type": "string"
                    },
                    "session": {
                      "description": "The step's session, which was sent a pointer to the file",
                      "type": "string"
                    },
                    "step": {
                      "description": "The amended step",
                      "type": "string"
                    }
                  },
                  "required": [
                    "actor",
                    "at",
                    "file",
                    "session",
                    "step"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "autonomous": {
                "description": "True for a run started with --autonomous: it goes on without the owner; absent otherwise",
                "type": "boolean"
              },
              "blocked": {
                "additionalProperties": false,
                "description": "What the run waits on while its agent step's session is blocked; absent otherwise",
                "properties": {
                  "kind": {
                    "description": "What kind of block: permission, question or auth; empty when the session gave none",
                    "type": "string"
                  },
                  "question": {
                    "description": "What the session asks the owner, as it reported it; empty when it gave nothing",
                    "type": "string"
                  },
                  "session": {
                    "description": "The step's session",
                    "type": "string"
                  },
                  "step": {
                    "description": "The agent step that waits",
                    "type": "string"
                  },
                  "tab": {
                    "additionalProperties": false,
                    "description": "The terminal tab the session runs in, where the owner answers",
                    "properties": {
                      "block": {
                        "description": "The Rex block running the agent; empty until the tab opened",
                        "type": "string"
                      },
                      "session": {
                        "description": "The Rex session; empty when Rex chose it",
                        "type": "string"
                      },
                      "title": {
                        "description": "The tab title",
                        "type": "string"
                      },
                      "window": {
                        "description": "The Rex window ID; empty until the tab opened",
                        "type": "string"
                      }
                    },
                    "required": [
                      "block",
                      "session",
                      "title",
                      "window"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "session",
                  "step",
                  "tab"
                ],
                "type": "object"
              },
              "change": {
                "description": "The change set it runs on",
                "type": "string"
              },
              "checks": {
                "description": "The checks its checks steps ran, in the order they began, each with its cycles and outcome; absent when there were none",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "check": {
                      "description": "The check's name",
                      "type": "string"
                    },
                    "cycles": {
                      "description": "The cycles it ran in, in order",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "at": {
                            "description": "When the check's outcome in the cycle was journalled, RFC 3339 UTC",
                            "type": "string"
                          },
                          "cycle": {
                            "description": "The cycle, from 1",
                            "type": "integer"
                          },
                          "decisions": {
                            "description": "For a fresh cycle past the cap, the Decisions (handles) answering the questions the cycle before raised; absent otherwise",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "detail": {
                            "description": "Why the check ended the cycle as it did",
                            "type": "string"
                          },
                          "kind": {
                            "description": "answered for a fresh cycle past the cap, owner for the cycle fixing the owner's request for changes; absent for a cycle within the cap",
                            "type": "string"
                          },
                          "outcome": {
                            "description": "passed or failed; empty while the cycle is open for the check",
                            "type": "string"
                          },
                          "sessions": {
                            "description": "The check's sessions in the cycle, in the order they started",
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "at": {
                                  "description": "When it started, RFC 3339 UTC",
                                  "type": "string"
                                },
                                "detail": {
                                  "description": "Why it was judged so: the session's exit, or that its agent said done",
                                  "type": "string"
                                },
                                "model": {
                                  "description": "The model it runs; empty for the agent's default",
                                  "type": "string"
                                },
                                "outcome": {
                                  "description": "pass or fail once its work was judged; empty while it runs",
                                  "type": "string"
                                },
                                "role": {
                                  "description": "check",
                                  "type": "string"
                                },
                                "session": {
                                  "description": "The session's ID",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "at",
                                "role",
                                "session"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "cycle",
                          "sessions"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "open_cycle": {
                      "description": "The cycle that is open, when its latest cycle is open after an earlier one was judged; absent otherwise",
                      "type": "integer"
                    },
                    "outcome": {
                      "description": "passed or failed: its latest cycle's outcome; empty while that cycle is open, even when an earlier cycle was judged",
                      "type": "string"
                    },
                    "prior_cycle": {
                      "description": "The newest earlier cycle that was judged, when open_cycle is set",
                      "type": "integer"
                    },
                    "prior_outcome": {
                      "description": "That cycle's outcome, passed or failed, when open_cycle is set",
                      "type": "string"
                    },
                    "questions": {
                      "description": "The questions it raised when it still failed with no fix cycle left, in order; absent when none",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "cycle": {
                            "description": "The cycle that ended with no fix cycle left",
                            "type": "integer"
                          },
                          "finding": {
                            "description": "The surviving confirmed finding it is about; empty for one on the check's failure itself",
                            "type": "string"
                          },
                          "leaf": {
                            "description": "The leaf node the finding names, which the question blocks; empty for a question in the change set at large",
                            "type": "string"
                          },
                          "leaf_handle": {
                            "description": "That leaf's handle",
                            "type": "string"
                          },
                          "question": {
                            "description": "The question node's ID",
                            "type": "string"
                          },
                          "question_handle": {
                            "description": "The question node's handle",
                            "type": "string"
                          }
                        },
                        "required": [
