        "properties": {
          "behind": {
            "description": "True if origin's main had commits the branch did not",
            "type": "boolean"
          },
          "branch": {
            "description": "The change set's branch",
            "type": "string"
          },
          "change": {
            "description": "The change set",
            "type": "string"
          },
          "commit": {
            "description": "The commit of that rendering; empty if it changed nothing",
            "type": "string"
          },
          "conflicts": {
            "description": "The files that conflicted when the rebase stopped on a conflict outside the rendered files; the rebase was aborted",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detail": {
            "description": "Why the rebase stopped; the command exits 1 then",
            "type": "string"
          },
          "onto": {
            "description": "The commit of origin's main the branch was compared with",
            "type": "string"
          },
          "pushed": {
            "description": "The rebased head pushed to the PR branch",
            "type": "string"
          },
          "question": {
            "description": "The handle of the question raised about those conflicts",
            "type": "string"
          },
          "question_change": {
            "description": "The change set the question was written into: the change set itself, or a record change set when it had already landed",
            "type": "string"
          },
          "rebased": {
            "description": "True if the branch was rebased onto origin's main",
            "type": "boolean"
          },
          "rendered": {
            "description": "The rendered files written or removed by rendering after the rebase",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "settled": {
            "description": "The rendered files whose conflicts were settled by rendering again",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "behind",
          "branch",
          "change",
          "onto",
          "rebased"
        ],
        "type": "object"
      },
      "summary": "Rebase a change set's branch onto origin's main when main has moved past it, settling rendered-only conflicts by rendering again, and push it",
      "write": true
    },
