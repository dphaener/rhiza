# describe --json must match the golden below byte for byte: it is the
# public contract of every operation (names, summaries, request and response
# schemas). When a request or response type changes on purpose, regenerate
# it and review the diff:
#
#   go test ./cmd/rhiza -run TestScripts/describe-golden -update
#
# or by hand: go build -o $TMPDIR/rhiza-x ./cmd/rhiza &&
# $TMPDIR/rhiza-x describe --json, pasted below the golden's header.

exec rhiza describe --json
cmp stdout describe.golden.json
! stderr .

-- describe.golden.json --
{
  "operations": [
    {
      "name": "accept",
      "request": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Why",
            "type": "string"
          },
          "rule": {
            "description": "The rule the decision is made under; default owner",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set moved",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "cleared_current": {
            "description": "True if the move ended the current change set and cleared it",
            "type": "boolean"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "from": {
            "description": "The state before the move",
            "type": "string"
          },
          "reason": {
            "description": "The reason of an accept or reject",
            "type": "string"
          },
          "rule": {
            "description": "The rule of an accept or reject",
            "type": "string"
          },
          "to": {
            "description": "The state after the move",
            "type": "string"
          }
        },
        "required": [
          "change_set",
          "from",
          "to"
        ],
        "type": "object"
      },
      "summary": "Accept a proposed change set",
      "write": true
    },
    {
      "name": "add",
      "request": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Place it just after this sibling; default after the last one",
            "type": "string"
          },
          "before": {
            "description": "Place it just before this sibling",
            "type": "string"
          },
          "fields": {
            "description": "A text field, name=text",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "handle": {
            "description": "The node's handle: lower-case words joined by single dashes, unique among live nodes",
            "type": "string"
          },
          "json_fields": {
            "description": "A JSON field, name=<json>",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "description": "The node's kind",
            "enum": [
              "intent",
              "capability",
              "constraint",
              "decision",
              "question",
              "evidence",
              "source",
              "actor",
              "anchor",
              "note"
            ],
            "type": "string"
          },
          "parent": {
            "description": "The parent node (capabilities and intents only, same kind); default a root",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "kind"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set written to (with --record, the new record change set)",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "drop": {
            "description": "Dry run only: the op IDs the entry would drop",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links the write created or retired, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "description": "The nodes the write created or changed, sorted; link endpoints are not included",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "Dry run only: the ops the entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "record": {
            "description": "True if the write opened and landed a record change set",
            "type": "boolean"
          }
        },
        "required": [
          "change_set",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Add a node",
      "write": true
    },
    {
      "name": "anchor.refresh",
      "request": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "description": "The anchor: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
            "type": "string"
          }
        },
        "required": [
          "anchor"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "description": "The anchor",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "change_set": {
            "description": "The change set written to; absent when unchanged",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent when unchanged and in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "fingerprint": {
            "description": "The fingerprint of the working tree",
            "type": "string"
          },
          "previous": {
            "description": "The fingerprint the anchor held; absent if it had none",
            "type": "string"
          },
          "unchanged": {
            "description": "True if the fingerprint already matched the working tree, so nothing was written",
            "type": "boolean"
          }
        },
        "required": [
          "anchor",
          "fingerprint",
          "unchanged"
        ],
        "type": "object"
      },
      "summary": "Re-fingerprint an anchor from the working tree into the current change set",
      "write": true
    },
    {
      "input": {
        "additionalProperties": false,
        "properties": {
          "writes": {
            "description": "The writes, applied in order",
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "after": {
                      "description": "Place it just after this sibling; default after the last one",
                      "type": "string"
                    },
                    "before": {
                      "description": "Place it just before this sibling",
                      "type": "string"
                    },
                    "fields": {
                      "description": "A text field, name=text",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "The node's handle: lower-case words joined by single dashes, unique among live nodes",
                      "type": "string"
                    },
                    "json_fields": {
                      "description": "A JSON field, name=<json>",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "kind": {
                      "description": "The node's kind",
                      "enum": [
                        "intent",
                        "capability",
                        "constraint",
                        "decision",
                        "question",
                        "evidence",
                        "source",
                        "actor",
                        "anchor",
                        "note"
                      ],
                      "type": "string"
                    },
                    "op": {
                      "const": "add",
                      "description": "The operation this item is a request of"
                    },
                    "parent": {
                      "description": "The parent node (capabilities and intents only, same kind); default a root",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle",
                    "kind",
                    "op"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "description": "Set a text field, name=text",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "A new handle",
                      "type": "string"
                    },
                    "json_fields": {
                      "description": "Set a JSON field, name=<json>",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "op": {
                      "const": "set",
                      "description": "The operation this item is a request of"
                    },
                    "rebase": {
                      "description": "When the change set already updates the node, move that update onto the node's landed version; refused unless this call sets or unsets every field the update writes",
                      "type": "boolean"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "unset": {
                      "description": "Remove a field by name",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "after": {
                      "description": "Place it just after this sibling; default after the last one",
                      "type": "string"
                    },
                    "before": {
                      "description": "Place it just before this sibling",
                      "type": "string"
                    },
                    "op": {
                      "const": "mv",
                      "description": "The operation this item is a request of"
                    },
                    "parent": {
                      "description": "The new parent, of the same kind",
                      "type": "string"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "root": {
                      "description": "Make it a root instead",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "retire",
                      "description": "The operation this item is a request of"
                    },
                    "reason": {
                      "description": "Why it is retired",
                      "type": "string"
                    },
                    "ref": {
                      "description": "The node: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "reason",
                    "ref"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "decision": {
                      "description": "The decision node behind an exempts link (exempts only, required there)",
                      "type": "string"
                    },
                    "from": {
                      "description": "The node or change set the link starts at: an ID, a unique ID prefix of 4+ characters, or a live node's handle",
                      "type": "string"
                    },
                    "note": {
                      "description": "Why; required on relates-to and exempts",
                      "type": "string"
                    },
                    "op": {
                      "const": "link",
                      "description": "The operation this item is a request of"
                    },
                    "to": {
                      "description": "The node or change set the link ends at",
                      "type": "string"
                    },
                    "type": {
                      "description": "What the link says",
                      "enum": [
                        "serves",
                        "constrains",
                        "exempts",
                        "depends-on",
                        "relates-to",
                        "decided-by",
                        "answers",
                        "blocks",
                        "supersedes",
                        "derived-from",
                        "discovered-from",
                        "implements",
                        "verifies",
                        "observes",
                        "discusses"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "op",
                    "to",
                    "type"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "unlink",
                      "description": "The operation this item is a request of"
                    },
                    "ref": {
                      "description": "The link (a full ID or a unique prefix of 4+ characters), or the node it starts at when type and to follow",
                      "type": "string"
                    },
                    "to": {
                      "description": "The node the link ends at, with type",
                      "type": "string"
                    },
                    "type": {
                      "description": "The link type, with to",
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "ref"
                  ],
                  "type": "object"
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "writes"
        ],
        "type": "object"
      },
      "name": "apply",
      "request": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "A JSON file of writes, or - for stdin (see the input schema); refs may name nodes added by earlier items",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The change set written to (with --record, the new record change set)",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "drop": {
            "description": "Dry run only: the op IDs the entry would drop",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The ops entry written; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links the write created or retired, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "description": "The nodes the write created or changed, sorted; link endpoints are not included",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "Dry run only: the ops the entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "record": {
            "description": "True if the write opened and landed a record change set",
            "type": "boolean"
          }
        },
        "required": [
          "change_set",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Apply many writes as one entry: a JSON file {\"writes\":[{\"op\":\"add\",...},...]} whose items are add, set, mv, retire, link or unlink requests plus \"op\"",
      "write": true
    },
    {
      "name": "carve",
      "request": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "The change set to carve from: an ID or a unique prefix of 4+ characters",
            "type": "string"
          },
          "nodes": {
            "description": "The nodes to move, at least one: IDs, unique ID prefixes of 4+ characters, or handles, as the source sees them; each must be created in the source",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to": {
            "description": "The change set to carve into: an ID or a unique prefix of 4+ characters",
            "type": "string"
          },
          "with_children": {
            "description": "Also move every node created in the source below a named one, transitively",
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "nodes",
          "to"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "depends_on": {
            "description": "The depends-on link added from the source to the target, if one was",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "dropped": {
            "description": "The op IDs dropped from the source, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "links": {
            "description": "The links moved, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "next": {
            "description": "A command that would help: withdrawing the source, when the carve left it with no ops",
            "type": "string"
          },
          "nodes": {
            "description": "The nodes moved, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "description": "The new op IDs in the target, in order",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "description": "The change set carved from",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "source_entry": {
            "description": "The entry written to the source, dropping the moved ops; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "source_ops": {
            "description": "Dry run only: the ops the source's entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          },
          "target": {
            "description": "The change set carved into",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_entry": {
            "description": "The entry written to the target, re-creating them; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_ops": {
            "description": "Dry run only: the ops the target's entry would carry, as canonical op JSON",
            "items": {},
            "type": "array"
          }
        },
        "required": [
          "dropped",
          "nodes",
          "ops",
          "source",
          "target"
        ],
        "type": "object"
      },
      "summary": "Move nodes from one change set to another, keeping their IDs",
      "write": true
    },
    {
      "name": "change.diff",
      "request": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "description": "The change set: a full ID or a unique prefix of 4+ characters; default --change, else the current one",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The change set's ID",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "links": {
            "description": "The links it adds and retires, in change set order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "description": "Whether the change set adds or retires the link",
                  "enum": [
                    "added",
                    "retired"
                  ],
                  "type": "string"
                },
                "from": {
                  "description": "The link's source",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "from_handle": {
                  "description": "The source's handle, when it is a node",
                  "type": "string"
                },
                "link": {
                  "description": "The link's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "note": {
                  "description": "The link's note",
                  "type": "string"
                },
                "to": {
                  "description": "The link's target",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "to_handle": {
                  "description": "The target's handle, when it is a node",
                  "type": "string"
                },
                "type": {
                  "description": "The link type",
                  "type": "string"
                }
              },
              "required": [
                "action",
                "from",
                "link",
                "to",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nodes": {
            "description": "One entry per node the change set writes, in the order it first writes them",
            "items": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "description": "What the change set does to the node",
                  "enum": [
                    "created",
                    "updated",
                    "moved",
                    "retired"
                  ],
                  "type": "string"
                },
                "changes": {
                  "description": "Each aspect that differs; handle, parent and key are named @handle, @parent and @key",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "description": "The field's name",
                        "type": "string"
                      },
                      "new": {
                        "description": "The value after the change set; absent when the field ends unset",
                        "type": "string"
                      },
                      "old": {
                        "description": "The value at the first op's base; absent for a created node or a field not set there",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "handle": {
                  "description": "The node's handle after the change set",
                  "type": "string"
                },
                "kind": {
                  "description": "The node's kind",
                  "type": "string"
                },
                "node": {
                  "description": "The node's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "reason": {
                  "description": "Why it is retired, for a retire",
                  "type": "string"
                }
              },
              "required": [
                "action",
                "changes",
                "handle",
                "kind",
                "node"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "links",
          "nodes"
        ],
        "type": "object"
      },
      "summary": "Show a change set's changes: per node, each field before and after",
      "write": false
    },
    {
      "name": "change.ls",
      "request": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_sets": {
            "description": "Every change set, sorted by ID",
            "items": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "description": "Whether it is the current change set",
                  "type": "boolean"
                },
                "id": {
                  "description": "The change set's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "intent": {
                  "description": "The change set's intent",
                  "type": "string"
                },
                "kind": {
                  "description": "intention or record; empty without a valid open",
                  "type": "string"
                },
                "state": {
                  "description": "The lifecycle state; empty without a valid open",
                  "type": "string"
                },
                "title": {
                  "description": "The change set's title, else its intent's first clause",
                  "type": "string"
                }
              },
              "required": [
                "current",
                "id",
                "intent",
                "kind",
                "state",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "problems": {
            "description": "Everything wrong with the log and its change sets",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "change_sets",
          "problems"
        ],
        "type": "object"
      },
      "summary": "List every change set with its kind, state and intent",
      "write": false
    },
    {
      "name": "change.new",
      "request": {
        "additionalProperties": false,
        "properties": {
          "intent": {
            "description": "What the change set is for, in a sentence",
            "type": "string"
          },
          "kind": {
            "description": "intention (reviewed before it lands) or record (lands as is); default intention",
            "enum": [
              "intention",
              "record"
            ],
            "type": "string"
          },
          "ref": {
            "description": "An opaque external reference, such as an issue URL, at most 2048 bytes; Rhiza never interprets it",
            "type": "string"
          },
          "sources": {
            "description": "A source node the change set comes from: an ID, ID prefix or handle",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "A short name for the change set, one line of at most 30 characters; default the intent's first clause",
            "type": "string"
          }
        },
        "required": [
          "intent"
        ],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "description": "Who opened it; absent in a dry run before any actor is recorded",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "change_set": {
            "description": "The new change set's ID",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "dry_run": {
            "description": "True if nothing was written",
            "type": "boolean"
          },
          "entry": {
            "description": "The open entry's ID; absent in a dry run",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "intent": {
            "description": "The change set's intent",
            "type": "string"
          },
          "kind": {
            "description": "intention or record",
            "type": "string"
          },
          "ref": {
            "description": "The change set's opaque external reference, if any",
            "type": "string"
          },
          "sources": {
            "description": "The source node IDs, sorted",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "The change set's title, else its intent's first clause",
            "type": "string"
          }
        },
        "required": [
          "change_set",
          "intent",
          "kind",
          "title"
        ],
        "type": "object"
      },
      "summary": "Open a change set and make it current",
      "write": true
    },
    {
      "name": "change.show",
      "request": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "description": "The change set: a full ID or a unique prefix of 4+ characters; default --change, else the current one",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "applied": {
            "description": "Every folded entry, in causal order",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "changes": {
            "additionalProperties": false,
            "description": "The change set's field-level diff, as change.diff reports it",
            "properties": {
              "id": {
                "description": "The change set's ID",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "links": {
                "description": "The links it adds and retires, in change set order",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "description": "Whether the change set adds or retires the link",
                      "enum": [
                        "added",
                        "retired"
                      ],
                      "type": "string"
                    },
                    "from": {
                      "description": "The link's source",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "from_handle": {
                      "description": "The source's handle, when it is a node",
                      "type": "string"
                    },
                    "link": {
                      "description": "The link's ID",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "note": {
                      "description": "The link's note",
                      "type": "string"
                    },
                    "to": {
                      "description": "The link's target",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "to_handle": {
                      "description": "The target's handle, when it is a node",
                      "type": "string"
                    },
                    "type": {
                      "description": "The link type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "action",
                    "from",
                    "link",
                    "to",
                    "type"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "nodes": {
                "description": "One entry per node the change set writes, in the order it first writes them",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "description": "What the change set does to the node",
                      "enum": [
                        "created",
                        "updated",
                        "moved",
                        "retired"
                      ],
                      "type": "string"
                    },
                    "changes": {
                      "description": "Each aspect that differs; handle, parent and key are named @handle, @parent and @key",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "description": "The field's name",
                            "type": "string"
                          },
                          "new": {
                            "description": "The value after the change set; absent when the field ends unset",
                            "type": "string"
                          },
                          "old": {
                            "description": "The value at the first op's base; absent for a created node or a field not set there",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "handle": {
                      "description": "The node's handle after the change set",
                      "type": "string"
                    },
                    "kind": {
                      "description": "The node's kind",
                      "type": "string"
                    },
                    "node": {
                      "description": "The node's ID",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "reason": {
                      "description": "Why it is retired, for a retire",
                      "type": "string"
                    }
                  },
                  "required": [
                    "action",
                    "changes",
                    "handle",
                    "kind",
                    "node"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "links",
              "nodes"
            ],
            "type": "object"
          },
          "current": {
            "description": "Whether it is the current change set",
            "type": "boolean"
          },
          "decided": {
            "additionalProperties": false,
            "description": "The applied accept or reject, if any",
            "properties": {
              "actor": {
                "description": "Who decided",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "entry": {
                "description": "The accept or reject entry",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "for": {
                "description": "Whom they decided for",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "type": "string"
              },
              "reason": {
                "description": "Why",
                "type": "string"
              },
              "rule": {
                "description": "The rule the decision was made under",
                "type": "string"
              },
              "type": {
                "description": "accept or reject",
                "type": "string"
              }
            },
            "required": [
              "actor",
              "entry",
              "for",
              "rule",
              "type"
            ],
            "type": "object"
          },
          "heads": {
            "description": "The entries a new entry would follow",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "history": {
            "description": "The lifecycle entries that applied, in causal order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "actor": {
                  "description": "Who wrote it",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "at": {
                  "description": "When it was written (RFC 3339, UTC)",
                  "type": "string"
                },
                "entry": {
                  "description": "The lifecycle entry",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "type": {
                  "description": "propose, accept, reject, withdraw, supersede, land or reopen",
                  "type": "string"
                }
              },
              "required": [
                "actor",
                "at",
                "entry",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "description": "The change set's ID",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "intent": {
            "description": "The change set's intent",
            "type": "string"
          },
          "kind": {
            "description": "intention or record; empty without a valid open",
            "type": "string"
          },
          "leaves": {
            "description": "The live capabilities it adds that have no live child capability, in build order: each after every leaf it depends on, ties in tree order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "description": "The capability's handle",
                  "type": "string"
                },
                "id": {
                  "description": "The capability's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "needs": {
                  "description": "The handles of every live capability it depends on, in or out of the change set, sorted",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "handle",
                "id",
                "needs"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "notes": {
            "description": "The live notes that discuss it, oldest first",
            "items": {
              "additionalProperties": false,
              "properties": {
                "actor": {
                  "description": "Who wrote it: the actor's handle (its ID when it has none)",
                  "type": "string"
                },
                "at": {
                  "description": "When it was written (RFC 3339, UTC)",
                  "type": "string"
                },
                "id": {
                  "description": "The note's ID",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "op": {
                  "description": "The operation of the change set the note is about, if it names one",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "text": {
                  "description": "The note",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "ops": {
            "description": "The current operations, as canonical op JSON, in change set order",
            "items": {},
            "type": "array"
          },
          "problems": {
            "description": "Everything wrong with its entries",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ref": {
            "description": "The change set's opaque external reference, if any: untrusted text",
            "type": "string"
          },
          "serves": {
            "description": "The intents its live serves links point to, in its write view, by link ID; empty when it serves none yet",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "sources": {
            "description": "The source node IDs",
            "items": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "description": "The lifecycle state; empty without a valid open",
            "type": "string"
          },
          "superseded_by": {
            "description": "The change set that superseded it, if any",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": {
            "description": "The change set's title, else its intent's first clause",
            "type": "string"
          }
        },
        "required": [
          "applied",
          "changes",
          "current",
          "heads",
          "history",
          "id",
          "intent",
          "kind",
          "leaves",
          "notes",
          "ops",
          "problems",
          "serves",
          "sources",
          "state",
          "title"
        ],
        "type": "object"
      },
      "summary": "Show a change set: its intent, state, operations and decision",
      "write": false
    },
    {
      "name": "change.use",
      "request": {
        "additionalProperties": false,
        "properties": {
          "none": {
            "description": "Clear the current change set instead",
            "type": "boolean"
          },
          "ref": {
            "description": "The change set: a full ID or a unique prefix of 4+ characters",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "change_set": {
            "description": "The current change set; absent when cleared",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "dry_run": {
            "description": "True if the current change set was left unchanged",
            "type": "boolean"
          },
          "intent": {
            "description": "Its intent",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "summary": "Set or clear the current change set",
      "write": false
    },
    {
      "name": "check",
      "request": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "The git revision the log may only have grown since; default the merge-base of HEAD with origin/HEAD, origin/main or main",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "The git revision the append-only rule compared against; empty when it was skipped",
            "type": "string"
          },
          "findings": {
            "description": "Every finding, sorted by rule (log, fold, model, in-flight, link, depends-on, evidence-actor, unclaimed, anchor, text-ref, render, append-only), then path and IDs",
            "items": {
              "additionalProperties": false,
              "properties": {
                "change_set": {
                  "description": "The change set's ID",
                  "type": "string"
                },
                "entry": {
                  "description": "The entry's ID",
                  "type": "string"
                },
                "link": {
                  "description": "The link's ID",
                  "type": "string"
                },
                "message": {
                  "description": "What is wrong",
                  "type": "string"
                },
                "next": {
                  "description": "A command that would help",
                  "type": "string"
                },
                "op": {
                  "description": "The operation's ID",
                  "type": "string"
                },
                "path": {
                  "description": "The file, relative to the project root",
                  "type": "string"
                },
                "rule": {
                  "description": "The rule that found it",
                  "enum": [
                    "log",
                    "fold",
                    "model",
                    "in-flight",
                    "link",
                    "depends-on",
                    "evidence-actor",
                    "unclaimed",
                    "anchor",
                    "text-ref",
                    "render",
                    "append-only"
                  ],
                  "type": "string"
                },
                "severity": {
                  "description": "fail makes the check fail; warn does not",
                  "enum": [
                    "fail",
                    "warn"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "message",
                "rule",
                "severity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "merge_base_of": {
            "description": "The ref whose merge-base with HEAD is the default base; absent with --base",
            "type": "string"
          },
          "ok": {
            "description": "True when no finding fails",
            "type": "boolean"
          },
          "skipped": {
            "description": "Why the append-only rule was skipped, if it was",
            "type": "string"
          }
        },
        "required": [
          "base",
          "findings",
          "ok"
        ],
        "type": "object"
      },
      "summary": "Check the log, the links and the rendered markdown",
      "write": false
    },
    {
      "name": "ci.install",
      "request": {
        "additionalProperties": false,
        "properties": {
          "force": {
