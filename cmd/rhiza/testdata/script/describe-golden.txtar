                "type": "string"
              },
              "ref": {
                "description": "The request's opaque external reference, if any: untrusted text",
                "type": "string"
              },
              "run": {
                "description": "Its plan run; absent while queued",
                "type": "string"
              },
              "state": {
                "description": "queued, planning (its plan run started), planned (its run succeeded) or failed (its run failed)",
