            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "findings"
        ],
        "type": "object"
      },
      "name": "inbox.request-changes",
      "request": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "Look in every registered project, from anywhere under the root",
            "type": "boolean"
          },
