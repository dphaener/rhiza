# A ship-change run whose CI fails with no failing test (an infra failure)
# goes from ci-triage to wait-ci-rerun instead of ending, waits while the red
# head's check runs are unchanged, reruns the failed jobs itself once its
# backoff is due, and passes pr-green on once that rerun (a new job) turns
# the head green.
#
# The repo's .rhiza/workflows/ship-change.toml replaces the built-in by name
# with its middle (the built-in's own steps; its wait carries --rerun-infra,
# which internal/workflow's tests check on the built-in). The fake gh's check
# is Actions run 42 and its logs name no failing test. wait-pr's ship check
# spends its one rerun on it, still red (the outage); only the second rerun,
# the wait's own `gh run rerun 42 --failed`, turns it green: the script never
# reruns. The test clock is fixed, so bin/rhiza (which runs the real rhiza
# further down PATH) moves the red_at pr-green recorded an hour back before
# each of the wait's polls until it has rerun: its first rerun (due 5m after)
# is due on its first poll. It logs those polls to gh.log, so the second
# rerun is seen to come from one. ship check reads the state before it calls
# gh, so the fake gh cannot do this itself.

chmod 755 bin/gh
chmod 755 bin/rhiza
env PATH=$WORK/bin:$PATH
exec git init -q --bare origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/ship-change.toml .rhiza/workflows/ship-change.toml
exec rhiza change new 'Ship it' --title 'Ship it' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git push -q origin main:cs/ship-it

exec rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual
stdout 'succeeded$'
exec rhiza run status
stdout '^- pr-green \(visit 1\): fail, then conflict-triage'
stdout '^- ci-triage \(visit 1\): fail, then wait-ci-rerun'
stdout '^- wait-ci-rerun \(visit 1\): pass, then pr-green'
stdout '^- pr-green \(visit 2\): pass, then signoff'
stdout '^- signoff \(visit 1\): pass, then end'
grep -count=2 '^run rerun 42 --failed$' $WORK/gh.log
grep '\nrhiza ship check --settled --changed --rerun-infra\npr view cs/ship-it [^\n]*\nrun rerun 42 --failed\n' $WORK/gh.log
fold-ok

-- ship-change.toml --
name = "ship-change"
start = "wait-pr"

[step.wait-pr]
kind = "wait"
until = "rhiza ship check --settled"
timeout = "30s"
interval = "50ms"
on.pass = "pr-green"

[step.pr-green]
kind = "command"
run = "rhiza ship check"
max_visits = 3
on.pass = "signoff"
on.fail = "conflict-triage"

[step.conflict-triage]
kind = "command"
run = "rhiza ship check --conflicts"
on.pass = "done"
on.fail = "ci-triage"

[step.ci-triage]
kind = "command"
run = "rhiza ship check --test-failures"
on.pass = "done"
on.fail = "wait-ci-rerun"

[step.wait-ci-rerun]
kind = "wait"
until = "rhiza ship check --settled --changed --rerun-infra"
timeout = "30s"
interval = "50ms"
max_visits = 3
on.pass = "pr-green"

[step.signoff]
kind = "command"
run = "true"
on.pass = "done"
-- bin/gh --
#!/bin/sh
echo "$@" >> "$WORK/gh.log"
case "$1 $2" in
"pr view")
	n=$(grep -c '^run rerun' "$WORK/gh.log")
	head=$(git -C "$WORK/origin.git" rev-parse "refs/heads/$3")
	# Red on job 9, still red on rerun 1's job 11, green on rerun 2's job 12.
	case "$n" in
	0) concl=FAILURE job=9 ;;
	1) concl=FAILURE job=11 ;;
	*) concl=SUCCESS job=12 ;;
	esac
	test='{"name":"test","status":"COMPLETED","conclusion":"'$concl'","detailsUrl":"https://github.test/o/r/actions/runs/42/job/'$job'"}'
	printf '{"body":"Change set %s","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[%s]}\n' "$RHIZA_CHANGE" "$head" "$test"
	;;
"run view")
	printf 'test\tRun\tError: The runner lost communication with the server.\n'
	;;
"run rerun")
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
-- bin/rhiza --
#!/bin/sh
self=$(cd "$(dirname "$0")" && pwd)
real=$(PATH=$(echo "$PATH" | tr : '\n' | grep -vx "$self" | paste -sd: -) command -v rhiza)
case " $* " in
*" --rerun-infra "*)
	echo "rhiza $*" >> "$WORK/gh.log"
	st="$WORK/repo/.git/rhiza/ship/$RHIZA_CHANGE.json"
	if ! grep -qs '"infra_reruns"' "$st"; then
		sed -i 's/"red_at": "[^"]*"/"red_at": "2000-01-01T00:00:00Z"/' "$st"
	fi
	;;
esac
exec "$real" "$@"
