# The daemon opens every tab in the Rex session rhiza-<repo>, <repo> being the
# main checkout's folder: it creates the session when `rex session ls` lacks
# it, creates none when present, and uses it whatever REX_SESSION says. Rex is
# faked: `session ls` reads $WORK/sessions.json, everything is logged.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_DETACH_LOG=$WORK/detach.log
env REX_SESSION=
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec rhiza add intent m --field milestone=1 --record
exec git add -A
exec git commit -qm init
exec rhiza change new Built --title Built
exec rhiza add capability built-leaf
exec rhiza link 01M5PWGMARA1WR6BD0MEF4Y76P serves m
exec rhiza propose
exec rhiza accept --reason ok

# Missing: created once, and the started run's tab carries -s rhiza-repo.
exec rhiza daemon --permission-mode manual --once
exec sh -c 'grep -c "^rex session new rhiza-repo " $WORK/rex.log'
stdout '^1$'
exec sh -c 'grep -Ec "^REX_SESSION=rhiza-repo RHIZA_RUN_LOG=[0-9A-Z]{26}\.start-1\.log rhiza run start " $WORK/detach.log'
stdout '^1$'
exec sh -c 'grep -vc "^REX_SESSION=rhiza-repo " $WORK/detach.log || true'
stdout '^0$'

# Present: none created, tabs still open in it.
cp $WORK/present.json $WORK/sessions.json
rm $WORK/rex.log $WORK/detach.log
exec rhiza daemon --permission-mode manual --once
exec sh -c 'grep -c "^rex session new" $WORK/rex.log || true'
stdout '^0$'
exec sh -c 'grep -Ec "^REX_SESSION=rhiza-repo (RHIZA_RUN_LOG=[^ ]* )?rhiza " $WORK/detach.log'
! stdout '^0$'
exec sh -c 'grep -vc "^REX_SESSION=rhiza-repo " $WORK/detach.log || true'
stdout '^0$'

# Another REX_SESSION does not move the tabs.
rm $WORK/rex.log $WORK/detach.log
env REX_SESSION=session:other
exec rhiza daemon --permission-mode manual --once
exec sh -c 'grep -Ec "^REX_SESSION=rhiza-repo (RHIZA_RUN_LOG=[^ ]* )?rhiza " $WORK/detach.log'
! stdout '^0$'
exec sh -c 'grep -c "session:other" $WORK/detach.log || true'
stdout '^0$'
-- present.json --
{"sessions":[{"session_id":"session:1","label":"rhiza-repo"}]}
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
if [ "$1 $2" = "session ls" ]; then
  if [ -f "$WORK/sessions.json" ]; then cat "$WORK/sessions.json"; else echo '{"sessions":[]}'; fi
  exit 0
fi
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
