# link creates a link between two live nodes, or with a change set at
# either end; unlink retires one, or drops it if the same change set
# created it. Link writes report links, not nodes.

rhiza init
rhiza change new Shape
rhiza add capability store
rhiza add capability log
rhiza add decision d1
rhiza add constraint c1
rhiza add intent goal

rhiza link log depends-on store
stdout '^Wrote entry [0-9A-Z]{26} to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^- link [0-9A-Z]{26}$'
! stdout '^- node'
rhiza link log relates-to store --note 'Same data' --json
stdout '"links": \[\n    "[0-9A-Z]{26}"\n  \]'
stdout '"nodes": \[\]'
rhiza link log exempts c1 --note Prototype --decision d1
rhiza change show
stdout -count=3 '^- link.create '

# A dry run writes nothing.
rhiza link store serves goal --dry-run
stdout '"op":"link.create"'
stdout '"type":"serves"'
rhiza change show
stdout -count=3 '^- link.create '

# The same live link again is a conflict, exit 3.
! rhiza link log depends-on store --json
stdout '"code": "conflict"'
stdout 'already exists'

# Usage errors, exit 2.
! rhiza link log bogus store
stderr 'unknown link type'
! rhiza link log relates-to store
stderr 'needs --note'
! rhiza link store exempts c1 --note x
stderr 'needs --decision'
! rhiza link store exempts c1 --note x --decision log
stderr 'not a decision'
! rhiza link log serves store --decision d1
stderr 'only an exempts link'
! rhiza link 01M5PWG serves store --json
stdout '"code": "usage"'

# A type that does not go from the from-end's kind to the to-end's kind is
# a usage error naming both kinds, and writes nothing, in every form.
! rhiza link store serves log --json
stdout '"code": "usage"'
stdout 'link type \\"serves\\" does not go from capability to capability'
! rhiza link store serves log
stderr 'link type "serves" does not go from capability to capability'
! rhiza link store serves log --dry-run
stderr 'link type "serves" does not go from capability to capability'
rhiza change show
stdout -count=3 '^- link.create '

# Unknown nodes are not_found, exit 4.
! rhiza link nosuch serves store --json
stdout '"code": "not_found"'

# unlink of a link added here drops it.
rhiza unlink log depends-on store
stdout '^- link [0-9A-Z]{26}$'
rhiza change show
stdout -count=2 '^- link.create '
! rhiza unlink log depends-on store --json
stdout '"code": "not_found"'
! rhiza unlink log depends-on
stderr 'unlink takes a link'

# unlink of a landed link writes a link.retire.
rhiza add capability a --record
rhiza add intent b --record
rhiza add capability a2 --record
! rhiza link a serves a2 --record
stderr 'link type "serves" does not go from capability to capability'
rhiza link a serves b --record --json
stdout '"record": true'
rhiza unlink a serves b --json
stdout '"links": \['
rhiza change show --json
stdout '"op": "link.retire"'
! rhiza unlink ZZZZZZ --json
stdout '"code": "not_found"'

fold-ok

# A change set can be an end: work found while doing Shape is a new change
# set discovered from it, and a question can block a change set.
rhiza link d1 relates-to 01M5PWGEF85Y185JZ2ZGCNH40N --note 'Decided for it' --change 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- link [0-9A-Z]{26}$'
rhiza change new Found
stdout 'change set 01M5PWH8V07G6ZE5KNFPW4J9K6 '
rhiza link 01M5PWH8V07G6ZE5KNFPW4J9K6 discovered-from 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- link [0-9A-Z]{26}$'
rhiza add question open-q --field statement=Which
rhiza link open-q blocks 01M5PWH8V07G
stdout '^- link [0-9A-Z]{26}$'
rhiza change show
stdout -count=2 '^- link.create '
! rhiza link ZZZZZZ discovered-from 01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout '"code": "not_found"'
fold-ok

# A change set serving a capability is refused; serving an intent succeeds.
rhiza change use 01M5PWGEF85Y185JZ2ZGCNH40N
! rhiza link 01M5PWGEF85Y185JZ2ZGCNH40N serves store
stderr 'link type "serves" does not go from change set to capability'
rhiza link 01M5PWGEF85Y185JZ2ZGCNH40N serves goal
stdout '^- link [0-9A-Z]{26}$'
fold-ok
