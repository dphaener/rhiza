# link creates a link between two live nodes, or with a change set at
# either end; unlink retires one, or drops it if the same change set
# created it. Link writes report links, not nodes.

exec rhiza init
exec rhiza change new Shape
exec rhiza add capability store
exec rhiza add capability log
exec rhiza add decision d1
exec rhiza add constraint c1

exec rhiza link log depends-on store
stdout '^Wrote entry [0-9A-Z]{26} to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^- link [0-9A-Z]{26}$'
! stdout '^- node'
exec rhiza link log relates-to store --note 'Same data' --json
stdout '"links": \[\n    "[0-9A-Z]{26}"\n  \]'
stdout '"nodes": \[\]'
exec rhiza link c1 exempts log --note Prototype --decision d1
exec rhiza change show
stdout -count=3 '^- link.create '

# A dry run writes nothing.
exec rhiza link store serves log --dry-run
stdout '"op":"link.create"'
stdout '"type":"serves"'
exec rhiza change show
stdout -count=3 '^- link.create '

# The same live link again is a conflict, exit 3.
! exec rhiza link log depends-on store --json
stdout '"code": "conflict"'
stdout 'already exists'

# Usage errors, exit 2.
! exec rhiza link log bogus store
stderr 'unknown link type'
! exec rhiza link log relates-to store
stderr 'needs --note'
! exec rhiza link c1 exempts store --note x
stderr 'needs --decision'
! exec rhiza link c1 exempts store --note x --decision log
stderr 'not a decision'
! exec rhiza link log serves store --decision d1
stderr 'only an exempts link'
! exec rhiza link 01M5PWG serves store --json
stdout '"code": "usage"'

# Unknown nodes are not_found, exit 4.
! exec rhiza link nosuch serves store --json
stdout '"code": "not_found"'

# unlink of a link added here drops it.
exec rhiza unlink log depends-on store
stdout '^- link [0-9A-Z]{26}$'
exec rhiza change show
stdout -count=2 '^- link.create '
! exec rhiza unlink log depends-on store --json
stdout '"code": "not_found"'
! exec rhiza unlink log depends-on
stderr 'unlink takes a link'

# unlink of a landed link writes a link.retire.
exec rhiza add capability a --record
exec rhiza add capability b --record
exec rhiza link a serves b --record --json
stdout '"record": true'
exec rhiza unlink a serves b --json
stdout '"links": \['
exec rhiza change show --json
stdout '"op": "link.retire"'
! exec rhiza unlink ZZZZZZ --json
stdout '"code": "not_found"'

fold-ok

# A change set can be an end: work found while doing Shape is a new change
# set discovered from it, and a question can block a change set.
exec rhiza link d1 relates-to 01M5PWGEF85Y185JZ2ZGCNH40N --note 'Decided for it' --change 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- link [0-9A-Z]{26}$'
exec rhiza change new Found
stdout 'change set 01M5PWH4Y0SRA04X93K2T73TD9 '
exec rhiza link 01M5PWH4Y0SRA04X93K2T73TD9 discovered-from 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- link [0-9A-Z]{26}$'
exec rhiza add question open-q --field statement=Which
exec rhiza link open-q blocks 01M5PWH4Y0SR
stdout '^- link [0-9A-Z]{26}$'
exec rhiza change show
stdout -count=2 '^- link.create '
! exec rhiza link ZZZZZZ discovered-from 01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout '"code": "not_found"'
fold-ok
