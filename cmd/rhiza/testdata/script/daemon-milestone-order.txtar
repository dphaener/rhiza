# Sibling milestones order by their number, not by ID or key: milestone 9
# comes before milestone 10 in the roadmap and the daemon starts it first
# under --max-runs 1. Rex is faked and only logs.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec rhiza add intent ten --field milestone=10 --record
exec rhiza add intent nine --field milestone=9 --record
exec git add -A
exec git commit -qm init

exec rhiza change new Ten --title Ten
exec rhiza add capability ten-leaf
exec rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves ten
exec rhiza propose
exec rhiza accept --reason ok

exec rhiza change new Nine --title Nine
exec rhiza add capability nine-leaf
exec rhiza link 01M5PWGW4RMJ580CPWEPP3158J serves nine
exec rhiza propose
exec rhiza accept --reason ok

exec rhiza roadmap --json
stdout '(?s)"handle": "nine".*"handle": "ten"'

exec rhiza daemon --permission-mode manual --once --max-runs 1
stdout -count=1 '^Started a run of 01M5PWGW4RMJ580CPWEPP3158J'
exec sh -c 'grep -c "run start" $WORK/rex.log'
stdout '^1$'
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
