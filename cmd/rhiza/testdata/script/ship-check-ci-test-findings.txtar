# A check still failing after its once-per-head rerun: ship check saves the
# failed run's log, trimmed to its failing lines, and lists the run as a
# test and a finding naming the saved file. A failing check whose log has
# no failing line stays a plain failure.

chmod 755 bin/gh
env PATH=$WORK/bin:$PATH

exec git init -q --bare origin.git
env ORIGIN=$WORK/origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
cp $WORK/other.mod go.mod
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
cp $WORK/feature.txt feature.txt
exec git add feature.txt
exec git commit -qm 'Build the feature'
exec git push -q -u origin cs/ship-it

# First failure: rerun, not settled.
! exec rhiza ship check --settled --json
stdout '"reran"'
! stdout '"findings"'

# Second: the run is a failure and a finding, and its saved log holds the
# failing line.
exec sh -c 'rhiza ship check --settled --json > $WORK/check.json'
exec cat $WORK/check.json
stdout '"tests": \['
stdout '"CI run 42 \(test\)"'
stdout '"findings"'
stdout 'failed: test'
exec sh -c 'cat "$(sed -n "s/.*saved in \([^:]*\):.*/\1/p" $WORK/check.json | head -1)"'
stdout '^--- FAIL: TestScripts/x \(0.10s\)$'
# The log is read twice: once at the rerun, for where it failed
# before it (the CI stability record's flakes, should the rerun pass), and
# once now.
exec sh -c 'grep -c "run view 42 --log-failed" $WORK/gh.log'
stdout '^2$'
exec sh -c 'cat $(git rev-parse --git-common-dir)/rhiza/ship/*.json'
stdout '"ci_findings"'
stdout 'CI run 42'

# An infra log has no failing line: a plain failure.
exec sh -c 'touch $WORK/infra'
exec rhiza ship check --settled --json
! stdout '"tests"'
! stdout '"findings"'
stdout 'failed: test'
# ...and the state file no longer holds the earlier read's findings.
exec sh -c 'cat $(git rev-parse --git-common-dir)/rhiza/ship/*.json'
! stdout 'ci_findings'

# Findings recorded again, then a green check clears them.
exec sh -c 'rm $WORK/infra'
exec rhiza ship check --settled --json
stdout '"findings"'
exec sh -c 'cat $(git rev-parse --git-common-dir)/rhiza/ship/*.json'
stdout '"ci_findings"'
exec sh -c 'touch $WORK/green'
exec rhiza ship check --settled --json
stdout '"green": true'
exec sh -c 'cat $(git rev-parse --git-common-dir)/rhiza/ship/*.json'
! stdout 'ci_findings'

-- other.mod --
module example.com/other

go 1.25
-- feature.txt --
feature
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
case "$1 $2" in
"pr view")
	head=$(git -C "$ORIGIN" rev-parse --verify "refs/heads/$3")
	conclusion=FAILURE
	[ -f "$WORK/green" ] && conclusion=SUCCESS
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"'$conclusion'","detailsUrl":"https://github.test/o/r/actions/runs/42/job/9"}]}\n' "$head"
	;;
"run rerun")
	;;
"run view")
	if [ -f "$WORK/infra" ]; then
		echo "Error: setup-go failed"
	else
		echo "test	Run tests	--- FAIL: TestScripts/x (0.10s)"
	fi
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
