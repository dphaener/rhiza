# rhiza question answer records the owner's words as a Decision quoting
# them, linked answers to the question, in the change set the question
# blocks. The question stops blocking, --dry-run writes nothing, an unknown
# question exits 2, and two answers get distinct handles. --change answers
# into a change set that is not the current one.

mkdir repo
cd repo
exec git init -q
rhiza init
exec git add -A
exec git commit -qm init

rhiza add capability store --record
rhiza add capability cache --record
rhiza add capability queue --record
rhiza change new Accepted
rhiza set store --field statement=Kept
rhiza set cache --field statement=Cached
rhiza set queue --field statement=Queued
rhiza propose
rhiza accept --reason ok
rhiza add question store-q --field statement=Which-store --record
rhiza link store-q blocks store --record
rhiza add question cache-q --field statement=Which-cache --record
rhiza link cache-q blocks cache --record
rhiza add question queue-q --field statement=Which-queue --record
rhiza link queue-q blocks queue --record

rhiza ready --json
stdout 'store-q'

# A dry run writes nothing.
rhiza question answer store-q 'use sqlite' --dry-run --json
stdout '"dry_run": true'
rhiza ready --json
stdout 'store-q'

# An unknown question is a usage error.
! rhiza question answer nope 'whatever' --json
stdout '"code": "usage"'
! rhiza question answer store-q '   ' --json

rhiza question answer store-q 'use sqlite' --json
rhiza question answer cache-q 'use redis' --json
rhiza show answer-store-q --json
stdout 'use sqlite'
rhiza show answer-cache-q --json
stdout 'use redis'
rhiza ready --json
! stdout 'store-q'
! stdout 'cache-q'
stdout 'queue-q'

# --change answers into Accepted while another change set is current.
rhiza change new Other
rhiza question answer queue-q 'use nats' --change 01M5PWGT68X5XKB54XFQMHKA0A --json
rhiza show answer-queue-q --view what-if:01M5PWGT68X5XKB54XFQMHKA0A --json
stdout 'use nats'
rhiza change show --json
! stdout 'answer-queue-q'
rhiza change show --change 01M5PWGT68X5XKB54XFQMHKA0A --json
stdout 'answer-queue-q'
rhiza ready --json
! stdout 'queue-q'

# A question already answered is refused, and nothing is written.
! rhiza question answer store-q 'again' --json
stdout '"code": "usage"'
! rhiza show answer-store-q-2 --json

# A question that blocks only a node the change set does not touch is
# refused, and nothing is written.
rhiza add capability apart --record
rhiza add question apart-q --field statement=Which-apart --record
rhiza link apart-q blocks apart --record
! rhiza question answer apart-q 'nope' --change 01M5PWGT68X5XKB54XFQMHKA0A --json
stdout '"code": "usage"'
! rhiza show answer-apart-q --json

# A second open question that blocks only another change set's node is
# refused too: Other touches apart, Accepted does not.
rhiza set apart --field statement=Apart
rhiza change show --json
stdout '"statement": "Apart"'
! rhiza question answer apart-q 'nope' --change 01M5PWGT68X5XKB54XFQMHKA0A --json
stdout '"code": "usage"'
! rhiza show answer-apart-q --json
! rhiza show answer-apart-q --view what-if:01M5PWGT68X5XKB54XFQMHKA0A --json

fold-ok
