# Revised in place, then rewritten (D13). A's in-place revision overlaps the
# field B wrote, a conflict; B writing the field again, after the revision,
# clears it.

rhiza init

# A adds base; B depends on A and sets base's statement.
rhiza change new A
stdout 'change set 01M5PWGEF85Y185JZ2ZGCNH40N '
rhiza add capability base --field statement=Base --field acceptance=a
rhiza change new B
stdout 'change set 01M5PWGKBGYFZMTH8Y8AF1G8GN '
rhiza link 01M5PWGKBGYFZMTH8Y8AF1G8GN depends-on 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza set base --field statement=FromB

# A revises the statement: a conflict on B's op.
rhiza set base --field statement=Revised --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza render
rhiza check
stdout '^warn in-flight change set 01M5PWGKBGYFZMTH8Y8AF1G8GN, op 01M5PWGNA0MVZ1H5AXG5VQ0BY9: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N revised op 01M5PWGJC82P7YGZTWYJ3Y88Z9 '
rhiza ready --json
stdout '"01M5PWGEF85Y18 revised under it: 1 operations"'

# B sets the statement again, having seen Revised: the conflict is gone.
rhiza show base --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stdout '^FromB$'
rhiza set base --field statement=FromBAgain
fold-ok
rhiza check
stdout '^ok$'
! stdout 'conflict'
rhiza ready --json
! stdout 'revised under it'

# A lands, then B.
rhiza propose
rhiza accept --reason ok
rhiza propose --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza accept --reason ok --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza land --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
fold-ok
rhiza show base
stdout '^FromBAgain$'
rhiza render
rhiza check
stdout '^ok$'
