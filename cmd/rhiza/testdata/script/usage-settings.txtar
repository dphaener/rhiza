# The usage governor's settings: two token limits (unset by default) and a
# reserve percent (20), shown by daemon settings and written by daemon set.

mkdir repo
cd repo
exec git init -q
rhiza init

rhiza daemon settings
stdout 'rhiza.daemon.usage.session = "" \(default, machine\)'
stdout 'rhiza.daemon.usage.weekly = "" \(default, machine\)'
stdout 'rhiza.daemon.usage.reserve = 20 \(default, machine\)'
rhiza daemon settings --json
stdout '"key": "rhiza.daemon.usage.reserve"'

rhiza daemon set rhiza.daemon.usage.session 5000000
rhiza daemon set rhiza.daemon.usage.weekly 90000000
rhiza daemon set rhiza.daemon.usage.reserve 35
rhiza daemon settings
stdout 'rhiza.daemon.usage.session = 5000000 \(rhiza.toml, machine\)'
stdout 'rhiza.daemon.usage.weekly = 90000000 \(rhiza.toml, machine\)'
stdout 'rhiza.daemon.usage.reserve = 35 \(rhiza.toml, machine\)'
rhiza daemon set rhiza.daemon.usage.reserve 0
rhiza daemon set rhiza.daemon.usage.reserve 100

# Bad values exit 2 and write nothing.
! rhiza daemon set rhiza.daemon.usage.reserve 101
stderr 'from 0 to 100'
! rhiza daemon set rhiza.daemon.usage.reserve -1
! rhiza daemon set rhiza.daemon.usage.reserve lots
! rhiza daemon set rhiza.daemon.usage.session many
stderr 'whole number of tokens'
! rhiza daemon set rhiza.daemon.usage.weekly 1.5
exec grep '"rhiza.daemon.usage.reserve" = ' $WORK/rhiza.toml
stdout '= "100"'
exec grep '"rhiza.daemon.usage.session" = ' $WORK/rhiza.toml
stdout '= "5000000"'

fold-ok
