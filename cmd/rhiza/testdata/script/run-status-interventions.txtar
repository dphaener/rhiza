# run status shows a run's outside interventions from its journal: in
# --json an interventions list in journal order and an intervention_count,
# and in text a line counting them by kind plus an Interventions section. A
# run with none shows an empty list, count 0 and "- Interventions: 0". An
# intervention entry with an unknown kind is not counted: the fold reports
# it as a warning. No command records interventions yet, so the journals
# are written by hand.

mkdir repo
cd repo
exec git init -q
rhiza init
exec git add -A
exec git commit -qm init
mkdir .git/rhiza/runs
cp ../two.jsonl .git/rhiza/runs/INTERVENE001.jsonl
cp ../none.jsonl .git/rhiza/runs/INTERVENE002.jsonl
cp ../bad.jsonl .git/rhiza/runs/INTERVENE003.jsonl

# Two interventions, in order, counted 2.
rhiza run status INTERVENE001 --json
stdout '"intervention_count": 2'
stdout '"interventions": \[\n\s+\{\n\s+"actor": "owner",\n\s+"at": "2026-01-01T00:00:02Z",\n\s+"detail": "told the builder to stop",\n\s+"kind": "message",\n\s+"step": "build"\n\s+\},\n\s+\{\n\s+"actor": "owner",\n\s+"at": "2026-01-01T00:00:03Z",\n\s+"commit": "1111111111111111111111111111111111111111",\n\s+"detail": "fix typo",\n\s+"kind": "hand-commit",\n\s+"step": "build"\n\s+\}\n\s+\]'
rhiza run status INTERVENE001
stdout '^- Interventions: 2 \(message 1, hand-commit 1\)$'
stdout '^## Interventions\n\n- 2026-01-01T00:00:02Z message by owner \(step build\): told the builder to stop\n- 2026-01-01T00:00:03Z hand-commit by owner \(step build\) commit 1111111111111111111111111111111111111111: fix typo\n'

# None: an empty list, count 0, and no section.
rhiza run status INTERVENE002 --json
stdout '"interventions": \[\]'
stdout '"intervention_count": 0'
rhiza run status INTERVENE002
stdout '^- Interventions: 0$'
! stdout '## Interventions'

# (failure case) An unknown kind is not counted; the fold warns of it.
rhiza run status INTERVENE003 --json
stdout '"intervention_count": 1'
stdout -count=1 '"kind": '
stdout '"kind": "resume"'
stdout 'unknown kind \\"poke\\": not counted'
rhiza run status INTERVENE003
stdout '^- Interventions: 1 \(resume 1\)$'

-- two.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","started":{"workflow":"one","definition":"","change":"01M5PWGEF85Y185JZ2ZGCNH40N"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"intervention","at":"2026-01-01T00:00:02Z","step":"build","kind":"message","actor":"owner","detail":"told the builder to stop"}
{"type":"intervention","at":"2026-01-01T00:00:03Z","step":"build","kind":"hand-commit","actor":"owner","detail":"fix typo","commit":"1111111111111111111111111111111111111111"}
-- none.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","started":{"workflow":"one","definition":"","change":"01M5PWGEF85Y185JZ2ZGCNH40N"}}
-- bad.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","started":{"workflow":"one","definition":"","change":"01M5PWGEF85Y185JZ2ZGCNH40N"}}
{"type":"intervention","at":"2026-01-01T00:00:01Z","kind":"poke","actor":"owner"}
{"type":"intervention","at":"2026-01-01T00:00:02Z","kind":"resume","actor":"owner","detail":"rhiza run resume"}
