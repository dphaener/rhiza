# A leaves step conducts the run change set's leaves, one at a time in
# leaf order: a builder session, then a verifier session, each through
# session.start's path (a Rex tab running `rhiza session run <id>`), each
# judged by its exit. run status lists every leaf with its sessions,
# judged attempts and outcome, in text and --json.
#
# The fake rex runs the tab's command synchronously in the window's
# directory, then prints a window; the fake claude logs its leaf, attempt
# and prompt, then exits 0.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init

# Two leaf capabilities: second depends on first, so first goes first.
exec rhiza change new 'Leaves' --title 'Leaves'
exec rhiza add capability second
exec rhiza add capability first
exec rhiza link second depends-on first
exec rhiza change show
stdout '## Leaves\n\n- first\n- second \(needs first\)\n'
mkdir .rhiza/workflows
cp $WORK/build.toml .rhiza/workflows/build.toml
exec git add -A
exec git commit -qm leaves

# A leaves step's role with no permission mode is refused before anything
# runs.
! exec rhiza run start --workflow build
stderr 'step "build" is a leaves step whose builder runs with no permission mode'
! exists $WORK/rex.log

exec sh -c 'rhiza run start --workflow build --permission-mode manual --json; echo exit=$?'
stdout '"state": "succeeded"'
stdout '^exit=0$'

# Each session ran with its leaf and attempt, builder then verifier, leaf
# by leaf, with its role's prompt filled.
exec cat $WORK/claude.log
cmp stdout $WORK/want.log

exec rhiza run status
stdout '^- build \(visit 1\): pass, then end: 2 of 2 leaves passed$'
stdout '\n## Leaves\n\n- first \(step build\): passed: attempt 1: verifier passed\n  - attempt 1 builder, session [0-9a-f-]{36}: pass \(exit 0\)\n  - attempt 1 verifier, session [0-9a-f-]{36}: pass \(exit 0\)\n- second \(step build\): passed: attempt 1: verifier passed\n  - attempt 1 builder, session [0-9a-f-]{36}: pass \(exit 0\)\n  - attempt 1 verifier, session [0-9a-f-]{36}: pass \(exit 0\)\n'

exec rhiza run status --json
stdout -count=1 '"handle": "first",'
stdout -count=1 '"handle": "second",'
stdout -count=2 '"outcome": "passed"'
stdout -count=2 '"attempt": 1,\n\s+"role": "builder",\n\s+"session": "[0-9a-f-]{36}"'
stdout -count=2 '"attempt": 1,\n\s+"role": "verifier",\n\s+"session": "[0-9a-f-]{36}"'
stdout -count=4 '"attempt": 1,\n\s+"detail": "exit 0",\n\s+"outcome": "pass",'
stdout '"leaves": \[\n(.*\n)*?\s+"handle": "first",(.*\n)*?\s+"handle": "second",'

fold-ok

-- want.log --
leaf=first attempt=1 prompt=Build first, attempt 1
leaf=first attempt=1 prompt=Verify first
leaf=second attempt=1 prompt=Build second, attempt 1
leaf=second attempt=1 prompt=Verify second
-- build.toml --
name = "build"

[step.build]
kind = "leaves"
on.pass = "done"

[step.build.builder]
prompt = "Build {leaf}, attempt {attempt}"

[step.build.verifier]
prompt = "Verify {leaf}"
-- bin/rex --
#!/bin/sh
echo "$@" >> "$WORK/rex.log"
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
echo "leaf=$RHIZA_LEAF attempt=$RHIZA_ATTEMPT prompt=$last" >> "$WORK/claude.log"
exit 0
