# rhiza run start --workflow plan runs the built-in plan workflow on a
# draft record change set, end to end: the interview writes the milestone
# into the model, a fresh reviewer finds one leaf with no acceptance, the
# critic confirms it, review-check fails, the reviser adds the acceptance,
# a second review is clean, review-check passes and the gate proposes the
# plan's draft change set. The run renders and commits its
# branch: no plan file.
#
# The plan ends on a pushed branch with an open PR: origin is a bare repo
# in $WORK and the fake gh logs its argv to gh.log and keeps the body a PR
# is created with in pr-body.md.
#
# Nothing here reaches Rex, GitHub or Claude Code. The fake rex starts the tab's
# command in the background in the window's directory and returns once the
# agent has touched $WORK/ready. One fake claude plays every role, by its
# prompt (its last argument): it logs the prompt, does the role's writes
# with the real rhiza, says done, touches $WORK/ready and exits 0.

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH
mkdir $HOME/.claude/projects/p
exec git init -q --bare origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
exec git add -A
exec git commit -qm init
exec git push -q -u origin main

# A draft record change set to plan a milestone in, committed (with the
# owner's actor) so the run's worktree has it.
exec rhiza change new 'Plan reports' --kind record --title 'Plan reports' --json
stdout '"change_set": "(01[0-9A-Z]{24})"'
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\".*/\1/p" > $WORK/rec'
exec git add -A
exec git commit -qm 'Plan reports'
exec git push -q origin main

exec sh -c 'rhiza run start $(cat $WORK/rec) --workflow plan --permission-mode manual > $WORK/out 2> $WORK/err; echo exit=$?'
stdout '^exit=0$'
exec cat $WORK/out
stdout '^Run [0-9A-Z]{26} succeeded$'

# The steps ran in order: one failed check sent the plan to the reviser,
# and the second round passed to the gate.
exec rhiza run status --json
stdout '"workflow": "plan"'
stdout '"state": "succeeded"'
exec rhiza run status
stdout '^- interview \(visit 1\): pass, then review, '
stdout '^- review \(visit 1\): pass, then critic, '
stdout '^- critic \(visit 1\): pass, then check, '
stdout '^- check \(visit 1\): fail, then revise: exit 1$'
stdout '^- revise \(visit 1\): pass, then review, '
stdout '^- review \(visit 2\): pass, then critic, '
stdout '^- critic \(visit 2\): pass, then check, '
stdout '^- check \(visit 2\): pass, then gate: exit 0$'
stdout '^- gate \(visit 1\): pass, then open-pr: exit 0$'
! stdout 'visit 3'

# Each agent was told its role; the review roles were told only the change
# set and the plan-review guide.
exec cat $WORK/prompts.log
stdout -count=1 '^/rhiza-plan Plan change set 01[0-9A-Z]{24} \(Plan reports\) '
stdout -count=2 '^Review the plan of change set 01[0-9A-Z]{24} as the reviewer: follow `rhiza guide plan-review`, then run `rhiza session done`\.$'
stdout -count=2 'as the critic'
stdout -count=1 'as the reviser'
! stdout 'plan file'

# Two review rounds: one confirmed finding, then a clean round.
exec rhiza run status --json
stdout '"kind": "missing-acceptance"'
stdout '"verdict": "confirmed"'
stdout '"round": 2'

# The record landed with the interview; the planned change set was
# proposed by the gate, and has the reviser's acceptance.
cd $WORK/repo.plan-reports
exec sh -c 'rhiza change show $(cat $WORK/rec) --json'
stdout '"state": "landed"'
exec sh -c 'rhiza change show $(cat $WORK/cs) --json'
stdout '"state": "proposed"'
exec sh -c 'rhiza show export-csv --change $(cat $WORK/cs) --json'
stdout '"acceptance": "A test exports a 100k-row report with flat memory use"'
exec sh -c 'rhiza show csv-streaming --json'
stdout '"quote": "Stream it, reports get huge"'
stdout '"type": "derived-from"'

# The run pushed its branch and opened one PR, titled by the change set,
# its body the plan's summary, and the ship state records its number.
exec sh -c 'grep -c "^pr create" $WORK/gh.log'
stdout '^1$'
grep '^pr create .*--title Plan reports' $WORK/gh.log
grep '^# Plan of run ' $WORK/pr-body.md
grep '^### Round 1$' $WORK/pr-body.md
grep '^### Round 2$' $WORK/pr-body.md
grep '^- confirmed f1 on export-csv: export-csv has no acceptance check — confirmed: export-csv has no acceptance field$' $WORK/pr-body.md
grep '^No findings\.$' $WORK/pr-body.md
grep '^## Gate$' $WORK/pr-body.md
grep '^- 01[0-9A-Z]{24} \(Export reports\): proposed$' $WORK/pr-body.md
exec sh -c 'test "$(git --git-dir=$WORK/origin.git rev-parse refs/heads/cs/plan-reports)" = "$(git rev-parse HEAD)"'
exec sh -c 'cat $(git rev-parse --git-common-dir)/rhiza/ship/*.json'
stdout '"pr": 7'

# The run rendered and committed its branch: nothing is left to commit,
# the branch checks as it is, and the last commit is the render commit
# with the Change and Actor trailers.
exec sh -c 'git status --porcelain --untracked-files=all | wc -l | tr -d " "'
stdout '^0$'
exec rhiza check
stdout '^ok'
exec git log -1 --format=%B
stdout '^Render the plan$'
stdout '^Change: 01[0-9A-Z]{24}$'
stdout '^Actor: '
fold-ok

-- source.json --
{"title":"Planning interview","summary":"The owner planned the reports milestone.","quotes":[{"text":"Stream it, reports get huge","by":"owner"}]}
-- record.json --
{"writes":[
  {"op":"add","kind":"intent","handle":"reports","fields":["statement=Users take their reports out of the product"]},
  {"op":"add","kind":"decision","handle":"csv-streaming","fields":[
    "statement=Stream CSV rows instead of building the file in memory",
    "quote=Stream it, reports get huge"]},
  {"op":"link","from":"csv-streaming","type":"derived-from","to":"plan-interview"}
]}
-- leaf.json --
{"writes":[
  {"op":"add","kind":"capability","handle":"export-csv","fields":["statement=Users export any report as CSV"]},
  {"op":"link","from":"export-csv","type":"decided-by","to":"csv-streaming"}
]}
-- findings.json --
{"findings":[{"node":"export-csv","kind":"missing-acceptance","reason":"export-csv has no acceptance check"}]}
-- clean.json --
{"findings":[]}
-- verdict.json --
{"verdicts":[{"finding":"f1","verdict":"confirmed","reason":"export-csv has no acceptance field"}]}
-- fix.json --
{"writes":[
  {"op":"set","ref":"export-csv","fields":["acceptance=A test exports a 100k-row report with flat memory use"]}
]}
-- transcript.jsonl --
{"type": "user", "message": {"role": "user", "content": "Stream it, reports get huge"}}
-- bin/rex --
#!/bin/sh
case "$1 $2" in
window\ close)
	echo "$*" >> "$WORK/rex.log"
	exit 0
	;;
esac
case "$1" in
events | send | send-key)
	echo "$*" >> "$WORK/rex.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
i=0
until [ -f "$WORK/ready" ]; do
	i=$((i + 1))
	if [ $i -gt 1600 ]; then
		echo 'fake rex: the agent never got ready' >&2
		exit 1
	fi
	sleep 0.025
done
rm -f "$WORK/ready"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
printf '%s\n' "$last" >> "$WORK/prompts.log"
fail() {
	echo "fake claude: $*" >> "$WORK/claude.err"
	touch "$WORK/ready"
	exit 1
}
has_acceptance() {
	rhiza show export-csv --change "$(cat "$WORK/cs")" --json | grep -q '"acceptance"'
}
case "$last" in
/rhiza-plan*)
	rec=$RHIZA_CHANGE
	cp "$WORK/transcript.jsonl" "$HOME/.claude/projects/p/$RHIZA_SESSION.jsonl"
	rhiza source add plan-interview "$WORK/source.json" --raw-session "$RHIZA_SESSION" --json >> "$WORK/agent.out" || fail source
	rhiza apply "$WORK/record.json" --json >> "$WORK/agent.out" || fail record
	rhiza change new 'Export reports' --json > "$WORK/new.out" || fail change new
	sed -n 's/.*"change_set": "\([0-9A-Z]*\)".*/\1/p' "$WORK/new.out" > "$WORK/cs"
	rhiza link "$(cat "$WORK/cs")" serves reports --change "$rec" >> "$WORK/agent.out" || fail serves
	rhiza land --json >> "$WORK/agent.out" || fail land
	rhiza apply "$WORK/leaf.json" --change "$(cat "$WORK/cs")" --json >> "$WORK/agent.out" || fail leaf
	;;
*'as the reviewer'*)
	if has_acceptance; then
		rhiza run findings "$WORK/clean.json" --json >> "$WORK/agent.out" || fail findings
	else
		rhiza run findings "$WORK/findings.json" --json >> "$WORK/agent.out" || fail findings
	fi
	;;
*'as the critic'*)
	if ! has_acceptance; then
		rhiza run verdict "$WORK/verdict.json" --json >> "$WORK/agent.out" || fail verdict
	fi
	;;
*'as the reviser'*)
	rhiza apply "$WORK/fix.json" --change "$(cat "$WORK/cs")" --json >> "$WORK/agent.out" || fail fix
	;;
*)
	fail "unexpected prompt: $last"
	;;
esac
rhiza session done >> "$WORK/done.out" || fail done
touch "$WORK/ready"
exit 0
-- bin/gh --
#!/bin/sh
echo "$@" >> "$WORK/gh.log"
o="$WORK/origin.git"
case "$1 $2" in
"pr view")
	if [ ! -f "$WORK/pr.created" ]; then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	head=$(git -C "$o" rev-parse --verify "refs/heads/$3")
	printf '{"number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[]}\n' "$head"
	;;
"pr create")
	while [ $# -gt 0 ]; do
		if [ "$1" = --body-file ]; then
			cp "$2" "$WORK/pr-body.md"
		fi
		shift
	done
	touch "$WORK/pr.created"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
