# Before every agent session a run starts, the daemon fills the session's
# directory (beside the run's journal, in the git common dir) with brief.md
# and slice.json and gives the agent RHIZA_BRIEF and RHIZA_SLICE; no
# handback.md exists, so no RHIZA_HANDBACK. slice.json is `rhiza slice
# --json` of the change set. An unwritable session directory fails the
# session start naming its path, and no agent starts.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Brief files' --title 'Brief files'
mkdir .rhiza/workflows
cp $WORK/brief.toml .rhiza/workflows/brief.toml

exec sh -c 'rhiza run start --foreground --workflow brief --permission-mode manual --json; echo exit=$?'
stdout '"state": "succeeded"'
stdout '^exit=0$'
exec cat $WORK/claude.brief
stdout '^# Brief$'
stdout '^- Title: Brief files$'
stdout '^Full contract: rhiza guide contract$'
exec cat $WORK/claude.env
stdout '^RHIZA_BRIEF='${WORK@R}'/repo/\.git/rhiza/runs/\w+/build-1/agent/brief\.md$'
stdout '^RHIZA_SLICE='${WORK@R}'/repo/\.git/rhiza/runs/\w+/build-1/agent/slice\.json$'
! stdout 'RHIZA_HANDBACK'
exec sh -c 'cat "$(sed -n "s/^RHIZA_SLICE=//p" $WORK/claude.env)"'
stdout '"intent": "Brief files"'

# An unwritable session directory fails the start, and no agent runs.
rm $WORK/claude.env
exec sh -c 'id=$(rhiza run start --foreground --workflow brief --permission-mode manual --dry-run | sed -n "s/^Run \(\S*\) would start$/\1/p"); : > .git/rhiza/runs/$id'
exec sh -c 'rhiza run start --foreground --workflow brief --permission-mode manual --json; echo exit=$?'
stdout 'rhiza/runs/\w+'
! stdout '"state": "succeeded"'
! exists $WORK/claude.env

-- brief.toml --
name = "brief"

[step.build]
kind = "agent"
prompt = "Build {change}"
on.pass = "done"
-- bin/rex --
#!/bin/sh
echo "$@" >> "$WORK/rex.log"
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
env > "$WORK/claude.env"
cat "$RHIZA_BRIEF" > "$WORK/claude.brief"
exit 0
