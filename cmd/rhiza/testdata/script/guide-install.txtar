# guide install writes the agent guide into Claude Code as a
# skills-directory plugin: ~/.claude/skills/rhiza by default, or the
# repository's .claude/skills/rhiza with --project. HOME is $WORK/home,
# set by the harness, never the real one.

# A user install needs no repository and writes the twenty-three files.
! exists .rhiza
exec rhiza guide install --agent claude
cmpenv stdout first.txt
cmp $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json plugin.json
cmp $HOME/.claude/skills/rhiza/hooks/hooks.json hooks.json
exists $HOME/.claude/skills/rhiza/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-scrub/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-plan/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-planner/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-plan-reviewer/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-plan-critic/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-plan-reviser/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-build/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-build-retry/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-builder/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-verifier/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-review/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-check-compliance/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-check-model/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-check-qa/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-check-quality/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-ci-fix/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-conflict-fix/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-critic/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-fixer/SKILL.md
exists $HOME/.claude/skills/rhiza/skills/rhiza-gate-fix/SKILL.md

# Each SKILL.md starts with its frontmatter, then the guide text.
exec head -3 $HOME/.claude/skills/rhiza/SKILL.md
stdout '\A---\nname: rhiza\ndescription: "Work with the product model of a repository that has a \.rhiza/ folder: .*"\n\z'
grep '^# Rhiza$' $HOME/.claude/skills/rhiza/SKILL.md
exec head -3 $HOME/.claude/skills/rhiza/skills/rhiza-scrub/SKILL.md
stdout '\A---\nname: rhiza-scrub\ndescription: "Turn a raw conversation .*"\n\z'
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-plan/SKILL.md
stdout '\A---\nname: rhiza-plan\ndescription: "Plan with the owner straight into a Rhiza product model: .*"\n---\n\z'

# The build topic is installed as the rhiza-build skill: frontmatter, a
# blank line, then rhiza guide build's text.
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-build/SKILL.md
stdout '\A---\nname: rhiza-build\ndescription: "Building a change set.s leaves: .*"\n---\n\z'
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-build/SKILL.md
cp stdout build-body.txt
exec rhiza guide build
cmp stdout build-body.txt
grep 'rhiza guide builder' $HOME/.claude/skills/rhiza/skills/rhiza-build/SKILL.md

# The builder, verifier and build-retry topics are skills the same way.
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-builder/SKILL.md
stdout '\A---\nname: rhiza-builder\ndescription: "The builder of a build run: .*"\n---\n\z'
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-builder/SKILL.md
cp stdout builder-body.txt
exec rhiza guide builder
cmp stdout builder-body.txt
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-verifier/SKILL.md
stdout '\A---\nname: rhiza-verifier\ndescription: "The verifier of a build run: .*"\n---\n\z'
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-verifier/SKILL.md
cp stdout verifier-body.txt
exec rhiza guide verifier
cmp stdout verifier-body.txt
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-build-retry/SKILL.md
stdout '\A---\nname: rhiza-build-retry\ndescription: "A builder.s later attempt: .*"\n---\n\z'
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-build-retry/SKILL.md
cp stdout retry-body.txt
exec rhiza guide build-retry
cmp stdout retry-body.txt

# The review topic is installed as the rhiza-review skill the same way.
exec head -4 $HOME/.claude/skills/rhiza/skills/rhiza-review/SKILL.md
stdout '\A---\nname: rhiza-review\ndescription: "Reviewing a built change set: an index .*"\n---\n\z'
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-review/SKILL.md
cp stdout review-body.txt
exec rhiza guide review
cmp stdout review-body.txt
grep 'rhiza guide check-compliance' $HOME/.claude/skills/rhiza/skills/rhiza-review/SKILL.md

# The eleven review role topics are installed as skills beside it, each the
# frontmatter and its topic's text.
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-check-compliance/SKILL.md
cp stdout check-compliance-body.txt
exec rhiza guide check-compliance
cmp stdout check-compliance-body.txt
grep '^name: rhiza-check-compliance$' $HOME/.claude/skills/rhiza/skills/rhiza-check-compliance/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-check-model/SKILL.md
cp stdout check-model-body.txt
exec rhiza guide check-model
cmp stdout check-model-body.txt
grep '^name: rhiza-check-model$' $HOME/.claude/skills/rhiza/skills/rhiza-check-model/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-check-qa/SKILL.md
cp stdout check-qa-body.txt
exec rhiza guide check-qa
cmp stdout check-qa-body.txt
grep '^name: rhiza-check-qa$' $HOME/.claude/skills/rhiza/skills/rhiza-check-qa/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-check-quality/SKILL.md
cp stdout check-quality-body.txt
exec rhiza guide check-quality
cmp stdout check-quality-body.txt
grep '^name: rhiza-check-quality$' $HOME/.claude/skills/rhiza/skills/rhiza-check-quality/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-ci-fix/SKILL.md
cp stdout ci-fix-body.txt
exec rhiza guide ci-fix
cmp stdout ci-fix-body.txt
grep '^name: rhiza-ci-fix$' $HOME/.claude/skills/rhiza/skills/rhiza-ci-fix/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-conflict-fix/SKILL.md
cp stdout conflict-fix-body.txt
exec rhiza guide conflict-fix
cmp stdout conflict-fix-body.txt
grep '^name: rhiza-conflict-fix$' $HOME/.claude/skills/rhiza/skills/rhiza-conflict-fix/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-critic/SKILL.md
cp stdout critic-body.txt
exec rhiza guide critic
cmp stdout critic-body.txt
grep '^name: rhiza-critic$' $HOME/.claude/skills/rhiza/skills/rhiza-critic/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-fixer/SKILL.md
cp stdout fixer-body.txt
exec rhiza guide fixer
cmp stdout fixer-body.txt
grep '^name: rhiza-fixer$' $HOME/.claude/skills/rhiza/skills/rhiza-fixer/SKILL.md
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-gate-fix/SKILL.md
cp stdout gate-fix-body.txt
exec rhiza guide gate-fix
cmp stdout gate-fix-body.txt
grep '^name: rhiza-gate-fix$' $HOME/.claude/skills/rhiza/skills/rhiza-gate-fix/SKILL.md

# The rhiza-plan skill's body, after the frontmatter and a blank line, is
# rhiza guide plan's text.
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-plan/SKILL.md
cp stdout plan-body.txt
exec rhiza guide plan
cmp stdout plan-body.txt

# A missing skill file makes the install out of date at the same version;
# a second install restores it.
rm $HOME/.claude/skills/rhiza/skills/rhiza-plan/SKILL.md
mkdir repo
cd repo
exec rhiza init
exec rhiza status
stdout '^- Guide \(user\): dev in .* \(out of date\)$'
stdout '^next: rhiza guide install --agent claude$'
exec rhiza guide install --agent claude
cmpenv stdout $WORK/restored.txt
exec rhiza status
stdout '^- Guide \(user\): dev in .* \(current\)$'
! stdout 'next: rhiza guide install'
cd $WORK
exec sed 1,5d $HOME/.claude/skills/rhiza/skills/rhiza-plan/SKILL.md
cmp stdout plan-body.txt

# A second install writes nothing.
exec rhiza guide install --agent claude
cmpenv stdout again.txt

# --json and api call print the same bytes.
exec rhiza guide install --agent claude --json
cp stdout install.json
exec rhiza api call guide.install '{"agent":"claude"}'
cmp stdout install.json
stdout '"written": \[\]'

# A plugin.json from another version is rewritten; the other files are not.
exec sh -c 'sed "s/\"dev\"/\"v0.0.1\"/" $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json > p.tmp && mv p.tmp $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json'
grep v0.0.1 $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json
exec rhiza guide install --agent claude
cmpenv stdout version.txt
cmp $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json plugin.json

# guide install writes no log entry: --dry-run is a usage error, exit 2.
! exec rhiza guide install --agent claude --dry-run
stderr 'does not take --dry-run'
stderr '^next: rhiza guide install --agent claude$'
exec sh -c 'rhiza guide install --agent claude --dry-run 2>/dev/null; echo exit $?'
stdout '^exit 2$'

# --agent is required and takes only claude: exit 2.
exec sh -c 'rhiza guide install 2>/dev/null; echo exit $?'
stdout '^exit 2$'
! exec rhiza guide install --agent agents-md
stderr '^rhiza: unknown agent "agents-md": want claude$'
exec sh -c 'rhiza guide install --agent agents-md 2>/dev/null; echo exit $?'
stdout '^exit 2$'

# A folder guide install did not write is a conflict, exit 3; nothing in it
# is touched.
rm $HOME/.claude/skills/rhiza
mkdir $HOME/.claude/skills/rhiza
cp mine.md $HOME/.claude/skills/rhiza/SKILL.md
cp extra.txt $HOME/.claude/skills/rhiza/extra.txt
! exec rhiza guide install --agent claude
stderr 'exists and was not written by rhiza guide install$'
stderr '^next: rhiza guide install --agent claude --force$'
exec sh -c 'rhiza guide install --agent claude 2>/dev/null; echo exit $?'
stdout '^exit 3$'
cmp $HOME/.claude/skills/rhiza/SKILL.md mine.md
! exists $HOME/.claude/skills/rhiza/.claude-plugin

# A plugin.json without the marker is not ours either.
mkdir $HOME/.claude/skills/rhiza/.claude-plugin
cp foreign-plugin.json $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json
exec sh -c 'rhiza guide install --agent claude 2>/dev/null; echo exit $?'
stdout '^exit 3$'
cmp $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json foreign-plugin.json

# --force writes the twenty-three files and keeps the others.
exec rhiza guide install --agent claude --force
cmpenv stdout first.txt
cmp $HOME/.claude/skills/rhiza/.claude-plugin/plugin.json plugin.json
cmp $HOME/.claude/skills/rhiza/extra.txt extra.txt
grep '^# Rhiza$' $HOME/.claude/skills/rhiza/SKILL.md

# --project outside a repository is not_found, exit 4.
! exec rhiza guide install --agent claude --project
stderr '^rhiza: no Rhiza repository in '
stderr '^next: rhiza init$'
exec sh -c 'rhiza guide install --agent claude --project 2>/dev/null; echo exit $?'
stdout '^exit 4$'
! exists .claude

# --project inside a repository writes .claude/skills/rhiza there.
mkdir proj
cd proj
exec rhiza init
exec rhiza guide install --agent claude --project
stdout '^Installed the Rhiza guide in .*/proj/\.claude/skills/rhiza \(25 written, 0 unchanged\)\.$'
cmp .claude/skills/rhiza/.claude-plugin/plugin.json $WORK/plugin.json
cmp .claude/skills/rhiza/hooks/hooks.json $WORK/hooks.json
exists .claude/skills/rhiza/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-scrub/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-plan/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-build/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-build-retry/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-builder/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-verifier/SKILL.md
exists .claude/skills/rhiza/skills/rhiza-review/SKILL.md
fold-ok

# With no plugin.json, files holding this rhiza's own bytes are a racing
# install's partial write, not foreign: the install writes plugin.json back.
exec sh -c 'rm .claude/skills/rhiza/.claude-plugin/plugin.json'
exec rhiza guide install --agent claude --project
stdout '\(1 written, 24 unchanged\)'
cmp .claude/skills/rhiza/.claude-plugin/plugin.json $WORK/plugin.json

# A project conflict's next keeps --project.
exec sh -c 'rm .claude/skills/rhiza/.claude-plugin/plugin.json && echo mine > .claude/skills/rhiza/SKILL.md'
! exec rhiza guide install --agent claude --project
stderr '^next: rhiza guide install --agent claude --force --project$'

-- first.txt --
Installed the Rhiza guide in $HOME/.claude/skills/rhiza (25 written, 0 unchanged).

- wrote .claude-plugin/plugin.json
- wrote SKILL.md
- wrote hooks/hooks.json
- wrote skills/rhiza-build-retry/SKILL.md
- wrote skills/rhiza-build/SKILL.md
- wrote skills/rhiza-builder/SKILL.md
- wrote skills/rhiza-check-code/SKILL.md
- wrote skills/rhiza-check-compliance/SKILL.md
- wrote skills/rhiza-check-model/SKILL.md
- wrote skills/rhiza-check-plan/SKILL.md
- wrote skills/rhiza-check-qa/SKILL.md
- wrote skills/rhiza-check-quality/SKILL.md
- wrote skills/rhiza-ci-fix/SKILL.md
- wrote skills/rhiza-conflict-fix/SKILL.md
- wrote skills/rhiza-critic/SKILL.md
- wrote skills/rhiza-fixer/SKILL.md
- wrote skills/rhiza-gate-fix/SKILL.md
- wrote skills/rhiza-plan-critic/SKILL.md
- wrote skills/rhiza-plan-reviewer/SKILL.md
- wrote skills/rhiza-plan-reviser/SKILL.md
- wrote skills/rhiza-plan/SKILL.md
- wrote skills/rhiza-planner/SKILL.md
- wrote skills/rhiza-review/SKILL.md
- wrote skills/rhiza-scrub/SKILL.md
- wrote skills/rhiza-verifier/SKILL.md
-- again.txt --
Installed the Rhiza guide in $HOME/.claude/skills/rhiza (0 written, 25 unchanged).
-- version.txt --
Installed the Rhiza guide in $HOME/.claude/skills/rhiza (1 written, 24 unchanged).

- wrote .claude-plugin/plugin.json
-- restored.txt --
Installed the Rhiza guide in $HOME/.claude/skills/rhiza (1 written, 24 unchanged).

- wrote skills/rhiza-plan/SKILL.md
-- plugin.json --
{
  "description": "The Rhiza agent guide: the rhiza, rhiza-scrub, rhiza-plan, rhiza-planner, rhiza-plan-reviewer, rhiza-plan-critic, rhiza-plan-reviser, rhiza-build, rhiza-builder, rhiza-verifier, rhiza-build-retry, rhiza-review and the eleven review role skills, and a SessionStart hook that runs rhiza status --hook.",
  "name": "rhiza",
  "rhiza": {
    "installed_by": "rhiza guide install"
  },
  "version": "dev"
}
-- hooks.json --
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "status",
              "--hook"
            ],
            "command": "rhiza",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
-- mine.md --
mine
-- extra.txt --
keep me
-- foreign-plugin.json --
{"name":"rhiza","version":"v9"}
