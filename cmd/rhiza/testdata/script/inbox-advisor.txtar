# When a normal run's agent session blocks on a question, the engine
# launches an advisor session on it (the arbiter step's adapter, with the
# question in its prompt) and does not wait for it. The advisor reports
# its recommendation and reasons with rhiza run recommend, which journals
# them; rhiza inbox shows them beside the question. Nothing is sent to the
# asking session and the run stays blocked on the owner. An advisor that
# fails leaves the question without a recommendation, the run still
# blocked.
#
# One fake claude plays both roles, by its prompt (its last argument). The
# asking agent reports an AskUserQuestion through the real hook path, then
# waits (bounded) for $WORK/answer and exits 0. The advisor logs its
# prompt, then per $WORK/mode recommends (recommend) or exits 5 at once
# (fail). The fake rex runs the tab in the background and logs anything
# typed at a session.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Advised runs' --title 'Advised runs' --json
stdout '"change_set": "[0-9A-Z]{26}"'
mkdir .rhiza/workflows
cp $WORK/ask.toml .rhiza/workflows/ask.toml
exec git add -A
exec git commit -qm 'Advised runs'

env REX_BLOCK=block:root
env REX_SESSION=session:s1

# (a) The advisor recommends.
exec sh -c 'echo recommend > $WORK/mode'
exec rhiza run start --workflow ask --permission-mode manual &
exec sh -c 'i=0; until [ -f $WORK/advisor.done ]; do i=$((i+1)); [ $i -gt 800 ] && exit 1; sleep 0.025; done'
exec cat $WORK/advisor.log
stdout -count=1 '^Recommend an answer to this question the owner was asked: Which colour\? -- follow rhiza guide advisor\.$'
exec cat $WORK/recommend.out
stdout 'Recommended an answer to the question session [0-9a-f-]{36} asked in run [0-9A-Z]{26}'
exec sh -c 'grep -c "\"type\":\"advisor\"" .git/rhiza/runs/*.jsonl'
stdout '^1$'
exec sh -c 'grep "\"type\":\"recommended\"" .git/rhiza/runs/*.jsonl'
stdout '"text":"Use blue"'
stdout '"detail":"Blue is the brand colour"'

# The inbox shows the question with the recommendation beside it.
exec rhiza inbox
stdout 'question run [0-9A-Z]{26}, change set [0-9A-Z]{26}, step build'
stdout '^  question: Which colour\?$'
stdout '^  recommendation: Use blue$'
stdout '^  reasons: Blue is the brand colour$'
exec rhiza inbox --json
stdout '"recommendation": "Use blue"'
stdout '"reasons": "Blue is the brand colour"'

# The advisor answered nothing: no model Decision, no message to the asker,
# and the run is still blocked.
exec rhiza run status
stdout '^Run [0-9A-Z]{26} blocked$'
! exists $WORK/typed.log
! exec sh -c 'grep -l "\"type\":\"\(asked\|answered\|arbiter\)\"" .git/rhiza/runs/*.jsonl'
exec sh -c 'cd ../repo.advised-runs && rhiza ls --kind decision --json | grep -c "\"handle\""; true'
stdout '^0$'

exec sh -c 'echo > $WORK/answer'
wait
stdout '^Run [0-9A-Z]{26} succeeded$'
exec rhiza inbox
stdout '^Nothing waits on you$'

# (b) The advisor fails: no recommendation, the run is still blocked.
rm $WORK/answer
rm $WORK/advisor.done
exec sh -c 'echo fail > $WORK/mode'
exec rhiza run start --workflow ask --permission-mode manual &
exec sh -c 'i=0; until [ -f $WORK/advisor.done ]; do i=$((i+1)); [ $i -gt 800 ] && exit 1; sleep 0.025; done'
exec sh -c 'i=0; while [ $i -lt 400 ]; do rhiza run status | grep -q "^Run .* blocked$" && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec rhiza inbox
stdout '^  question: Which colour\?$'
! stdout 'recommendation'
exec rhiza inbox --json
stdout '"question": "Which colour\?"'
! stdout '"recommendation"'
exec rhiza run status
stdout '^Run [0-9A-Z]{26} blocked$'
! exists $WORK/typed.log
exec cat $WORK/advisor.log
stdout -count=2 '^Recommend an answer'

exec sh -c 'echo > $WORK/answer'
wait
stdout '^Run [0-9A-Z]{26} succeeded$'

fold-ok

-- ask.toml --
name = "ask"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "done"
on.fail = "done"
-- bin/rex --
#!/bin/sh
case "$1" in
events)
	exit 0
	;;
send | send-key)
	echo "$*" >> "$WORK/typed.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
for a; do last=$a; done
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
case "$last" in
*'rhiza guide advisor'*)
	echo "$last" >> "$WORK/advisor.log"
	if [ "$(cat "$WORK/mode")" = recommend ]; then
		rhiza run recommend --recommendation 'Use blue' --reasons 'Blue is the brand colour' >> "$WORK/recommend.out" || exit 7
		rhiza session done >> "$WORK/done.out" || exit 6
	fi
	echo > "$WORK/advisor.done"
	[ "$(cat "$WORK/mode")" = recommend ] || exit 5
	exit 0
	;;
esac
echo '{"session_id":"'$sid'","hook_event_name":"PreToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Which colour?"}]}}' | rhiza session hook PreToolUse >> "$WORK/hook.out" || exit 8
i=0
until [ -f "$WORK/answer" ]; do
	i=$((i + 1))
	if [ $i -gt 800 ]; then
		echo 'no answer' >&2
		exit 9
	fi
	sleep 0.025
done
exit 0
