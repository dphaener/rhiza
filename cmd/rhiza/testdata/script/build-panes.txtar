# A leaves step runs its sessions in one tab of the change set: the first
# builder opens it, and each later session splits a pane of it, along the
# anchor pane's longer side in pixels unless the step's split fixes the
# direction. The first verifier splits its builder's pane; a verifier
# started while another is live splits that verifier's pane (the verifier
# half). The next builder splits the passed builder's pane, which then
# closes. A passed verifier's pane closes; a failed session's pane stays
# until the step ends.
#
# The fake rex logs each call to rex.log, numbering new blocks b1, b2, ...
# in order, answers `block call size` from size.json and runs a pane's
# command in the background in its -c directory. The fake claude, as a
# builder, commits its leaf's file with a Leaf: trailer on attempt 1 and
# exits 1 on a retry. Verifier a waits until verifier b has started, then
# writes its Evidence and passes; verifier b exits 1. Leaves a and b are
# independent.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH

# A landscape pane: every split goes right.
cp $WORK/landscape.json $WORK/size.json
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Panes' --title 'Panes'
exec rhiza add capability a
exec rhiza add capability b
mkdir .rhiza/workflows
cp $WORK/build.toml .rhiza/workflows/build.toml
exec git add -A
exec git commit -qm leaves

exec sh -c 'rhiza run start --workflow build --permission-mode manual --json; echo exit=$?'
stdout '^exit=0$'
exec rhiza run status
stdout '^- a \(step build\): passed: attempt 1: verifier passed$'
stdout '^- b \(step build\): failed: attempt 3: builder failed: exit 1$'

# b1 is a's builder in a new tab. a's verifier (b2) splits it; b's
# builder (b3) splits it too and takes its place, so b1 closes. b's
# verifier (b4) starts while a's verifier is live and splits its pane.
# b's retry builders split the builder before them: b5 takes passed b3's
# place, b6 splits failed b5, which stays. a's verifier's pane b2 closes
# once it passes, at a time that depends on the race with b's retries;
# the failed sessions' panes b4, b5, b6 close when the step ends, last.
grep '^close block:b2$' $WORK/rex.log
exec sh -c 'grep -v "^close block:b2$" $WORK/rex.log'
cmp stdout $WORK/want-landscape.log
fold-ok

# A portrait pane: the split goes below. A passed verifier's pane closes
# as it passes, and the passed builder's when the step ends.
cd $WORK
rm $WORK/rex.log $WORK/rex.n
cp $WORK/portrait.json $WORK/size.json
mkdir repo2
cd repo2
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Tall' --title 'Tall'
exec rhiza add capability c
mkdir .rhiza/workflows
cp $WORK/build.toml .rhiza/workflows/build.toml
exec git add -A
exec git commit -qm leaves
exec sh -c 'rhiza run start --workflow build --permission-mode manual --json; echo exit=$?'
stdout '^exit=0$'
cmp $WORK/rex.log $WORK/want-portrait.log

# The step's split = "below" wins over a landscape pane, and Rex is not
# asked its size.
cd $WORK
rm $WORK/rex.log $WORK/rex.n
cp $WORK/landscape.json $WORK/size.json
mkdir repo3
cd repo3
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Fixed' --title 'Fixed'
exec rhiza add capability c
mkdir .rhiza/workflows
cp $WORK/build-below.toml .rhiza/workflows/build.toml
exec git add -A
exec git commit -qm leaves
exec sh -c 'rhiza run start --workflow build --permission-mode manual --json; echo exit=$?'
stdout '^exit=0$'
cmp $WORK/rex.log $WORK/want-override.log

-- landscape.json --
{"columns":200,"rows":50,"cell_width_px":8,"cell_height_px":16}
-- portrait.json --
{"columns":100,"rows":120,"cell_width_px":8,"cell_height_px":16}
-- want-landscape.log --
window new -> block:b1
size block:b1
split block:b1 right -> block:b2 verifier a #1
size block:b1
split block:b1 right -> block:b3 builder b #1
close block:b1
size block:b2
split block:b2 right -> block:b4 verifier b #1
size block:b3
split block:b3 right -> block:b5 builder b #2
close block:b3
size block:b5
split block:b5 right -> block:b6 builder b #3
close block:b4
close block:b5
close block:b6
-- want-portrait.log --
window new -> block:b1
size block:b1
split block:b1 below -> block:b2 verifier c #1
close block:b2
close block:b1
-- want-override.log --
window new -> block:b1
split block:b1 below -> block:b2 verifier c #1
close block:b2
close block:b1
-- build.toml --
name = "build"

[step.build]
kind = "leaves"
interval = "50ms"
on.pass = "done"
on.fail = "done"

[step.build.builder]
prompt = "Build {leaf}"

[step.build.verifier]
prompt = "Verify {leaf}"
-- build-below.toml --
name = "build"

[step.build]
kind = "leaves"
interval = "50ms"
split = "below"
on.pass = "done"
on.fail = "done"

[step.build.builder]
prompt = "Build {leaf}"

[step.build.verifier]
prompt = "Verify {leaf}"
-- bin/rex --
#!/bin/sh
log="$WORK/rex.log"
case "$1 $2" in
"block call")
	b=
	while [ $# -gt 0 ]; do
		[ "$1" = -b ] && b=$2
		shift
	done
	echo "size $b" >> "$log"
	cat "$WORK/size.json"
	exit 0
	;;
"block close")
	shift 2
	[ "$1" = -s ] && shift 2
	echo "close $1" >> "$log"
	exit 0
	;;
"window close")
	echo "$@" >> "$log"
	exit 0
	;;
esac
verb=$1
dir=
anchor=
split=
label=
while [ $# -gt 0 ]; do
	case "$1" in
	-c) dir=$2; shift ;;
	-b) anchor=$2; shift ;;
	--split) split=$2; shift ;;
	--label) label=$2; shift ;;
	--) shift; break ;;
	esac
	shift
done
n=$(cat "$WORK/rex.n" 2>/dev/null || echo 0)
n=$((n + 1))
echo $n > "$WORK/rex.n"
if [ "$verb" = split ]; then
	echo "split $anchor $split -> block:b$n $label" >> "$log"
	out="{\"block_id\":\"block:b$n\",\"window_id\":\"window:w1\"}"
else
	echo "window new -> block:b$n" >> "$log"
	out="{\"window_id\":\"window:w1\",\"block_ids\":[\"block:b$n\"]}"
fi
(cd "$dir" && exec "$@") >>"$WORK/panes.out" 2>&1 </dev/null &
echo "$out"
-- bin/claude --
#!/bin/sh
if [ "$RHIZA_ROLE" = builder ]; then
	[ "$RHIZA_ATTEMPT" != 1 ] && exit 1
	echo "$RHIZA_LEAF" > "$RHIZA_LEAF.txt"
	git add "$RHIZA_LEAF.txt"
	git commit -q -m "build $RHIZA_LEAF" -m "Leaf: $RHIZA_LEAF" -- "$RHIZA_LEAF.txt" || exit 1
	exit 0
fi
if [ "$RHIZA_LEAF" = b ]; then
	touch "$WORK/b.verifier"
	exit 1
fi
if [ "$RHIZA_LEAF" = a ]; then
	i=0
	until [ -f "$WORK/b.verifier" ]; do
		i=$((i + 1))
		[ $i -gt 800 ] && exit 1
		sleep 0.025
	done
fi
rhiza add evidence "$RHIZA_LEAF-ok" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" || exit 1
rhiza link "$RHIZA_LEAF-ok" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" || exit 1
exit 0
