# The import topic states the load-bearing rule and the wording form for an
# agent-made decision; a decision written by that form shows the wording and
# the Source in rhiza why, and has no quote field.

exec rhiza guide import
stdout 'only a decision that shapes a capability or constraint'
stdout 'made autonomously by the agent and not confirmed by the owner'
stdout 'gets no `quote` field'

exec rhiza init
exec rhiza change new 'Import docs'
exec rhiza add capability store --field 'statement=Keeps entries'
exec rhiza add source decisions-md --field 'summary=docs/decisions.md, written by an agent.'
exec rhiza add decision keep-in-ram --field 'statement=Entries stay in memory.' --field 'wording=Entries stay in memory, made autonomously by the agent and not confirmed by the owner'
exec rhiza link store decided-by keep-in-ram
exec rhiza link keep-in-ram derived-from decisions-md
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza land

exec rhiza why store
stdout 'made autonomously by the agent and not confirmed by the owner'
stdout '^- keep-in-ram derived from decisions-md$'
! stdout 'quote'
exec rhiza show keep-in-ram --json
! stdout '"quote"'
fold-ok
