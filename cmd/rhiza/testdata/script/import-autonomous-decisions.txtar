# The import topic states the load-bearing rule and the wording form for an
# agent-made decision; a decision written by that form shows the wording and
# the Source in rhiza why, and has no quote field.

rhiza guide import
stdout 'only a decision that shapes a capability or constraint'
stdout 'made autonomously by the agent and not confirmed by the owner'
stdout 'gets no `quote` field'

rhiza init
rhiza change new 'Import docs'
rhiza add capability store --field 'statement=Keeps entries'
rhiza add source decisions-md --field 'summary=docs/decisions.md, written by an agent.'
rhiza add decision keep-in-ram --field 'statement=Entries stay in memory.' --field 'wording=Entries stay in memory, made autonomously by the agent and not confirmed by the owner'
rhiza link store decided-by keep-in-ram
rhiza link keep-in-ram derived-from decisions-md
rhiza propose
rhiza accept --reason ok
rhiza land

rhiza why store
stdout 'made autonomously by the agent and not confirmed by the owner'
stdout '^- keep-in-ram derived from decisions-md$'
! stdout 'quote'
rhiza show keep-in-ram --json
! stdout '"quote"'
fold-ok
