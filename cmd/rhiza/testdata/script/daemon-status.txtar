# rhiza daemon status reads the state file under the git common dir: not
# running before any daemon; after a poll (--once) the run the daemon
# started, in text and --json; a start whose run never journaled; not
# running again when the lock file names a process that is gone. Rex is
# faked and only logs.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec rhiza add intent m --field milestone=1 --record
exec git add -A
exec git commit -qm init

exec rhiza daemon status
stdout '^Daemon not running$'
exec rhiza daemon status --json
stdout '"running": false'

exec rhiza change new Built --title Built
exec rhiza add capability built-leaf
exec rhiza link 01M5PWGMARA1WR6BD0MEF4Y76P serves m
exec rhiza propose
exec rhiza accept --reason ok

# Three more accepted change sets the daemon will not start: one serving no
# milestone, one with no leaves and one depending on an unlanded change set.
exec rhiza change new Orphan --title Orphan
exec rhiza add capability orphan-leaf
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza change new Leafless --title Leafless
exec rhiza link 01M5PWGX40FB1RBRN9YHMNJW07 serves m
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza change new Waiting --title Waiting
exec rhiza link 01M5PWH110D047SG185GTXKBCB serves m
exec rhiza link 01M5PWH110D047SG185GTXKBCB depends-on 01M5PWGS702G3VYA781BNZ0K7Q
exec rhiza add capability waiting-leaf
exec rhiza propose
exec rhiza accept --reason ok


# Shipped: ready, with a leaf, and its latest run is a succeeded ship-change
# run (a fixture journal) that ended after the accept.
exec rhiza change new Shipped --title Shipped
exec rhiza link 01M5PWH6WG057XVB12H62KNP5F serves m
exec rhiza add capability shipped-leaf
exec rhiza propose
exec rhiza accept --reason ok
mkdir .git/rhiza/runs
exec sh -c 'printf "%s\n%s\n" "{\"type\":\"started\",\"at\":\"2099-01-01T00:00:00Z\",\"started\":{\"workflow\":\"ship-change\",\"definition\":\"\",\"change\":\"01M5PWH6WG057XVB12H62KNP5F\"}}" "{\"type\":\"finished\",\"at\":\"2099-01-01T00:00:02Z\",\"end\":\"succeeded\"}" > .git/rhiza/runs/SHIPPED0001.jsonl'

exec rhiza daemon --permission-mode manual --once --max-runs=3 --autonomous
stdout '^Started a run of '

# The daemon is gone, so it is not running, but its state says what it did.
exec rhiza daemon status
stdout '^Daemon not running$'
stdout '^Version: .+$'
stdout '^Max runs: 3$'
stdout '^Autonomous: true$'
stdout '^Last started: a run of '
stdout '^Skipped: 01M5PWGS702G3VYA781BNZ0K7Q Orphan: serves no milestone$'
stdout '^Skipped: 01M5PWGX40FB1RBRN9YHMNJW07 Leafless: has no leaves$'
stdout '^Skipped: 01M5PWH110D047SG185GTXKBCB Waiting: not ready \(.*\)$'
stdout '^Skipped: 01M5PWH6WG057XVB12H62KNP5F Shipped: its latest run shipped it$'
exec rhiza daemon status --json
stdout '"running": false'
stdout '"max_runs": 3'
stdout '"autonomous": true'
stdout '"last_started": \{'
exec rhiza daemon status --json
stdout '"reason": "not-ready"'
stdout '"reason": "shipped"'
stdout '"title": "Waiting"'
stdout '"detail": \[\n *"depends on'

# A start whose run never journaled is reported, with when it is retried.
exec sh -c 'sed "s/}\$/,\"unjournaled\":[{\"change\":\"CSX\",\"at\":\"2026-01-01T00:00:00Z\"}]}/" .git/rhiza/daemon.state.json > s.tmp && mv s.tmp .git/rhiza/daemon.state.json'
exec rhiza daemon status
stdout '^Not journaled: the run of CSX started at 2026-01-01T00:00:00Z wrote no journal; retried at 2026-01-01T00:15:00Z, or sooner when a run of it journals$'
exec rhiza daemon status --json
stdout '"change": "CSX"'

# A lock file naming a dead process holds nothing.
exec sh -c 'rm .git/rhiza/daemon.state.json; printf "{\"host\":\"h\",\"pid\":999999,\"started\":\"2026-01-01T00:00:00Z\"}\n" > .git/rhiza/daemon.lock'
exec rhiza daemon status
stdout '^Daemon not running$'
! stdout 'Last started'
exec rhiza daemon status --json
stdout '"running": false'
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
