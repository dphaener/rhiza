# rhiza daemon status reads the state file under the git common dir: not
# running before any daemon; after a poll (--once) the run the daemon
# started, in text and --json; a start whose run never journaled; not
# running again when the lock file names a process that is gone. Rex is
# faked and only logs.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_DETACH_LOG=$WORK/detach.log
mkdir repo
cd repo
exec git init -q
rhiza init
exec sh -c 'printf "[schedule]\nbacklog = \"skip\"\n" > .rhiza/policy.toml'
rhiza add intent m --field milestone=1 --record
exec git add -A
exec git commit -qm init

rhiza daemon status
stdout '^Daemon not running$'
rhiza daemon status --json
stdout '"running": false'

rhiza change new Built --title Built
rhiza add capability built-leaf
rhiza link 01M5PWGMARA1WR6BD0MEF4Y76P serves m
rhiza propose
rhiza accept --reason ok

# Three more accepted change sets the daemon will not start: one serving no
# milestone, one with no leaves (pinned to ship-change-classic, which builds
# only planned leaves; the conductor default would plan it) and one
# depending on an unlanded change set.
rhiza change new Orphan --title Orphan
rhiza add capability orphan-leaf
rhiza propose
rhiza accept --reason ok
rhiza change new Leafless --title Leafless --workflow ship-change-classic
rhiza link 01M5PWGX40FB1RBRN9YHMNJW07 serves m
rhiza propose
rhiza accept --reason ok
rhiza change new Waiting --title Waiting
rhiza link 01M5PWH110D047SG185GTXKBCB serves m
rhiza link 01M5PWH110D047SG185GTXKBCB depends-on 01M5PWGS702G3VYA781BNZ0K7Q
rhiza add capability waiting-leaf
rhiza propose
rhiza accept --reason ok


# Shipped: ready, with a leaf, and its latest run is a succeeded ship-change
# run (a fixture journal) that ended after the accept.
rhiza change new Shipped --title Shipped
rhiza link 01M5PWH6WG057XVB12H62KNP5F serves m
rhiza add capability shipped-leaf
rhiza propose
rhiza accept --reason ok
mkdir .git/rhiza/runs
exec sh -c 'printf "%s\n%s\n" "{\"type\":\"started\",\"at\":\"2099-01-01T00:00:00Z\",\"started\":{\"workflow\":\"ship-change\",\"definition\":\"\",\"change\":\"01M5PWH6WG057XVB12H62KNP5F\"}}" "{\"type\":\"finished\",\"at\":\"2099-01-01T00:00:02Z\",\"end\":\"succeeded\"}" > .git/rhiza/runs/SHIPPED0001.jsonl'

rhiza daemon --permission-mode manual --once --max-runs=3 --autonomous
stdout '^Started a run of '

# The daemon is gone, so it is not running, but its state says what it did.
rhiza daemon status
stdout '^Daemon not running$'
stdout '^Version: .+$'
stdout '^Max runs: 3$'
stdout '^Web UI: http://127.0.0.1:7787$'
stdout '^Autonomous: true$'
stdout '^runs: [0-9]+/3 live, [0-9]+ starting$'
stdout '^Last started: a run of '
stdout '^Skipped: 01M5PWGS702G3VYA781BNZ0K7Q Orphan: serves no milestone$'
stdout '^Skipped: 01M5PWGX40FB1RBRN9YHMNJW07 Leafless: has no leaves$'
stdout '^Skipped: 01M5PWH110D047SG185GTXKBCB Waiting: not ready \(.*\)$'
stdout '^Skipped: 01M5PWH6WG057XVB12H62KNP5F Shipped: its latest run shipped it$'
rhiza daemon status --json
stdout '"running": false'
stdout '"max_runs": 3'
stdout '"live": [0-9]+'
stdout '"starting": [0-9]+'
stdout '"max": 3'
stdout '"web": "http://127.0.0.1:7787"'
stdout '"autonomous": true'
stdout '"last_started": \{'
rhiza daemon status --json
stdout '"reason": "not-ready"'
stdout '"reason": "shipped"'
stdout '"title": "Waiting"'
stdout '"detail": \[\n *"depends on'

# The web UI follows rhiza.web.host: its address reads in the URL.
rhiza daemon set rhiza.web.host 0.0.0.0
rhiza daemon --permission-mode manual --once --max-runs=3 --autonomous
rhiza daemon status
stdout '^Web UI: http://0.0.0.0:7787$'
rhiza daemon status --json
stdout '"web": "http://0.0.0.0:7787"'
rhiza daemon set rhiza.web.host ::1
rhiza daemon --permission-mode manual --once --max-runs=3 --autonomous
rhiza daemon status
stdout '^Web UI: http://\[::1\]:7787$'
rhiza daemon status --json
stdout '"web": "http://\[::1\]:7787"'
rhiza daemon set rhiza.web.host 127.0.0.1

# The web UI follows rhiza.web.port: off after it is set to off and polled.
rhiza daemon set rhiza.web.port off
rhiza daemon --permission-mode manual --once --max-runs=3 --autonomous
rhiza daemon status
stdout '^Web UI: off$'
rhiza daemon status --json
stdout '"web": "off"'

# A start whose run never journaled is reported, with when it is retried.
exec sh -c 'sed "s/}\$/,\"unjournaled\":[{\"change\":\"CSX\",\"at\":\"2026-01-01T00:00:00Z\"}]}/" .git/rhiza/daemon.state.json > s.tmp && mv s.tmp .git/rhiza/daemon.state.json'
rhiza daemon status
stdout '^Not journaled: the run of CSX started at 2026-01-01T00:00:00Z wrote no journal; retried at 2026-01-01T00:15:00Z, or sooner when a run of it journals$'
rhiza daemon status --json
stdout '"change": "CSX"'

# A lock file naming a dead process holds nothing.
exec sh -c 'rm .git/rhiza/daemon.state.json; printf "{\"host\":\"h\",\"pid\":999999,\"started\":\"2026-01-01T00:00:00Z\"}\n" > .git/rhiza/daemon.lock'
rhiza daemon status
stdout '^Daemon not running$'
! stdout 'Last started'
rhiza daemon status --json
stdout '"running": false'
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
