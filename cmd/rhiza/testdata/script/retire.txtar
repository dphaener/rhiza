# retire retires a node with a reason. A node added in the same change set
# is dropped instead: its create goes, with the links added here that end at
# it, and no node.retire is written.

exec rhiza init
exec rhiza change new Shape
exec rhiza add capability store --record

# A landed node: a node.retire.
exec rhiza retire store --reason 'Folded into api'
stdout '^Wrote entry [0-9A-Z]{26} to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^- node [0-9A-Z]{26} \(store\)$'
exec rhiza change show --json
stdout '"op": "node.retire"'
stdout '"reason": "Folded into api"'

# Its handle is free again, and retiring it twice is a conflict, exit 3.
exec rhiza add capability store
! exec rhiza retire 01M5PWGJC82P7YGZTWYFFZ0VJG --reason again --json
stdout '"code": "conflict"'
stdout 'is retired'

# A node added here is dropped, with its link.
exec rhiza add capability tmp
exec rhiza link tmp depends-on store
exec rhiza retire tmp --reason 'Not needed' --dry-run
stdout '^Dry run: would write 0 operation\(s\) and drop 2'
stdout -count=2 '^- drop [0-9A-Z]{26}$'
exec rhiza retire tmp --reason 'Not needed' --json
stdout '"links": \['
exec rhiza change show
! stdout '\(tmp\)'
! stdout 'link.create'

# --reason is required; unknown refs are not_found.
! exec rhiza retire store
stderr 'reason'
! exec rhiza retire nosuch --reason x --json
stdout '"code": "not_found"'
! exec rhiza retire 01M5PWG --reason x --json
stdout '"code": "usage"'

fold-ok
