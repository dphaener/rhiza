# A text that refers to another node and holds <, > and & stays canonical when
# shown: check, change show, change diff and show all read it, before and
# after landing.

mkdir repo
cd repo
exec git init -q
rhiza init
exec git add -A
exec git commit -qm init

rhiza add capability other --field statement=Other --record
rhiza change new Canon
rhiza add capability mine --field 'statement=Sees @other with <branch>, a & b, x > y'
rhiza render
rhiza check
rhiza change show
stdout '<branch>, a & b, x > y'
! stdout 'u003c'
rhiza change show --json
stdout '<branch>, a & b, x > y'
! stdout 'u003c'
rhiza change diff
stdout '<branch>, a & b, x > y'
rhiza show mine --json
stdout '<branch>, a & b, x > y'
! stdout 'u003c'

exec sh -c 'rhiza change show --json | grep -m1 "\"id\"" | cut -d\" -f4 > cs.txt'
rhiza propose
rhiza accept
rhiza land
exec sh -c 'rhiza change show $(cat cs.txt)'
stdout '<branch>, a & b, x > y'
