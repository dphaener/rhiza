# Each check session works in a throwaway detached worktree at the run
# branch's head commit, under the git common dir, removed once its session
# ends whatever its outcome, while its rhiza writes (findings, Evidence)
# go into the run worktree's journal and log through RHIZA_ROOT; the
# engine commits a session's log writes once it is judged. The
# uncommitted edits in the run worktree stay as they were.
#
# A command step first leaves staged, unstaged and untracked edits in the
# run worktree and snapshots them and the branch head. The fake rex runs
# the tab's command synchronously in the window's directory. The fake claude, as a check, logs where it runs and what it
# sees. Check alpha records a major finding and writes Evidence, and its
# critic, in a checkout of its own, drops the finding; check beta fails in
# cycle 1 and records an empty round in cycle 2.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init

exec rhiza change new 'Review me' --title 'Review me'
exec rhiza add capability thing
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
cp $WORK/notes.txt notes.txt
exec git add -A
exec git commit -qm review

exec sh -c 'rhiza run start --foreground --workflow review --permission-mode manual --json; echo exit=$?'
stdout '"state": "succeeded"'
stdout '^exit=0$'
exec sh -c 'ls .git/rhiza/runs | sed "s/\.jsonl$//" > $WORK/runid'

# Each check session ran in a detached checkout of the branch head, not
# in the run worktree, with RHIZA_ROOT naming the run worktree. (Once
# alpha's check was judged, its Evidence was committed, so later
# sessions' branch head is that commit.)
exec cat $WORK/check.log
cmp stdout $WORK/want.log
grep '/repo/\.git/rhiza/checkouts/[0-9A-Z]+/alpha-check-1$' $WORK/alpha-check-1.pwd
grep '/repo/\.git/rhiza/checkouts/[0-9A-Z]+/alpha-critic-1$' $WORK/alpha-critic-1.pwd
grep '/repo/\.git/rhiza/checkouts/[0-9A-Z]+/beta-check-1$' $WORK/beta-check-1.pwd
grep '/repo/\.git/rhiza/checkouts/[0-9A-Z]+/beta-check-2$' $WORK/beta-check-2.pwd

# Every checkout is gone after its session ended, pass and fail.
exec sh -c 'for l in alpha-check-1 alpha-critic-1 beta-check-1 beta-check-2; do test -e "$(cat $WORK/$l.pwd)" && echo "$l left"; done; git worktree list'
! stdout 'left'
! stdout 'rhiza/checkouts'
! stdout 'detached'

# The check-session entries name their checkouts.
exec sh -c 'grep -c "\"type\":\"check-session\",.*\"detail\":\"[^\"]*/rhiza/checkouts/[0-9A-Z]*/[a-z]*-\(check\|critic\)-[12]\"" .git/rhiza/runs/$(cat $WORK/runid).jsonl'
stdout '^4$'

# alpha's finding is in the run's journal, its Evidence in the run
# worktree's log; the checkout stayed clean.
exec sh -c 'grep -c "\"type\":\"findings\",.*\"reason\":\"panics on empty input\"}\],\"check\":\"alpha\",\"cycle\":1}" .git/rhiza/runs/$(cat $WORK/runid).jsonl'
stdout '^1$'
exec sh -c 'grep -rl "alpha-ok" "$(cat $WORK/run.pwd)/.rhiza/log"'
stdout '\.json$'
grep '^alpha clean$' $WORK/checkout-status.log
exec sh -c 'cd "$(cat $WORK/run.pwd)" && git log --format=%s $(cat $WORK/head)..HEAD'
stdout '\Achore\(rhiza\): record beta check writes\nchore\(rhiza\): record alpha critic writes\nchore\(rhiza\): record beta check writes\nchore\(rhiza\): record alpha check writes\n\z'

exec rhiza run status
stdout '^- review \(visit 1\): pass, then end: 2 of 2 checks passed$'

# The run worktree's uncommitted edits are untouched.
exec sh -c 'cd "$(cat $WORK/run.pwd)" && git diff > $WORK/after.diff && git diff --cached > $WORK/after.cached && git status --porcelain --untracked-files=all -- notes.txt scratch.txt > $WORK/after.status'
cmp $WORK/after.diff $WORK/before.diff
cmp $WORK/after.cached $WORK/before.cached
cmp $WORK/after.status $WORK/before.status
grep 'unstaged' $WORK/after.diff
grep 'staged' $WORK/after.cached
grep '^\?\? scratch.txt$' $WORK/after.status

fold-ok

-- want.log --
check=alpha role=check cycle=1 dir=checkout head=branch-head detached=yes root=run
check=beta role=check cycle=1 dir=checkout head=branch-head detached=yes root=run
check=alpha role=critic cycle=1 dir=checkout head=branch-head detached=yes root=run
check=beta role=check cycle=2 dir=checkout head=branch-head detached=yes root=run
-- notes.txt --
notes
-- alpha.json --
{"findings":[{"severity":"major","place":"main.go:12","reason":"panics on empty input"}]}
-- drop.json --
{"verdicts":[{"finding":"f1","verdict":"dropped","reason":"not reproduced"}]}
-- empty.json --
{"findings":[]}
-- dirty.sh --
pwd -P > "$WORK/run.pwd"
git rev-parse HEAD > "$WORK/head"
echo staged >> notes.txt
git add notes.txt
echo unstaged >> notes.txt
echo scratch > scratch.txt
git diff > "$WORK/before.diff"
git diff --cached > "$WORK/before.cached"
git status --porcelain --untracked-files=all -- notes.txt scratch.txt > "$WORK/before.status"
-- review.toml --
[step.dirty]
kind = "command"
run = "sh $WORK/dirty.sh"
on.pass = "review"

[step.review]
kind = "checks"
interval = "50ms"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[[step.review.check]]
name = "beta"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
run="$(cat "$WORK/run.pwd")"
pwd -P > "$WORK/$RHIZA_CHECK-$RHIZA_ROLE-$RHIZA_CYCLE.pwd"
dir=run
[ "$(pwd -P)" != "$(cd "$run" && pwd -P)" ] && dir=checkout
head=other
[ "$(git rev-parse HEAD)" = "$(git -C "$run" rev-parse HEAD)" ] && head=branch-head
detached=no
git symbolic-ref -q HEAD > /dev/null || detached=yes
root=other
[ "$(cd "$RHIZA_ROOT" && pwd -P)" = "$(cd "$run" && pwd -P)" ] && root=run
echo "check=$RHIZA_CHECK role=$RHIZA_ROLE cycle=$RHIZA_CYCLE dir=$dir head=$head detached=$detached root=$root" >> "$WORK/check.log"
case $RHIZA_CHECK-$RHIZA_ROLE-$RHIZA_CYCLE in
alpha-critic-1)
	rhiza run verdict --check alpha "$WORK/drop.json" >&2 || exit 1
	;;
alpha-check-1)
	rhiza run findings --check alpha "$WORK/alpha.json" >&2 || exit 1
	rhiza add evidence alpha-ok --field "statement=alpha looked" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	[ -z "$(git status --porcelain)" ] && echo "alpha clean" >> "$WORK/checkout-status.log"
	;;
beta-check-1)
	exit 1
	;;
*)
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty.json" >&2 || exit 1
	;;
esac
exit 0
