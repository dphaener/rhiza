# One poll of the daemon (--once) starts the accepted, ready change sets that
# serve a milestone, each as a detached process running
# `rhiza run start --foreground <change set>`. A leafless one starts too: the
# conductor default ship-change plans its leaves itself. A leafless change
# set pinned to ship-change-classic, which builds only planned leaves, and a
# backlog one are left alone. Rex is faked and only logs.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_DETACH_LOG=$WORK/detach.log
mkdir repo
cd repo
exec git init -q
rhiza init
exec sh -c 'printf "[schedule]\nbacklog = \"skip\"\n" > .rhiza/policy.toml'
rhiza add intent m --field milestone=1 --record
rhiza add intent plain --record
exec git add -A
exec git commit -qm init

# Built: a milestone change set with a leaf.
rhiza change new Built --title Built
rhiza add capability built-leaf
rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves m
rhiza propose
rhiza accept --reason ok

# Leafless: serves the milestone, creates no capability.
rhiza change new Leafless --title Leafless
rhiza link 01M5PWGW4RMJ580CPWEPP3158J serves m
rhiza propose
rhiza accept --reason ok

# Backlog: has a leaf, serves no milestone.
rhiza change new Backlog --title Backlog
rhiza add capability backlog-leaf
rhiza link 01M5PWH01R1B9MDYF6J8XB3MQG serves plain
rhiza propose
rhiza accept --reason ok

# Classic: serves the milestone with no leaves, pinned to ship-change-classic.
rhiza change new Classic --title Classic --workflow ship-change-classic --json
stdout '"change_set": "01M5PWH4Y0SRA04X93K2T73TD9"'
rhiza link 01M5PWH4Y0SRA04X93K2T73TD9 serves m
rhiza propose
rhiza accept --reason ok

! rhiza daemon --permission-mode manual --once --max-runs=-1

# No permission mode: ship-change's agent steps would have none, so the
# daemon refuses before it opens any tab. A mode that bypasses the agent's
# permission checks is refused the same way.
! rhiza daemon --once
stderr 'no permission mode: give --permission-mode'
! rhiza daemon --once --permission-mode bypassPermissions
stderr 'bypasses the agent''s permission checks'
! exists $WORK/detach.log

# Disk guard: under 10 GiB free the daemon starts nothing and status says
# why; --min-free 0 turns the guard off; at 20 GiB the runs start.
env RHIZA_TEST_FREE_BYTES=1073741824
rhiza daemon --permission-mode manual --once
! stdout 'Started'
! exists $WORK/detach.log
rhiza daemon status --json
stdout '"reason": "disk-low"'
stdout '1.0 GiB free, under the minimum of 10.0 GiB'
rhiza daemon status
stdout 'Built: disk space is low \(1.0 GiB free'
rhiza inbox --json
stdout -count=1 '"kind": "disk-low"'
env RHIZA_TEST_FREE_BYTES=21474836480
rhiza daemon --permission-mode manual --once
stdout -count=2 '^Started a run of '
stdout '^Started a run of 01M5PWGQ8GB4618G4RH2TV0ZAH'
stdout '^Started a run of 01M5PWGW4RMJ580CPWEPP3158J'
! stdout '01M5PWH4Y0SRA04X93K2T73TD9'
! stdout '01M5PWH01R1B9MDYF6J8XB3MQG'
rhiza daemon status
stdout '^Skipped: 01M5PWH4Y0SRA04X93K2T73TD9 Classic: has no leaves$'
rhiza inbox --json
! stdout 'disk-low'
exec rm $WORK/detach.log
env RHIZA_TEST_FREE_BYTES=1073741824
rhiza daemon --permission-mode manual --once --min-free 0
stdout -count=2 '^Started a run of '
! rhiza daemon --permission-mode manual --once --min-free lots
stderr '--min-free'
exec rm $WORK/detach.log
env RHIZA_TEST_FREE_BYTES=1099511627776

# The mode reaches each started run's command.
rhiza daemon --permission-mode manual --once
stdout -count=2 '^Started a run of '
exec sh -c 'grep -c "^REX_SESSION=.* rhiza run start --foreground [0-9A-Z]* --permission-mode manual$" $WORK/detach.log'
stdout '^2$'
rhiza daemon --permission-mode manual --once --json
stdout '"started": \['

# --autonomous reaches the started run's command, and only then.
exec sh -c 'grep -c -- "--autonomous" $WORK/detach.log || true'
stdout '^0$'
rhiza daemon --permission-mode manual --once --autonomous
exec sh -c 'grep "^REX_SESSION=.* rhiza run start --foreground [0-9A-Z]* --permission-mode manual --autonomous$" $WORK/detach.log | wc -l'
stdout '^ *2$'

# Milestone order: sibling milestones sort by their number, not by ID or
# key, so milestone 9 comes before milestone 10 in the roadmap and the
# daemon starts its change set first under --max-runs 1.
cd $WORK
mkdir order
cd order
exec git init -q
rhiza init
cd $WORK
rhiza project rm repo
rhiza project add order
cd order
rhiza add intent ten --field milestone=10 --record
rhiza add intent nine --field milestone=9 --record
exec git add -A
exec git commit -qm init

rhiza change new Ten --title Ten
rhiza add capability ten-leaf
rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves ten
rhiza propose
rhiza accept --reason ok

rhiza change new Nine --title Nine
rhiza add capability nine-leaf
rhiza link 01M5PWGW4RMJ580CPWEPP3158J serves nine
rhiza propose
rhiza accept --reason ok

rhiza roadmap --json
stdout '(?s)"handle": "nine".*"handle": "ten"'

exec rm $WORK/detach.log
rhiza daemon --permission-mode manual --once --max-runs 1
stdout -count=1 '^Started a run of 01M5PWGW4RMJ580CPWEPP3158J'
exec sh -c 'grep -c "run start" $WORK/detach.log'
stdout '^1$'
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
