# run start --autonomous starts a run without the owner: the journal's
# started entry records it, run status shows it, and every agent the run
# launches has RHIZA_AUTONOMOUS=1. A resume keeps it without the flag. A
# run started without the flag has none of these, even when the terminal
# has RHIZA_AUTONOMOUS set.
#
# The fake rex runs the tab's command synchronously in the window's
# directory; the fake claude logs its prompt (the step) and its
# RHIZA_AUTONOMOUS, then exits 0. The run's worktree is a sibling of the
# repo, so ../go is $WORK/go.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Autonomous runs' --title 'Autonomous runs' --json
stdout '"change_set": "[0-9A-Z]{26}"'
mkdir .rhiza/workflows
cp $WORK/twoagents.toml .rhiza/workflows/twoagents.toml

# A dry run shows it, and writes nothing.
exec rhiza run start --foreground --workflow twoagents --permission-mode manual --autonomous --dry-run --json
stdout '"autonomous": true'
! exists $WORK/agents.log

# The autonomous run launches step one's agent, then stops at the wait.
exec rhiza run start --foreground --workflow twoagents --permission-mode manual --autonomous --no-wait
stdout '^Run 01M5PWGJC82P7YGZTWYFFZ0VJG stopped$'
stdout '^- Autonomous: yes$'
stdout '^- Current step: gate$'
grep '"type":"started".*"autonomous":true' .git/rhiza/runs/01M5PWGJC82P7YGZTWYFFZ0VJG.jsonl
exec rhiza run status --json
stdout '"autonomous": true'
exec rhiza run status
stdout '^- Autonomous: yes$'
exec cat $WORK/agents.log
stdout -count=1 '^one autonomous=1$'

# A resume without the flag keeps it: step two's agent has it too.
exec sh -c 'echo > $WORK/go'
exec rhiza run resume 01M5PWGJC82P7YGZTWYFFZ0VJG
stdout '^Run 01M5PWGJC82P7YGZTWYFFZ0VJG succeeded$'
stdout '^- Autonomous: yes$'
exec cat $WORK/agents.log
stdout '^two autonomous=1$'
! stdout 'autonomous=unset'

# A run without the flag: no autonomous in the journal, status or the
# agent's environment, though the terminal has RHIZA_AUTONOMOUS.
rm $WORK/go
rm $WORK/agents.log
env RHIZA_AUTONOMOUS=1
exec rhiza run start --foreground --workflow twoagents --permission-mode manual --no-wait --json
! stdout '"autonomous":'
exec rhiza run status
! stdout '^- Autonomous:'
exec sh -c 'grep "\"type\":\"started\"" .git/rhiza/runs/*.jsonl | grep -vc \"autonomous\"'
stdout '^1$'
exec cat $WORK/agents.log
stdout '^one autonomous=unset$'
! stdout 'autonomous=1'

fold-ok

-- twoagents.toml --
name = "twoagents"

[step.one]
kind = "agent"
prompt = "one"
interval = "50ms"
on.pass = "gate"

[step.gate]
kind = "wait"
until = "test -f ../go"
timeout = "30s"
interval = "50ms"
on.pass = "two"
on.timeout = "failed"

[step.two]
kind = "agent"
prompt = "two"
interval = "50ms"
on.pass = "done"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
for a; do last=$a; done
echo "$last autonomous=${RHIZA_AUTONOMOUS-unset}" >> "$WORK/agents.log"
exit 0
