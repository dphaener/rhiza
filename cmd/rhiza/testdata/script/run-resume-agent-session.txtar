# run resume refuses inside an agent session (RHIZA_SESSION set), naming
# the session and journaling nothing; with it cleared the resume goes on.

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Resume a run' --title 'Run resume' --json
mkdir .rhiza/workflows
cp ../one.toml .rhiza/workflows/one.toml

exec rhiza run start --foreground --workflow one --no-wait
stdout '^Run ([0-9A-Z]{26}) stopped$'
exec sh -c 'cat .git/rhiza/runs/* > ../before'

env RHIZA_SESSION=01SESSIONFORTESTING
! exec sh -c 'rhiza run resume --foreground $(ls .git/rhiza/runs | sed "s/\..*//" | head -1)'
stderr '01SESSIONFORTESTING'
exec sh -c 'cat .git/rhiza/runs/* > ../after; cmp ../before ../after'

env RHIZA_SESSION=
exec sh -c 'touch ../go; rhiza run resume --foreground $(ls .git/rhiza/runs | sed "s/\..*//" | head -1)'
stdout 'succeeded$'

-- one.toml --
name = "one"

[step.a]
kind = "wait"
until = "test -f ../go"
timeout = "30s"
interval = "50ms"
on.pass = "done"
