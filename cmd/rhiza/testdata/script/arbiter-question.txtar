# An autonomous run's agent step whose session blocks on a question does
# not wait on the owner: the engine adds the question, as the session
# reported it, as a question node in the run's change set, journals an
# asked entry, and launches the arbiter on its ID. A failing arbiter ends
# the run failed, naming the question. A normal run is blocked on the
# owner, as before: no question node, no arbiter.
#
# One fake claude plays both roles, by its prompt (its last argument). The
# asking agent reports an AskUserQuestion through the real hook path (in
# an autonomous run it then goes idle, as the denied call tells it to),
# then waits (bounded) for the arbiter's answer to be typed as a message,
# for a failed arbiter to finish, or for $WORK/answer, and exits 0. The
# arbiter logs its prompt, then per $WORK/mode writes the answering
# Decision with rhiza apply (answer) or nothing (none), says
# done and exits 0. The fake rex runs the tab in the background, so the
# agent step keeps polling.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Blocked runs' --title 'Blocked runs' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
mkdir .rhiza/workflows
cp $WORK/ask.toml .rhiza/workflows/ask.toml
# Commit the owner's actor, so the agents' writes in the worktree can
# name it as their for-actor.
exec git add -A
exec git commit -qm 'Blocked runs'

# Inside Rex: a run's reports to the owner go to stderr.
env REX_BLOCK=block:root
env REX_SESSION=session:s1

# (a) Autonomous, and the arbiter answers: the run succeeds. No one is
# told of the block: the question is the arbiter's.
exec sh -c 'echo answer > $WORK/mode'
exec rhiza run start --foreground --workflow ask --permission-mode manual --autonomous
stdout '^Run [0-9A-Z]{26} succeeded$'
stderr 'step build: blocked on question'
stderr 'step build: session [0-9a-f-]+ asked question question-[0-9a-f]{8}-1 \([0-9A-Z]{26}\); the arbiter answers it'
stderr 'step build: arbiter pass on question [0-9A-Z]{26}: answered by assume-blue'
! stderr 'state=blocked'
stderr -count=1 'state=working'

# The run's change set has the question node, its statement the question
# the session reported and its session field the asking session.
cd ../repo.blocked-runs
exec rhiza ls --kind question --view what-if:01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout -count=1 '"handle": "question-[0-9a-f]{8}-1"'
exec sh -c 'rhiza ls --kind question --view what-if:01M5PWGEF85Y185JZ2ZGCNH40N --json | sed -n "s/.*\"id\": \"\([0-9A-Z]*\)\".*/\1/p" | head -1 > $WORK/qid'
exec sh -c 'rhiza show $(cat $WORK/qid) --view what-if:01M5PWGEF85Y185JZ2ZGCNH40N --json'
stdout '"statement": "Which colour\?"'
stdout '"session": "[0-9a-f-]{36}"'
cd ../repo

# The journal has the asked and arbiter entries naming it, and the
# arbiter's prompt names it.
exec sh -c 'grep "\"type\":\"asked\"" .git/rhiza/runs/*.jsonl | grep "\"detail\":\"Which colour?\"" | grep -c "\"question\":\"$(cat $WORK/qid)\",\"handle\":\"question-"'
stdout '^1$'
exec sh -c 'grep "\"type\":\"arbiter\"" .git/rhiza/runs/*.jsonl | grep -c "\"question\":\"$(cat $WORK/qid)\""'
stdout '^1$'
exec sh -c 'grep -c "^Decide question $(cat $WORK/qid): follow rhiza guide arbiter.$" $WORK/arbiter.log'
stdout '^1$'

# The answer was typed into the asking session's tab.
exec cat $WORK/typed.log
stdout -count=1 '^send-key -b block:b1 enter$'

# (b) Autonomous, and the arbiter writes nothing: the run fails, naming
# the question.
exec sh -c 'echo none > $WORK/mode'
rm $WORK/arbiter.done
rm $WORK/typed.log
! exec rhiza run start --foreground --workflow ask --permission-mode manual --autonomous
stdout '^Run [0-9A-Z]{26} failed$'
! stderr 'state=blocked'
exec rhiza run status
stdout '^Run [0-9A-Z]{26} failed$'
stdout 'arbiter failed on question question-[0-9a-f]{8}-1 \([0-9A-Z]{26}\): no live Decision answers question [0-9A-Z]{26}'
exec cat $WORK/arbiter.log
stdout -count=2 '^Decide question [0-9A-Z]{26}: follow rhiza guide arbiter\.$'
# The asking agent is released and exits.
exec sh -c 'i=0; until [ "$(grep -c exited $WORK/asker.log)" = 2 ]; do i=$((i+1)); [ $i -gt 400 ] && exit 1; sleep 0.025; done'

# (c) A normal run: blocked on the owner, no question node, no arbiter.
rm $WORK/arbiter.done
exec rhiza run start --foreground --workflow ask --permission-mode manual &
exec sh -c 'i=0; while [ $i -lt 400 ]; do rhiza run status | grep -q "^Run .* blocked$" && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec rhiza run status
stdout '^Run [0-9A-Z]{26} blocked$'
stdout '^- Question: Which colour\?$'
cd ../repo.blocked-runs
exec rhiza ls --kind question --view what-if:01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout -count=2 '"handle": "question-'
cd ../repo
exec cat $WORK/arbiter.log
stdout -count=2 '^Decide question'
exec sh -c 'grep -l "\"type\":\"asked\"" .git/rhiza/runs/*.jsonl | wc -l'
stdout '^ *2$'
exec sh -c 'i=0; while [ $i -lt 400 ]; do grep -l "\"type\":\"blocked\"" .git/rhiza/runs/*.jsonl | wc -l | grep -q 3 && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec sh -c 'echo > $WORK/answer'
wait
stdout '^Run [0-9A-Z]{26} succeeded$'
# The owner was told of the block, and of its end: the run's working
# status again, as it was before the block.
stderr -count=1 ']7501;state=blocked:kind=question:app=rhiza:'
stderr -count=2 ']7501;state=working:app=rhiza:title='

fold-ok

-- ask.toml --
name = "ask"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "done"
on.fail = "done"

[step.decide]
kind = "arbiter"
interval = "50ms"
-- bin/rex --
#!/bin/sh
case "$1" in
events)
	exit 0
	;;
send | send-key)
	echo "$*" >> "$WORK/typed.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
for a; do last=$a; done
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
case "$last" in
*'rhiza guide arbiter'*)
	echo "$last" >> "$WORK/arbiter.log"
	q=$(printf '%s\n' "$last" | sed -n 's/^Decide question \([0-9A-Z]*\):.*/\1/p')
	if [ "$(cat "$WORK/mode")" = answer ]; then
		printf '{"writes":[{"op":"add","kind":"decision","handle":"assume-blue","fields":["statement=Use blue","wording=(assumed, would have escalated)","reasoning=Blue is the brand colour"]},{"op":"link","from":"assume-blue","type":"answers","to":"%s"}]}\n' "$q" > "$WORK/decision.json"
		rhiza apply "$WORK/decision.json" --json >> "$WORK/apply.out" || exit 7
	fi
	rhiza session done >> "$WORK/done.out" || exit 6
	echo > "$WORK/arbiter.done"
	exit 0
	;;
esac
echo '{"session_id":"'$sid'","hook_event_name":"PreToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Which colour?"}]}}' | rhiza session hook PreToolUse >> "$WORK/hook.out" || exit 8
if [ "$RHIZA_AUTONOMOUS" = 1 ]; then
	echo '{"session_id":"'$sid'","hook_event_name":"Stop"}' | rhiza session hook Stop >> "$WORK/hook.out" || exit 8
fi
i=0
until grep -q '^send-key ' "$WORK/typed.log" 2>/dev/null || [ -f "$WORK/answer" ] ||
	{ [ -f "$WORK/arbiter.done" ] && [ "$(cat "$WORK/mode")" != answer ]; }; do
	i=$((i + 1))
	if [ $i -gt 800 ]; then
		echo 'no answer' >&2
		exit 9
	fi
	sleep 0.025
done
echo exited >> "$WORK/asker.log"
exit 0
