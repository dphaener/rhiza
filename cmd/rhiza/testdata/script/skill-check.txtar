# rhiza skill check runs an invoke as a builder's session against a
# one-leaf fixture change set in a scratch repo outside every git
# repository, through a one-step workflow in the foreground, and reports
# each gate: session-done, trailers (Change:, Actor: and Leaf:) and check.
# Any failed gate exits 1; --json prints the same gates. An invoke whose
# skill is not installed is refused before anything runs. The current
# repo never changes.
#
# The fake rex runs each tab's command synchronously. The fake claude, as
# a builder, picks its behaviour from its prompt: good renders and
# commits everything with the three trailers and says done, bare commits
# with no trailers, quiet commits with the trailers and never says done, fail commits with the
# trailers and exits 1. As a verifier it writes its own Evidence.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza guide install --agent claude
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cp stdout $WORK/before

# A builder that commits with the three trailers and says done passes.
exec rhiza skill check '/rhiza-builder good {leaf}' --role builder --permission-mode manual
stdout '^skill check /rhiza-builder good \{leaf\} as builder passes: 3 of 3 gates pass$'
stdout '^  pass session-done +the builder ran rhiza session done$'
stdout '^  pass trailers +commit \w+ carries Change:, Actor: and Leaf: trailers$'
stdout '^  pass check +rhiza check is clean at the builder''s commit \w+$'
# The fixture's own stop at its verifier, which never runs, is skill
# check's stop: no failure, no install advice.
stdout '^  run: stopped by skill check after the builder: the fixture starts no other role''s session$'
! stdout 'rhiza-skill-check-unused|guide install'
exec grep -c '^builder greeting-file good' $WORK/claude.log
stdout '^1$'
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before

# --json prints the same gates, pass each.
exec rhiza skill check '/rhiza-builder good {leaf}' --permission-mode manual --json
stdout '"passed": true'
stdout '"name": "session-done",\s+"result": "pass"'
stdout '"name": "trailers",\s+"result": "pass"'
stdout '"name": "check",\s+"result": "pass"'
! stdout '"scratch"'

# A builder that commits without trailers fails the trailer gate.
! exec rhiza skill check '/rhiza-builder bare {leaf}' --role builder --permission-mode manual
stdout 'as builder fails: 2 of 3 gates pass$'
stdout '^  fail trailers +none of the builder''s 1 commit\(s\) carries all of Change: \w+, Actor: and Leaf: greeting-file$'
stdout '^  pass session-done'
! exec rhiza skill check '/rhiza-builder bare {leaf}' --permission-mode manual --json
stdout '"passed": false'
stdout '"name": "trailers",\s+"result": "fail"'
stdout '"name": "session-done",\s+"result": "pass"'
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before

# A builder that never says done fails the session-done gate.
! exec rhiza skill check '/rhiza-builder quiet {leaf}' --role builder --permission-mode manual
stdout 'as builder fails: 2 of 3 gates pass$'
stdout '^  fail session-done +the builder never ran rhiza session done before it exited$'
stdout '^  pass trailers'
! exec rhiza skill check '/rhiza-builder quiet {leaf}' --permission-mode manual --json
stdout '"name": "session-done",\s+"result": "fail"'
stdout '"name": "trailers",\s+"result": "pass"'
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before

# A builder that fails is launched once: its attempt is not retried, and
# no verifier starts after any builder.
! exec rhiza skill check '/rhiza-builder fail {leaf}' --role builder --permission-mode manual
stdout 'as builder fails: '
exec grep -c '^builder greeting-file fail' $WORK/claude.log
stdout '^1$'
! exec grep '^verifier' $WORK/claude.log
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before

# --keep keeps the scratch repo, outside the current repo, and names it.
exec sh -c 'rhiza skill check "/rhiza-builder good {leaf}" --permission-mode manual --keep | sed -n "s/^  scratch repo kept: //p" > $WORK/kept'
exec cat $WORK/kept
stdout '/repo$'
exec sh -c 'cd "$(cat $WORK/kept)" && git log --format=%s -1 && ls .rhiza/workflows'
stdout '^fixture$'
stdout '^skill-check.toml$'
exec sh -c 'case "$(cat $WORK/kept)" in "$PWD"*) echo inside;; *) echo outside;; esac'
stdout '^outside$'
exec sh -c 'rm -rf "$(dirname "$(cat $WORK/kept)")"'
exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before

# An invoke whose skill is not installed is refused before anything runs.
exec rm -r $HOME/.claude/skills/rhiza/skills/rhiza-builder $HOME/.claude/commands
exec sh -c 'wc -l < $WORK/claude.log > $WORK/calls'
! exec rhiza skill check '/rhiza-builder good {leaf}' --role builder --permission-mode manual
stderr 'start command /rhiza-builder unknown to claude: skill not installed; run rhiza guide install --agent claude'
exec sh -c 'wc -l < $WORK/claude.log'
cmp stdout $WORK/calls

# An unknown role is refused.
! exec rhiza skill check 'Build {leaf}' --role planner --permission-mode manual
stderr 'unknown role "planner": want builder'

exec sh -c 'git status --porcelain; ls -R .rhiza/log'
cmp stdout $WORK/before
fold-ok

-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
if [ "$RHIZA_ROLE" = builder ]; then
	case "$*" in
	*good*) mode=good ;;
	*bare*) mode=bare ;;
	*quiet*) mode=quiet ;;
	*fail*) mode=fail ;;
	esac
	echo "builder $RHIZA_LEAF $mode $RHIZA_ATTEMPT" >> "$WORK/claude.log"
	echo hello > GREETING
	rhiza render >&2
	git add -A
	if [ "$mode" = bare ]; then
		git commit -qm "build $RHIZA_LEAF"
		rhiza session done >&2
		exit 0
	fi
	git commit -qm "build $RHIZA_LEAF" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Leaf: $RHIZA_LEAF"
	if [ "$mode" = good ]; then
		rhiza session done >&2
	fi
	if [ "$mode" = fail ]; then
		exit 1
	fi
	exit 0
fi
echo "verifier $RHIZA_LEAF" >> "$WORK/claude.log"
rhiza add evidence "$RHIZA_LEAF-ok" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
rhiza link "$RHIZA_LEAF-ok" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
exit 0
