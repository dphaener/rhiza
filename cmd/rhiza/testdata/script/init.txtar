# init creates .rhiza with repo.json, an empty log (holding only a
# .gitkeep, so git keeps the folder) and a .gitignore that keeps local/ (the
# current change set) out of git.
mkdir proj
cd proj
exec git init -q
exec rhiza init
stdout '^Initialised a Rhiza repository in .*proj \(repo [0-9A-Z]{26}\)\.$'
stdout '^next: rhiza change new "<intent>"$'
! stderr .
exists .rhiza/repo.json
exists .rhiza/log
exists .rhiza/log/.gitkeep
cmp .rhiza/.gitignore $WORK/want.gitignore
fold-ok

# A second init is a conflict: exit 3, with a next command.
! exec rhiza init
stderr '^rhiza: a Rhiza repository already exists in '
stderr '^next: rhiza change ls$'
! stdout .
! exec rhiza init --json
stdout '"code": "conflict"'
! stderr .

# So is init in a folder below a repository: the root is found upwards.
mkdir sub
cd sub
! exec rhiza init --json
stdout '"code": "conflict"'
! exists .rhiza

# init writes no log entry, so --dry-run is a usage error and does nothing.
mkdir $WORK/fresh
cd $WORK/fresh
! exec rhiza init --dry-run --json
stdout '"code": "usage"'
! exists .rhiza

# --json gives the repo ID and the absolute root.
exec rhiza init --json
stdout '"repo": "[0-9A-Z]{26}"'
stdout '"root": "/.*fresh"'
fold-ok

-- want.gitignore --
local/
