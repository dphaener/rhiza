# init creates .rhiza with repo.json, an empty log (holding only a
# .gitkeep, so git keeps the folder) and a .gitignore that keeps local/ (the
# current change set) out of git. With no terminal on stdin it asks
# nothing: the project's agent is the default adapter, written to
# rhiza.project.agent in git config.
mkdir proj
cd proj
exec git init -q
stdin $WORK/answer
exec rhiza init
stdout '^Initialised a Rhiza repository in .*proj \(repo [0-9A-Z]{26}\)\.$'
stdout '^Agent: claude-code, written to rhiza.project.agent in git config\.$'
stdout '^next: rhiza change new "<intent>"$'
! stderr .
exec git config --get rhiza.project.agent
stdout '^claude-code$'
exists .rhiza/repo.json
exists .rhiza/log
exists .rhiza/log/.gitkeep
cmp .rhiza/.gitignore $WORK/want.gitignore
fold-ok

# A second init is a conflict: exit 3, with a next command.
! exec rhiza init
stderr '^rhiza: a Rhiza repository already exists in '
stderr '^next: rhiza change ls$'
! stdout .
! exec rhiza init --json
stdout '"code": "conflict"'
! stderr .

# So is init in a folder below a repository: the root is found upwards.
mkdir sub
cd sub
! exec rhiza init --json
stdout '"code": "conflict"'
! exists .rhiza

# init writes no log entry, so --dry-run is a usage error and does nothing.
mkdir $WORK/fresh
cd $WORK/fresh
! exec rhiza init --dry-run --json
stdout '"code": "usage"'
! exists .rhiza

# An unknown --agent is a usage error naming the registered adapters, and
# creates nothing.
! exec rhiza init --agent nope
stderr '^rhiza: --agent "nope" is not a registered agent adapter: want one of claude-code$'
stderr '^next: rhiza init --agent <agent>$'
! exists .rhiza

# --json gives the repo ID, the absolute root and the agent, here outside
# a git repository: no setting is written.
exec rhiza init --json --agent claude-code
stdout '"repo": "[0-9A-Z]{26}"'
stdout '"root": "/.*fresh"'
stdout '"agent": "claude-code"'
stdout '"saved": false'
fold-ok

# Outside a git repository the text says how to set the agent later.
mkdir $WORK/nogit
cd $WORK/nogit
exec rhiza init
stdout '^Agent: claude-code, not written: this is not a git repository\. Once it is one, run rhiza daemon set rhiza.project.agent claude-code\.$'

# Inside one, --agent is written and --json says so.
mkdir $WORK/flag
cd $WORK/flag
exec git init -q
exec rhiza init --json --agent claude-code
stdout '"agent": "claude-code"'
stdout '"saved": true'
exec git config --get rhiza.project.agent
stdout '^claude-code$'

-- answer --
nope
-- want.gitignore --
local/
