# ready says which change sets can be worked on now and why the others
# can't. A change set's serves and depends-on links are written inside it
# (D7), naming the change set by its ID.

rhiza init

# Nothing in flight.
rhiza ready
stdout '^Nothing is ready: no change set is in flight\.$'
stdout '^next: rhiza change new "<intent>"$'

rhiza add intent fast --record
rhiza add capability store --record

# A serves fast, from inside A; a draft is not ready.
rhiza change new A
stdout 'change set 01M5PWGQ8GB4618G4RH2TV0ZAH '
rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves fast
fold-ok
rhiza ready
stdout '^Nothing is ready\.$'
stdout '^01M5PWGQ8GB461 A: not accepted: draft$'
stdout '^- \[draft\] 01M5PWGQ8GB461 A$'
rhiza propose
rhiza accept --reason ok

# B depends on A, from inside B, and touches store.
rhiza change new B
stdout 'change set 01M5PWGV5G8W2RPXNBFMN118QF '
rhiza link 01M5PWGV5G8W2RPXNBFMN118QF depends-on 01M5PWGQ8GB4618G4RH2TV0ZAH
fold-ok
rhiza set store --field statement=Kept
rhiza propose
rhiza accept --reason ok

# A is next; B waits for A to land. The current change set (B) does not
# change the default view: it is to-be (D17).
rhiza ready
stdout '^next: 01M5PWGQ8GB461 A$'
stdout '^## Ready$'
stdout '^- 01M5PWGQ8GB461 A$'
stdout '^## Not ready$'
stdout '^- \[accepted\] 01M5PWGV5G8W2R B$'
stdout '^  - depends on 01M5PWGQ8GB461 \(accepted\)$'
rhiza ready --json
stdout '"next": "01M5PWGQ8GB4618G4RH2TV0ZAH"'
stdout '"view": "to-be"'
stdout '"depends on 01M5PWGQ8GB461 \(accepted\)"'

# Land A: B is next.
rhiza land --change 01M5PWGQ8GB4618G4RH2TV0ZAH
rhiza ready
stdout '^next: 01M5PWGV5G8W2R B$'
! stdout 'Not ready'

# An open question blocking a node B touches stops it.
rhiza add question which-disk --record
rhiza link which-disk blocks store --record
rhiza ready
stdout '^Nothing is ready\.$'
stdout '^01M5PWGV5G8W2R B: blocked by question which-disk on store$'
rhiza ready --json
! stdout '"next"'
stdout '"ready": false'
stdout '"reasons": \[\n *"blocked by question which-disk on store"'

# Answered by a decision, it no longer blocks.
rhiza add decision ssd --record
rhiza link ssd answers which-disk --record
rhiza ready
stdout '^next: 01M5PWGV5G8W2R B$'

# --view overrides the default; api call prints the same bytes as --json.
rhiza ready --view as-is --json
stdout '"view": "as-is"'
cp stdout ready.json
rhiza api call ready '{"view":"as-is"}'
cmp stdout ready.json
! rhiza ready --view what-if:ZZZZ
stderr 'no change set'


# Milestone work comes first: Q serves a milestone, so it is next though
# B and P, in the backlog, are ready and have smaller IDs.
rhiza add intent ms --field milestone=2 --record
rhiza change new P
stdout 'change set 01M5PWHFNRPA4JTNZM0B6MMB0H '
rhiza propose
rhiza accept --reason ok
rhiza change new Q
stdout 'change set 01M5PWHJKGRCC1XHQD183TPV5R '
rhiza link 01M5PWHJKGRCC1XHQD183TPV5R serves ms
rhiza propose
rhiza accept --reason ok
rhiza ready
stdout '^next: 01M5PWHJKGRCC1 Q$'
stdout '^- 01M5PWHFNRPA4J P$'
