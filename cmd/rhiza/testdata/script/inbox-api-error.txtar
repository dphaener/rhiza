# A live run's session whose hook report is idle with the API-error detail is an
# inbox item of kind api-error, never stalled however old; its next hook
# report clears it. The session record is written by hand.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Erroring runs' --title 'Erroring runs' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'

mkdir .rhiza/workflows
cp $WORK/work.toml .rhiza/workflows/work.toml
env REX_BLOCK=block:root
env REX_SESSION=session:s1
exec rhiza run start --foreground --workflow work --permission-mode manual &

# Wait (bounded) until the agent has reported working through its hook.
exec sh -c 'i=0; while [ $i -lt 400 ]; do grep -q "\"hook\"" "$WORK"/repo/.git/rhiza/sessions/*.json && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'

# An autonomous session idle with the API-error detail since 00:00:00.
edit-sessions autonomous
edit-sessions hook-state idle api-error 'stopped on an API error: API Error: 403 Attention Required!'
edit-sessions hook-at 2030-01-01T00:00:00Z

env RHIZA_TEST_NOW=2030-01-01T00:21:00Z
exec rhiza inbox --json
stdout '"kind": "api-error"'
stdout '"step": "build"'
stdout '"at": "2030-01-01T00:00:00Z"'
stdout 'stopped on an API error: API Error: 403 Attention Required!'
stdout '"session": "'
stdout '"run": "'
stdout '"next": "rhiza session message [0-9A-Za-z-]+ <text>"'
! stdout '"stalled"'
exec rhiza inbox
stdout 'api-error run [0-9A-Za-z]+, change set [0-9A-Z]+, step build'
stdout 'API Error: 403 Attention Required!'
stdout 'next: rhiza session message'

# A plain idle report of the same age is stalled instead.
edit-sessions hook-state idle api-error ''
exec rhiza inbox --json
stdout '"kind": "stalled"'
! stdout '"api-error"'

# A later working hook report clears the item.
edit-sessions hook-state idle api-error 'stopped on an API error: API Error: 403 Attention Required!'
edit-sessions hook-state working api-error ''
env RHIZA_TEST_NOW=2030-01-01T00:05:00Z
exec rhiza inbox --json
! stdout '"api-error"'

exec sh -c 'echo > $WORK/go'
wait

-- work.toml --
name = "work"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "done"
-- bin/rex --
#!/bin/sh
echo "$@" >> "$WORK/rex.log"
if [ "$1" = events ]; then
	exit 0
fi
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
echo '{"session_id":"'$sid'","hook_event_name":"UserPromptSubmit"}' | rhiza session hook UserPromptSubmit >> "$WORK/hook.out" || exit 8
i=0
until [ -f "$WORK/go" ]; do
	i=$((i + 1))
	if [ $i -gt 800 ]; then
		exit 9
	fi
	sleep 0.025
done
exit 0
