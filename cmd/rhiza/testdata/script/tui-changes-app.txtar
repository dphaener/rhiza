# The changes app shows the landed change sets not seen yet, newest first,
# with PR numbers. --once prints them as JSON and marks them seen in
# .git/rhiza/feed.json; a change set landed later appears on the next look.
# It never dials Rex, starts a daemon or binds a socket.

env REX_SESSION=
env REX_SERVER=
exec git init -q
env RHIZA_TEST_NOW=2026-10-25T12:00:00Z
exec rhiza init
exec rhiza add capability alpha --record --field 'statement=Alpha'
env RHIZA_TEST_NOW=2026-10-26T12:00:00Z
exec rhiza add capability beta --record --field 'statement=Beta'
exec rhiza add evidence beta-ci --record --field 'statement=Pull request #7 passed CI' --field 'pr=https://github.com/o/r/pull/7' --field 'status=verified'
exec rhiza link beta-ci verifies beta --record

# Newest first, the PR number on the one that has it.
exec rhiza tui app changes --once
stdout '"pr": 7'
stdout '(?s)add evidence.*add capability beta.*add capability alpha'
exists .git/rhiza/feed.json

# Seen now: a second look lists none.
exec rhiza tui app changes --once
stdout '"change_sets": \[\]'

# Something landed later appears, alone.
env RHIZA_TEST_NOW=2026-10-27T12:00:00Z
exec rhiza add capability gamma --record --field 'statement=Gamma'
exec rhiza tui app changes --once
stdout -count=1 '"title"'
stdout 'gamma'
exec rhiza tui app changes --once
stdout '"change_sets": \[\]'

! exec rhiza tui app changes --bogus
stderr 'takes \[--once\]'

! exists .git/rhiza/daemon.lock
exec find $WORK -type s
! stdout .
