# roadmap lists an umbrella change set (one serving an intent with a
# non-empty umbrella field) only in that intent's umbrella group, after
# the milestones and the backlog.

rhiza init

rhiza add intent m1 --field milestone=1 --record
rhiza add intent umb --field umbrella=yes --record

# U serves the umbrella.
rhiza change new U
stdout 'change set 01M5PWGQ8GB4618G4RH2TV0ZAH '
rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves umb
rhiza propose

# V serves the umbrella and the milestone: the umbrella group only.
rhiza change new V
stdout 'change set 01M5PWGT68X5XKB54XFQMHKA0A '
rhiza link 01M5PWGT68X5XKB54XFQMHKA0A serves m1
rhiza link 01M5PWGT68X5XKB54XFQMHKA0A serves umb
rhiza propose

# W serves the milestone, X nothing.
rhiza change new W
stdout 'change set 01M5PWGY38TY4APFS7ZR0Q10WA '
rhiza link 01M5PWGY38TY4APFS7ZR0Q10WA serves m1
rhiza propose
rhiza change new X
stdout 'change set 01M5PWH110D047SG185GTXKBCB '
rhiza propose
fold-ok

rhiza roadmap --json
stdout '"kind": "milestone"[^\x00]*"kind": "backlog"[^\x00]*"kind": "umbrella"'
stdout -count=1 '"id": "01M5PWGT68X5XKB54XFQMHKA0A"'
stdout -count=1 '"id": "01M5PWGQ8GB4618G4RH2TV0ZAH"'
cp stdout roadmap.json
rhiza roadmap
stdout '(?s)## m1.*## Backlog.*## umb'
rhiza api call roadmap '{}'
cmp stdout roadmap.json

# An umbrella change set is never ready; next skips it.
rhiza change use 01M5PWGQ8GB4618G4RH2TV0ZAH
rhiza accept --reason ok
rhiza change use 01M5PWGY38TY4APFS7ZR0Q10WA
rhiza accept --reason ok
rhiza ready --json
stdout '"umbrella: work is carved out of it"'
stdout '"next": "01M5PWGY38TY4APFS7ZR0Q10WA"'
