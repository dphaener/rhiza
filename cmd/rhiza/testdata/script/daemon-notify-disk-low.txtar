# The daemon's disk-low notice follows the poll that found it, not the state
# saved by the poll before: the first low poll, even with --once, sends it,
# and a poll that finds enough space sends none. The notice text is base64:
# ZGlzayBzcGFjZSBpcyBsb3c is "disk space is low".

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
env REX_BLOCK=block:b0

env RHIZA_TEST_FREE_BYTES=1073741824
exec rhiza daemon --permission-mode manual --once
stderr -count=1 'state=blocked'
stderr 'msg=ZGlzayBzcGFjZSBpcyBsb3c'

# Still low: notified already, nothing sent.
exec rhiza daemon --permission-mode manual --once
! stderr 'state=blocked'

# Enough space again: no false disk-low notice.
env RHIZA_TEST_FREE_BYTES=21474836480
exec rhiza daemon --permission-mode manual --once
! stderr 'state=blocked'
! stderr 'msg=ZGlzayBzcGFjZSBpcyBsb3c'

# Low again: a new notice.
env RHIZA_TEST_FREE_BYTES=1073741824
exec rhiza daemon --permission-mode manual --once
stderr -count=1 'state=blocked'
