# rhiza docs writes the CLI reference from the op registry.
exec rhiza docs --out $WORK/out
stdout 'cli.md'
grep '^## rhiza request$' out/cli.md
# Both flags sit in the request command's own section: no heading line
# comes between "## rhiza request" and them.
grep '(?s)^## rhiza request\n(?:[^\n]|\n[^#])*\n- `--kind`: feature, bug or milestone' out/cli.md
grep '(?s)^## rhiza request\n(?:[^\n]|\n[^#])*\n- `--milestone`: ' out/cli.md
grep '^- `4`: Not found' out/cli.md

# Same registry, same bytes; the second run changes nothing.
cp out/cli.md first.md
exec rhiza docs --out $WORK/out
stdout '3 unchanged'
! stdout 'wrote'
cmp out/cli.md first.md
