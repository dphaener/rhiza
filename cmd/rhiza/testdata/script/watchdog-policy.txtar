# The watchdog's policy keys: machine keys under [daemon] in rhiza.toml, project
# keys in git config, each listed by daemon settings with source and scope.

mkdir repo
cd repo
exec git init -q
exec rhiza init

exec rhiza daemon settings
stdout 'rhiza.daemon.watchdog.enabled = true \(default, machine\)'
stdout 'rhiza.daemon.watchdog.agentNudge = 20m \(default, machine\)'
stdout 'rhiza.daemon.watchdog.agentRetry = 40m \(default, machine\)'
stdout 'rhiza.daemon.watchdog.commandLimit = 30m \(default, machine\)'
stdout 'rhiza.daemon.watchdog.waitLimit = 90m \(default, machine\)'
stdout 'rhiza.daemon.watchdog.retryBudget = 2 \(default, machine\)'
stdout 'rhiza.daemon.watchdog.ciReruns = 1 \(default, machine\)'
stdout 'rhiza.daemon.watchdog.pollBehind = 3 \(default, machine\)'
stdout 'rhiza.daemon.watchdog.fileBugs = true \(default, machine\)'
stdout 'rhiza.daemon.watchdog.autonomousOnly = true \(default, machine\)'
stdout 'rhiza.project.watchdog.retryBudget = 2 \(default, project\)'
stdout 'rhiza.project.watchdog.enabled = true \(default, project\)'
! stdout 'rhiza.project.watchdog.pollBehind'

exec rhiza daemon set rhiza.daemon.watchdog.retryBudget 4
exec rhiza daemon set rhiza.project.watchdog.retryBudget 1
exec rhiza daemon settings
stdout 'rhiza.daemon.watchdog.retryBudget = 4 \(rhiza.toml, machine\)'
stdout 'rhiza.project.watchdog.retryBudget = 1 \(git config, project\)'
exec git config --get rhiza.project.watchdog.retryBudget
stdout '^1$'

! exec rhiza daemon set rhiza.daemon.watchdog.agentNudge soon
stderr 'rhiza.daemon.watchdog.agentNudge'
! exec rhiza daemon set rhiza.project.watchdog.fileBugs maybe
stderr 'rhiza.project.watchdog.fileBugs'
! exec rhiza daemon set rhiza.project.watchdog.pollBehind 2
stderr 'unknown setting'

fold-ok
