# The daemon starts and resumes nothing new while the machine is overloaded:
# a hold begins when the 1-minute load per core is over rhiza.daemon.maxLoad
# and ends only when the 5-minute load is back under it; MemAvailable under
# rhiza.daemon.minMemory holds too. Readings come from test env vars (loads
# per core, bytes); Setup gives every script an idle machine. rhiza daemon
# status shows the last poll's readings and the hold, why and since when; the
# daemon log (its stderr) has one line when a hold begins and one when it ends.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_DETACH_LOG=$WORK/detach.log
mkdir repo
cd repo
exec git init -q
rhiza init
exec sh -c 'printf "[schedule]\nbacklog = \"skip\"\n" > .rhiza/policy.toml'
rhiza add intent m --field milestone=1 --record
exec git add -A
exec git commit -qm init
rhiza change new Built --title Built
rhiza add capability built-leaf
rhiza link 01M5PWGMARA1WR6BD0MEF4Y76P serves m
rhiza propose
rhiza accept --reason ok

# Idle readings: shown, no hold, no log line.
rhiza daemon --permission-mode manual --once
stdout -count=1 '^Started a run of '
! stderr 'holding new runs'
! stderr 'released'
exec rm $WORK/detach.log
rhiza daemon status
stdout 'Load: 0.00 per core \(1 minute\), 0.00 \(5 minutes\)'
stdout 'Memory available: 1.0 TiB'
stdout 'New runs held: no'
rhiza daemon status --json
stdout '"load1": "0.00"'
stdout '"load5": "0.00"'
stdout '"bytes": 1099511627776'
! stdout '"hold"'

# 1-minute load over the limit: nothing starts, status says why.
env RHIZA_TEST_LOAD1=3.5
env RHIZA_TEST_LOAD5=3.5
rhiza daemon --permission-mode manual --once
! stdout 'Started'
! exists $WORK/detach.log
stderr -count=1 'holding new runs: load-high'
! stderr 'released'
rhiza daemon status --json
stdout '"load1": "3.50"'
stdout '"load5": "3.50"'
stdout '"reason": "load-high"'
stdout '"since": "[0-9T:Z-]+"'
stdout '"detail": "1-minute load 3.50 per core, over the limit of 3.00"'
rhiza daemon status
stdout 'Load: 3.50 per core \(1 minute\), 3.50 \(5 minutes\)'
stdout 'New runs held: load-high since [0-9T:Z-]+: 1-minute load 3.50 per core, over the limit of 3.00'
stdout 'machine load is high'

# 1-minute back under, 5-minute still over: still held.
env RHIZA_TEST_LOAD1=1
rhiza daemon --permission-mode manual --once
! stdout 'Started'
! exists $WORK/detach.log
! stderr 'holding new runs'
! stderr 'released'
rhiza daemon status --json
stdout '"reason": "load-high"'
stdout '5-minute load 3.50 per core, not yet under the limit of 3.00'
rhiza daemon status
stdout 'New runs held: load-high since'

# 5-minute under: the run starts.
env RHIZA_TEST_LOAD5=2
rhiza daemon --permission-mode manual --once
stdout -count=1 '^Started a run of '
stderr -count=1 'released the load-high hold on new runs'
! stderr 'holding new runs'
exec rm $WORK/detach.log
rhiza daemon status
stdout 'New runs held: no'

# Low memory holds with its own reason; the load is fine.
env RHIZA_TEST_LOAD1=0
env RHIZA_TEST_LOAD5=0
env RHIZA_TEST_MEM_AVAILABLE=1073741824
rhiza daemon --permission-mode manual --once
! stdout 'Started'
! exists $WORK/detach.log
rhiza daemon status --json
stdout '"reason": "memory-low"'
stdout '1.0 GiB available, under the minimum of 2.0 GiB'
rhiza daemon status
stdout 'Memory available: 1.0 GiB'

# A limit of 0 turns its check off.
rhiza daemon set rhiza.daemon.minMemory 0
rhiza daemon --permission-mode manual --once
stdout -count=1 '^Started a run of '
exec rm $WORK/detach.log
rhiza daemon set rhiza.daemon.minMemory 2G
env RHIZA_TEST_MEM_AVAILABLE=1099511627776
env RHIZA_TEST_LOAD1=9
env RHIZA_TEST_LOAD5=9
rhiza daemon set rhiza.daemon.maxLoad 0
rhiza daemon --permission-mode manual --once
stdout -count=1 '^Started a run of '
exec rm $WORK/detach.log
rhiza daemon set rhiza.daemon.maxLoad 3

# Readings unavailable on this platform: shown so, and no hold.
env RHIZA_TEST_LOAD1=unavailable
env RHIZA_TEST_LOAD5=unavailable
env RHIZA_TEST_MEM_AVAILABLE=unavailable
rhiza daemon --permission-mode manual --once
! stderr 'holding new runs'
rhiza daemon status
stdout 'Load: unavailable on this platform'
stdout 'Memory available: unavailable on this platform'
stdout 'New runs held: no'
rhiza daemon status --json
stdout '"available": false'
! stdout '"hold"'

-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
