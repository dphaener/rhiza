# workflow describe resolves as run start does and starts nothing. --json is
# the bytes of api call workflow.describe.

env XDG_CONFIG_HOME=$WORK/xdg
mkdir repo
cd repo
exec git init -q
rhiza init
fold-ok

# a built-in
rhiza workflow describe build
stdout '^build \(builtin\) builtin:build$'
stdout '^start '
stdout 'on\.pass ->'
stdout 'role builder models'
stdout '^  role verifier low_risk_models \[sonnet\]$'
stdout '^  role verifier risky_paths \[\*_test\.go, \*\*/\*_test\.go, \*\*/testdata/\*\*, .*\.github/\*\*.*\*\*/\*retry\*\]$'
! stdout '^autonomy '

# the same bytes as the api
rhiza workflow describe build --json
cp stdout build.json
rhiza api call workflow.describe '{"workflow":"build"}'
cmp stdout build.json
stdout '"path": "builtin:build"'

# a repo override that shadows the built-in
mkdir .rhiza/workflows
cp $WORK/w.toml .rhiza/workflows/build.toml
rhiza workflow describe build
stdout '^build \(repo\) .*/repo/.rhiza/workflows/build.toml$'
stdout '^  shadows builtin builtin:build$'
stdout '^start only$'
stdout '^only command$'

# the layer and shadows follow the resolved name, not the file's name =
cp $WORK/named.toml .rhiza/workflows/mine.toml
rhiza workflow describe mine
stdout '^custom \(repo\) .*/repo/.rhiza/workflows/mine.toml$'
! stdout 'shadows'
mkdir $WORK/xdg/rhiza/workflows
cp $WORK/named.toml $WORK/xdg/rhiza/workflows/mine.toml
rhiza workflow describe mine
stdout '^custom \(personal\) .*/xdg/rhiza/workflows/mine.toml$'
stdout '^  shadows repo .*/repo/.rhiza/workflows/mine.toml$'
rm $WORK/xdg/rhiza/workflows/mine.toml
rm .rhiza/workflows/mine.toml

# a file that includes another workflow
cp $WORK/inc.toml inc.toml
rhiza workflow describe inc.toml
stdout '^inc \(file\) '
stdout '^includes build$'
stdout '^build/only command$'
rhiza workflow describe inc.toml --json
cp stdout inc.json
rhiza api call workflow.describe '{"workflow":"inc.toml"}'
cmp stdout inc.json

# a workflow's declared autonomy, by stage in order
cp $WORK/aut.toml aut.toml
rhiza workflow describe aut.toml
stdout '^autonomy ship auto$'
stdout '^autonomy signoff owner$'
! stdout '^autonomy (plan|accept) '
rhiza workflow describe aut.toml --json
stdout '"mode": "owner",\n\s*"stage": "signoff"'
rhiza workflow describe build --json
stdout '"autonomy": \[\]'

# a workflow's cleanup steps, in order
cp $WORK/clean.toml clean.toml
rhiza workflow describe clean.toml
stdout '^cleanup drop-db: dropdb x$'
stdout '^cleanup cleanup-2: rm -rf tmp$'
rhiza workflow describe clean.toml --json
stdout '"name": "drop-db"'
rhiza workflow describe build --json
stdout '"cleanup": \[\]'

# a workflow's own [env], in name order, {run_tmp} as written
cp $WORK/env.toml env.toml
rhiza workflow describe env.toml
stdout '^env A_DIR=\{run_tmp\}/a$'
stdout '^env B_CMD=go build -o "\$A_DIR" \./x$'
rhiza workflow describe env.toml --json
stdout '"name": "A_DIR",\n\s*"value": "\{run_tmp\}/a"'
rhiza workflow describe build --json
stdout '"env": \[\]'

# a verifier's tiering fields
cp $WORK/tier.toml tier.toml
rhiza workflow describe tier.toml
stdout '^  role verifier low_risk_models \[sonnet\]$'
stdout '^  role verifier risky_paths \[\*\*/testdata/\*\*, \.github/\*\*\]$'
! stdout 'role builder low_risk'
rhiza workflow describe tier.toml --json
stdout '"low_risk_models": \[\s*"sonnet"\s*\]'
stdout '"risky_paths": \['
stdout '"low_risk_models": \[\]'

# a step's retry_from, and an included workflow's prefixed
cp $WORK/retry.toml .rhiza/workflows/retry.toml
rhiza workflow describe retry
stdout '^check command\n  on\.pass -> done\n  retry_from -> plan$'
rhiza workflow describe retry --json
stdout '"retry_from": "plan"'
stdout '"retry_from": ""'
cp $WORK/inc-retry.toml inc-retry.toml
rhiza workflow describe inc-retry.toml
stdout '^retry/check command\n  on\.fail -> failed\n  on\.pass -> after\n  retry_from -> retry/plan$'
stdout '^after command\n  retry_from -> retry/check$'

# nothing was written: no runs, and the model still folds
rhiza run ls
! stdout 'inc|build'
fold-ok

-- w.toml --
[step.only]
kind = "command"
run = "true"
-- named.toml --
name = "custom"
[step.only]
kind = "command"
run = "true"
-- tier.toml --
[step.build]
kind = "leaves"
[step.build.builder]
prompt = "build {leaf}"
[step.build.verifier]
prompt = "verify {leaf}"
models = ["opus"]
low_risk_models = ["sonnet"]
risky_paths = ["**/testdata/**", ".github/**"]
-- inc.toml --
[step.go]
kind = "workflow"
workflow = "build"
-- aut.toml --
[autonomy]
signoff = "owner"
ship = "auto"
[step.only]
kind = "command"
run = "true"
-- env.toml --
[env]
B_CMD = 'go build -o "$A_DIR" ./x'
A_DIR = "{run_tmp}/a"
[step.only]
kind = "command"
run = "true"
-- clean.toml --
[[cleanup]]
name = "drop-db"
run = "dropdb x"
[[cleanup]]
run = "rm -rf tmp"
[step.only]
kind = "command"
run = "true"
-- retry.toml --
[step.plan]
kind = "agent"
prompt = "plan"
on.pass = "check"
[step.check]
kind = "command"
run = "true"
retry_from = "plan"
on.pass = "done"
-- inc-retry.toml --
[step.w]
kind = "workflow"
workflow = "retry"
on.pass = "after"
[step.after]
kind = "command"
run = "true"
retry_from = "w/check"
