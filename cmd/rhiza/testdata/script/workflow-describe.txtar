# workflow describe resolves as run start does and starts nothing. --json is
# the bytes of api call workflow.describe.

env XDG_CONFIG_HOME=$WORK/xdg
mkdir repo
cd repo
exec git init -q
exec rhiza init
fold-ok

# a built-in
exec rhiza workflow describe build
stdout '^build \(builtin\) builtin:build$'
stdout '^start '
stdout 'on\.pass ->'
stdout 'role builder models'
! stdout '^autonomy '

# the same bytes as the api
exec rhiza workflow describe build --json
cp stdout build.json
exec rhiza api call workflow.describe '{"workflow":"build"}'
cmp stdout build.json
stdout '"path": "builtin:build"'

# a repo override that shadows the built-in
mkdir .rhiza/workflows
cp $WORK/w.toml .rhiza/workflows/build.toml
exec rhiza workflow describe build
stdout '^build \(repo\) .*/repo/.rhiza/workflows/build.toml$'
stdout '^  shadows builtin builtin:build$'
stdout '^start only$'
stdout '^only command$'

# the layer and shadows follow the resolved name, not the file's name =
cp $WORK/named.toml .rhiza/workflows/mine.toml
exec rhiza workflow describe mine
stdout '^custom \(repo\) .*/repo/.rhiza/workflows/mine.toml$'
! stdout 'shadows'
mkdir $WORK/xdg/rhiza/workflows
cp $WORK/named.toml $WORK/xdg/rhiza/workflows/mine.toml
exec rhiza workflow describe mine
stdout '^custom \(personal\) .*/xdg/rhiza/workflows/mine.toml$'
stdout '^  shadows repo .*/repo/.rhiza/workflows/mine.toml$'
rm $WORK/xdg/rhiza/workflows/mine.toml
rm .rhiza/workflows/mine.toml

# a file that includes another workflow
cp $WORK/inc.toml inc.toml
exec rhiza workflow describe inc.toml
stdout '^inc \(file\) '
stdout '^includes build$'
stdout '^build/only command$'
exec rhiza workflow describe inc.toml --json
cp stdout inc.json
exec rhiza api call workflow.describe '{"workflow":"inc.toml"}'
cmp stdout inc.json

# a workflow's declared autonomy, by stage in order
cp $WORK/aut.toml aut.toml
exec rhiza workflow describe aut.toml
stdout '^autonomy ship auto$'
stdout '^autonomy signoff owner$'
! stdout '^autonomy (plan|accept) '
exec rhiza workflow describe aut.toml --json
stdout '"mode": "owner",\n\s*"stage": "signoff"'
exec rhiza workflow describe build --json
stdout '"autonomy": \[\]'

# nothing was written: no runs, and the model still folds
exec rhiza run ls
! stdout 'inc|build'
fold-ok

-- w.toml --
[step.only]
kind = "command"
run = "true"
-- named.toml --
name = "custom"
[step.only]
kind = "command"
run = "true"
-- inc.toml --
[step.go]
kind = "workflow"
workflow = "build"
-- aut.toml --
[autonomy]
signoff = "owner"
ship = "auto"
[step.only]
kind = "command"
run = "true"
