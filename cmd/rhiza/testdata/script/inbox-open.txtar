# rhiza inbox open <item> focuses the Rex tab an item waits in: the asking
# session's for a question, the run's journalled tab for a sign-off, a
# failed run or a run the daemon gave up on. A run whose tab Rex no longer
# has is named with its tab gone, and an unknown item exits 2. The fake rex
# fails for the block "gone" and logs every call. The journals are
# fixtures.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH

mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .git/rhiza/runs
cp ../question.jsonl .git/rhiza/runs/QUESTIONRUN.jsonl
cp ../signoff.jsonl .git/rhiza/runs/SIGNOFFRUN01.jsonl
cp ../failed.jsonl .git/rhiza/runs/FAILEDRUN001.jsonl
cp ../notab.jsonl .git/rhiza/runs/NOTABRUN0001.jsonl

# A question: the asking session's tab.
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ question " | cut -d" " -f1'
cp stdout ../qid
exec sh -c 'rhiza inbox open "$(cat ../qid)"'
stdout 'Focused block:q1, the tab of question run QUESTIONRUN'
exec cat ../rex.log
stdout 'rex focus -s session:s1 block:q1'
exec sh -c 'rm ../rex.log'

# A sign-off: the run's journalled tab.
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ signoff " | cut -d" " -f1'
cp stdout ../sid
exec sh -c 'rhiza inbox open "$(cat ../sid)" --json'
stdout '"opened": true'
stdout '"tab": "block:r1"'
exec cat ../rex.log
stdout 'rex focus block:r1'

# A failed run whose tab Rex no longer has: named, tab gone, nothing focused.
exec sh -c 'rm ../rex.log'
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ failed run FAILEDRUN001" | cut -d" " -f1'
cp stdout ../fid
exec sh -c 'rhiza inbox open "$(cat ../fid)"'
stdout 'failed run FAILEDRUN001: tab gone \(Rex no longer has block:gone\)'
exec sh -c 'rhiza inbox open "$(cat ../fid)" --json'
stdout '"tab_gone": true'
stdout '"opened": false'
! grep focus ../rex.log

# A run with no recorded tab is named with its tab gone too.
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ failed run NOTABRUN0001" | cut -d" " -f1'
cp stdout ../nid
exec sh -c 'rhiza inbox open "$(cat ../nid)"'
stdout 'tab gone \(no tab is recorded'

# An unknown item exits 2.
! exec rhiza inbox open zzzzzzz
stderr 'no inbox item'
-- question.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSQUESTION"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"blocked","at":"2026-01-01T01:00:00Z","step":"build","session":"S1","block":{"kind":"question","question":"Which store?","tab_session":"session:s1","tab_title":"leaf one","tab_block":"block:q1"}}
-- signoff.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"signoff","started":{"workflow":"ship-change","definition":"","change":"CSSIGNOFF"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"signoff","visit":1}
{"type":"process","at":"2026-01-01T00:00:02Z","process":{"host":"h","pid":1,"rex_window":"window:w1","rex_block":"block:r1"}}
{"type":"stopped","at":"2026-01-01T02:00:00Z","step":"signoff","detail":"waiting for the owner's sign-off: rhiza run approve | rhiza run request-changes <file>; rhiza run summary"}
-- failed.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSFAILED"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"process","at":"2026-01-01T00:00:02Z","process":{"host":"h","pid":1,"rex_window":"window:w9","rex_block":"block:gone"}}
{"type":"finished","at":"2026-01-01T03:00:00Z","step":"build","end":"failed","detail":"boom"}
-- notab.jsonl --
{"type":"started","at":"2026-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSNOTAB"}}
{"type":"entered","at":"2026-01-01T00:00:01Z","step":"build","visit":1}
{"type":"finished","at":"2026-01-01T03:30:00Z","step":"build","end":"failed","detail":"bang"}
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
case "$*" in
*block:gone*) exit 1 ;;
esac
case "$1" in
block) echo '{"block":{"window_id":"window:w1"}}' ;;
esac
