# ship check --settled on a PR GitHub reports CONFLICTING merges origin's main
# into the branch as ship rebase does.
#
# Case 1: main moved with a change to a rendered file the branch changed too.
# The conflict is settled by rendering again, origin's branch then holds
# origin/main, and the ship record's pushed is the new head.
#
# Case 2: main moved with a change to a code file the branch changed too.
# The check exits 0 (settled) with the conflict in its detail, leaves the merge
# in progress and raises no question. Plain ship check then fails naming the
# files, whatever the head's checks say, until a resolving merge is committed;
# after that it passes on green checks, before and after the head is pushed.
#
# The fake gh reports CONFLICTING until origin's branch holds origin's main.

chmod 755 bin/gh
env PATH=$WORK/bin:$PATH

# Case 1: a rendered-only conflict.
exec git init -q --bare origin.git
env ORIGIN=$WORK/origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza render
cp $WORK/base.txt code.txt
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
exec sh -c 'echo branch >> .rhiza/rendered/index.md'
exec git add -A
exec git commit -qm 'Branch edits rendered'
exec git push -q -u origin cs/ship-it

exec git clone -q $WORK/origin.git $WORK/other
cd $WORK/other
exec git config user.email other@example.test
exec git config user.name Other
exec sh -c 'echo main >> .rhiza/rendered/index.md'
exec git add -A
exec git commit -qm 'Main edits rendered'
exec git push -q origin main

cd $WORK/repo
! exec rhiza ship check --settled
stdout 'rebased onto main and pushed'
exec git fetch -q origin
exec git merge-base --is-ancestor origin/main origin/cs/ship-it
exec sh -c 'grep -q "\"pushed\": \"$(git rev-parse origin/cs/ship-it)\"" "$(git rev-parse --git-common-dir)"/rhiza/ship/*.json'
# Settled now that GitHub no longer reports a conflict.
exec rhiza ship check --settled

# Case 2: a conflict in a code file.
cd $WORK
exec git init -q --bare origin2.git
env ORIGIN=$WORK/origin2.git
mkdir repo2
cd repo2
exec git init -q
exec git remote add origin $WORK/origin2.git
exec rhiza init
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza render
cp $WORK/base.txt code.txt
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git checkout -q -b cs/ship-it
exec sh -c 'echo branch >> code.txt'
exec git add -A
exec git commit -qm 'Branch edits code'
exec git push -q -u origin cs/ship-it
exec git rev-parse HEAD
cp stdout $WORK/before.txt

exec git clone -q $WORK/origin2.git $WORK/other2
cd $WORK/other2
exec git config user.email other@example.test
exec git config user.name Other
exec sh -c 'echo main >> code.txt'
exec git add -A
exec git commit -qm 'Main edits code'
exec git push -q origin main

cd $WORK/repo2
exec rhiza ship check --settled --json
stdout '"settled": true'
stdout 'code\.txt'
stdout 'merge is left in progress'
exec git status --porcelain --untracked-files=no
stdout 'code.txt'
exec git rev-parse --verify MERGE_HEAD
exec git rev-parse origin/cs/ship-it
cmp stdout $WORK/before.txt
exec sh -c 'rhiza ship check --json; echo exit=$?'
stdout 'code\.txt'
stdout '"passed": false'
stdout '^exit=1$'
! exec rhiza ship check
stdout 'unresolved, conflicts in code\.txt'
exec sh -c 'grep -q merge_conflict "$(git rev-parse --git-common-dir)"/rhiza/ship/*.json'

# A merge committed on top resolves it: plain check passes on green checks,
# before and after the head is pushed.
exec sh -c 'printf "base\nresolved\n" > code.txt'
exec git add code.txt
exec git commit -q --no-edit
exec rhiza ship check
! exec rhiza ship check --settled
exec git fetch -q origin
exec git merge-base --is-ancestor origin/main origin/cs/ship-it
exec sh -c '! grep -q merge_conflict "$(git rev-parse --git-common-dir)"/rhiza/ship/*.json'
exec rhiza ship check

-- base.txt --
base
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
case "$1 $2" in
"pr view")
	if ! head=$(git -C "$ORIGIN" rev-parse --verify --quiet "refs/heads/$3"); then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	m=MERGEABLE
	if ! git -C "$ORIGIN" merge-base --is-ancestor main "$head"; then
		m=CONFLICTING
	fi
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","mergeable":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"}]}\n' "$head" "$m"
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
