# rhiza run log pages a headless run's driver log with the paging flags ls
# takes, and exits 2 for a run with no log. Each daemon start of a change set
# logs to its own run's file, so a second run of the same change set shows
# none of the first one's lines.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec rhiza add intent m --field milestone=1 --record
exec git add -A
exec git commit -qm init
exec rhiza change new Built --title Built
exec rhiza add capability built-leaf
exec rhiza link 01M5PWGMARA1WR6BD0MEF4Y76P serves m
exec rhiza propose
exec rhiza accept --reason ok

exec rhiza daemon --permission-mode manual --once
exec sh -c 'for i in $(seq 1 100); do ls .git/rhiza/runs/*.jsonl >/dev/null 2>&1 && break; sleep 0.1; done; sleep 1'

exec sh -c 'basename .git/rhiza/runs/*.jsonl .jsonl | tr -d "\n" > $WORK/run1'

# A log the child wrote: the first page holds one line and names the next.
exec sh -c 'printf "one\ntwo\nthree\n" > .git/rhiza/logs/$(cat $WORK/run1).log'
exec rhiza run log --limit 2
stdout '^one$'
stdout '^two$'
! stdout three
stdout 'next: rhiza run log .* --cursor 2'
exec rhiza run log --limit 2 --cursor 2
stdout '^three$'
! stdout next:
exec rhiza run log --all
stdout '^three$'

# Stop the child through the pid its journal names.
exec sh -c 'kill $(sed -n "s/.*\"pid\":\([0-9]*\).*/\1/p" .git/rhiza/runs/*.jsonl | head -1)'
exec sh -c 'for i in $(seq 1 100); do rhiza run ls --json | grep -q "\"live\": true" || break; sleep 0.1; done'

# The first run given up, a second start of the change set, queued and
# started by the daemon, logs to its own run's file: neither run's log shows
# the other's lines.
exec sh -c 'rhiza run abandon $(cat $WORK/run1)'
exec rhiza run start 01M5PWGMARA1WR6BD0MEF4Y76P --permission-mode manual
exec rhiza daemon --permission-mode manual --once
stdout -count=1 '^Started a run of '
exec sh -c 'for i in $(seq 1 100); do [ $(ls .git/rhiza/runs/*.jsonl | wc -l) -ge 2 ] && break; sleep 0.1; done; ls .git/rhiza/runs/*.jsonl | xargs -n1 basename | sed "s/.jsonl$//" | grep -v $(cat $WORK/run1) | tr -d "\n" > $WORK/run2'
exec sh -c 'f=.git/rhiza/logs/$(cat $WORK/run2).log; for i in $(seq 1 100); do grep -q "step build/build: entered" $f && break; sleep 0.1; done; rhiza run log $(cat $WORK/run2) --all'
stdout 'step build/build: entered'
! stdout '^one$'
exec sh -c 'rhiza run log $(cat $WORK/run1) --all'
stdout '^one$'
! stdout 'step build/build: entered'
exec sh -c 'kill $(sed -n "s/.*\"pid\":\([0-9]*\).*/\1/p" .git/rhiza/runs/$(cat $WORK/run2).jsonl | head -1)'

# No log: exit 2.
rm .git/rhiza/logs
exec sh -c 'rhiza run log 2>/dev/null; echo exit $?'
stdout 'exit 2'
-- bin/rex --
#!/bin/sh
echo "rex $*" >> "$WORK/rex.log"
if [ "$1 $2" = "session ls" ]; then
  echo '{"sessions":[{"session_id":"session:1","label":"rhiza-repo"}]}'
  exit 0
fi
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
