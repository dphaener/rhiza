# workflow check warns, never fails, for each merge step (a command step
# whose run calls rhiza ship merge or gh pr merge) the run can reach from
# its start step without entering a gate step, naming the step and one
# such path.

mkdir repo
cd repo
exec git init -q
rhiza init
mkdir .rhiza/workflows
cp $WORK/merge.toml .rhiza/workflows/merge.toml

rhiza workflow check merge
stdout '^workflow merge is valid'
stdout '^  warning: step merge merges with no gate step before it: the run can reach it along build -> push -> merge; route every path to it through a gate step$'
rhiza workflow check merge --json
stdout '"valid": true'
stdout '"step merge merges with no gate step before it: the run can reach it along build -> push -> merge; route every path to it through a gate step"'

# every path through the gate: no warning
exec sed -i 's/^on.fail = "push"$/on.fail = "failed"/' .rhiza/workflows/merge.toml
rhiza workflow check merge
stdout '^workflow merge is valid'
! stdout 'no gate step'

# ship-change merges only after its gate
rhiza workflow check ship-change
! stdout 'no gate step'

-- merge.toml --
name = "merge"

[step.build]
kind = "agent"
prompt = "Build {change}"
on.pass = "gate"
on.fail = "push"

[step.gate]
kind = "gate"
commands = ["rhiza check"]
on.pass = "push"
on.fail = "handback:build"

[step.push]
kind = "command"
run = "rhiza ship open-pr"
on.pass = "merge"

[step.merge]
kind = "command"
run = "rhiza ship merge"
on.pass = "done"
