# The import topic gives a second wording form for a decision its document
# records the owner making or confirming; both forms land, pass the check and
# show their wording and Source in rhiza why, with no quote field.

rhiza guide import
stdout 'made by the owner as recorded in <document>'
stdout 'made autonomously by the agent and not confirmed by the owner'
stdout 'document records the owner making or confirming'
stdout 'gets no `quote` field'

rhiza init
rhiza change new 'Import docs'
rhiza add capability store --field 'statement=Keeps entries'
rhiza add source decisions-md --field 'summary=docs/decisions.md, written by an agent.'
rhiza add decision keep-in-ram --field 'statement=Entries stay in memory.' --field 'wording=Entries stay in memory, made by the owner as recorded in docs/decisions.md'
rhiza add decision no-disk --field 'statement=Nothing is written to disk.' --field 'wording=Nothing is written to disk, made autonomously by the agent and not confirmed by the owner'
rhiza link store decided-by keep-in-ram
rhiza link store decided-by no-disk
rhiza link keep-in-ram derived-from decisions-md
rhiza link no-disk derived-from decisions-md
rhiza propose
rhiza accept --reason ok
rhiza land

rhiza why store
stdout 'made by the owner as recorded in docs/decisions.md'
stdout 'made autonomously by the agent and not confirmed by the owner'
! stdout 'quote'

rhiza why keep-in-ram
stdout 'decisions-md'
rhiza why no-disk
stdout 'decisions-md'

rhiza show keep-in-ram --json
! stdout '"quote"'
rhiza show no-disk --json
! stdout '"quote"'
fold-ok
