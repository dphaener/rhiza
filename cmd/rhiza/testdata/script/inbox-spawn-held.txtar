{"type":"entered","at":"2030-01-01T00:00:01Z","step":"build","visit":1}
{"type":"spawn-held","at":"2030-01-01T00:00:02Z","step":"build","detail":"disk-low: 1.0 GiB free, under the minimum of 2.0 GiB"}
