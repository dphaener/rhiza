# rhiza overlaps lists the overlaps between in-flight change sets; a draft
# counts only when named with --change.

rhiza init
rhiza change new A
rhiza add capability base --field statement=Base --field acceptance=a
rhiza propose
rhiza accept --reason ok
rhiza land
rhiza change new B
rhiza set base --field statement=FromB
rhiza propose
rhiza change new C
rhiza set base --field statement=FromC

# Without a name the draft is not in flight.
rhiza overlaps
stdout '^No overlaps$'
rhiza overlaps --json
stdout '"overlaps": \[\]'

# Naming the draft counts it.
rhiza overlaps --change 01M5PWGS702G3VYA781BNZ0K7Q
stdout '^change sets 01M5PWGP98GD3JXPKEPHTS0TQE and 01M5PWGS702G3VYA781BNZ0K7Q both write field:statement of base$'
rhiza overlaps --change 01M5PWGS702G3VYA781BNZ0K7Q --json
stdout '"a": "01M5PWGP98GD3JXPKEPHTS0TQE"'
stdout '"b": "01M5PWGS702G3VYA781BNZ0K7Q"'
stdout '"target": "base"'
stdout '"field:statement"'
fold-ok
