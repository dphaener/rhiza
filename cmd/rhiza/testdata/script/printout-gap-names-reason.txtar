# A session with no readable token use is listed with the reason instead of
# "no token use recorded", and left out of the totals: one whose agent is
# still running (its record has no exit), and one whose transcript file is
# missing. The counted session stays in the totals.
#
# The fake claude writes transcripts for the first two calls only. The
# review session is then made to look still running: its record loses its
# exit report and its transcript goes.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Token use' --title 'Token use' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
mkdir .rhiza/workflows
cp $WORK/three.toml .rhiza/workflows/three.toml

exec rhiza run start --foreground --workflow three --permission-mode manual
stdout '^Run 01M5PWGJC82P7YGZTWYFFZ0VJG succeeded$'
exec sh -c 'f=$(git rev-parse --git-common-dir)/rhiza/runs/01M5PWGJC82P7YGZTWYFFZ0VJG.jsonl; grep -v "\"tokens\"" $f > $f.new; mv $f.new $f'
exec sh -c 'rm "$HOME"/.claude/projects/p/158fe87f-5cf8-452b-9c62-01a16dc84988.jsonl'
exec sh -c 'f=$(git rev-parse --git-common-dir)/rhiza/sessions/158fe87f-5cf8-452b-9c62-01a16dc84988.json; sed "/^    \"exit\": {/,/^    }/d" $f > $f.new; mv $f.new $f'
! grep exit .git/rhiza/sessions/158fe87f-5cf8-452b-9c62-01a16dc84988.json

exec rhiza run status 01M5PWGJC82P7YGZTWYFFZ0VJG --json
stdout '"no_tokens": "still running",\n\s+"session": "158fe87f-5cf8-452b-9c62-01a16dc84988"'
stdout '"no_tokens": "transcript unreadable: no transcript of session 158fe87f-5cfc-4086-9c96-01a16dc84988: looked in [^"]*",\n\s+"session": "158fe87f-5cfc-4086-9c96-01a16dc84988"'
stdout -count=1 '"tokens": \{'
stdout '"totals": \{\n\s+"helpers": \{\n\s+"cache_creation": 3,\n\s+"cache_read": 4,\n\s+"input": 1,\n\s+"output": 2\n\s+\},\n\s+"session": \{\n\s+"cache_creation": 30,\n\s+"cache_read": 40,\n\s+"input": 10,\n\s+"output": 20'

exec rhiza run status 01M5PWGJC82P7YGZTWYFFZ0VJG
stdout '- review, session 158fe87f-5cf8-452b-9c62-01a16dc84988: no token use shown, still running\n'
stdout '- check, session 158fe87f-5cfc-4086-9c96-01a16dc84988: no token use shown, transcript unreadable: no transcript of session 158fe87f-5cfc-4086-9c96-01a16dc84988: looked in [^\n]*\n'
! stdout 'no token use recorded'
stdout 'Totals: tokens input 10, output 20, cache creation 30, cache read 40; helper tokens input 1, output 2, cache creation 3, cache read 4'

fold-ok

-- three.toml --
name = "three"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "review"
on.fail = "review"

[step.review]
kind = "agent"
prompt = "Review {change}"
interval = "50ms"
on.pass = "check"
on.fail = "check"

[step.check]
kind = "agent"
prompt = "Check {change}"
interval = "50ms"
on.pass = "done"
on.fail = "done"
-- cmd.toml --
name = "cmd"

[step.a]
kind = "command"
run = "true"
on.pass = "done"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@"; echo "exit=$?") >"$WORK/tab.out" 2>&1
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
echo x >> "$WORK/claude.calls"
n=$(wc -l < "$WORK/claude.calls" | tr -d ' ')
t="$HOME/.claude/projects/p/$sid.jsonl"
mkdir -p "$HOME/.claude/projects/p"
if [ "$n" = 1 ]; then
	echo '{"type":"assistant","isSidechain":false,"message":{"id":"msg_A","usage":{"input_tokens":10,"output_tokens":20,"cache_creation_input_tokens":30,"cache_read_input_tokens":40}}}' > "$t"
	echo '{"type":"assistant","isSidechain":true,"message":{"id":"msg_H","usage":{"input_tokens":1,"output_tokens":2,"cache_creation_input_tokens":3,"cache_read_input_tokens":4}}}' >> "$t"
fi
if [ "$n" = 2 ]; then
	echo '{"type":"assistant","isSidechain":false,"message":{"id":"msg_B","usage":{"input_tokens":100,"output_tokens":200,"cache_creation_input_tokens":300,"cache_read_input_tokens":400}}}' > "$t"
	echo '{"type":"assistant","isSidechain":true,"message":{"id":"msg_I","usage":{"input_tokens":5,"output_tokens":6,"cache_creation_input_tokens":7,"cache_read_input_tokens":8}}}' >> "$t"
fi
exit 0
