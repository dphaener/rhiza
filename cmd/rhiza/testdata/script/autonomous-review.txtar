# rhiza run status on an autonomous run lists what the run did in the
# owner's place: each accept it made under rule autonomous (change set and
# log entry) and each question put to its arbiter, with the Decision that
# answers it or why it is undecided. A normal run's status lists neither.
#
# The fakes are arbiter-answer's: one fake claude plays the asking agent
# and the arbiter, by its prompt. The asking agent first accepts another
# change set, proposed before the run, under rule autonomous, then asks one
# question through the real hook, which the fake arbiter answers.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init

# The other change set, proposed before the run.
exec rhiza change new 'Other work' --title 'Other work' --json
stdout '"change_set": "[0-9A-Z]{26}"'
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\",$/\1/p" > $WORK/other'
exec rhiza propose

exec rhiza change new 'Reviewed runs' --title 'Reviewed runs' --json
stdout '"change_set": "[0-9A-Z]{26}"'
mkdir .rhiza/workflows
cp $WORK/ask.toml .rhiza/workflows/ask.toml
cp $WORK/plain.toml .rhiza/workflows/plain.toml
exec git add -A
exec git commit -qm 'Reviewed runs'

env REX_BLOCK=block:root
env REX_SESSION=session:s1

exec rhiza run start --workflow ask --permission-mode manual --autonomous
stdout '^Run [0-9A-Z]{26} succeeded$'
exec cat $WORK/accept.out
stdout '"rule": "autonomous"'
exec sh -c 'ls .git/rhiza/runs | sed "s/\.jsonl$//" > $WORK/autorun'

# status --json lists the accept and the question with its Decision.
exec sh -c 'rhiza run status $(cat $WORK/autorun) --json'
stdout '"accepts": \['
stdout '"verb": "accepted"'
stdout '"entry": "[0-9A-Z]{26}"'
stdout '"questions": \['
stdout '"handle": "question-[0-9a-f]{8}-1"'
stdout '"text": "Which colour\?"'
stdout '"step": "build"'
stdout '"outcome": "pass"'
stdout '"decision": "assume-blue"'
stdout '"answered": true'
exec sh -c 'rhiza run status $(cat $WORK/autorun) --json | grep -c "\"change\": \"$(cat $WORK/other)\""'
stdout '^1$'
# The accept's entry is the one the journal holds.
exec sh -c 'grep "\"type\":\"accepted\"" .git/rhiza/runs/*.jsonl | sed -n "s/.*\"log_entry\":\"\([0-9A-Z]*\)\".*/\1/p" > $WORK/entry'
exec sh -c 'rhiza run status $(cat $WORK/autorun) --json | grep -c "\"entry\": \"$(cat $WORK/entry)\""'
stdout '^1$'

# The markdown shows both.
exec sh -c 'rhiza run status $(cat $WORK/autorun)'
stdout '^## Accepted in the owner.s place$'
stdout '^- [0-9T:-]+Z accepted change set [0-9A-Z]{26} \(log entry [0-9A-Z]{26}\)$'
stdout '^## Questions put to the arbiter$'
stdout '^- question-[0-9a-f]{8}-1 \([0-9A-Z]{26}\): Which colour\? — decision assume-blue$'

# A normal run lists neither.
exec rhiza run start --workflow plain
stdout '^Run ([0-9A-Z]{26}) succeeded$'
exec sh -c 'ls .git/rhiza/runs | sed "s/\.jsonl$//" | grep -v $(cat $WORK/autorun) > $WORK/plainrun'
exec sh -c 'rhiza run status $(cat $WORK/plainrun) --json'
! stdout '"accepts"'
! stdout '"questions"'
exec sh -c 'rhiza run status $(cat $WORK/plainrun)'
! stdout 'owner.s place'
! stdout 'put to the arbiter'

fold-ok

-- ask.toml --
name = "ask"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "done"
on.fail = "done"

[step.decide]
kind = "arbiter"
interval = "50ms"
-- plain.toml --
name = "plain"

[step.build]
kind = "command"
run = "true"
on.pass = "done"
-- bin/rex --
#!/bin/sh
case "$1" in
events)
	exit 0
	;;
send | send-key)
	echo "$*" >> "$WORK/typed.log"
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >>"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
for a; do last=$a; done
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
case "$last" in
*'rhiza guide arbiter'*)
	q=$(printf '%s\n' "$last" | sed -n 's/^Decide question \([0-9A-Z]*\):.*/\1/p')
	printf '{"writes":[{"op":"add","kind":"decision","handle":"assume-blue","fields":["statement=Use blue","wording=(assumed, would have escalated)","reasoning=Blue is the brand colour"]},{"op":"link","from":"assume-blue","type":"answers","to":"%s"}]}\n' "$q" > "$WORK/decision.json"
	rhiza apply "$WORK/decision.json" --json >> "$WORK/apply.out" || exit 7
	rhiza session done >> "$WORK/done.out" || exit 6
	exit 0
	;;
esac
# Accept the other change set in the owner's place, before asking.
rhiza accept --change "$(cat "$WORK/other")" --rule autonomous --json > "$WORK/accept.out" || exit 11
echo '{"session_id":"'$sid'","hook_event_name":"PreToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Which colour?"}]}}' | rhiza session hook PreToolUse > "$WORK/deny.out" || exit 8
echo '{"session_id":"'$sid'","hook_event_name":"Stop"}' | rhiza session hook Stop >> "$WORK/hook.out" || exit 8
msg=".rhiza/local/messages/$sid/0001.md"
i=0
# The pointer is typed once the message is written: wait for it, so the
# session is still there when the run types it.
until [ -f "$msg" ] && grep -q '^send-key ' "$WORK/typed.log" 2>/dev/null; do
	i=$((i + 1))
	if [ $i -gt 800 ]; then
		echo 'no answer' >&2
		exit 9
	fi
	sleep 0.025
done
grep -q '^Use blue$' "$msg" || exit 10
echo "got $msg" >> "$WORK/asker.log"
cat "$msg" >> "$WORK/asker.log"
exit 0
