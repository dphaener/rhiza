# Two change sets with the same title get distinct worktrees and branches:
# the earlier one cs/<slug>, the later one cs/<slug>-<first 12 characters of
# its ID, lowercased> (never its display short ID).

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
exec rhiza change new 'Twin work' --title 'Twin work' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza change new 'Twin work' --title 'Twin work' --json
stdout '"change_set": "01M5PWGJC82P7YGZTWYFFZ0VJG"'
mkdir .rhiza/workflows
cp $WORK/plan.toml .rhiza/workflows/plan.toml
exec git add -A
exec git commit -qm changes

# A dry run predicts the suffixed worktree for the later change set, and for
# a plan run that would open a third change set with the same title.
exec rhiza run start --foreground --workflow plan 01M5PWGJC82P7YGZTWYFFZ0VJG --permission-mode manual --dry-run --json
stdout '"worktree": ".*repo\.twin-work-01m5pwgjc82p"'
exec rhiza run start --foreground --workflow plan --new 'Twin work' --permission-mode manual --dry-run --json
stdout '"change": "(01[0-9A-Z]{24})"'
stdout '"worktree": ".*repo\.twin-work-01[0-9a-z]{10}"'
! stdout 'repo\.twin-work"'
! stdout 'twin-work-01m5pwgjc82p'

exec rhiza session start 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json
exec rhiza session start 01M5PWGJC82P7YGZTWYFFZ0VJG --permission-mode manual --json

exec git worktree list
stdout 'repo\.twin-work '
stdout 'repo\.twin-work-01m5pwgjc82p '
exec git branch --list
stdout 'cs/twin-work$'
stdout 'cs/twin-work-01m5pwgjc82p$'

-- plan.toml --
name = "plan"

[step.interview]
kind = "agent"
prompt = "Plan {change}"
on.pass = "done"
-- bin/rex --
#!/bin/sh
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
exit 0
