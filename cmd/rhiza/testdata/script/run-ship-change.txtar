# run start with no --workflow runs the built-in ship-change workflow end
# to end on a change set of two leaves, the second depending on the first:
# build's builders and verifiers, a render committed on the branch with
# the actor records build's sessions left uncommitted, then
# the repo's review (its code check and two fake checks, its sign-off
# skipped), then the pull request
# opened with the review's summary as its body. The run waits for CI, then stops at its sign-off until `rhiza run
# approve`. After that it finds main has not moved (nothing to rebase),
# lands the change set on the PR branch with the PR recorded as Evidence,
# waits for CI on that head, finds main still has not moved, squash merges
# pinned to it, waits for main to go green, closes out (worktree, branch
# and origin branch gone, main pulled) and then runs the repo's own ship
# command.
#
# Nothing here reaches GitHub, Rex or Claude Code. origin is a bare repo in
# $WORK. The fake rex runs the tab's command synchronously in the window's
# directory. The fake claude logs its role and leaf; as a builder it
# commits with the change set, its actor and its leaf as trailers, as a
# verifier it writes the leaf's Evidence, and as a check it records an
# empty round. The fake gh logs its argv to gh.log, keeps the body a PR is
# created with in pr-body.md, and answers from the bare origin: before a PR is created the
# branch's only PR is #3, merged earlier (as a plan's PR on the change set's
# branch is), so open-pr opens a new one; the PR (#7), once created, is open with every check passed
# at the branch's current head on origin; a merge squashes the branch onto
# main in origin (refusing any head but the branch's); the merged PR names
# that squash commit; and CI on it has passed, which it notes in order.log
# before answering.

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH
exec git init -q --bare origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/ship.sh .rhiza/workflows/ship.sh
cp $WORK/review.toml .rhiza/workflows/review.toml

# An accepted change set of two leaves, second depending on first,
# committed on main and pushed, as a reviewed change set would be.
exec rhiza change new 'Ship it' --title 'Ship it' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability second --field 'statement=Does second'
exec rhiza add capability first --field 'statement=Does first'
exec rhiza link second depends-on first
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main

exec sh -c 'rhiza run start 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
stdout '"state": "stopped"'
stdout '"signoff_waiting": true'
stdout '^exit=0$'

# Both leaves were built and verified, first before second, and the review's
# checks ran after them.
exec sh -c 'grep -v "role=check" $WORK/claude.log'
cmp stdout $WORK/want.log
exec sh -c 'grep -c "role=check" $WORK/claude.log'
stdout '^2$'
exec rhiza run status
stdout '^- build/build \(visit 1\): pass, then build/render: 2 of 2 leaves passed$'
stdout '^- build/render \(visit 1\): pass, then build/check: exit 0$'
stdout '^- build/check \(visit 1\): pass, then review/code: exit 0$'
stdout '^- review/code \(visit 1\): pass, then review/review'
stdout '^- review/review \(visit 1\): pass, then render-pr'
stdout '^- render-pr \(visit 1\): pass, then open-pr: exit 0$'
stdout '^- open-pr \(visit 1\): pass, then wait-pr: '
stdout '^- wait-pr \(visit 1\): pass, then pr-green: held after [0-9]+ checks?$'
stdout '^- pr-green \(visit 1\): pass, then signoff: exit 0$'
stdout '^- Pull request: https://github.test/o/r/pull/7$'
stdout '^- Current step: signoff$'

# The PR was opened once, its body the run's summary, and nothing has
# landed or merged before the owner signs off.
exec sh -c 'grep -c "^pr create" $WORK/gh.log'
stdout '^1$'
grep '^pr create .*--title Ship it' $WORK/gh.log
grep '^# Review of run ' $WORK/pr-body.md
grep '^Change set 01M5PWGEF85Y185JZ2ZGCNH40N: Ship it\. Workflow ship-change' $WORK/pr-body.md
grep '^## Checks of step review/review$' $WORK/pr-body.md
grep '^### alpha' $WORK/pr-body.md
grep '^### beta' $WORK/pr-body.md
! grep '^pr merge' $WORK/gh.log
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- State: accepted'

# The builders commit only their own files, yet the pushed branch holds
# every actor record its rendered pages are built from: a fresh clone of
# it passes rhiza check, as the PR's CI would.
exec git clone -q -b cs/ship-it $WORK/origin.git $WORK/pr-clone
cd $WORK/pr-clone
exec rhiza check
cd $WORK/repo

# The owner signs off from the change set's worktree, and the run carries on
# to the end. Close-out removes that folder under the running process, and
# the ship command still runs, in the main checkout.
cd $WORK/repo.ship-it
exec sh -c 'rhiza run approve; echo exit=$?'
cd $WORK/repo
stdout '^exit=0$'
stdout '^Run \S+ succeeded$'

# The run was the built-in ship-change, every step passing in order.
exec rhiza run status --json
stdout '"workflow": "ship-change"'
stdout '"state": "succeeded"'
exec rhiza run status
stdout '^- signoff \(visit 1\): pass, then rebase'
stdout '^- rebase \(visit 1\): pass, then wait-rebased: exit 0$'
stdout '^- wait-rebased \(visit 1\): pass, then rebased-green: held after [0-9]+ checks?$'
stdout '^- rebased-green \(visit 1\): pass, then land: exit 0$'
stdout '^- land \(visit 1\): pass, then wait-landed: exit 0$'
stdout '^- wait-landed \(visit 1\): pass, then landed-green: held after [0-9]+ checks?$'
stdout '^- landed-green \(visit 1\): pass, then rebase-merge: exit 0$'
stdout '^- rebase-merge \(visit 1\): pass, then wait-rebased-merge: exit 0$'
stdout '^- wait-rebased-merge \(visit 1\): pass, then rebased-merge-green: held after [0-9]+ checks?$'
stdout '^- rebased-merge-green \(visit 1\): pass, then merge: exit 0$'
stdout '^- merge \(visit 1\): pass, then wait-main: exit 0$'
stdout '^- wait-main \(visit 1\): pass, then main-green: held after [0-9]+ checks?$'
stdout '^- main-green \(visit 1\): pass, then close-out: exit 0$'
stdout '^- close-out \(visit 1\): pass, then ship: exit 0$'
stdout '^- ship \(visit 1\): pass, then end: exit 0$'

# The merge was a squash pinned to the head whose checks passed: the land
# commit the run pushed, which is the branch's last head on origin.
exec cat $WORK/landed.sha
exec sh -c 'grep -c -x "pr merge 7 --squash --match-head-commit $(cat $WORK/landed.sha)" $WORK/gh.log'
stdout '^1$'
! grep '[-]-admin|[-]-auto|[-]-delete-branch' $WORK/gh.log
grep '^pr view cs/ship-it --json number,url,state,headRefOid,statusCheckRollup$' $WORK/gh.log
grep '^pr view 7 --json mergeCommit,state$' $WORK/gh.log
exec sh -c 'grep -c -x "run list --commit $(cat $WORK/merge.sha) --json name,status,conclusion" $WORK/gh.log'
! stdout '^0$'

# The land commit is the PR head's last commit, with the Change trailer
# and an Actor trailer naming the run's actor (git's user.email here), in
# one trailer block, so git reads both as trailers.
exec sh -c 'git -C $WORK/origin.git log -1 --format=%B $(cat $WORK/landed.sha)'
stdout '^Land the change set and record its CI$'
stdout '^Change: 01M5PWGEF85Y185JZ2ZGCNH40N$'
stdout '^Actor: test$'
exec sh -c 'git -C $WORK/origin.git log -1 --format="%(trailers:only,unfold)" $(cat $WORK/landed.sha)'
stdout -count=2 '^.+$'
stdout '^Change: 01M5PWGEF85Y185JZ2ZGCNH40N$'
stdout '^Actor: test$'

# Close-out: no worktree, no local branch, no branch on origin, and main
# here is the merge commit.
! exists $WORK/repo.ship-it
! exec git rev-parse --verify --quiet refs/heads/cs/ship-it
! exec git -C $WORK/origin.git rev-parse --verify --quiet refs/heads/cs/ship-it
exec git worktree list --porcelain
stdout -count=1 '^worktree '
exec sh -c 'test "$(git rev-parse HEAD)" = "$(cat $WORK/merge.sha)" && echo same'
stdout '^same$'
exists first.txt
exists second.txt

# The repo's ship command ran once, after main's CI was green.
exec cat $WORK/ship.log
stdout -count=1 '^shipped$'
cmp $WORK/order.log $WORK/want.order

# The change set landed, and an Evidence node names PR #7 and its checks
# and verifies the capability.
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- State: landed'
exec rhiza show pr-7-ship-it
stdout 'Pull request #7 \(https://github\.test/o/r/pull/7\) passed CI at [0-9a-f]{7}'
stdout '2 checks passed: test SUCCESS, lint SUCCESS'
stdout '^- verifies first '
stdout '^- verifies second '
exec rhiza ls --kind evidence --json
stdout '"handle": "pr-7-ship-it"'
fold-ok

-- review.toml --
# The repo's own review, as the built-in one but with two fake checks.
# Its code step runs rhiza check, which passes only because ship-change
# rendered and committed what build's sessions wrote.
[step.code]
kind = "command"
run = "rhiza run code-check"
on.pass = "review"

[step.review]
kind = "checks"
interval = "50ms"
max_visits = 3
on.pass = "signoff"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[[step.review.check]]
name = "beta"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"

[step.signoff]
kind = "signoff"
max_visits = 3
on.pass = "done"
on.changes = "review"
-- want.log --
role=builder leaf=first
role=verifier leaf=first
role=builder leaf=second
role=verifier leaf=second
-- want.order --
main-green
main-green
shipped
-- ship.sh --
#!/bin/sh
echo shipped >> "$WORK/ship.log"
echo shipped >> "$WORK/order.log"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
echo "role=$RHIZA_ROLE leaf=$RHIZA_LEAF" >> "$WORK/claude.log"
case "$RHIZA_ROLE" in
builder)
	echo "$RHIZA_LEAF" > "$RHIZA_LEAF.txt"
	git add "$RHIZA_LEAF.txt"
	git commit -q -m "build $RHIZA_LEAF" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Leaf: $RHIZA_LEAF" -- "$RHIZA_LEAF.txt" || exit 1
	;;
verifier)
	rhiza add evidence "$RHIZA_LEAF-verified" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	rhiza link "$RHIZA_LEAF-verified" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
	;;
check)
	echo '{"findings":[]}' > "$WORK/empty-round.json"
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty-round.json" >&2 || exit 1
	;;
esac
exit 0
-- bin/gh --
#!/bin/sh
echo "$@" >> "$WORK/gh.log"
o="$WORK/origin.git"
case "$1 $2" in
"pr view")
	if [ "$3" = 7 ]; then
		printf '{"mergeCommit":{"oid":"%s"},"state":"MERGED"}\n' "$(cat "$WORK/merge.sha")"
		exit 0
	fi
	if ! head=$(git -C "$o" rev-parse --verify --quiet "refs/heads/$3"); then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	if [ ! -f "$WORK/pr.created" ]; then
		printf '{"number":3,"url":"https://github.test/o/r/pull/3","state":"MERGED","headRefOid":"%s","statusCheckRollup":[]}\n' "$head"
		exit 0
	fi
	echo "$head" > "$WORK/landed.sha"
	printf '{"number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"},{"context":"lint","state":"SUCCESS"}]}\n' "$head"
	;;
"pr create")
	while [ $# -gt 0 ]; do
		if [ "$1" = --body-file ]; then
			cp "$2" "$WORK/pr-body.md"
		fi
		shift
	done
	touch "$WORK/pr.created"
	;;
"pr edit")
	;;
"pr merge")
	head=$(git -C "$o" rev-parse refs/heads/cs/ship-it)
	if [ "$6" != "$head" ]; then
		echo "head branch was modified" >&2
		exit 1
	fi
	sha=$(git -C "$o" commit-tree "$head^{tree}" -p refs/heads/main -m 'Ship it (#7)')
	git -C "$o" update-ref refs/heads/main "$sha"
	echo "$sha" > "$WORK/merge.sha"
	;;
"run list")
	echo main-green >> "$WORK/order.log"
	echo '[{"name":"ci","status":"completed","conclusion":"success"}]'
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
