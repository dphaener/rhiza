# A change set that edits a node and later retires it holds one retire on the
# node's landed version, and lands with no conflict.

rhiza init
rhiza add capability store --field 'statement=Stores' --record
rhiza change new Shape
rhiza set store --field 'statement=Stores more'
rhiza retire store --reason 'Folded into api'
rhiza change show --json
stdout -count=1 '"op": "node.retire"'
! stdout '"op": "node.update"'
fold-ok
rhiza propose
rhiza accept --reason ok
rhiza land
fold-ok
