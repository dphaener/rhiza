# A session of a live run that resolves as blocked on a permission prompt is an
# inbox item of kind permission, in an owner-run and an autonomous run alike,
# with the prompt's message and the session's own tab; a newer Rex idle report
# clears it. An autonomous run's question block still gives no item. The
# session records are written by hand.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_NOW=2030-01-01T00:10:00Z
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .rhiza/workflows
cp $WORK/work.toml .rhiza/workflows/work.toml
env REX_BLOCK=block:root
env REX_SESSION=session:s1
exec rhiza change new 'Owner blocked' --title 'Owner blocked' --json
exec rhiza run start --foreground --workflow work --permission-mode manual &

# Wait (bounded) until the agent has reported working through its hook.
exec sh -c 'i=0; while [ $i -lt 400 ]; do grep -q "\"hook\"" "$WORK"/repo/.git/rhiza/sessions/*.json && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec rhiza inbox --json
! stdout '"permission"'

# A permission block reported at 00:00:00.
exec sh -c 'for f in "$WORK"/repo/.git/rhiza/sessions/*.json; do perl -0pe "s/(\"hook\": \{.*?\"state\": \")working\"/\${1}blocked\", \"kind\": \"permission\", \"detail\": \"Allow the hook command?\"/s; s/(\"hook\": \{.*?\"at\": \")[^\"]*/\${1}2030-01-01T00:00:00Z/s; s/\"tab\": \{[^}]*\}/\"tab\": {\"title\": \"build tab\", \"block\": \"block:sess\", \"session\": \"session:s2\"}/s" "$f" > "$f.new" && mv "$f.new" "$f"; done'
exec rhiza inbox --json
stdout '"kind": "permission"'
stdout '"step": "build"'
stdout '"detail": "Allow the hook command\?"'
stdout '"at": "2030-01-01T00:00:00Z"'
stdout '"tab": "build tab"'
stdout '"tab_block": "block:sess"'
stdout '"tab_session": "session:s2"'
stdout '"next": "rhiza inbox open [0-9a-f]+"'
stdout '"session": "'
stdout '"run": "'
exec rhiza inbox
stdout 'permission run [0-9A-Za-z]+, change set [0-9A-Z]+, step build'
stdout 'Allow the hook command\?'
stdout 'next: rhiza inbox open'

# Opening it focuses the blocked session's own tab, not the run's.
exec sh -c 'rhiza inbox | grep -E "^[0-9a-f]+ permission " | cut -d" " -f1'
cp stdout ../pid
exec sh -c 'rhiza inbox open "$(cat ../pid)"'
stdout 'Focused block:sess, the tab of permission run'
exec cat ../rex.log
stdout 'focus -s session:s2 block:sess'
! stdout 'focus .*block:root'

# A newer Rex idle report clears it.
exec sh -c 'for f in "$WORK"/repo/.git/rhiza/sessions/*.json; do perl -0pe "s/(\"status\": \{)/\${1}\"rex\": {\"state\": \"idle\", \"at\": \"2030-01-01T00:05:00Z\"}, /" "$f" > "$f.new" && mv "$f.new" "$f"; done'
exec rhiza inbox --json
! stdout '"permission"'

exec sh -c 'echo > $WORK/go'
wait

# An autonomous run's session lists one too, but its question block none:
# the fixture journal is an autonomous run waiting on a question.
exec sh -c 'rm $WORK/go; rm -f .git/rhiza/sessions/*.json'
exec rhiza change new 'Autonomous blocked' --title 'Autonomous blocked' --json
exec rhiza run start --foreground --workflow work --permission-mode manual --autonomous &
exec sh -c 'i=0; while [ $i -lt 400 ]; do grep -q "\"hook\"" "$WORK"/repo/.git/rhiza/sessions/*.json && exit 0; i=$((i+1)); sleep 0.025; done; exit 1'
exec sh -c 'for f in "$WORK"/repo/.git/rhiza/sessions/*.json; do perl -0pe "s/(\"hook\": \{.*?\"state\": \")working\"/\${1}blocked\", \"kind\": \"permission\", \"detail\": \"Allow the hook command?\"/s; s/(\"hook\": \{.*?\"at\": \")[^\"]*/\${1}2030-01-01T00:00:00Z/s; s/\"tab\": \{[^}]*\}/\"tab\": {\"title\": \"build tab\", \"block\": \"block:sess\", \"session\": \"session:s2\"}/s" "$f" > "$f.new" && mv "$f.new" "$f"; done'
exec rhiza inbox --json
stdout '"kind": "permission"'
mkdir .git/rhiza/runs
cp ../autoquestion.jsonl .git/rhiza/runs/AUTOQUESTION1.jsonl
exec rhiza inbox --json
! stdout '"question"'

exec sh -c 'echo > $WORK/go'
wait

-- autoquestion.jsonl --
{"type":"started","at":"2030-01-01T00:00:00Z","step":"build","started":{"workflow":"ship-change","definition":"","change":"CSAUTO","autonomous":true}}
{"type":"entered","at":"2030-01-01T00:00:01Z","step":"build","visit":1}
{"type":"blocked","at":"2030-01-01T00:01:00Z","step":"build","session":"S1","block":{"kind":"question","question":"Which store?"}}
-- work.toml --
name = "work"

[step.build]
kind = "agent"
prompt = "Build {change}"
interval = "50ms"
on.pass = "done"
-- bin/rex --
#!/bin/sh
echo "$@" >> "$WORK/rex.log"
if [ "$1" = events ]; then
	exit 0
fi
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && exec "$@") >"$WORK/tab.out" 2>&1 </dev/null &
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
sid=
while [ $# -gt 0 ]; do
	if [ "$1" = --session-id ]; then
		sid=$2
	fi
	shift
done
echo '{"session_id":"'$sid'","hook_event_name":"UserPromptSubmit"}' | rhiza session hook UserPromptSubmit >> "$WORK/hook.out" || exit 8
i=0
until [ -f "$WORK/go" ]; do
	i=$((i + 1))
	if [ $i -gt 800 ]; then
		exit 9
	fi
	sleep 0.025
done
exit 0
