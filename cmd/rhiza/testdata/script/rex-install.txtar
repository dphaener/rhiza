# rex install puts rhiza.lua beside Rex's init.lua, adds one require line
# and reloads Rex; uninstall undoes it. REX_CONFIG points at a folder in
# $WORK and rex is a fake: no test touches the real Rex.

env PATH=$WORK/bin:$PATH
env REX_CONFIG=$WORK/conf/init.lua
chmod 755 bin/rex
mkdir conf
cp owner.lua conf/init.lua

exec rhiza rex install
stdout 'Installed Rhiza.s app actions and key mode'
! stdout 'quick-launch'
grep '^-- Written by rhiza rex install\.$' conf/rhiza.lua
grep 'launch_key = "ctrl\+a>a"' conf/rhiza.lua
grep -count=1 'require\("rhiza"\)' conf/init.lua
grep '^-- mine$' conf/init.lua
grep -count=1 '^config reload$' rex.log

# Every registered app is a Rex action of its own, titled with its name and
# running `rhiza tui app <name>`: read, write and model apps alike.
grep 'name = "rhiza_app_roadmap"' conf/rhiza.lua
grep 'title = "roadmap"' conf/rhiza.lua
grep '"tui", "app", "roadmap"' conf/rhiza.lua
grep 'title = "session-ls"' conf/rhiza.lua
grep 'name = "rhiza_app_inbox"' conf/rhiza.lua
grep '"tui", "app", "inbox"' conf/rhiza.lua
grep 'name = "rhiza_app_session_ls"' conf/rhiza.lua
! grep 'name = "rhiza_app_[a-z0-9_]*[^a-z0-9_"]' conf/rhiza.lua
grep '"tui", "app", "model"' conf/rhiza.lua
grep 'title = "model"' conf/rhiza.lua
grep 'title = "accept"' conf/rhiza.lua
grep 'bounds = cell_bounds\(ctx.block_id, 100, 30\)' conf/rhiza.lua
grep 'window_id = block_window\(ctx.block_id\),' conf/rhiza.lua
# No app opens full-screen: every action sizes its layer with cell_bounds
# to the cells of its app's component NaturalSize, centred. No registered
# app hosts a component yet, so every action asks for the default 100x30:
# no bounds line is anything but that call. internal/api's
# TestRexInstallOpensEveryAppAsACentredModalSizedToItsComponent runs the
# actions with sizes taken from a Form's, a List's and a Dialog's NaturalSize.
! grep 'bounds = LAYER_BOUNDS' conf/rhiza.lua
! grep '^      bounds = ([^c]|c[^e])' conf/rhiza.lua
! grep 'bounds = cell_bounds\(ctx\.block_id, ([^1]|1[^0]|10[^0]|100[^,]|100, ([^3]|3[^0]|30[^)]))' conf/rhiza.lua

# The launch key enters the rhiza key mode, which binds one key per app to
# that app's action.
grep 'client.mode.enter", \{ name = MODE' conf/rhiza.lua
grep '^  \["roadmap"\] = "[a-z0-9]",$' conf/rhiza.lua
grep '^  \["model"\] = "[a-z0-9]",$' conf/rhiza.lua
grep 'name = "rhiza_app_changes"' conf/rhiza.lua
grep '"tui", "app", "changes"' conf/rhiza.lua
grep '^  \["changes"\] = "g",$' conf/rhiza.lua
# The other apps keep the keys they had before the changes app.
grep '^  \["show"\] = "h",$' conf/rhiza.lua
grep '^  \["change-show"\] = "c",$' conf/rhiza.lua
# The health app is on t, which no app had: no other key moved.
grep 'name = "rhiza_app_health"' conf/rhiza.lua
grep '"tui", "app", "health"' conf/rhiza.lua
grep '^  \["health"\] = "t",$' conf/rhiza.lua
grep '^  \["accept"\] = "a",$' conf/rhiza.lua
grep '^  \["inbox"\] = "i",$' conf/rhiza.lua
grep '^  \["land"\] = "l",$' conf/rhiza.lua
grep '^  \["live"\] = "v",$' conf/rhiza.lua
grep '^  \["model"\] = "m",$' conf/rhiza.lua
grep '^  \["propose"\] = "p",$' conf/rhiza.lua
grep '^  \["ready"\] = "r",$' conf/rhiza.lua
grep '^  \["record-add"\] = "e",$' conf/rhiza.lua
grep '^  \["record-link"\] = "o",$' conf/rhiza.lua
grep '^  \["record-retire"\] = "d",$' conf/rhiza.lua
grep '^  \["record-set"\] = "s",$' conf/rhiza.lua
grep '^  \["roadmap"\] = "b",$' conf/rhiza.lua
grep '^  \["run-status"\] = "u",$' conf/rhiza.lua
grep '^  \["session-ls"\] = "n",$' conf/rhiza.lua
grep '^  \["slice"\] = "f",$' conf/rhiza.lua
grep '^  \["why"\] = "w",$' conf/rhiza.lua
grep 'keys = \{\},' conf/rhiza.lua
grep '^  \["session-ls"\] = "rhiza_app_session_ls",$' conf/rhiza.lua
grep 'rex.bind\(MODE .. "/" .. k, APP_ACTIONS\[app\]\)' conf/rhiza.lua

# The requests app has an action on a key no other app had; no existing key
# moved.
grep 'name = "rhiza_app_requests"' conf/rhiza.lua
grep '"tui", "app", "requests"' conf/rhiza.lua
grep '^  \["requests"\] = "q",$' conf/rhiza.lua
grep '^  \["roadmap"\] = "b",$' conf/rhiza.lua
grep '^  \["ready"\] = "r",$' conf/rhiza.lua
grep '^  \["live"\] = "v",$' conf/rhiza.lua
grep '^  \["inbox"\] = "i",$' conf/rhiza.lua

# The autonomy app has an action on key y, which no app had; no existing key
# moved.
grep 'name = "rhiza_app_autonomy"' conf/rhiza.lua
grep '"tui", "app", "autonomy"' conf/rhiza.lua
grep '^  \["autonomy"\] = "y",$' conf/rhiza.lua
grep '^  \["requests"\] = "q",$' conf/rhiza.lua
grep '^  \["health"\] = "t",$' conf/rhiza.lua
grep '^  \["roadmap"\] = "b",$' conf/rhiza.lua
grep '^  \["inbox"\] = "i",$' conf/rhiza.lua

# A second install changes neither file, and keeps an edited setting: the
# owner edits launch_key, and a reinstall leaves that line byte for byte.
exec sed -e 's/launch_key = "ctrl+a>a"/launch_key = "ctrl+b>x"/' conf/rhiza.lua
cp stdout conf/rhiza.lua
grep -count=1 '^  launch_key = "ctrl\+b>x",$' conf/rhiza.lua
cp conf/init.lua first-init.lua
cp conf/rhiza.lua first-rhiza.lua
exec rhiza rex install --json
stdout '"written": \[\]'
cmp conf/init.lua first-init.lua
cmp conf/rhiza.lua first-rhiza.lua
grep -count=1 '^  launch_key = "ctrl\+b>x",$' conf/rhiza.lua
grep '^-- settings begin$' conf/rhiza.lua
grep '^-- settings end$' conf/rhiza.lua

# Uninstall gives the owner's file back byte for byte.
exec rhiza rex uninstall
stdout 'Removed Rhiza.s app actions and key mode from Rex'
! stdout 'quick-launch'
cmp conf/init.lua owner.lua
! exists conf/rhiza.lua

# A rhiza.lua that is not ours is a conflict, exit 5.
cp theirs.lua conf/rhiza.lua
! exec rhiza rex install
stderr 'was not written by rhiza rex install'

# An init.lua symlinked from dotfiles is edited through the link, and
# rhiza.lua goes in the folder Rex reads, where require("rhiza") finds it,
# not beside the link's target.
env REX_CONFIG=$WORK/linked/init.lua
mkdir dotfiles linked
cp owner.lua dotfiles/init.lua
symlink linked/init.lua -> ../dotfiles/init.lua
exec rhiza rex install
grep -count=1 'require\("rhiza"\)' dotfiles/init.lua
grep '^-- Written by rhiza rex install\.$' linked/rhiza.lua
! exists dotfiles/rhiza.lua
exec rhiza rex uninstall
cmp dotfiles/init.lua owner.lua
! exists linked/rhiza.lua

-- theirs.lua --
-- theirs
-- owner.lua --
-- mine
rex.bind("ctrl+a r", "client.config.reload")
-- bin/rex --
#!/bin/sh
echo "$@" >> "$WORK/rex.log"
