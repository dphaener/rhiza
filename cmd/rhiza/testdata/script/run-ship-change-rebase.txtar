# The built-in ship-change run rebases a PR that main has moved past:
# before landing and again before merging, rhiza ship rebase fetches
# origin and, when origin's main has commits the branch lacks, rebases the
# branch onto it.
#
# Case 1: main moves after the land commit is pushed (another change set
# landed and rendered there), so the land commit's rendered index.md
# conflicts. Conflicts only under .rhiza/rendered/ are settled by
# rendering again; the run pushes the rebased head with a lease, waits for
# CI on it and merges it.
#
# Case 2: main moves while the builder builds, with a commit that adds the
# same files the builder adds. That conflict is not a rendered one: the
# rebase is aborted, the step and the run fail, and a question in the
# change set names the files. One file is named @shipping, so the
# question's statement refers to the shipping capability: it is stored by
# ID, and raising the same conflict again still writes nothing.
#
# Case 3: the branch already holds a merge of main. The builder merges
# main, which also added feature.txt, resolving the conflict; main then
# moves with an unrelated commit. Rebasing would replay the builder's
# commit onto it and bring the conflict back, so rhiza merges main into the
# branch instead: no question, the earlier merge stays in the pushed
# head's history, and the run merges.
#
# The fakes and the repo's review are run-ship-change.txtar's, except that
# the builder commits feature.txt, gh finds origin from the checkout it runs
# in, and main moves at a set point: case 1's gh pushes a prepared commit to
# origin's main the first time it sees the land commit as the PR's head;
# case 2's builder pushes one while it builds. Each run stops at its
# sign-off, and the owner approves it.

chmod 755 bin/rex
chmod 755 bin/claude
chmod 755 bin/gh
env PATH=$WORK/bin:$PATH

# Case 1: a rendered-only conflict.
exec git init -q --bare origin.git
mkdir repo
cd repo
exec git init -q
exec git remote add origin $WORK/origin.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
exec rhiza change new 'Ship it' --title 'Ship it' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza render
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main

# Another change set lands on main while this one ships: prepared in a
# clone (with its own ID seed, so its IDs differ), pushed by the fake gh.
exec git clone -q $WORK/origin.git $WORK/other
cd $WORK/other
env RHIZA_TEST_SEED=2
exec rhiza change new 'Other' --title 'Other'
exec rhiza add capability other --field 'statement=Does another thing'
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza land
exec rhiza render
stdout 'index\.md'
exec git add -A
exec git commit -qm 'Land other'
env RHIZA_TEST_SEED=1
cd $WORK/repo
exec touch $WORK/move-main

exec sh -c 'rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
stdout '^exit=0$'
exec sh -c 'rhiza run approve --foreground; echo exit=$?'
stdout '^exit=0$'
stdout '^Run \S+ succeeded$'
# Main had not moved before the land; it had before the merge, and the
# rendered conflict was settled.
stderr '^cs/ship-it already holds origin/main at [0-9a-f]{7}; nothing to rebase\.$'
stderr '^Rebased cs/ship-it onto origin/main at [0-9a-f]{7}\.$'
stderr '^Settled 1 rendered file by rendering again\.$'
! exists $WORK/move-main

exec rhiza run status
stdout '^- rebase \(visit 1\): pass, then wait-rebased: exit 0$'
stdout '^- land \(visit 1\): pass, then wait-landed: exit 0$'
stdout '^- landed-green \(visit 1\): pass, then rebase-merge: exit 0$'
stdout '^- rebase-merge \(visit 1\): pass, then wait-rebased-merge: exit 0$'
stdout '^- wait-rebased-merge \(visit 1\): pass, then rebased-merge-green: held after [0-9]+ checks?$'
stdout '^- rebased-merge-green \(visit 1\): pass, then merge: exit 0$'
stdout '^- merge \(visit 1\): pass, then wait-main: exit 0$'
stdout '^- ship \(visit 1\): pass, then deploy-check: exit 0$'
stdout '^- deploy-check \(visit 1\): pass, then end: exit 0$'

# The merge was pinned to the rebased head, which holds the other change
# set's commit and is not the land head CI first passed.
exec sh -c 'grep -c -x "pr merge 7 --squash --match-head-commit $(cat $WORK/landed.sha)" $WORK/gh.log'
stdout '^1$'
exec sh -c 'test "$(cat $WORK/landed.sha)" != "$(cat $WORK/before.sha)" && echo moved'
stdout '^moved$'
exec sh -c 'git -C $WORK/origin.git merge-base --is-ancestor $(cat $WORK/other.sha) $(cat $WORK/landed.sha) && echo rebased'
stdout '^rebased$'

# Main now holds both change sets, rendered from the model: the index
# names both capabilities, and rhiza check finds nothing stale.
exec sh -c 'test "$(git rev-parse HEAD)" = "$(cat $WORK/merge.sha)" && echo same'
stdout '^same$'
exec cat .rhiza/rendered/index.md
stdout 'shipping'
stdout 'other'
! stdout '<<<<<<<|>>>>>>>'
exec rhiza check
! stdout 'stale'
exec rhiza change show 01M5PWGEF85Y185JZ2ZGCNH40N
stdout '^- State: landed'
fold-ok

rm $WORK/gh.log
rm $WORK/pr.created

# Case 2: a code conflict.
cd $WORK
exec git init -q --bare origin2.git
mkdir repo2
exec sh -c 'printf "[projects.repo2]\npath = \"repo2\"\n" >> $WORK/rhiza.toml'
cd repo2
exec git init -q
exec git remote add origin $WORK/origin2.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
exec rhiza change new 'Ship two' --title 'Ship two' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main

# main gets its own feature.txt and @shipping; the builder pushes them
# while it builds.
exec git clone -q $WORK/origin2.git $WORK/other2
cd $WORK/other2
exec sh -c 'echo theirs > feature.txt'
exec sh -c 'echo theirs > @shipping'
exec git add feature.txt @shipping
exec git commit -qm 'Add a feature on main'
cd $WORK/repo2

exec rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json
stdout '"signoff_waiting": true'
! exec rhiza run approve --foreground
stdout '^Run \S+ failed$'
stdout '^- Detail: step "rebase" ended with outcome "fail"$'
stderr '^Rebasing cs/ship-two onto origin/main at [0-9a-f]{7} conflicts in:$'
stderr '^- feature\.txt$'
stderr '^- @shipping$'
stderr '^Raised question rebase-conflict-ship-two\.$'

exec rhiza run status
stdout '^- rebase \(visit 1\): fail, then end: exit 1$'
! stdout '^- land '
! grep '^pr merge' $WORK/gh.log

# The branch is as open-pr pushed it, plus the question's commit, which is
# not pushed; no rebase is left in progress.
cd $WORK/repo2.ship-two
exec git status
! stdout 'rebase'
exec git log -1 --format=%s
stdout '^Raise a question on the rebase conflicts$'
exec sh -c 'test "$(git rev-parse HEAD~1)" = "$(git -C $WORK/origin2.git rev-parse refs/heads/cs/ship-two)" && echo unpushed'
stdout '^unpushed$'
exec cat feature.txt
stdout '^built$'

# The question is in the change set and names the conflicting file.
exec rhiza ls --kind question --json
stdout '"handle": "rebase-conflict-ship-two"'
exec rhiza show rebase-conflict-ship-two
stdout 'feature\.txt'
stdout '@shipping'
! stdout '@@shipping|@\{'
stdout 'cs/ship-two onto origin/main'
exec sh -c 'cat .rhiza/log/*/*.json'
stdout '"statement": "Rebasing branch cs/ship-two .*@\{[0-9A-Z]{26}\}'
fold-ok

# The question blocks the change set: the inbox lists it as a blocker.
exec rhiza show rebase-conflict-ship-two --json
stdout '"type": "blocks"'
exec rhiza inbox --json
stdout '"kind": "blocker"'
stdout '"handle": "rebase-conflict-ship-two"'
stdout '"blocks": "this change set"'

# Raising it again on the same conflict writes nothing.
exec sh -c 'find .rhiza/log -type f | sort | xargs cat | wc -c > $WORK/log.before'
! exec rhiza ship rebase
stdout '^Raised question rebase-conflict-ship-two\.$'
exec sh -c 'find .rhiza/log -type f | sort | xargs cat | wc -c > $WORK/log.after'
exec cmp $WORK/log.before $WORK/log.after
exec rhiza ls --kind question --json
stdout '"handle": "rebase-conflict-ship-two"'

# A question raised before it blocked its change set (no blocks link)
# gains the link when the conflict is raised again; no second question is
# added.
exec sh -c 'rhiza unlink $(rhiza show rebase-conflict-ship-two --json | grep -A2 "\"links_out\"" | sed -n "s/.*\"id\": \"\\([0-9A-Z]*\\)\".*/\\1/p") --change 01M5PWGEF85Y185JZ2ZGCNH40N'
stdout '^- link [0-9A-Z]{26}$'
exec rhiza show rebase-conflict-ship-two --json
! stdout '"type": "blocks"'
! exec rhiza ship rebase
stdout '^Raised question rebase-conflict-ship-two\.$'
exec rhiza show rebase-conflict-ship-two --json
stdout '"type": "blocks"'
exec rhiza ls --kind question --json
stdout -count=1 '"handle": "rebase-conflict-ship-two'
exec rhiza inbox --json
stdout '"blocks": "this change set"'
fold-ok

# The owner answers it with --change.
exec rhiza question answer rebase-conflict-ship-two 'Keep main' --change 01M5PWGEF85Y185JZ2ZGCNH40N
fold-ok

rm $WORK/gh.log
rm $WORK/pr.created
rm $WORK/other2
rm $WORK/other
rm $WORK/merge.sha

# Case 3: a merge the branch already holds.
cd $WORK
exec git init -q --bare origin3.git
mkdir repo3
exec sh -c 'printf "[projects.repo3]\npath = \"repo3\"\n" >> $WORK/rhiza.toml'
cd repo3
exec git init -q
exec git remote add origin $WORK/origin3.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
exec rhiza change new 'Ship it' --title 'Ship it' --json
stdout '"change_set": "01M5PWGEF85Y185JZ2ZGCNH40N"'
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main

# The builder pushes main's feature.txt from other3, then merges it.
exec git clone -q $WORK/origin3.git $WORK/other3
cd $WORK/other3
exec sh -c 'echo theirs > feature.txt'
exec git add feature.txt
exec git commit -qm 'Add a feature on main'
# The fake gh moves main again, from other, once CI has seen the land commit.
exec git clone -q $WORK/origin3.git $WORK/other
cd $WORK/other
exec sh -c 'echo unrelated > unrelated.txt'
exec git add unrelated.txt
exec git commit -qm 'Add something unrelated'
cd $WORK/repo3
exec touch $WORK/merge-in-build
exec touch $WORK/move-main

exec sh -c 'rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json; echo exit=$?'
stdout '"signoff_waiting": true'
exec sh -c 'rhiza run approve --foreground; echo exit=$?'
stdout '^exit=0$'
stdout '^Run \S+ succeeded$'
stderr '^Rebased cs/ship-it onto origin/main at [0-9a-f]{7}\.$'
! exists $WORK/move-main
! stderr 'Raised question'

exec rhiza run status
stdout '^- rebase-merge \(visit 1\): pass, then wait-rebased-merge: exit 0$'
stdout '^- merge \(visit 1\): pass, then wait-main: exit 0$'

# The pushed head holds main's new commit and still has the builder's
# merge of main in its history.
exec sh -c 'git -C $WORK/origin3.git merge-base --is-ancestor $(cat $WORK/other.sha) $(cat $WORK/landed.sha) && echo moved'
stdout '^moved$'
exec sh -c 'git -C $WORK/origin3.git merge-base --is-ancestor $(cat $WORK/builder-merge.sha) $(cat $WORK/landed.sha) && echo kept'
stdout '^kept$'
exec sh -c 'test "$(cat $WORK/landed.sha)" != "$(cat $WORK/before.sha)" && echo moved'
stdout '^moved$'
exec rhiza ls --kind question --json
! stdout 'rebase-conflict'
fold-ok

rm $WORK/gh.log
rm $WORK/pr.created
rm $WORK/other3
rm $WORK/other
rm $WORK/merge.sha
rm $WORK/builder-merge.sha

# Case 4: as case 3, but main's new commit changes feature.txt again, so
# the merge of main conflicts outside the rendered files: the question is
# raised and the step fails.
cd $WORK
exec git init -q --bare origin4.git
mkdir repo4
exec sh -c 'printf "[projects.repo4]\npath = \"repo4\"\n" >> $WORK/rhiza.toml'
cd repo4
exec git init -q
exec git remote add origin $WORK/origin4.git
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/review.toml .rhiza/workflows/review.toml
exec rhiza change new 'Ship it' --title 'Ship it' --json
exec rhiza add capability shipping --field 'statement=Ships a change set'
exec rhiza propose
exec rhiza accept --reason ok
exec git add -A
exec git commit -qm 'Start shipping'
exec git push -q -u origin main
exec git clone -q $WORK/origin4.git $WORK/other3
cd $WORK/other3
exec sh -c 'echo theirs > feature.txt'
exec git add feature.txt
exec git commit -qm 'Add a feature on main'
exec git push -q origin HEAD:main
exec git clone -q $WORK/origin4.git $WORK/other
cd $WORK/other
exec sh -c 'echo again > feature.txt'
exec git commit -qam 'Change the feature again'
cd $WORK/repo4
exec touch $WORK/move-main

exec rhiza run start --foreground 01M5PWGEF85Y185JZ2ZGCNH40N --permission-mode manual --json
stdout '"signoff_waiting": true'
! exec rhiza run approve --foreground
stdout '^Run \S+ failed$'
stdout '^- Detail: step "rebase-merge" ended with outcome "fail"$'
stderr '^- feature\.txt$'
stderr '^Raised question rebase-conflict-ship-it\.$'
exec rhiza run status
stdout '^- rebase-merge \(visit 1\): fail, then end: exit 1$'
! grep '^pr merge' $WORK/gh.log
cd $WORK/repo4.ship-it
exec git status
! stdout 'rebase|merge'
fold-ok

-- review.toml --
# The repo's own review, as the built-in one but with two fake checks and
# no code step: run-ship-change.txtar runs the code step after the render.
[step.review]
kind = "checks"
interval = "50ms"
max_visits = 3
on.pass = "signoff"

[[step.review.check]]
name = "alpha"
prompt = "Review change set {change} as check {check}"

[[step.review.check]]
name = "beta"
prompt = "Review change set {change} as check {check}"

[step.review.critic]
prompt = "Criticise {check}"

[step.review.fixer]
prompt = "Fix {leaf}"

[step.review.verifier]
prompt = "Verify {leaf}"

[step.signoff]
kind = "signoff"
max_visits = 3
on.pass = "done"
on.changes = "review"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
case "$RHIZA_ROLE" in
builder)
	files=feature.txt
	[ -d "$WORK/other2" ] && files="feature.txt @shipping"
	for f in $files; do echo built > "$f"; done
	git add $files
	git commit -q -m "build $RHIZA_LEAF" -m "Change: $RHIZA_CHANGE
Actor: $RHIZA_ACTOR
Leaf: $RHIZA_LEAF" -- $files || exit 1
	if [ -f "$WORK/merge-in-build" ]; then
		git -C "$WORK/other3" push -q origin HEAD:main || exit 1
		git fetch -q origin || exit 1
		git merge -q --no-edit origin/main >&2 || true
		echo built > feature.txt
		git add feature.txt
		git commit -q --no-edit || exit 1
		git rev-parse HEAD > "$WORK/builder-merge.sha"
	elif [ -d "$WORK/other2" ]; then
		git -C "$WORK/other2" push -q origin HEAD:main || exit 1
	fi
	;;
verifier)
	rhiza add evidence "$RHIZA_LEAF-verified" --field "statement=$RHIZA_LEAF works" --field result=PASS --change "$RHIZA_CHANGE" >&2 || exit 1
	rhiza link "$RHIZA_LEAF-verified" verifies "$RHIZA_LEAF" --change "$RHIZA_CHANGE" >&2 || exit 1
	;;
check)
	echo '{"findings":[]}' > "$WORK/empty-round.json"
	rhiza run findings --check "$RHIZA_CHECK" "$WORK/empty-round.json" >&2 || exit 1
	;;
esac
exit 0
-- bin/gh --
#!/bin/sh
csid=${RHIZA_CHANGE:-$(grep -l '"type": "open"' .rhiza/log/*/*.json | tail -1 | xargs grep -ho '"change_set": "[0-9A-Z]*"' | tr -dc 0-9A-Z)}
echo "$@" >> "$WORK/gh.log"
o=$(git remote get-url origin)
case "$1 $2" in
"pr view")
	if [ "$3" = 7 ]; then
		printf '{"mergeCommit":{"oid":"%s"},"state":"MERGED"}\n' "$(cat "$WORK/merge.sha")"
		exit 0
	fi
	if ! head=$(git -C "$o" rev-parse --verify --quiet "refs/heads/$3") || [ ! -f "$WORK/pr.created" ]; then
		echo "no pull requests found for branch \"$3\"" >&2
		exit 1
	fi
	# Case 1: main moves once CI has seen the land commit.
	if [ -f "$WORK/move-main" ] && [ "$(git -C "$o" log -1 --format=%s "$head")" = "Land the change set and record its CI" ]; then
		if [ -f "$WORK/merge-in-build" ]; then
			git -C "$WORK/other" pull -q --rebase origin main || exit 1
		fi
		git -C "$WORK/other" push -q origin HEAD:main || exit 1
		git -C "$WORK/other" rev-parse HEAD > "$WORK/other.sha"
		echo "$head" > "$WORK/before.sha"
		rm "$WORK/move-main"
	fi
	echo "$head" > "$WORK/landed.sha"
	printf '{"body":"Change set '"$csid"'","number":7,"url":"https://github.test/o/r/pull/7","state":"OPEN","headRefOid":"%s","statusCheckRollup":[{"name":"test","status":"COMPLETED","conclusion":"SUCCESS"},{"context":"lint","state":"SUCCESS"}]}\n' "$head"
	;;
"pr create")
	touch "$WORK/pr.created"
	;;
"pr edit")
	;;
"pr merge")
	head=$(git -C "$o" rev-parse refs/heads/cs/ship-it)
	if [ "$6" != "$head" ]; then
		echo "head branch was modified" >&2
		exit 1
	fi
	sha=$(git -C "$o" commit-tree "$head^{tree}" -p refs/heads/main -m 'Ship it (#7)')
	git -C "$o" update-ref refs/heads/main "$sha"
	echo "$sha" > "$WORK/merge.sha"
	;;
"run list")
	echo '[{"name":"ci","status":"completed","conclusion":"success"}]'
	;;
*)
	echo "fake gh: unexpected: $*" >&2
	exit 1
	;;
esac
