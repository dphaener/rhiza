# run start --workflow plan --autonomous is a usage error (exit 2) when the
# run plans a milestone: --new --milestone, or an existing record change
# set. It writes no draft and no journal. The same starts without
# --autonomous run, an intention with --autonomous still runs, and run
# resume refuses a milestone plan run journaled autonomous.
#
# The workflow has no agent step, so nothing here needs an agent.

chmod 755 bin/rex
env PATH=$WORK/bin:$PATH
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .rhiza/workflows
cp $WORK/plan.toml .rhiza/workflows/plan.toml
exec rhiza change new 'Plan reports' --kind record --title 'Plan reports' --json
exec sh -c 'rhiza change show --json | sed -n "s/^  \"id\": \"\([0-9A-Z]*\)\".*/\1/p" > $WORK/rec'
exec sh -c 'rhiza change ls --json | grep -c "\"intent\"" > $WORK/before'

# Refused: nothing is opened or journaled.
exec sh -c 'rhiza run start --foreground --workflow plan --new "Plan the milestone" --milestone --permission-mode manual --autonomous 2>&1; echo exit=$?'
stdout 'milestone planning needs the owner'
stdout '^exit=2$'
exec sh -c 'rhiza run start --foreground $(cat $WORK/rec) --workflow plan --permission-mode manual --autonomous 2>&1; echo exit=$?'
stdout 'milestone planning needs the owner'
stdout '^exit=2$'
exec sh -c 'rhiza change ls --json | grep -c "\"intent\""'
cmp stdout $WORK/before
! exists .git/rhiza/runs

# Without --autonomous a milestone plan runs; so does an autonomous
# intention plan.
exec sh -c 'rhiza run start --foreground $(cat $WORK/rec) --workflow plan --permission-mode manual --json'
stdout '"state": "succeeded"'
exec rhiza run start --foreground --workflow plan --new 'Plan an intention' --permission-mode manual --autonomous --json
stdout '"state": "succeeded"'
stdout '"autonomous": true'

# A milestone run journaled autonomous is not resumed.
exec sh -c 'grep -l "$(cat $WORK/rec)" .git/rhiza/runs/*.jsonl > $WORK/journal'
exec sh -c 'sed -i "0,/\"permission_mode\":\"manual\"/s//\"permission_mode\":\"manual\",\"autonomous\":true/" $(cat $WORK/journal)'
exec sh -c 'rhiza run resume $(basename $(cat $WORK/journal) .jsonl) 2>&1; echo exit=$?'
stdout 'milestone planning needs the owner'
stdout '^exit=2$'

-- plan.toml --
name = "plan"

[step.a]
kind = "command"
run = "true"
on.pass = "done"
-- bin/rex --
#!/bin/sh
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
