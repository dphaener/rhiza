# rhiza request queues a plan request in the clone, request ls shows each
# request's state, and the daemon starts a plan run for the oldest queued
# request while a slot is free: run start --workflow plan --new with the
# request's text (a bug's prefixed Fix, a milestone's with --milestone),
# --autonomous only with plan autonomy auto. Paused, it starts nothing.
#
# The fake rex only logs the daemon's start commands; the plan run of the first
# request is then run by hand, as its tab would, with a fake claude that
# does nothing.

chmod 755 bin/rex
chmod 755 bin/claude
env PATH=$WORK/bin:$PATH
env RHIZA_TEST_DETACH_LOG=$WORK/detach.log
mkdir repo
cd repo
exec git init -q
exec rhiza init
mkdir .rhiza/workflows
cp $WORK/plan.toml .rhiza/workflows/plan.toml
exec git add -A
exec git commit -qm init

# Nothing queued yet.
exec rhiza request ls
stdout '^No plan requests$'
! exec rhiza request '  '
stderr 'needs its text'
! exec rhiza request 'Add exports' --kind chore
stderr 'one of feature, bug, milestone'

# --milestone names a live milestone intent; anything else is a usage error
# and queues nothing.
exec rhiza add intent ms --field milestone=1 --record
exec rhiza add intent area --record
! exec rhiza request 'Bad one' --milestone area
stderr 'not a live milestone intent'
! exec rhiza request 'Bad two' --milestone nonesuch
stderr 'no such node'
exec rhiza request ls
stdout '^No plan requests$'
exec rhiza request 'Add paging' --milestone ms
exec rhiza request ls --json
stdout '"milestone": "[0-9A-Z]{26}"'
exec rhiza request ls
stdout 'Add paging'
exec rm .git/rhiza/requests.json

# Queue a feature, a bug and a milestone.
exec rhiza request 'Add exports'
stdout '^Queued feature request [0-9A-Z]{26}: Add exports$'
exec rhiza request 'Login fails' --kind bug
exec rhiza request 'Ship v2' --kind milestone
exec rhiza request ls --json
stdout -count=3 '"state": "queued"'
! stdout '"run"'
exists .git/rhiza/requests.json
exec sh -c 'rhiza request ls --json | sed -n "s/^      \"id\": \"\(.*\)\",$/\1/p" > $WORK/ids'
exec sh -c 'head -1 $WORK/ids | tr -d "\n" > $WORK/req1'

# A queued request has no run for run start to take.
exec sh -c 'rhiza run start --foreground --workflow plan --new "Add exports" --request $(cat $WORK/req1) --permission-mode manual 2>&1; echo exit=$?'
stdout 'is queued'
stdout '^exit=2$'

# Paused: nothing starts.
exec rhiza daemon set rhiza.daemon.paused true
exec rhiza daemon --permission-mode manual --once
! stdout 'plan run'
! exists $WORK/detach.log
exec rhiza request ls --json
stdout -count=3 '"state": "queued"'

# Unpaused, one slot: the milestone request's plan run starts first, not
# autonomous, whatever the queue order.
exec rhiza daemon set rhiza.daemon.paused false
exec rhiza daemon --permission-mode manual --max-runs 1 --once
stdout -count=1 '^Started the plan run of request '
exec cat $WORK/detach.log
stdout -count=1 '^REX_SESSION=.* rhiza '
stdout 'run start --foreground --workflow plan --new Ship v2 --request [0-9A-Z]{26} --permission-mode manual --milestone$'
exec rhiza request ls
stdout 'milestone planning: Ship v2'
stdout 'feature queued: Add exports$'
stdout 'bug queued: Login fails$'

# A second feature request, queued after the first pass started.
exec rhiza request 'Add search'

# Plan autonomy auto, four slots: the milestone's start, not journaled yet,
# holds one; the feature, the bug and the new feature start autonomous. The
# milestone (always the owner's) never does.
exec rhiza daemon set rhiza.autonomy.plan auto
exec rhiza daemon --permission-mode manual --max-runs 4 --once
stdout -count=3 '^Started the plan run of request '
exec cat $WORK/detach.log
stdout -count=4 '^REX_SESSION=.* rhiza '
stdout 'run start --foreground --workflow plan --new Add exports --request [0-9A-Z]{26} --permission-mode manual --autonomous$'
stdout 'run start --foreground --workflow plan --new Fix Login fails --request [0-9A-Z]{26} --permission-mode manual --autonomous$'
stdout 'run start --foreground --workflow plan --new Add search --request [0-9A-Z]{26} --permission-mode manual --autonomous$'
stdout 'run start --foreground --workflow plan --new Ship v2 --request [0-9A-Z]{26} --permission-mode manual --milestone$'
! stdout 'Ship v2.*--autonomous'
exec rhiza request ls --json
stdout -count=4 '"state": "planning"'

# The first request's tab runs its plan run: it takes the request's run ID,
# and once it succeeds request ls shows the change set it planned.
exec sh -c 'rhiza run start --foreground --workflow plan --new "Add exports" --request $(cat $WORK/req1) --permission-mode manual --json'
stdout '"state": "succeeded"'
exec sh -c 'rhiza request ls --json | grep -B3 -A6 "$(cat $WORK/req1)"'
stdout '"state": "planned"'
stdout '"change": "[0-9A-Z]{26}"'
exec sh -c 'rhiza request ls --json | grep -B3 -A6 "$(cat $WORK/req1)" | sed -n "s/^      \"run\": \"\(.*\)\",$/\1/p" > $WORK/run1'
exec sh -c 'ls .git/rhiza/runs | grep -c "$(cat $WORK/run1)"'
stdout '^1$'

# The daemon detached the plan run into its run's log, <run>.log, so run log
# finds it; no plan-<request>.log is left.
exec sh -c 'ls .git/rhiza/logs/$(cat $WORK/run1).log'
exec sh -c 'ls .git/rhiza/logs | grep -c "^plan-" || true'
stdout '^0$'
exec sh -c 'rhiza run log $(cat $WORK/run1) --all; echo exit=$?'
stdout '^exit=0$'
exec rhiza request ls
stdout 'feature planned: Add exports \(run [0-9A-Z]{26}, change set [0-9A-Z]{26}\)$'

# Its run is taken: a second start of it is refused.
exec sh -c 'rhiza run start --foreground --workflow plan --new "Add exports" --request $(cat $WORK/req1) --permission-mode manual 2>&1; echo exit=$?'
stdout 'already has run'
stdout '^exit=2$'

# The milestone request's tab starts its run as the daemon said, with no
# --autonomous: its journal is not autonomous (the journal exists: it has a
# started entry).
exec sh -c 'rhiza request ls --json | sed -n "s/^      \"id\": \"\(.*\)\",$/\1/p" | sed -n 3p | tr -d "\n" > $WORK/req3'
exec sh -c 'rhiza run start --foreground --workflow plan --new "Ship v2" --request $(cat $WORK/req3) --permission-mode manual --milestone --no-wait --json'
exec sh -c 'run=$(rhiza request ls --json | grep -A6 "$(cat $WORK/req3)" | sed -n "s/^ *\"run\": \"\(.*\)\",$/\1/p"); grep -c "\"autonomous\":true" .git/rhiza/runs/$run.jsonl || true'
stdout '^0$'

fold-ok

-- plan.toml --
name = "plan"

[step.interview]
kind = "agent"
prompt = "Plan {change}"
on.pass = "done"
-- bin/rex --
#!/bin/sh
# A daemon's plan-run tab is only logged; any other tab (an agent's) runs.
case "$*" in
*--request*)
	echo "rex $*" >> "$WORK/rex.log"
	echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
	exit 0
	;;
esac
dir=
while [ $# -gt 0 ]; do
	if [ "$1" = -c ]; then
		dir=$2
	fi
	if [ "$1" = -- ]; then
		shift
		(cd "$dir" && "$@") >&2 || true
		break
	fi
	shift
done
echo '{"window_id":"window:w1","block_ids":["block:b1"]}'
-- bin/claude --
#!/bin/sh
exit 0
