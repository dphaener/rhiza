# why walks back from a node: its decisions (and theirs), its sources and
# the change sets of its history, every field printed in full.

exec rhiza init
exec rhiza change new Base
exec rhiza add capability store
exec rhiza add capability cache --parent store
exec rhiza add source talk --field 'summary=The owner said caching is the point.' --json-field 'quotes=["Keep it in memory, always."]'
exec rhiza add decision use-ram --field 'statement=We keep the hot set in RAM because disk is too slow for us.'
exec rhiza add decision old-way
exec rhiza link cache decided-by use-ram
exec rhiza link use-ram derived-from talk
exec rhiza link use-ram supersedes old-way
exec rhiza link store relates-to old-way --note 'not walked'
exec rhiza propose
exec rhiza accept --reason ok
exec rhiza land

# Both texts appear in full, with how each was reached.
exec rhiza why cache
stdout '^# Why cache$'
stdout '^## Decisions$'
stdout '^### use-ram$'
stdout '^- cache decided by use-ram$'
stdout '^- statement: We keep the hot set in RAM because disk is too slow for us\.$'
stdout '^### old-way$'
stdout '^- use-ram supersedes old-way$'
stdout '^## Sources$'
stdout '^- use-ram derived from talk$'
stdout '^- summary: The owner said caching is the point\.$'
stdout '"Keep it in memory, always\."'
stdout '^## Change sets$'
stdout '^- [0-9A-Z]{26} landed intention: Base$'

# Asked about a decision, why leads with the decision's own words.
exec rhiza why use-ram
stdout '^# Why use-ram$'
stdout '^- statement: We keep the hot set in RAM because disk is too slow for us\.$'
stdout '^- use-ram derived from talk$'

# A child inherits its parent's decisions; relates-to is not walked.
exec rhiza link store decided-by old-way --record
exec rhiza why store
stdout '^- store decided by old-way$'
stdout '^- old-way superseded by use-ram$'
! stdout 'relates'

# --json carries the fields as JSON; old-way is now reached first as
# inherited from store.
exec rhiza why cache --json
stdout '"relation": "decided by"'
stdout '"inherited": false'
stdout '"inherited": true'
stdout '"statement": "We keep the hot set in RAM because disk is too slow for us\."'
stdout '"summary": "The owner said caching is the point\."'
stdout '"view": "as-is"'

# A decision shows only the quotes of its source that contain its quote.
exec rhiza change new Cite
exec rhiza add source talk2 --json-field 'quotes=["we must  keep\nit small","we shall grow"]'
exec rhiza add decision small --field 'quote=must keep it'
exec rhiza link small derived-from talk2
exec rhiza why small
stdout 'we must  keep'
! stdout 'we shall grow'
stdout 'Quotes left out: 1'
exec rhiza why small --json
stdout '"quotes_left_out": 1'

# Nothing to say: None.
exec rhiza why talk
stdout -count=2 '^None\.$'

# An unknown ref is not_found, exit 4.
! exec rhiza why nosuch --json
stdout '"code": "not_found"'
stdout '"next": "rhiza ls"'
! exec rhiza why nosuch
