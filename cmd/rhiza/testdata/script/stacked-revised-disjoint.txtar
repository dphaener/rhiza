# Revised in place, disjoint (D13). A revises its create of base in place,
# changing a field B does not write: no overlap, no conflict anywhere, and B
# sees A's latest content.

rhiza init

# A adds base; B depends on A and sets base's statement.
rhiza change new A
stdout 'change set 01M5PWGEF85Y185JZ2ZGCNH40N '
rhiza add capability base --field statement=Base --field acceptance=a
rhiza change new B
stdout 'change set 01M5PWGKBGYFZMTH8Y8AF1G8GN '
rhiza link 01M5PWGKBGYFZMTH8Y8AF1G8GN depends-on 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza set base --field statement=FromB

# A revises acceptance, a field B never wrote.
rhiza set base --field acceptance=revised --change 01M5PWGEF85Y185JZ2ZGCNH40N
fold-ok

# No conflict in check or ready.
rhiza render
rhiza check
stdout '^ok$'
! stdout 'conflict'
rhiza ready --json
! stdout 'revised under it'

# B's what-if has A's revised acceptance and B's own statement.
rhiza show base --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stdout '^- View: what-if:01M5PWGKBGYFZMTH8Y8AF1G8GN$'
stdout '^revised$'
stdout '^FromB$'

# Accepted, A lands, then B, cleanly.
rhiza propose
rhiza accept --reason ok
rhiza propose --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza accept --reason ok --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza land --change 01M5PWGEF85Y185JZ2ZGCNH40N
rhiza land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
fold-ok
rhiza show base
stdout '^revised$'
stdout '^FromB$'
rhiza render
rhiza check
stdout '^ok$'
