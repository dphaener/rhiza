# rhiza inbox lists a change set proposed by hand with a leaf and no run as
# one accept item, under accept auto and under accept owner. A live plan run
# on it, or a failed one, takes the item away; so does accepting it.

chmod 755 mkcs.sh
chmod 755 mkrun.sh
mkdir ids
mkdir repo
cd repo
exec git init -q
exec rhiza init
exec git add -A
exec git commit -qm init
mkdir .git/rhiza/runs

exec $WORK/mkcs.sh fresh
exec $WORK/mkcs.sh other

exec git config rhiza.autonomy.accept auto
exec rhiza inbox --json
stdout 'waiting for acceptance: no plan run covers it'
stdout '"kind": "accept"'
stdout 'rhiza accept --rule owner --change '
exec sh -c 'rhiza inbox --json | grep -c "no plan run covers it" > $WORK/n'
exec grep -x 2 $WORK/n

exec git config rhiza.autonomy.accept owner
exec sh -c 'rhiza inbox --json | grep -c "no plan run covers it" > $WORK/n'
exec grep -x 2 $WORK/n

# Accepting one removes its item.
exec sh -c 'rhiza accept --rule owner --change $(cat $WORK/ids/other)'
exec sh -c 'rhiza inbox --json | grep -c "no plan run covers it" > $WORK/n'
exec grep -x 1 $WORK/n

# A live plan run covers fresh: no item.
exec $WORK/mkrun.sh 01M5PWGZZZZZZZZZZZZZZZZZ01 plan fresh live ''
exec sh -c 'rhiza inbox --json | grep -c "no plan run covers it" > $WORK/n; true'
exec grep -x 0 $WORK/n

fold-ok

-- mkcs.sh --
#!/bin/sh
set -e
rhiza change new "$1" --title "$1" --json | sed -n 's/.*"change_set": "\(.*\)",/\1/p' > "$WORK/ids/$1"
rhiza add capability "$1-leaf" > /dev/null
rhiza propose > /dev/null
-- mkrun.sh --
#!/bin/sh
set -e
f=.git/rhiza/runs/$1.jsonl
cs=$(cat "$WORK/ids/$3")
printf '{"type":"started","at":"2026-01-01T00:00:00Z","step":"s","started":{"workflow":"%s","definition":"","change":"%s"}}\n' "$2" "$cs" > "$f"
if [ "$4" = live ]; then
	printf '{"type":"process","at":"2026-01-01T00:00:02Z","process":{"host":"elsewhere","pid":999999}}\n' >> "$f"
else
	printf '{"type":"finished","at":"2026-01-01T00:02:00Z","end":"%s","detail":"%s"}\n' "$4" "$5" >> "$f"
fi
