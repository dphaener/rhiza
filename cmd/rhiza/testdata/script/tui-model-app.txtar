# The model app shows what rhiza tree and rhiza roadmap print: --once
# prints the as-is tree, a blank line, then the roadmap. It never dials Rex,
# starts a daemon or binds a socket.

exec rhiza init
exec rhiza add intent grow --record
exec rhiza add capability store --record
exec rhiza add capability disk --record
exec rhiza change new A
exec rhiza link 01M5PWGQ8GB4618G4RH2TV0ZAH serves grow
exec rhiza set store --field statement=Kept
exec rhiza propose
exec rhiza accept --reason ok
fold-ok

env REX_SESSION=
env REX_SERVER=

exec rhiza tree --view as-is
cmp stdout want-tree.txt
exec rhiza roadmap
cmp stdout want-roadmap.txt
exec rhiza tui app model --once
cmp stdout want-both.txt

# A ref limits the tree to that node's subtree.
exec rhiza tree store --view as-is
cmp stdout want-sub.txt
exec rhiza tui app model store --once
cmp stdout want-sub-both.txt

! exec rhiza tui app model --bogus --once
stderr 'takes \[<ref>\] \[--once\]'

! exists .git/rhiza/daemon.lock
exec find $WORK -type s
! stdout .

-- want-tree.txt --
- store (01M5PWGMARA1WR)
- disk (01M5PWGQ8GB461)
-- want-sub.txt --
- store (01M5PWGMARA1WR)
