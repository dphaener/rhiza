# source add makes a node of kind source from a JSON file of its title,
# summary and quotes, plus the sha256 of its raw material. The raw material,
# and its path, never reach the log.

exec rhiza init

# No change set and no --record: usage, with a next.
! exec rhiza source add founding s.json --raw raw.txt
stderr '^rhiza: no change set'
stderr '^next: '
! exists .rhiza/local/change

# --record: the node lands with the hash; the raw text and path do not.
exec rhiza source add founding s.json --raw raw.txt --record --json
stdout '"record": true'
stdout '"change_set": "[0-9A-Z]{26}"'
stdout '"nodes": \['
exec rhiza change ls
stdout '^- [0-9A-Z]{26} landed record: source add founding$'
exec grep -rl 'b345a999113979bf201cf0b7f3235db6c43e2bb620cbe731c35ab9ae859bbe7e' .rhiza/log
exec grep -rl '"raw_sha256"' .rhiza/log
exec grep -rlE '"kind": ?"source"' .rhiza/log
exec grep -rl 'yes to all five' .rhiza/log
! exec grep -r 'SECRET-RAW' .rhiza
! exec grep -r 'raw.txt' .rhiza
fold-ok

# Inside an open change set.
exec rhiza change new Sources
exec rhiza source add notes s.json --raw-sha256 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
stdout '^Wrote entry [0-9A-Z]{26} to change set [0-9A-Z]{26}\.$'
stdout '^- node [0-9A-Z]{26} \(notes\)$'
exec rhiza change show
stdout -count=1 '^- node.create'
exec grep -rl '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' .rhiza/log
fold-ok

# --dry-run writes nothing; --json and api call give the same bytes.
exec ls -R .rhiza/log
cp stdout before.txt
exec rhiza source add dry s.json --raw raw.txt --dry-run --json
stdout '"dry_run": true'
stdout '"kind": "source"'
stdout 'raw_sha256'
! stdout 'SECRET-RAW'
cp stdout dry.json
exec rhiza api call source.add '{"handle":"dry","file":"s.json","raw":"raw.txt"}' --dry-run
cmp stdout dry.json
exec ls -R .rhiza/log
cmp stdout before.txt
exec rhiza source add dry s.json --raw raw.txt --dry-run
stdout '^Dry run: would write 1 operation\(s\)'

# Exactly one of --raw and --raw-sha256.
! exec rhiza source add x s.json --record
stderr 'exactly one of --raw or --raw-sha256'
stderr '^next: rhiza describe source.add$'
! exec rhiza source add x s.json --raw raw.txt --raw-sha256 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --record --json
stdout '"code": "usage"'
exec sh -c 'rhiza source add x s.json --record >/dev/null 2>&1; echo exit $?'
stdout '^exit 2$'

# A bad --raw-sha256 is usage.
! exec rhiza source add x s.json --raw-sha256 ABC --record
stderr '64 lower-case hex'
! exec rhiza source add x s.json --raw-sha256 0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef --record
stderr '64 lower-case hex'

# Bad files are usage, naming the key.
! exec rhiza source add x extra.json --raw raw.txt --record
stderr 'unknown field "extra"'
! exec rhiza source add x quote-extra.json --raw raw.txt --record
stderr 'unknown field "page"'
! exec rhiza source add x no-title.json --raw raw.txt --record
stderr '"title" is missing or empty'
! exec rhiza source add x no-summary.json --raw raw.txt --record
stderr '"summary" is missing or empty'
! exec rhiza source add x no-quotes.json --raw raw.txt --record
stderr '"quotes" is missing'
! exec rhiza source add x empty-quote.json --raw raw.txt --record
stderr 'quotes\[0\]: "text" is missing or empty'
! exec rhiza source add x bad.json --raw raw.txt --record --json
stdout '"code": "usage"'
exec sh -c 'rhiza source add x extra.json --raw raw.txt --record >/dev/null 2>&1; echo exit $?'
stdout '^exit 2$'

# Empty quotes are fine.
exec rhiza source add bare none.json --raw-sha256 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --record
stdout '\(bare\)'

# A missing file, or a missing --raw file, is not_found.
! exec rhiza source add x missing.json --raw raw.txt --record --json
stdout '"code": "not_found"'
! exec rhiza source add x s.json --raw missing.txt --record --json
stdout '"code": "not_found"'
exec sh -c 'rhiza source add x missing.json --raw raw.txt --record >/dev/null 2>&1; echo exit $?'
stdout '^exit 4$'

# A taken handle is a conflict, as with add.
! exec rhiza source add founding s.json --raw raw.txt --record --json
stdout '"code": "conflict"'

fold-ok

-- s.json --
{"title":"Founding call","summary":"The owner agreed to the plan.","quotes":[{"text":"yes to all five","by":"owner"},{"text":"ship it","where":"minute 12"}]}
-- none.json --
{"title":"Bare","summary":"Nothing quotable.","quotes":[]}
-- raw.txt --
SECRET-RAW
-- extra.json --
{"title":"t","summary":"s","quotes":[],"extra":1}
-- quote-extra.json --
{"title":"t","summary":"s","quotes":[{"text":"q","page":3}]}
-- no-title.json --
{"title":"","summary":"s","quotes":[]}
-- no-summary.json --
{"title":"t","quotes":[]}
-- no-quotes.json --
{"title":"t","summary":"s"}
-- empty-quote.json --
{"title":"t","summary":"s","quotes":[{"text":"","by":"me"}]}
-- bad.json --
{"title":"t",
