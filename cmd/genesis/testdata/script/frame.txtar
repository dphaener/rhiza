# No arguments: usage from the registry on stdout, exit 0.
exec genesis
stdout '^Usage:'
stdout '^  describe +Describe operations'
stdout '^  api call '
stdout '^  version '
stdout '--json'
! stderr .

# -h and --help print the same usage.
exec genesis --help
stdout '^Usage:'
exec genesis -h
stdout '^Usage:'

# An unknown command: message and usage on stderr, exit 2.
! exec genesis nope
stderr '^genesis: unknown command "nope"$'
stderr '^Usage:'
! stdout .

# With --json, anywhere on the line, the error is JSON on stdout only.
! exec genesis nope --json
stdout '"code": "usage"'
stdout '"message": "unknown command \\"nope\\""'
stdout '"next": "genesis --help"'
! stderr .

# A group of operations without a subcommand asks for one, exit 2.
! exec genesis change
stderr '^genesis: "change" needs a subcommand: ls, new, show, use$'
stderr '^next: genesis --help$'
! stdout .
! exec genesis change --json
stdout '"code": "usage"'
stdout '"message": "\\"change\\" needs a subcommand: ls, new, show, use"'
! stderr .

# An unknown flag on a command is a usage error with a next command.
! exec genesis describe --bogus
stderr '^genesis: describe: unknown flag --bogus$'
stderr '^next: genesis describe describe$'
! stdout .

# Too many arguments.
! exec genesis describe a b
stderr 'too many arguments'

# A global flag without its value.
! exec genesis describe --change
stderr '^genesis: flag --change needs a value$'

# A command's --help describes it.
exec genesis describe --help
stdout '^## describe$'
stdout 'genesis describe \[<op>\]'

# Bad test clock.
env GENESIS_TEST_NOW=yesterday
! exec genesis describe
stderr 'GENESIS_TEST_NOW'
env GENESIS_TEST_NOW=

# --record is for node and link writes; anything else refuses it, exit 2,
# before touching the repo. Help still describes the command.
! exec genesis change ls --record --json
stdout '"code": "usage"'
stdout '"message": "change ls does not take --record: it is for node and link writes"'
stdout '"next": "genesis describe change.ls"'
! stderr .
! exec genesis describe --record
stderr '^genesis: describe does not take --record'
exec genesis add --record -h
stdout '^## add$'

# version still works.
exec genesis version
stdout '\Agenesis \S+\n\z'
! stderr .
