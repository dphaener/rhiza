# The change set commands. IDs are fixed: Setup pins the clock and seed and
# every run offsets them by the number of entry files, so the same script
# always writes the same IDs.

# Outside a repository every change command is not_found, exit 4.
! exec genesis change ls
stderr '^genesis: no Genesis repository in '
stderr '^next: genesis init$'
! stdout .
! exec genesis change ls --json
stdout '"code": "not_found"'
stdout '"next": "genesis init"'

exec genesis init

# An empty log.
exec genesis change ls
stdout '^No change sets yet\.$'
stdout '^next: genesis change new "<intent>"$'
exec genesis change ls --json
stdout '"change_sets": \[\]'

# change new opens an intention and makes it current. The first write
# records the git user as an actor, in its own landed record change set.
exec genesis change new 'Try it' --json
stdout '"change_set": "[0-9A-Z]{26}"'
stdout '"entry": "[0-9A-Z]{26}"'
stdout '"actor": "[0-9A-Z]{26}"'
stdout '"kind": "intention"'
stdout '"intent": "Try it"'
exec genesis change ls
stdout '^- [0-9A-Z]{26} landed record: Record actor test@genesis.invalid$'
stdout '^- [0-9A-Z]{26} draft intention: Try it \(current\)$'

# A second one becomes current.
exec genesis change new Other
stdout '^Opened change set [0-9A-Z]{26} \(intention\): Other$'
stdout '^It is now the current change set'
exec genesis change ls
stdout ': Other \(current\)$'
! stdout 'Try it \(current\)'

# change show defaults to the current change set.
exec genesis change show
stdout '^# Change set [0-9A-Z]{26}$'
stdout '^- Intent: Other$'
stdout '^- State: draft \(current\)$'
stdout '^## Operations$'
stdout '^No operations yet\.$'

# change use switches back, by full ID or a unique prefix (any case).
exec genesis change use 01M5PWGDG0ABYZR1S1GQMF9KCV
stdout '^Current change set: 01M5PWGDG0ABYZR1S1GQMF9KCV: Try it$'
grep '^01M5PWGDG0ABYZR1S1GQMF9KCV$' .genesis/local/change
exec genesis change ls
stdout ': Try it \(current\)$'
exec genesis change use 01m5pwghd0r04 --json
stdout '"change_set": "01M5PWGHD0R04H7R1ACFJCYMSD"'
stdout '"intent": "Other"'

# A prefix matching several change sets is a usage error listing them.
! exec genesis change use 01M5PWGDG0 --json
stdout '"code": "usage"'
stdout '01M5PWGDG0ABYZR1S1GCH2EVRN, 01M5PWGDG0ABYZR1S1GQMF9KCV'

# An unknown change set is not_found, exit 4.
! exec genesis change use ZZZZZZ --json
stdout '"code": "not_found"'
stdout '"next": "genesis change ls"'

# A landed change set cannot be current: conflict, exit 3.
! exec genesis change use 01M5PWGDG0ABYZR1S1GCH2EVRN --json
stdout '"code": "conflict"'
stdout 'is landed; nothing can be written to it'
stdout '"next": "genesis change new \\"<intent>\\""'
! exec genesis change use 01M5PWGDG0ABYZR1S1GCH2EVRN
stderr '^next: genesis change new "<intent>"$'

# change show takes a ref or --change, and shows a landed one's operations.
exec genesis change show 01M5PWGDG0ABYZR1S1GCH2EVRN
stdout '^# Change set 01M5PWGDG0ABYZR1S1GCH2EVRN$'
stdout '^- Intent: Record actor test@genesis.invalid$'
stdout '^- Kind: record$'
stdout '^- State: landed$'
stdout '^- Entries: 3$'
stdout '^- node.create [0-9A-Z]{26} \(test\)$'
exec genesis change show --change 01M5PWGDG0ABYZR1S1GCH2EVRN --json
stdout '"op": "node.create"'
stdout '"kind": "actor"'
stdout '"state": "landed"'
stdout '"current": false'
stdout '"problems": \[\]'

# Exactly one of a ref and --none.
! exec genesis change use
stderr '^genesis: change use takes a change set or --none'
! exec genesis change use 01M5PWGDG0ABYZR1S1GQMF9KCV --none
stderr 'not both or neither'

# --none clears it; then change show has nothing to show.
exec genesis change use --none
stdout '^No current change set\.$'
! exists .genesis/local/change
! exec genesis change show --json
stdout '"code": "usage"'
stdout '"next": "genesis change ls"'
exec genesis change ls
! stdout '\(current\)'

# A dry run prints the change set it would open and writes nothing.
exec genesis change new --dry-run Nope
stdout '^Would open change set [0-9A-Z]{26} \(intention\): Nope$'
stdout 'dry run'
exec genesis change ls
! stdout Nope
! exists .genesis/local/change

# Bad requests are usage errors, exit 2, and record nothing.
! exec genesis change new --kind bogus x --json
stdout '"code": "usage"'
stdout 'unknown change set kind'
! exec genesis change new --record x --json
stdout '"code": "usage"'
! exec genesis change new --source nothing-here x --json
stdout '"code": "not_found"'

# A record change set; api call gives the same bytes as the command.
exec genesis change new --kind record 'Fix a typo'
stdout '\(record\): Fix a typo$'
exec genesis change ls --json
cp stdout ls.json
exec genesis api call change.ls
cmp stdout ls.json

# The whole log, the auto-recorded actor included, folds cleanly.
fold-ok
