# fold-ok reads $WORK/.genesis (or a named folder) and passes only when the
# log reads and folds with no problems. The tree below is a copy of
# testdata/corpus/format-1/lifecycle/.genesis.
fold-ok
! stdout .
fold-ok .genesis

# Removing an open entry makes the fold report problems.
rm .genesis/log/01M5N90J1RW65PGTX0VGG8SZPE/01M5N90K10CPYQ18HXM016PSGG.json
! fold-ok
stdout '^fold: 01M5N90J1RW65PGTX0VGG8SZPE/'

# A file that is not an entry is a log problem.
cp garbage.json .genesis/log/01M5N90J1RW65PGTX0VGG8SZPE/01M5N90K10CPYQ18HXM016PSGG.json
! fold-ok
stdout '^log: log/01M5N90J1RW65PGTX0VGG8SZPE/01M5N90K10CPYQ18HXM016PSGG.json: '

# A missing folder is a problem too.
! fold-ok nowhere
stdout 'is not a folder'

-- garbage.json --
{"not": "an entry"}
