# guide install writes the agent guide into Claude Code as a
# skills-directory plugin: ~/.claude/skills/genesis by default, or the
# repository's .claude/skills/genesis with --project. HOME is $WORK/home,
# set by the harness, never the real one.

# A user install needs no repository and writes the four files.
! exists .genesis
exec genesis guide install --agent claude
cmpenv stdout first.txt
cmp $HOME/.claude/skills/genesis/.claude-plugin/plugin.json plugin.json
cmp $HOME/.claude/skills/genesis/hooks/hooks.json hooks.json
exists $HOME/.claude/skills/genesis/SKILL.md
exists $HOME/.claude/skills/genesis/skills/genesis-scrub/SKILL.md

# Each SKILL.md starts with its frontmatter, then the guide text.
exec head -3 $HOME/.claude/skills/genesis/SKILL.md
stdout '\A---\nname: genesis\ndescription: "Work with the product model of a repository that has a \.genesis/ folder: .*"\n\z'
grep '^# Genesis$' $HOME/.claude/skills/genesis/SKILL.md
exec head -3 $HOME/.claude/skills/genesis/skills/genesis-scrub/SKILL.md
stdout '\A---\nname: genesis-scrub\ndescription: "Turn a raw conversation .*"\n\z'

# A second install writes nothing.
exec genesis guide install --agent claude
cmpenv stdout again.txt

# --json and api call print the same bytes.
exec genesis guide install --agent claude --json
cp stdout install.json
exec genesis api call guide.install '{"agent":"claude"}'
cmp stdout install.json
stdout '"written": \[\]'

# A plugin.json from another version is rewritten; the other files are not.
exec sh -c 'sed "s/\"dev\"/\"v0.0.1\"/" $HOME/.claude/skills/genesis/.claude-plugin/plugin.json > p.tmp && mv p.tmp $HOME/.claude/skills/genesis/.claude-plugin/plugin.json'
grep v0.0.1 $HOME/.claude/skills/genesis/.claude-plugin/plugin.json
exec genesis guide install --agent claude
cmpenv stdout version.txt
cmp $HOME/.claude/skills/genesis/.claude-plugin/plugin.json plugin.json

# guide install writes no log entry: --dry-run is a usage error, exit 2.
! exec genesis guide install --agent claude --dry-run
stderr 'does not take --dry-run'
stderr '^next: genesis guide install --agent claude$'
exec sh -c 'genesis guide install --agent claude --dry-run 2>/dev/null; echo exit $?'
stdout '^exit 2$'

# --agent is required and takes only claude: exit 2.
exec sh -c 'genesis guide install 2>/dev/null; echo exit $?'
stdout '^exit 2$'
! exec genesis guide install --agent agents-md
stderr '^genesis: unknown agent "agents-md": want claude$'
exec sh -c 'genesis guide install --agent agents-md 2>/dev/null; echo exit $?'
stdout '^exit 2$'

# A folder guide install did not write is a conflict, exit 3; nothing in it
# is touched.
rm $HOME/.claude/skills/genesis
mkdir $HOME/.claude/skills/genesis
cp mine.md $HOME/.claude/skills/genesis/SKILL.md
cp extra.txt $HOME/.claude/skills/genesis/extra.txt
! exec genesis guide install --agent claude
stderr 'exists and was not written by genesis guide install$'
stderr '^next: genesis guide install --agent claude --force$'
exec sh -c 'genesis guide install --agent claude 2>/dev/null; echo exit $?'
stdout '^exit 3$'
cmp $HOME/.claude/skills/genesis/SKILL.md mine.md
! exists $HOME/.claude/skills/genesis/.claude-plugin

# A plugin.json without the marker is not ours either.
mkdir $HOME/.claude/skills/genesis/.claude-plugin
cp foreign-plugin.json $HOME/.claude/skills/genesis/.claude-plugin/plugin.json
exec sh -c 'genesis guide install --agent claude 2>/dev/null; echo exit $?'
stdout '^exit 3$'
cmp $HOME/.claude/skills/genesis/.claude-plugin/plugin.json foreign-plugin.json

# --force writes the four files and keeps the others.
exec genesis guide install --agent claude --force
cmpenv stdout first.txt
cmp $HOME/.claude/skills/genesis/.claude-plugin/plugin.json plugin.json
cmp $HOME/.claude/skills/genesis/extra.txt extra.txt
grep '^# Genesis$' $HOME/.claude/skills/genesis/SKILL.md

# --project outside a repository is not_found, exit 4.
! exec genesis guide install --agent claude --project
stderr '^genesis: no Genesis repository in '
stderr '^next: genesis init$'
exec sh -c 'genesis guide install --agent claude --project 2>/dev/null; echo exit $?'
stdout '^exit 4$'
! exists .claude

# --project inside a repository writes .claude/skills/genesis there.
mkdir proj
cd proj
exec genesis init
exec genesis guide install --agent claude --project
stdout '^Installed the Genesis guide in .*/proj/\.claude/skills/genesis \(4 written, 0 unchanged\)\.$'
cmp .claude/skills/genesis/.claude-plugin/plugin.json $WORK/plugin.json
cmp .claude/skills/genesis/hooks/hooks.json $WORK/hooks.json
exists .claude/skills/genesis/SKILL.md
exists .claude/skills/genesis/skills/genesis-scrub/SKILL.md
fold-ok

# A project conflict's next keeps --project.
exec sh -c 'rm .claude/skills/genesis/.claude-plugin/plugin.json'
! exec genesis guide install --agent claude --project
stderr '^next: genesis guide install --agent claude --force --project$'

-- first.txt --
Installed the Genesis guide in $HOME/.claude/skills/genesis (4 written, 0 unchanged).

- wrote .claude-plugin/plugin.json
- wrote SKILL.md
- wrote hooks/hooks.json
- wrote skills/genesis-scrub/SKILL.md
-- again.txt --
Installed the Genesis guide in $HOME/.claude/skills/genesis (0 written, 4 unchanged).
-- version.txt --
Installed the Genesis guide in $HOME/.claude/skills/genesis (1 written, 3 unchanged).

- wrote .claude-plugin/plugin.json
-- plugin.json --
{
  "description": "The Genesis agent guide: the genesis and genesis-scrub skills, and a SessionStart hook that runs genesis status --hook.",
  "genesis": {
    "installed_by": "genesis guide install"
  },
  "name": "genesis",
  "version": "dev"
}
-- hooks.json --
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "status",
              "--hook"
            ],
            "command": "genesis",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
-- mine.md --
mine
-- extra.txt --
keep me
-- foreign-plugin.json --
{"name":"genesis","version":"v9"}
