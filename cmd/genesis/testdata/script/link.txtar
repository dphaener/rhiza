# link creates a link between two live nodes; unlink retires one, or drops
# it if the same change set created it. Link writes report links, not nodes.

exec genesis init
exec genesis change new Shape
exec genesis add capability store
exec genesis add capability log
exec genesis add decision d1
exec genesis add constraint c1

exec genesis link log depends-on store
stdout '^Wrote entry [0-9A-Z]{26} to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
stdout '^- link [0-9A-Z]{26}$'
! stdout '^- node'
exec genesis link log relates-to store --note 'Same data' --json
stdout '"links": \[\n    "[0-9A-Z]{26}"\n  \]'
stdout '"nodes": \[\]'
exec genesis link c1 exempts log --note Prototype --decision d1
exec genesis change show
stdout -count=3 '^- link.create '

# A dry run writes nothing.
exec genesis link store serves log --dry-run
stdout '"op":"link.create"'
stdout '"type":"serves"'
exec genesis change show
stdout -count=3 '^- link.create '

# The same live link again is a conflict, exit 3.
! exec genesis link log depends-on store --json
stdout '"code": "conflict"'
stdout 'already exists'

# Usage errors, exit 2.
! exec genesis link log bogus store
stderr 'unknown link type'
! exec genesis link log relates-to store
stderr 'needs --note'
! exec genesis link c1 exempts store --note x
stderr 'needs --decision'
! exec genesis link c1 exempts store --note x --decision log
stderr 'not a decision'
! exec genesis link log serves store --decision d1
stderr 'only an exempts link'
! exec genesis link 01M5PWG serves store --json
stdout '"code": "usage"'

# Unknown nodes are not_found, exit 4.
! exec genesis link nosuch serves store --json
stdout '"code": "not_found"'

# unlink of a link added here drops it.
exec genesis unlink log depends-on store
stdout '^- link [0-9A-Z]{26}$'
exec genesis change show
stdout -count=2 '^- link.create '
! exec genesis unlink log depends-on store --json
stdout '"code": "not_found"'
! exec genesis unlink log depends-on
stderr 'unlink takes a link'

# unlink of a landed link writes a link.retire.
exec genesis add capability a --record
exec genesis add capability b --record
exec genesis link a serves b --record --json
stdout '"record": true'
exec genesis unlink a serves b --json
stdout '"links": \['
exec genesis change show --json
stdout '"op": "link.retire"'
! exec genesis unlink ZZZZZZ --json
stdout '"code": "not_found"'

fold-ok
