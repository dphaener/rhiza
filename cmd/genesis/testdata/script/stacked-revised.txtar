# Revised in place, overlapping (D13). B depends on A and sets base's
# statement; A then revises its own node.create of base in place (same op
# ID, so base's version is unchanged) and the revision changes the statement
# too. B would overwrite a value it never saw: check warns with next, ready
# gives the reason, and land refuses B, before A lands and after.

exec genesis init

# A adds base; B depends on A and sets base's statement.
exec genesis change new A
stdout 'change set 01M5PWGEF85Y185JZ2ZGCNH40N '
exec genesis add capability base --field statement=Base --field owner=a
stdout '^- node 01M5PWGJC82P7YGZTWYFFZ0VJG \(base\)$'
exec genesis change new B
stdout 'change set 01M5PWGKBGYFZMTH8Y8AF1G8GN '
exec genesis link 01M5PWGKBGYFZMTH8Y8AF1G8GN depends-on 01M5PWGEF85Y185JZ2ZGCNH40N
exec genesis set base --field statement=FromB
exec genesis render
exec genesis check
stdout '^ok$'
! stdout 'conflict'

# A revises its create of base in place: one op, same ID, new statement.
exec genesis set base --field statement=Revised --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec genesis change show 01M5PWGEF85Y185JZ2ZGCNH40N --json
stdout '"id": "01M5PWGJC82P7YGZTWYJ3Y88Z9"'
stdout '"statement": "Revised"'
! stdout 'node.update'
fold-ok

# check warns on B's op, naming A's revised op and the field, with next.
exec genesis check
stdout '^ok$'
stdout '^warn in-flight change set 01M5PWGKBGYFZMTH8Y8AF1G8GN, op 01M5PWGNA0MVZ1H5AXG5VQ0BY9: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N revised op 01M5PWGJC82P7YGZTWYJ3Y88Z9 on 01M5PWGJC82P7YGZTWYFFZ0VJG \(field:statement\) after op 01M5PWGNA0MVZ1H5AXG5VQ0BY9 was written$'
stdout '^  next: genesis slice --change 01M5PWGKBGYFZMTH8Y8AF1G8GN --view what-if$'
exec genesis check --json
stdout '"next": "genesis slice --change 01M5PWGKBGYFZMTH8Y8AF1G8GN --view what-if"'

# Both accepted: A is ready, B is not, with the revision as a reason.
exec genesis propose
exec genesis accept --reason ok
exec genesis propose --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec genesis accept --reason ok --change 01M5PWGEF85Y185JZ2ZGCNH40N
exec genesis ready
stdout '^next: 01M5PWGEF85Y18 A$'
stdout '^  - 01M5PWGEF85Y18 revised under it: 1 operations$'
exec genesis ready --json
stdout '"reasons": \[\n +"depends on 01M5PWGEF85Y18 \(accepted\)",\n +"01M5PWGEF85Y18 revised under it: 1 operations"\n +\]'

# land refuses B, exit 3 with next: A has not landed.
! exec genesis land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stderr '^genesis: cannot land change set 01M5PWGKBGYFZMTH8Y8AF1G8GN: it depends on 01M5PWGEF85Y185JZ2ZGCNH40N \(accepted\)$'
stderr '^next: genesis land --change 01M5PWGEF85Y18$'

# A lands. The revision still went under B's write: A is landed but B
# depends on it, so check still warns, ready gives the reason, and land
# refuses B, exit 3, with next.
exec genesis land --change 01M5PWGEF85Y185JZ2ZGCNH40N
fold-ok
exec genesis render
exec genesis check
stdout '^ok$'
stdout '^warn in-flight change set 01M5PWGKBGYFZMTH8Y8AF1G8GN, op 01M5PWGNA0MVZ1H5AXG5VQ0BY9: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N revised op 01M5PWGJC82P7YGZTWYJ3Y88Z9 on 01M5PWGJC82P7YGZTWYFFZ0VJG \(field:statement\) after op 01M5PWGNA0MVZ1H5AXG5VQ0BY9 was written$'
exec genesis ready --json
stdout '"reasons": \[\n +"01M5PWGEF85Y18 revised under it: 1 operations"\n +\]'
! stdout '"next"'
! exec genesis land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stderr '^genesis: cannot land change set 01M5PWGKBGYFZMTH8Y8AF1G8GN: model: conflict: change set 01M5PWGEF85Y185JZ2ZGCNH40N revised op 01M5PWGJC82P7YGZTWYJ3Y88Z9 '
stderr '^next: genesis check$'
exec sh -c 'genesis land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN 2>/dev/null; echo exit $?'
stdout '^exit 3$'

# B, having seen Revised, writes the statement again: the conflict clears
# and B lands with its new value.
exec genesis show base --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stdout '^FromB$'
exec genesis set base --field statement=FromBAgain --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
exec genesis check
! stdout 'conflict'
exec genesis ready --json
stdout '"next": "01M5PWGKBGYFZMTH8Y8AF1G8GN"'
exec genesis land --change 01M5PWGKBGYFZMTH8Y8AF1G8GN
stdout '^Landed change set 01M5PWGKBGYFZMTH8Y8AF1G8GN \(accepted → landed\)\.$'
fold-ok
exec genesis show base
stdout '^FromBAgain$'
exec genesis render
exec genesis check
stdout '^ok$'
! stdout 'warn in-flight'
