# A fresh init survives a clone: git keeps no empty folder, so init leaves
# .genesis/log/.gitkeep and a clone still has the (empty) log to check.
mkdir origin
cd origin
exec git init -q
exec genesis init
exists .genesis/log/.gitkeep
exec genesis render
exec git add -A
exec git commit -qm init
exec genesis check
stdout '^ok$'

cd $WORK
exec git clone -q origin clone
cd clone
exists .genesis/log/.gitkeep
exec genesis check
stdout '^ok$'
! stdout fail
