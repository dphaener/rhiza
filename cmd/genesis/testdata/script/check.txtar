# check reports every finding of the log, the links and the rendered
# markdown, failures first; it exits 1 on any failure and 0 when there are
# only warnings. $WORK is no git work tree, so the append-only rule is
# skipped with a warning throughout (check-git.txtar covers it).

# A fresh repository, rendered, is ok.
mkdir fresh
cd fresh
exec genesis init
! exec genesis check
stdout '^failed$'
stdout '^fail render \.genesis/rendered: the rendered folder is missing$'
stdout '^  next: genesis render$'
exec genesis render
exec genesis check
cmp stdout $WORK/ok.txt

# A stale render fails with the command that fixes it.
cp $WORK/stale.md .genesis/rendered/index.md
! exec genesis check
stdout '^failed$'
stdout '^fail render \.genesis/rendered/index\.md: differs from what render writes$'
stdout '^  next: genesis render$'
exec sh -c 'genesis check >/dev/null; echo exit $?'
stdout '^exit 1$'
exec genesis render
exec genesis check
stdout '^ok$'

# --json and api call print the same bytes, and both exit 1 on a failure.
cp $WORK/stale.md .genesis/rendered/index.md
! exec genesis check --json
cp stdout check.json
stdout '"ok": false'
stdout '"rule": "render"'
stdout '"next": "genesis render"'
! stdout '"change_set"'
! exec genesis api call check
cmp stdout check.json
exec sh -c 'genesis check --json >/dev/null; echo exit $?; genesis api call check >/dev/null; echo exit $?'
stdout -count=2 '^exit 1$'
exec genesis render
exec genesis check --json
cmp stdout $WORK/ok.json
exec genesis api call check '{}'
cmp stdout $WORK/ok.json

# Check writes nothing: --dry-run is a usage error.
! exec genesis check --dry-run
stderr 'does not take --dry-run'
stderr '^next: genesis check$'
exec sh -c 'genesis check --dry-run 2>/dev/null; echo exit $?'
stdout '^exit 2$'
fold-ok

# A link whose type does not join its endpoints' kinds fails. Writes do
# not check endpoints; check does.
cd $WORK
mkdir badlink
cd badlink
exec genesis init
exec genesis add intent fast --record
exec genesis add capability store --record
exec genesis link fast verifies store --record
exec genesis render
fold-ok
! exec genesis check
stdout '^fail link change set [0-9A-Z]{26}, op [0-9A-Z]{26}, link [0-9A-Z]{26}: link type "verifies" does not go from intent to capability$'
exec genesis unlink fast verifies store --record
exec genesis render
exec genesis check
stdout '^ok$'

# A corrupt entry file fails the log rule.
exists .genesis/log/01M5PWGEF85Y185JZ2ZB9QSVK7/01M5PWGEF85Y185JZ2ZEVTPAGP.json
cp $WORK/corrupt.json .genesis/log/01M5PWGEF85Y185JZ2ZB9QSVK7/01M5PWGEF85Y185JZ2ZEVTPAGP.json
! exec genesis check
stdout '^fail log \.genesis/log/01M5PWGEF85Y185JZ2ZB9QSVK7/01M5PWGEF85Y185JZ2ZEVTPAGP\.json: '

# A landed conflict fails the model rule. Two record change sets set the
# same field from the same base: the first is hidden while the second is
# written (with another seed, so their IDs differ), then put back.
cd $WORK
mkdir conflict
cd conflict
exec genesis init
exec genesis add capability store --record
exec genesis set store --field statement=A --record
stdout '^Recorded and landed change set 01M5PWGMARA1WR6BD0MGG098MY '
mv .genesis/log/01M5PWGMARA1WR6BD0MGG098MY $WORK/hold
env GENESIS_TEST_SEED=2
exec genesis set store --field statement=B --record
env GENESIS_TEST_SEED=1
mv $WORK/hold .genesis/log/01M5PWGMARA1WR6BD0MGG098MY
fold-ok
exec genesis render
! exec genesis check
stdout '^fail model change set [0-9A-Z]{26}, op [0-9A-Z]{26}: model: conflict: .* is stale: .* wrote field:statement$'
stdout '^  next: genesis change new "Resolve the conflict on 01M5PWGEF85Y185JZ2ZMTJ11QP"$'

# Two concurrent entries writing the same op only warn: an honest merge
# leaves them. The second set is written while the first is hidden.
cd $WORK
mkdir concurrent
cd concurrent
exec genesis init
exec genesis change new Shape
exec genesis add capability a
exec genesis set a --field s=1
stdout '^Wrote entry 01M5PWGKBGYFZMTH8Y8AF1G8GN to change set 01M5PWGEF85Y185JZ2ZGCNH40N\.$'
mv .genesis/log/01M5PWGEF85Y185JZ2ZGCNH40N/01M5PWGKBGYFZMTH8Y8AF1G8GN.json $WORK/hold.json
env GENESIS_TEST_SEED=2
exec genesis set a --field s=2
env GENESIS_TEST_SEED=1
mv $WORK/hold.json .genesis/log/01M5PWGEF85Y185JZ2ZGCNH40N/01M5PWGKBGYFZMTH8Y8AF1G8GN.json
exec genesis render
exec genesis check
stdout '^ok$'
stdout '^warn fold \.genesis/log/01M5PWGEF85Y185JZ2ZGCNH40N/01M5PWGKBGYFZMTH8Y8AF1G8GN\.json: changeset: concurrent entries: ops [0-9A-Z]{26} and ops 01M5PWGKBGYFZMTH8Y8AF1G8GN both write op [0-9A-Z]{26}$'
! stdout '^fail'

# Outside a repository, check is not_found.
cd $WORK
mkdir empty
cd empty
! exec genesis check
stderr '^genesis: no Genesis repository in '
stderr '^next: genesis init$'
! exec genesis check --json
stdout '"code": "not_found"'
exec sh -c 'genesis check 2>/dev/null; echo exit $?'
stdout '^exit 4$'

-- ok.txt --
ok
append-only: skipped (not a git work tree)

warn append-only: append-only check skipped: not a git work tree
-- ok.json --
{
  "base": "",
  "findings": [
    {
      "message": "append-only check skipped: not a git work tree",
      "rule": "append-only",
      "severity": "warn"
    }
  ],
  "ok": true,
  "skipped": "not a git work tree"
}
-- stale.md --
# Model

Something else.
-- corrupt.json --
{"not": "an entry"
