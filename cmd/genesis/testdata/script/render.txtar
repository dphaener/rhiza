# render writes the as-is model as markdown under .genesis/rendered: only
# the files whose bytes differ, and it removes what it does not write.

# Outside a repository render is not_found, exit 4.
! exec genesis render
stderr '^genesis: no Genesis repository in '
stderr '^next: genesis init$'
exec sh -c 'genesis render 2>/dev/null; echo exit $?'
stdout '^exit 4$'

# An empty repository renders the empty index.
exec genesis init
exec genesis render
cmp stdout first.txt
cmp .genesis/rendered/index.md empty.md

# Render writes no log entry: --dry-run is a usage error, exit 2.
! exec genesis render --dry-run
stderr 'does not take --dry-run'
stderr '^next: genesis render$'
exec sh -c 'genesis render --dry-run 2>/dev/null; echo exit $?'
stdout '^exit 2$'

# Nothing renders until it lands.
exec genesis add capability store --field 'statement=Keeps the log' --record
exec genesis add capability log --parent store --record
exec genesis add constraint c1 --field statement=Small --record
exec genesis link c1 constrains log --record
exec genesis change new Shape
exec genesis add capability draft
exec genesis render
stdout '^Rendered 5 files \(5 written, 0 removed, 0 unchanged\)\.$'
stdout '^- wrote \.genesis/rendered/capability/store/log\.md$'
! stdout draft
cmp .genesis/rendered/index.md golden/index.md
cmp .genesis/rendered/actor/test.md golden/actor/test.md
cmp .genesis/rendered/capability/store.md golden/capability/store.md
cmp .genesis/rendered/capability/store/log.md golden/capability/store/log.md
cmp .genesis/rendered/constraint/c1.md golden/constraint/c1.md
! exists .genesis/rendered/capability/draft.md

# A second render writes nothing.
exec genesis render
cmp stdout again.txt

# A file render does not write is removed, and so is a folder it empties;
# a changed page is rewritten.
mkdir .genesis/rendered/old/deep
cp empty.md .genesis/rendered/old/deep/page.md
cp empty.md .genesis/rendered/extra.md
cp empty.md .genesis/rendered/constraint/c1.md
exec genesis render
cmp stdout prune.txt
! exists .genesis/rendered/old
! exists .genesis/rendered/extra.md
cmp .genesis/rendered/constraint/c1.md golden/constraint/c1.md

# --json and api call print the same bytes.
exec genesis render --json
cp stdout render.json
exec genesis api call render
cmp stdout render.json
cmp stdout again.json
fold-ok

-- empty.md --
# Model

Nothing has landed yet.
-- first.txt --
Rendered 1 file (1 written, 0 removed, 0 unchanged).

- wrote .genesis/rendered/index.md
-- again.txt --
Rendered 5 files (0 written, 0 removed, 5 unchanged).
-- prune.txt --
Rendered 5 files (1 written, 4 removed, 4 unchanged).

- wrote .genesis/rendered/constraint/c1.md
- removed .genesis/rendered/extra.md
- removed .genesis/rendered/old
- removed .genesis/rendered/old/deep
- removed .genesis/rendered/old/deep/page.md
-- again.json --
{
  "removed": [],
  "unchanged": 5,
  "written": []
}
