# show prints one node (its fields, path, links out and in, children) or
# one link, in a view. A ref is tried as a node, then as a link.

exec genesis init
exec genesis add capability store --field 'statement=Keep the log' --record
exec genesis add capability cache --parent store --record
exec genesis add capability ram --parent cache --record
exec genesis add intent faster --record
exec genesis link cache serves faster --record
exec genesis retire ram --reason 'Too small' --record

# By handle: markdown, every section that has something in it.
exec genesis show cache
cmp stdout cache.md
exec genesis show store
stdout '^# capability store$'
stdout '^## Fields$'
stdout '^### statement$'
stdout '^Keep the log$'
! stdout '^## Links$'
! stdout '^- Path:'

# Incoming links read backwards.
exec genesis show faster
stdout '^- served by cache \(01M5PWGMARA1WR\)$'
! stdout '^## Children$'

# By ID prefix, a retired node too (its handle no longer resolves).
exec genesis show 01M5PWGQ8GB4
stdout '^# capability ram$'
stdout '^- Retired: Too small$'
stdout '^- Path: store / cache$'
! exec genesis show ram
stderr '^next: genesis ls$'

# By link ID, full or a prefix.
exec genesis show 01M5PWGX40FB1RBRN9YHMNJW07
cmp stdout link.md
exec genesis show 01M5PWGX40FB --json
stdout '"kind": "link"'
stdout '"handle": "faster"'

# --json is the canonical response, the same bytes as api call.
exec genesis show cache --json
stdout '"kind": "node"'
stdout '"name": "serves"'
stdout '"view": "as-is"'
cp stdout show.json
exec genesis api call show '{"ref":"cache"}'
cmp stdout show.json
exec genesis show 01M5PWGX40FB1RBRN9YHMNJW07 --json
cp stdout link.json
exec genesis api call show '{"ref":"01M5PWGX40FB1RBRN9YHMNJW07"}'
cmp stdout link.json

# Nothing by that ref: not_found, exit 4, with a next.
! exec genesis show nosuch
stderr '^genesis: no node or link matches "nosuch"$'
stderr '^next: genesis ls$'
exec sh -c 'genesis show nosuch 2>/dev/null; echo exit $?'
stdout '^exit 4$'
! exec genesis show nosuch --json
stdout '"code": "not_found"'

# An ambiguous node prefix is usage, exit 2; so is a bad view.
! exec genesis show 01M5PWG --json
stdout '"code": "usage"'
! exec genesis show cache --view sideways --json
stdout '"code": "usage"'

# In a draft change set the default view is its what-if: a node it adds
# shows there, not in as-is.
exec genesis change new 'Add disk'
exec genesis add capability disk --parent store
exec genesis show disk
stdout '^# capability disk$'
stdout '^- View: what-if:[0-9A-Z]{26}$'
! exec genesis show disk --view as-is
stderr 'no node or link matches "disk"'
exec genesis show store
stdout '^- capability disk \('

fold-ok

-- cache.md --
# capability cache

- ID: 01M5PWGMARA1WR6BD0MEF4Y76P
- Path: store
- Version: 01M5PWGMARA1WR6BD0MGG098MY
- Created: 01M5PWGMARA1WR6BD0MJ9F50JK
- View: as-is

## Links

- serves faster (01M5PWGT68X5XK)

## Children

- capability ram (01M5PWGQ8GB461) [retired]
-- link.md --
# link 01M5PWGX40FB1R

- ID: 01M5PWGX40FB1RBRN9YHMNJW07
- Type: serves
- From: cache (01M5PWGMARA1WR)
- To: faster (01M5PWGT68X5XK)
- Version: 01M5PWGX40FB1RBRN9YMPACB1N
- Created: 01M5PWGX40FB1RBRN9YPPM0XVN
- View: as-is
