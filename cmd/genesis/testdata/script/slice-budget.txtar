# --budget fits the slice to a token budget (4 bytes a token), measured on
# the bytes printed, so markdown and --json cut on their own: lower sections
# shrink to one line per item (brief), then to a count, from In flight up,
# and the footer names each and the command that shows it. Focus,
# Constraints and Open questions are never cut. Past that, the slice is
# printed anyway, marked over budget, and the exit code is still 0.
#
# Uncut, log's slice is 292 tokens of markdown and 843 of JSON. At 250
# (markdown) and 700 (JSON) some sections are brief and the rest counts.

exec genesis init
exec genesis apply model.json --record

exec genesis slice log --budget 250
cmp stdout cut.md
exec genesis slice log --budget 250
cmp stdout cut.md
exec genesis slice log --budget 700 --json
cmp stdout cut.json
exec genesis slice log --budget 700 --json
cmp stdout cut.json

# Everything that can be cut is a count, and it is still over: exit 0.
exec genesis slice log --budget 20
cmp stdout over.md
stdout '^Still over budget by [0-9]+ tokens\.$'
exec genesis slice log --budget 20
cmp stdout over.md
exec genesis slice log --budget 20 --json
cmp stdout over.json
stdout '"over_budget": true'
exec genesis slice log --budget 20 --json
cmp stdout over.json

-- model.json --
{"writes":[
  {"op":"add","kind":"capability","handle":"store","fields":["statement=Keeps the log on disk"]},
  {"op":"add","kind":"capability","handle":"log","parent":"store","fields":["statement=Appends entries, one file each","owner=storage team"]},
  {"op":"add","kind":"capability","handle":"segment","parent":"log","fields":["statement=Splits the log into segments"]},
  {"op":"add","kind":"capability","handle":"index","fields":["statement=Answers queries fast"]},
  {"op":"add","kind":"constraint","handle":"no-network","fields":["statement=Never touches the network"]},
  {"op":"add","kind":"constraint","handle":"plain-json","fields":["statement=Every file is plain JSON"]},
  {"op":"link","from":"no-network","type":"constrains","to":"store"},
  {"op":"link","from":"plain-json","type":"constrains","to":"store"},
  {"op":"add","kind":"decision","handle":"binary-segments","fields":["statement=Segments may be binary"]},
  {"op":"link","from":"log","type":"exempts","to":"plain-json","note":"Segments are packed","decision":"binary-segments"},
  {"op":"add","kind":"decision","handle":"use-sqlite","fields":["statement=Keep the log in SQLite"]},
  {"op":"add","kind":"decision","handle":"use-files","fields":["statement=One file per entry"]},
  {"op":"link","from":"log","type":"decided-by","to":"use-sqlite"},
  {"op":"link","from":"log","type":"decided-by","to":"use-files"},
  {"op":"link","from":"use-files","type":"supersedes","to":"use-sqlite"},
  {"op":"add","kind":"decision","handle":"git-friendly","fields":["statement=Diffs stay readable in git"]},
  {"op":"link","from":"store","type":"decided-by","to":"git-friendly"},
  {"op":"add","kind":"question","handle":"which-fs","fields":["statement=Which file systems must we support?"]},
  {"op":"link","from":"which-fs","type":"blocks","to":"log"},
  {"op":"add","kind":"question","handle":"max-size","fields":["statement=How large may one entry be?"]},
  {"op":"link","from":"max-size","type":"relates-to","to":"log","note":"Bounds the file size"},
  {"op":"add","kind":"question","handle":"one-dir","fields":["statement=One folder per change set?"]},
  {"op":"link","from":"one-dir","type":"blocks","to":"log"},
  {"op":"link","from":"use-files","type":"answers","to":"one-dir"},
  {"op":"add","kind":"evidence","handle":"log-tests","fields":["statement=The log tests pass","status=verified"]},
  {"op":"link","from":"log-tests","type":"verifies","to":"log"},
  {"op":"add","kind":"evidence","handle":"fsync-bench","fields":["statement=fsync stays under 2 ms","status=failing"]},
  {"op":"link","from":"fsync-bench","type":"verifies","to":"segment"},
  {"op":"add","kind":"anchor","handle":"log-go","fields":["statement=internal/store/log.go"]},
  {"op":"link","from":"log-go","type":"implements","to":"log"},
  {"op":"link","from":"log","type":"depends-on","to":"index"},
  {"op":"add","kind":"capability","handle":"render","fields":["statement=Writes markdown"]},
  {"op":"link","from":"render","type":"depends-on","to":"log"},
  {"op":"link","from":"log","type":"relates-to","to":"render","note":"Render reads the log"}
]}
