# guide prints the agent guide that ships in the binary, and guide ls lists
# its texts. Neither needs a repository: this script starts with none.

! exists .genesis

# genesis guide prints the genesis skill, the same as guide genesis.
exec genesis guide
stdout '^# Genesis$'
stdout '^## The core loop$'
stdout '^## Hard rules$'
! stderr .
cp stdout skill.md
exec genesis guide genesis
cmp stdout skill.md

# --json carries the name, the version and the same text; api call gives
# the same bytes.
exec genesis guide --json
stdout '"name": "genesis"'
stdout '"version": "'
stdout '"text": "# Genesis\\n'
stdout 'The core loop'
cp stdout guide.json
exec genesis api call guide '{}'
cmp stdout guide.json
exec genesis guide sources --json
cp stdout sources.json
exec genesis api call guide '{"name":"sources"}'
cmp stdout sources.json

# The scrub skill.
exec genesis guide scrub
stdout '^# genesis-scrub$'
stdout '^## Steps$'

# Each topic.
exec genesis guide apply
stdout '^# apply$'
stdout '^## The file$'
exec genesis guide change-sets
stdout '^# Change sets$'
stdout '^## Lifecycle$'
exec genesis guide sources
stdout '^# Sources$'
stdout '^## Stored fields$'

# guide ls lists all five texts with their kinds and sizes.
exec genesis guide ls
stdout -count=5 '^- '
stdout '^- genesis +skill +[0-9]+ tokens  Work with the product model'
stdout '^- scrub +skill +[0-9]+ tokens  '
stdout '^- apply +topic +[0-9]+ tokens  '
stdout '^- change-sets +topic +[0-9]+ tokens  '
stdout '^- sources +topic +[0-9]+ tokens  '
exec genesis guide ls --json
stdout '"texts": \['
stdout '"kind": "skill"'
stdout '"kind": "topic"'
stdout '"tokens": [0-9]+'
cp stdout ls.json
exec genesis api call guide.ls '{}'
cmp stdout ls.json

# An unknown name is not_found, exit 4, with a next.
! exec genesis guide nope
stderr '^genesis: no guide text "nope"$'
stderr '^next: genesis guide ls$'
! stdout .
exec sh -c 'genesis guide nope 2>/dev/null; echo exit $?'
stdout '^exit 4$'
! exec genesis guide nope --json
stdout '"code": "not_found"'
stdout '"next": "genesis guide ls"'

# Nothing above made a repository; inside one guide works the same.
! exists .genesis
exec genesis init
exec genesis guide
cmp stdout skill.md
exec genesis guide ls --json
cmp stdout ls.json
