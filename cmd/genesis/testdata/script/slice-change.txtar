# slice with no ref is a change slice of the effective change set
# (--change, else GENESIS_CHANGE, else the current one): every node it
# touches is a Focus item, the other sections their union, and its intent
# heads the slice. The default view follows the change set: what-if for a
# draft or proposed one, to-be for an accepted one, as-is for none.

exec genesis init
exec genesis apply model.json --record
exec genesis change new 'Add a read cache'
exec genesis add capability cache --parent store --field 'statement=Caches reads'
exec genesis link cache depends-on log
exec genesis set log --field 'statement=Appends entries in batches'

# The current draft: what-if, and the same bytes every time.
exec genesis slice
cmp stdout change.md
! stderr .
exec genesis slice
cmp stdout change.md
exec genesis slice --json
cmp stdout change.json
exec genesis slice --json
cmp stdout change.json

# A node slice through the change set: cache exists only in what-if.
exec genesis slice cache
cmp stdout cache.md
exec genesis slice cache
cmp stdout cache.md

# With no current change set there is nothing to slice without a ref.
exec genesis change use --none
! exec genesis slice
stderr '^genesis: no change set to slice'
stderr '^next: genesis slice <ref>$'
! exec genesis slice --json
stdout '"code": "usage"'

# --change by a unique prefix, any case, and GENESIS_CHANGE: the same slice.
exec genesis slice --change 01M5PWGMAR
cmp stdout change.md
env GENESIS_CHANGE=01m5pwgmar
exec genesis slice
cmp stdout change.md
env GENESIS_CHANGE=

# --view as-is: the touched nodes as they are, without the new one.
exec genesis slice --change 01M5PWGMAR --view as-is
cmp stdout change-as-is.md
exec genesis slice --change 01M5PWGMAR --view as-is
cmp stdout change-as-is.md

# what-if needs a change set.
! exec genesis slice log --view what-if
stderr '^genesis: --view what-if needs a change set'
stderr '^next: genesis change ls$'
! exec genesis slice log --view what-if --json
stdout '"code": "usage"'

# Accepted: the default is to-be.
exec genesis change use 01M5PWGMAR
exec genesis propose
exec genesis accept --reason ok
exec genesis slice
cmp stdout accepted.md
exec genesis slice
cmp stdout accepted.md

# A second draft that also touches log: the accepted one is in flight.
exec genesis change new 'Tune the log'
exec genesis set log --field 'owner=core team'
exec genesis slice log
cmp stdout in-flight.md
exec genesis slice log
cmp stdout in-flight.md

